BEGIN|prosa.analysis.facts.busy_interval.service_inversion.cumul_service_inv_le_cumul_priority_inv
@cumul_service_inv_le_cumul_priority_inv
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job), uniprocessor_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall (j : Job) (t1 t2 : instant), cumulative_service_inversion arr_seq sched j t1 t2 <= cumulative_priority_inversion arr_seq sched j t1 t2
