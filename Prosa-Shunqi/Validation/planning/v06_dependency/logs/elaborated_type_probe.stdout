     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (tsk : Task) (H3 : Interference Job) (j : Job) (t1 t : instant), is_idle arr_seq sched t -> interference j t + service_at sched j t <= service_of_jobs_at sched (job_of_task tsk) (arrivals_between arr_seq t1 (t1 + (job_arrival j - t1) + 1)) t + task_interference arr_seq sched j t
