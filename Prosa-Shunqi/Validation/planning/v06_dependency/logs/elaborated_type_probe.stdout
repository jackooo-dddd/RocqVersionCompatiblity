     : forall (Task : TaskType) (H3 : PriorityPoint Task) (Job : JobType) (H4 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (H5 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (tsk : Task) (sched : schedule (ideal.processor_state Job)), valid_schedule sched arr_seq -> forall FP : FP_policy Task, reflexive_task_priorities FP -> transitive_task_priorities FP -> total_task_priorities FP -> valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (ELF FP) -> forall priority_inversion_lp_tasks_bound : duration, priority_inversion_cond_is_bounded_by arr_seq sched tsk (fun j' : Job => hp_task tsk (job_task j')) (constant priority_inversion_lp_tasks_bound) -> forall priority_inversion_ep_tasks_bound : duration -> duration, priority_inversion_cond_is_bounded_by arr_seq sched tsk (fun j' : Job => ep_task tsk (job_task j')) priority_inversion_ep_tasks_bound -> priority_inversion_is_bounded_by arr_seq sched tsk (priority_inversion_bound priority_inversion_lp_tasks_bound priority_inversion_ep_tasks_bound)
