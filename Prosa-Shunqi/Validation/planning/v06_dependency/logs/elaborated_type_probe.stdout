@bounded_pi.instantiated_busy_intervals_are_bounded
     : forall (Task : TaskType) (H : TaskCost Task) (MaxArrivals0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (JobReady0 : JobReady Job (ideal.processor_state Job)) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall FP : FP_policy Task, reflexive_task_priorities FP -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> work_bearing_readiness arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall (tsk : Task) (priority_inversion_bound : duration), priority_inversion_is_bounded_by arr_seq sched tsk (constant priority_inversion_bound) -> work_conserving arr_seq sched -> forall L : duration, 0 < L -> L = priority_inversion_bound + total_hep_request_bound_function_FP ts tsk L -> busy_intervals_are_bounded_by arr_seq sched tsk L
