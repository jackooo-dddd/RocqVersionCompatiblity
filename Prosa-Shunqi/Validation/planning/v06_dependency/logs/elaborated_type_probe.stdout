BEGIN|prosa.results.transfer_schedulability.paper_model.ref_finish_time
@ref_finish_time
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobPredecessors Job) (arr_seq : arrival_sequence Job) (Omega : Type) (H1 : SystemEvolutions Omega Job) (omega_0 : Omega) (algA : Scheduler Omega Job), (forall j : Job, arrives_in arr_seq j -> {R : duration | job_response_time_bound (algA omega_0) j R}) -> forall jf : Job, arrives_in arr_seq jf -> instant
END|prosa.results.transfer_schedulability.paper_model.ref_finish_time
BEGIN|prosa.results.transfer_schedulability.paper_model.online_response_time_bound
@online_response_time_bound
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobPredecessors Job) (arr_seq : arrival_sequence Job) (Omega : Type) (H1 : SystemEvolutions Omega Job) (omega_0 : Omega) (algA algB : Scheduler Omega Job) (H_non_starvation : forall j : Job, arrives_in arr_seq j -> {R : duration | job_response_time_bound (algA omega_0) j R}) (omega : Omega) (jf : Job) (H_arrives : arrives_in arr_seq jf), schedulability_transferred_AB Omega omega_0 algA algB omega -> job_response_time_bound (algB omega) jf (sval (H_non_starvation jf H_arrives))
END|prosa.results.transfer_schedulability.paper_model.online_response_time_bound
BEGIN|prosa.results.transfer_schedulability.paper_model.online_finish_time
@online_finish_time
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobPredecessors Job) (arr_seq : arrival_sequence Job) (Omega : Type) (H1 : SystemEvolutions Omega Job) (omega_0 : Omega) (algA algB : Scheduler Omega Job), (forall j : Job, arrives_in arr_seq j -> {R : duration | job_response_time_bound (algA omega_0) j R}) -> forall (omega : Omega) (jf : Job), arrives_in arr_seq jf -> schedulability_transferred_AB Omega omega_0 algA algB omega -> instant
END|prosa.results.transfer_schedulability.paper_model.online_finish_time
BEGIN|prosa.results.transfer_schedulability.paper_model.online_finish_time_bounded
@online_finish_time_bounded
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobPredecessors Job) (arr_seq : arrival_sequence Job) (Omega : Type) (H1 : SystemEvolutions Omega Job) (omega_0 : Omega) (algA algB : Scheduler Omega Job), (forall j : Job, arrives_in arr_seq j -> {R : duration | job_response_time_bound (algA omega_0) j R}) -> forall (omega : Omega) (jf : Job), arrives_in arr_seq jf -> schedulability_transferred_AB Omega omega_0 algA algB omega -> bool
END|prosa.results.transfer_schedulability.paper_model.online_finish_time_bounded
BEGIN|prosa.results.transfer_schedulability.paper_model.clairvoyant_sufficiency'
@clairvoyant_sufficiency'
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobPredecessors Job) (arr_seq : arrival_sequence Job) (H_valid_arrivals : valid_arrival_sequence arr_seq) (Omega : Type) (H1 : SystemEvolutions Omega Job) (omega_0 : Omega) (H_max_cost : forall (omega : Omega) (j : Job), job_cost j <= job_cost j) (algA algB : Scheduler Omega Job) (H_well_formed_A : valid_schedule (algA omega_0) arr_seq) (H_well_formed_B : forall omega : Omega, valid_schedule (algB omega) arr_seq) (H_non_starvation : forall j : Job, arrives_in arr_seq j -> {R : duration | job_response_time_bound (algA omega_0) j R}) (H_criterion : clairvoyant_criterion arr_seq Omega omega_0 algA algB) (omega : Omega) (j : Job) (IN : arrives_in arr_seq j), online_finish_time_bounded arr_seq Omega omega_0 algA algB H_non_starvation omega j IN (clairvoyant_sufficiency arr_seq H_valid_arrivals Omega omega_0 H_max_cost algA algB H_well_formed_A H_well_formed_B H_criterion omega)
END|prosa.results.transfer_schedulability.paper_model.clairvoyant_sufficiency'
BEGIN|prosa.results.transfer_schedulability.paper_model.nonclairvoyant_sufficiency'
@nonclairvoyant_sufficiency'
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobPredecessors Job) (arr_seq : arrival_sequence Job) (H_valid_arrivals : valid_arrival_sequence arr_seq) (Omega : Type) (H1 : SystemEvolutions Omega Job) (omega_0 : Omega) (H_max_cost : forall (omega : Omega) (j : Job), job_cost j <= job_cost j) (algA algB : Scheduler Omega Job) (H_well_formed_A : valid_schedule (algA omega_0) arr_seq) (H_well_formed_B : forall omega : Omega, valid_schedule (algB omega) arr_seq) (H_non_starvation : forall j : Job, arrives_in arr_seq j -> {R : duration | job_response_time_bound (algA omega_0) j R}) (H_criterion : nonclairvoyant_criterion arr_seq Omega omega_0 algA algB) (omega : Omega) (j : Job) (IN : arrives_in arr_seq j), online_finish_time_bounded arr_seq Omega omega_0 algA algB H_non_starvation omega j IN (nonclairvoyant_sufficiency arr_seq H_valid_arrivals Omega omega_0 H_max_cost algA algB H_well_formed_A H_well_formed_B H_criterion omega)
END|prosa.results.transfer_schedulability.paper_model.nonclairvoyant_sufficiency'
BEGIN|prosa.results.transfer_schedulability.paper_model.online_finish_time'
@online_finish_time'
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobPredecessors Job) (arr_seq : arrival_sequence Job) (Omega : Type) (H1 : SystemEvolutions Omega Job) (algB : Scheduler Omega Job), (forall j : Job, arrives_in arr_seq j -> forall omega : Omega, {R : duration | job_response_time_bound (algB omega) j R}) -> Omega -> forall jf : Job, arrives_in arr_seq jf -> instant
END|prosa.results.transfer_schedulability.paper_model.online_finish_time'
BEGIN|prosa.results.transfer_schedulability.paper_model.online_finish_time_bounded'
@online_finish_time_bounded'
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobPredecessors Job) (arr_seq : arrival_sequence Job) (Omega : Type) (H1 : SystemEvolutions Omega Job) (omega_0 : Omega) (algA algB : Scheduler Omega Job), (forall j : Job, arrives_in arr_seq j -> {R : duration | job_response_time_bound (algA omega_0) j R}) -> (forall j : Job, arrives_in arr_seq j -> forall omega : Omega, {R : duration | job_response_time_bound (algB omega) j R}) -> Omega -> forall jf : Job, arrives_in arr_seq jf -> bool
END|prosa.results.transfer_schedulability.paper_model.online_finish_time_bounded'
BEGIN|prosa.results.transfer_schedulability.paper_model.clairvoyant_necessity'
@clairvoyant_necessity'
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobPredecessors Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (Omega : Type) (H1 : SystemEvolutions Omega Job) (omega_0 : Omega), (forall (omega : Omega) (j : Job), job_cost j <= job_cost j) -> forall algA algB : Scheduler Omega Job, valid_schedule (algA omega_0) arr_seq -> (forall omega : Omega, valid_schedule (algB omega) arr_seq) -> forall (H_non_starvation : forall j : Job, arrives_in arr_seq j -> {R : duration | job_response_time_bound (algA omega_0) j R}) (H_non_starvation' : forall j : Job, arrives_in arr_seq j -> forall omega : Omega, {R : duration | job_response_time_bound (algB omega) j R}), (forall (omega : Omega) (j : Job) (in_arrival_sequence : arrives_in arr_seq j), online_finish_time_bounded' arr_seq Omega omega_0 algA algB H_non_starvation H_non_starvation' omega j in_arrival_sequence) -> clairvoyant_criterion arr_seq Omega omega_0 algA algB
END|prosa.results.transfer_schedulability.paper_model.clairvoyant_necessity'
BEGIN|prosa.util.bigcat.mem_bigcat_nat
mem_bigcat_nat
     : forall (T : eqType) (f : nat -> seq T) (x : T) (m n j : nat), m <= j < n -> x \in f j -> x \in \cat_(m<=i<n)f i
END|prosa.util.bigcat.mem_bigcat_nat
BEGIN|prosa.util.bigcat.mem_bigcat_nat_exists
mem_bigcat_nat_exists
     : forall (T : eqType) (f : nat -> seq T) (x : T) (m n : nat), x \in \cat_(m<=i<n)f i -> exists i : nat, x \in f i /\ m <= i < n
END|prosa.util.bigcat.mem_bigcat_nat_exists
BEGIN|prosa.util.bigcat.mem_bigcat_ord
mem_bigcat_ord
     : forall (T : eqType) (x : T) (n : nat) (j : 'I_n) (f : 'I_n -> seq T), j < n -> x \in f j -> x \in \cat_(i<n)f i
END|prosa.util.bigcat.mem_bigcat_ord
BEGIN|prosa.util.bigcat.bigcat_nat_uniq
bigcat_nat_uniq
     : forall (T : eqType) (f : nat -> seq T), (forall i : nat, uniq (f i)) -> (forall (x : T) (i1 i2 : nat), x \in f i1 -> x \in f i2 -> i1 = i2) -> forall n1 n2 : nat, uniq (\cat_(n1<=i<n2)f i)
END|prosa.util.bigcat.bigcat_nat_uniq
BEGIN|prosa.util.bigcat.bigcat_nat_filter_eq_filter_bigcat_nat
@bigcat_nat_filter_eq_filter_bigcat_nat
     : forall (X : Type) (F : nat -> seq X) (P : X -> bool) (t1 t2 : nat), [seq x <- \cat_(t1<=t<t2)F t | P x] = \cat_(t1<=t<t2)[seq x <- F t | P x]
END|prosa.util.bigcat.bigcat_nat_filter_eq_filter_bigcat_nat
BEGIN|prosa.util.bigcat.size_big_nat
@size_big_nat
     : forall (X : Type) (F : nat -> seq X) (t1 t2 : nat), \sum_(t1 <= t < t2) size (F t) = size (\cat_(t1<=t<t2)F t)
END|prosa.util.bigcat.size_big_nat
BEGIN|prosa.util.bigcat.mem_bigcat
mem_bigcat
     : forall (X Y : eqType) (f : X -> seq Y) (x : X) (y : Y) (s : seq_predType X), x \in s -> y \in f x -> y \in \cat_(x0<-s)f x0
END|prosa.util.bigcat.mem_bigcat
BEGIN|prosa.util.bigcat.mem_bigcat_exists
mem_bigcat_exists
     : forall (X Y : eqType) (f : X -> seq Y) (P : X -> bool) (s : seq X) (y : Y), y \in \cat_(x<-s|P x)f x -> exists x : X, x \in s /\ y \in f x
END|prosa.util.bigcat.mem_bigcat_exists
BEGIN|prosa.util.bigcat.bigcat_filter_eq_filter_bigcat
bigcat_filter_eq_filter_bigcat
     : forall (X Y : eqType) (f : X -> seq Y) (xss : seq X) (P : Y -> bool), [seq x <- \cat_(xs<-xss)f xs | P x] = \cat_(xs<-xss)[seq x <- f xs | P x]
END|prosa.util.bigcat.bigcat_filter_eq_filter_bigcat
BEGIN|prosa.util.bigcat.bigcat_uniq
bigcat_uniq
     : forall (X Y : eqType) (f : X -> seq Y) (xs : seq X) (P : pred X), (forall x : X, P x -> uniq (f x)) -> (forall (x : Y) (y z : X), x \in f y -> x \in f z -> y = z) -> uniq xs -> uniq (\cat_(x<-xs|P x)f x)
END|prosa.util.bigcat.bigcat_uniq
BEGIN|prosa.util.bigcat.seq_different_elements_nil
seq_different_elements_nil
     : forall (X Y : eqType) (f : X -> seq Y) (g : Y -> X), (forall (x : X) (y : Y), y \in f x -> g y = x) -> forall x1 x2 : X, x1 != x2 -> [seq x <- f x1 | g x == x2] = [::]
END|prosa.util.bigcat.seq_different_elements_nil
BEGIN|prosa.util.bigcat.bigcat_seq_uniqK
bigcat_seq_uniqK
     : forall (X Y : eqType) (f : X -> seq Y) (g : Y -> X), (forall (x : X) (y : Y), y \in f x -> g y = x) -> forall (y : X) (xs : seq_predType X), y \in xs -> uniq xs -> \cat_(x<-xs)[seq x' <- f x | g x' == y] = f y
END|prosa.util.bigcat.bigcat_seq_uniqK
BEGIN|prosa.util.bigcat.bigcat_partitions
bigcat_partitions
     : forall (X Y : eqType) (xs : seq X) (ys : seq Y) (P : pred X) (x_to_y : X -> Y), (forall x : X, x \in xs -> P x -> x_to_y x \in ys) -> forall j : X, (j \in [seq x <- xs | P x]) = (j \in \cat_(y<-ys)[seq x <- xs | P x & x_to_y x == y])
END|prosa.util.bigcat.bigcat_partitions
BEGIN|prosa.util.bigop.big_pred1_seq
big_pred1_seq
     : forall (R : Type) (idx : R) (op : Monoid.law idx) (X : eqType) (P : pred X) (F : X -> R) (xs : seq X) (i : X), i \in xs -> uniq xs -> P =1 pred1 i -> \big[op/idx]_(j <- xs | P j) F j = F i
END|prosa.util.bigop.big_pred1_seq
BEGIN|prosa.util.div_mod.eqdivn_leqmodn
eqdivn_leqmodn
     : forall t1 t2 h : nat, t1 <= t2 -> t1 %/ h = t2 %/ h -> t1 %% h <= t2 %% h
END|prosa.util.div_mod.eqdivn_leqmodn
BEGIN|prosa.util.div_mod.ltdivn_dvdn
ltdivn_dvdn
     : forall x y : nat, x %/ y < (x + 1) %/ y -> y %| x + 1
END|prosa.util.div_mod.ltdivn_dvdn
BEGIN|prosa.util.div_mod.addn1_modn_commute
addn1_modn_commute
     : forall x h : nat, 0 < h -> x %/ h = (x + 1) %/ h -> (x + 1) %% h = x %% h + 1
END|prosa.util.div_mod.addn1_modn_commute
BEGIN|prosa.util.div_mod.addmod_le_mod
addmod_le_mod
     : forall x y h : nat, 0 < h -> x %/ h = (x + y) %/ h -> x %% h + y %% h < h
END|prosa.util.div_mod.addmod_le_mod
BEGIN|prosa.util.div_mod.divn_leq
divn_leq
     : forall k T x : nat, k * T <= x < k.+1 * T -> x %/ T = k
END|prosa.util.div_mod.divn_leq
BEGIN|prosa.util.div_mod.div_floor
div_floor
     : nat -> nat -> nat
END|prosa.util.div_mod.div_floor
BEGIN|prosa.util.div_mod.div_ceil
div_ceil
     : nat -> nat -> nat
END|prosa.util.div_mod.div_ceil
BEGIN|prosa.util.div_mod.div_ceil0
div_ceil0
     : forall b : nat, div_ceil 0 b = 0
END|prosa.util.div_mod.div_ceil0
BEGIN|prosa.util.div_mod.div_ceil_gt0
div_ceil_gt0
     : forall a b : nat, 0 < a -> 0 < b -> 0 < div_ceil a b
END|prosa.util.div_mod.div_ceil_gt0
BEGIN|prosa.util.div_mod.div_ceil_monotone1
div_ceil_monotone1
     : forall d m n : nat, m <= n -> div_ceil m d <= div_ceil n d
END|prosa.util.div_mod.div_ceil_monotone1
BEGIN|prosa.util.div_mod.leq_div_ceil_add1
leq_div_ceil_add1
     : forall Δ T : nat, 0 < T -> T <= Δ -> div_ceil (Δ - T) T < div_ceil Δ T
END|prosa.util.div_mod.leq_div_ceil_add1
BEGIN|prosa.util.div_mod.div_ceil_subadditive
div_ceil_subadditive
     : forall T : nat, subadditive (div_ceil^~ T)
END|prosa.util.div_mod.div_ceil_subadditive
BEGIN|prosa.util.div_mod.div_ceil_multiple
div_ceil_multiple
     : forall Δ T n : nat, 0 < T -> T * n < Δ -> n < div_ceil Δ T
END|prosa.util.div_mod.div_ceil_multiple
BEGIN|prosa.util.div_mod.div_floor_add_g
div_floor_add_g
     : forall a b : nat, 0 < b -> a < a %/ b * b + b
END|prosa.util.div_mod.div_floor_add_g
BEGIN|prosa.util.div_mod.mod_elim
mod_elim
     : forall a b c : nat, b < c -> (a + c - b) %% c = (if b <= a %% c then a %% c - b else a %% c + c - b)
END|prosa.util.div_mod.mod_elim
BEGIN|prosa.util.fixpoint.find_fixpoint_from
find_fixpoint_from
     : (nat -> nat) -> nat -> nat -> nat -> option nat
END|prosa.util.fixpoint.find_fixpoint_from
BEGIN|prosa.util.fixpoint.find_fixpoint
find_fixpoint
     : (nat -> nat) -> nat -> option nat
END|prosa.util.fixpoint.find_fixpoint
BEGIN|prosa.util.fixpoint.ffpf_finds_fixpoint
ffpf_finds_fixpoint
     : forall (f : nat -> nat) (h s x fuel : nat), find_fixpoint_from f s h fuel = Some x -> x = f x
END|prosa.util.fixpoint.ffpf_finds_fixpoint
BEGIN|prosa.util.fixpoint.ffp_finds_fixpoint
ffp_finds_fixpoint
     : forall (f : nat -> nat) (h x : nat), find_fixpoint f h = Some x -> x = f x
END|prosa.util.fixpoint.ffp_finds_fixpoint
BEGIN|prosa.util.fixpoint.no_fixpoint_skipped
no_fixpoint_skipped
     : forall f : nat -> nat, monotone leq f -> 0 < f 1 -> forall a c : nat, c = f a -> forall b : nat, a <= b < c -> b != f b
END|prosa.util.fixpoint.no_fixpoint_skipped
BEGIN|prosa.util.fixpoint.ffpf_finds_least_fixpoint
ffpf_finds_least_fixpoint
     : forall (f : nat -> nat) (h : nat), monotone leq f -> 0 < f 1 -> forall y s fuel : nat, find_fixpoint_from f s h fuel = Some y -> forall x : nat, s <= x < y -> x != f x
END|prosa.util.fixpoint.ffpf_finds_least_fixpoint
BEGIN|prosa.util.fixpoint.ffp_finds_least_fixpoint
ffp_finds_least_fixpoint
     : forall (f : nat -> nat) (h : nat), monotone leq f -> 0 < f 1 -> forall x y : nat, 0 < x < y -> find_fixpoint f h = Some y -> x != f x
END|prosa.util.fixpoint.ffp_finds_least_fixpoint
BEGIN|prosa.util.fixpoint.ffpf_finds_positive_fixpoint
ffpf_finds_positive_fixpoint
     : forall (f : nat -> nat) (h : nat), monotone leq f -> 0 < f 1 -> forall s fuel x : nat, Some x = find_fixpoint_from f s h fuel -> 0 < s -> 0 < x
END|prosa.util.fixpoint.ffpf_finds_positive_fixpoint
BEGIN|prosa.util.fixpoint.ffp_finds_positive_fixpoint
ffp_finds_positive_fixpoint
     : forall (f : nat -> nat) (h : nat), monotone leq f -> 0 < f 1 -> forall x : nat, Some x = find_fixpoint f h -> 0 < x
END|prosa.util.fixpoint.ffp_finds_positive_fixpoint
BEGIN|prosa.util.fixpoint.ffpf_finds_none
ffpf_finds_none
     : forall (f : nat -> nat) (h : nat), monotone leq f -> 0 < f 1 -> forall s fuel : nat, s <= f s -> h - s <= fuel -> find_fixpoint_from f s h fuel = None -> forall x : nat, s <= x < h -> x != f x
END|prosa.util.fixpoint.ffpf_finds_none
BEGIN|prosa.util.fixpoint.ffp_finds_none
ffp_finds_none
     : forall (f : nat -> nat) (h : nat), monotone leq f -> 0 < f 1 -> find_fixpoint f h = None -> forall x : nat, 0 < x < h -> x != f x
END|prosa.util.fixpoint.ffp_finds_none
BEGIN|prosa.util.fixpoint.find_max_fixpoint_of_seq
find_max_fixpoint_of_seq
     : (nat -> nat -> nat) -> seq nat -> nat -> option nat
END|prosa.util.fixpoint.find_max_fixpoint_of_seq
BEGIN|prosa.util.fixpoint.fmfs_finds_fixpoint
fmfs_finds_fixpoint
     : forall (f : nat -> nat -> nat) (sp : seq nat) (h x : nat), ~~ nilp sp -> find_max_fixpoint_of_seq f sp h = Some x -> exists2 a : Datatypes_nat__canonical__eqtype_Equality, a \in sp & x = f a x
END|prosa.util.fixpoint.fmfs_finds_fixpoint
BEGIN|prosa.util.fixpoint.fmfs_is_maximum
fmfs_is_maximum
     : forall (f : nat -> nat -> nat) (sp : seq nat) (h s r : nat), Some r = find_max_fixpoint_of_seq f sp h -> s \in sp -> exists2 v : nat, Some v = find_fixpoint (f s) h & v <= r
END|prosa.util.fixpoint.fmfs_is_maximum
BEGIN|prosa.util.fixpoint.find_max_fixpoint
find_max_fixpoint
     : nat -> pred nat -> (nat -> nat -> nat) -> nat -> option nat
END|prosa.util.fixpoint.find_max_fixpoint
BEGIN|prosa.util.fixpoint.fmf_finds_fixpoint
fmf_finds_fixpoint
     : forall (L : nat) (P : pred nat) (f : nat -> nat -> nat) (h x : nat), find_max_fixpoint L P f h = Some x -> exists2 a : nat, (a < L) && P a & x = f a x
END|prosa.util.fixpoint.fmf_finds_fixpoint
BEGIN|prosa.util.fixpoint.fmf_is_maximum
fmf_is_maximum
     : forall (L : nat) (P : pred nat) (f : nat -> nat -> nat) (h s r : nat), Some r = find_max_fixpoint L P f h -> (s < L) && P s -> exists2 v : nat, Some v = find_fixpoint (f s) h & v <= r
END|prosa.util.fixpoint.fmf_is_maximum
BEGIN|prosa.util.lcmseq.lcml
lcml
     : seq nat -> nat
END|prosa.util.lcmseq.lcml
BEGIN|prosa.util.lcmseq.int_divides_lcm_in_seq
int_divides_lcm_in_seq
     : forall (x : nat) (xs : seq nat), x %| lcml (x :: xs)
END|prosa.util.lcmseq.int_divides_lcm_in_seq
BEGIN|prosa.util.lcmseq.lcm_seq_divides_lcm_super
lcm_seq_divides_lcm_super
     : forall (x : nat) (xs : seq nat), lcml xs %| lcml (x :: xs)
END|prosa.util.lcmseq.lcm_seq_divides_lcm_super
BEGIN|prosa.util.lcmseq.lcm_seq_is_mult_of_all_ints
lcm_seq_is_mult_of_all_ints
     : forall (x : nat) (xs : seq nat), x \in xs -> x %| lcml xs
END|prosa.util.lcmseq.lcm_seq_is_mult_of_all_ints
BEGIN|prosa.util.lcmseq.all_pos_implies_lcml_pos
all_pos_implies_lcml_pos
     : forall xs : seq nat, (forall x : Datatypes_nat__canonical__eqtype_Equality, x \in xs -> 0 < x) -> 0 < lcml xs
END|prosa.util.lcmseq.all_pos_implies_lcml_pos
BEGIN|prosa.util.list.max0
max0
     : seq nat -> nat
END|prosa.util.list.max0
BEGIN|prosa.util.list.first0
first0
     : seq nat -> nat
END|prosa.util.list.first0
BEGIN|prosa.util.list.last0
last0
     : seq nat -> nat
END|prosa.util.list.last0
BEGIN|prosa.util.list.last0_cons
last0_cons
     : forall (x : nat) (xs : seq nat), xs <> [::] -> last0 (x :: xs) = last0 xs
END|prosa.util.list.last0_cons
BEGIN|prosa.util.list.last0_cat
last0_cat
     : forall xs_l xs_r : seq nat, xs_r <> [::] -> last0 (xs_l ++ xs_r) = last0 xs_r
END|prosa.util.list.last0_cat
BEGIN|prosa.util.list.last0_nth
last0_nth
     : forall xs : seq nat, last0 xs = nth 0 xs (size xs).-1
END|prosa.util.list.last0_nth
BEGIN|prosa.util.list.last0_ex_cat
last0_ex_cat
     : forall (x : nat) (xs : seq nat), xs <> [::] -> last0 xs = x -> exists xsh : seq nat, xsh ++ [:: x] = xs
END|prosa.util.list.last0_ex_cat
BEGIN|prosa.util.list.last0_filter
last0_filter
     : forall (x : nat) (xs : seq nat) (P : nat -> bool), xs <> [::] -> last0 xs = x -> P x -> last0 [seq x0 <- xs | P x0] = x
END|prosa.util.list.last0_filter
BEGIN|prosa.util.list.max0_cons
max0_cons
     : forall (x : nat) (xs : seq nat), max0 (x :: xs) = maxn x (max0 xs)
END|prosa.util.list.max0_cons
BEGIN|prosa.util.list.max0_of_uniform_set
max0_of_uniform_set
     : forall (k : Datatypes_nat__canonical__eqtype_Equality) (xs : seq Datatypes_nat__canonical__eqtype_Equality), 0 < size xs -> (forall x : Datatypes_nat__canonical__eqtype_Equality, x \in xs -> x = k) -> max0 xs = k
END|prosa.util.list.max0_of_uniform_set
BEGIN|prosa.util.list.in_max0_le
in_max0_le
     : forall (xs : seq_predType Datatypes_nat__canonical__eqtype_Equality) (x : nat), x \in xs -> x <= max0 xs
END|prosa.util.list.in_max0_le
BEGIN|prosa.util.list.max0_in_seq
max0_in_seq
     : forall xs : seq nat, xs <> [::] -> max0 xs \in xs
END|prosa.util.list.max0_in_seq
BEGIN|prosa.util.list.max0_2cons_eq
max0_2cons_eq
     : forall (x : nat) (xs : seq nat), max0 [:: x, x & xs] = max0 (x :: xs)
END|prosa.util.list.max0_2cons_eq
BEGIN|prosa.util.list.max0_2cons_le
max0_2cons_le
     : forall (x1 x2 : nat) (xs : seq nat), x1 <= x2 -> max0 [:: x1, x2 & xs] = max0 (x2 :: xs)
END|prosa.util.list.max0_2cons_le
BEGIN|prosa.util.list.max0_rem0
max0_rem0
     : forall xs : seq nat, max0 [seq x <- xs | 0 < x] = max0 xs
END|prosa.util.list.max0_rem0
BEGIN|prosa.util.list.last_of_seq_le_max_of_seq
last_of_seq_le_max_of_seq
     : forall xs : seq nat, last0 xs <= max0 xs
END|prosa.util.list.last_of_seq_le_max_of_seq
BEGIN|prosa.util.list.max_of_dominating_seq
max_of_dominating_seq
     : forall xs ys : seq nat, (forall n : nat, nth 0 xs n <= nth 0 ys n) -> max0 xs <= max0 ys
END|prosa.util.list.max_of_dominating_seq
BEGIN|prosa.util.list.rem_in
@rem_in
     : forall (X : eqType) (x y : X) (xs : seq X), x \in rem (T:=X) y xs -> x \in xs
END|prosa.util.list.rem_in
BEGIN|prosa.util.list.in_neq_impl_rem_in
@in_neq_impl_rem_in
     : forall (X : eqType) (x y : X) (xs : seq X), x \in xs -> x != y -> x \in rem (T:=X) y xs
END|prosa.util.list.in_neq_impl_rem_in
BEGIN|prosa.util.list.filter_size_rem
@filter_size_rem
     : forall (X : eqType) (x : X) (xs : seq X) (P : pred X), x \in xs -> P x -> size [seq y <- xs | P y] = size [seq y <- rem (T:=X) x xs | P y] + 1
END|prosa.util.list.filter_size_rem
BEGIN|prosa.util.list.in_seq_equiv_undup
@in_seq_equiv_undup
     : forall (X : eqType) (xs : seq X) (x : X), (x \in undup xs) = (x \in xs)
END|prosa.util.list.in_seq_equiv_undup
BEGIN|prosa.util.list.nth0_cons
nth0_cons
     : forall (x : nat) (xs : seq nat) (n : nat), 0 < n -> nth 0 (x :: xs) n = nth 0 xs n.-1
END|prosa.util.list.nth0_cons
BEGIN|prosa.util.list.seq1_some
@seq1_some
     : forall (T : eqType) (x y : T), ([:: x] == [:: y]) = (Some x == Some y)
END|prosa.util.list.seq1_some
BEGIN|prosa.util.list.seq_elim_last
@seq_elim_last
     : forall (X : Type) (n : nat) (xs : seq X), size xs = n.+1 -> exists (x : X) (xs__c : seq X), xs = xs__c ++ [:: x] /\ size xs__c = n
END|prosa.util.list.seq_elim_last
BEGIN|prosa.util.list.in_cat
@in_cat
     : forall (X : eqType) (x : X) (xs : seq X), x \in xs -> exists xsl xsr : seq X, xs = xsl ++ [:: x] ++ xsr
END|prosa.util.list.in_cat
BEGIN|prosa.util.list.subseq_leq_size
@subseq_leq_size
     : forall (X : eqType) (xs ys : seq X), uniq xs -> (forall x : X, x \in xs -> x \in ys) -> size xs <= size ys
END|prosa.util.list.subseq_leq_size
BEGIN|prosa.util.list.in_zip
@in_zip
     : forall (X Y : eqType) (xs : seq X) (ys : seq Y) (x x__d : X) (y y__d : Y), size xs = size ys -> (exists idx : nat, idx < size xs /\ nth x__d xs idx = x /\ nth y__d ys idx = y) -> (x, y) \in zip xs ys
END|prosa.util.list.in_zip
BEGIN|prosa.util.list.filter_in_pred0
@filter_in_pred0
     : forall (X : eqType) (xs : seq X) (P : pred X), (forall x : X, x \in xs -> ~~ P x) -> [seq x <- xs | P x] = [::]
END|prosa.util.list.filter_in_pred0
BEGIN|prosa.util.list.eq_ind_in_seq
@eq_ind_in_seq
     : forall (X : eqType) (a b : X) (xs : seq X), index a xs = index b xs -> a \in xs -> b \in xs -> a = b
END|prosa.util.list.eq_ind_in_seq
BEGIN|prosa.util.list.default_or_in
@default_or_in
     : forall (X : eqType) (n : nat) (d : X) (xs : seq X), nth d xs n = d \/ nth d xs n \in xs
END|prosa.util.list.default_or_in
BEGIN|prosa.util.list.exists_two
@exists_two
     : forall (X : eqType) (xs : seq X), 1 < size xs -> uniq xs -> exists a b : X, a <> b /\ a \in xs /\ b \in xs
END|prosa.util.list.exists_two
BEGIN|prosa.util.list.has_all_nilp
@has_all_nilp
     : forall (T : eqType) (s : seq T) (P : pred T), all P s -> ~~ nilp s -> has P s
END|prosa.util.list.has_all_nilp
BEGIN|prosa.util.list.sorted_split
@sorted_split
     : forall (X : eqType) (xs : seq X) (P : X -> bool) (f : X -> nat) (t : nat), sorted (fun x y : X => f x <= f y) xs -> [seq x <- xs | P x] = [seq x <- xs | P x & f x <= t] ++ [seq x <- xs | P x & t < f x]
END|prosa.util.list.sorted_split
BEGIN|prosa.util.list.sorted_cat
@sorted_cat
     : forall (X : eqType) (R : rel X) (xs1 xs2 : seq X), transitive (T:=X) R -> sorted R (xs1 ++ xs2) -> sorted R xs1 /\ sorted R xs2
END|prosa.util.list.sorted_cat
BEGIN|prosa.util.list.nonnil_last
@nonnil_last
     : forall (X : eqType) (xs : seq X) (d1 d2 : X), xs != [::] -> last d1 xs = last d2 xs
END|prosa.util.list.nonnil_last
BEGIN|prosa.util.list.filter_last_mem
@filter_last_mem
     : forall (X : eqType) (xs : seq X) (d : X) (P : pred X), has P xs -> last d [seq x <- xs | P x] \in xs
END|prosa.util.list.filter_last_mem
BEGIN|prosa.util.list.rem_all
@rem_all
     : forall X : eqType, X -> seq X -> seq X
END|prosa.util.list.rem_all
BEGIN|prosa.util.list.nin_rem_all
@nin_rem_all
     : forall (X : eqType) (x : X) (xs : seq X), ~ x \in rem_all x xs
END|prosa.util.list.nin_rem_all
BEGIN|prosa.util.list.in_rem_all
@in_rem_all
     : forall (X : eqType) (a x : X) (xs : seq X), a \in rem_all x xs -> a \in xs
END|prosa.util.list.in_rem_all
BEGIN|prosa.util.list.rem_lt_id
rem_lt_id
     : forall (x : nat) (xs : seq_predType Datatypes_nat__canonical__eqtype_Equality), (forall y : nat, y \in xs -> x < y) -> rem_all x xs = xs
END|prosa.util.list.rem_lt_id
BEGIN|prosa.util.list.range
range
     : nat -> nat -> seq nat
END|prosa.util.list.range
BEGIN|prosa.util.list.iotaD_impl
iotaD_impl
     : forall n_le m n : nat, n_le <= n -> iota m n = iota m n_le ++ iota (m + n_le) (n - n_le)
END|prosa.util.list.iotaD_impl
BEGIN|prosa.util.list.index_iota_lt_step
index_iota_lt_step
     : forall a b : nat, a < b -> index_iota a b = a :: index_iota a.+1 b
END|prosa.util.list.index_iota_lt_step
BEGIN|prosa.util.list.index_iota_cat
index_iota_cat
     : forall t t1 t2 : nat, t1 <= t <= t2 -> index_iota t1 t2 = index_iota t1 t ++ index_iota t t2
END|prosa.util.list.index_iota_cat
BEGIN|prosa.util.list.range_filter_2cons
range_filter_2cons
     : forall (x : Datatypes_nat__canonical__eqtype_Equality) (xs : seq Datatypes_nat__canonical__eqtype_Equality) (k : nat), [seq ρ <- range 0 k | ρ \in [:: x, x & xs]] = [seq ρ <- range 0 k | ρ \in x :: xs]
END|prosa.util.list.range_filter_2cons
BEGIN|prosa.util.list.index_iota_filter_eqx
index_iota_filter_eqx
     : forall x a b : nat, a <= x < b -> [seq ρ <- index_iota a b | ρ == x] = [:: x]
END|prosa.util.list.index_iota_filter_eqx
BEGIN|prosa.util.list.index_iota_filter_singl
index_iota_filter_singl
     : forall x a b : nat, a <= x < b -> [seq ρ <- index_iota a b | ρ \in [:: x]] = [:: x]
END|prosa.util.list.index_iota_filter_singl
BEGIN|prosa.util.list.index_iota_filter_inxs
index_iota_filter_inxs
     : forall (a b x : nat) (xs : seq_predType Datatypes_nat__canonical__eqtype_Equality), x < a -> [seq ρ <- index_iota a b | ρ \in xs] = [seq ρ <- index_iota a b | ρ \in rem_all x xs]
END|prosa.util.list.index_iota_filter_inxs
BEGIN|prosa.util.list.index_iota_filter_step
index_iota_filter_step
     : forall (x : nat) (xs : seq_predType Datatypes_nat__canonical__eqtype_Equality) (a b : nat), a <= x < b -> (forall y : nat, y \in xs -> x <= y) -> [seq ρ <- index_iota a b | ρ \in x :: xs] = x :: [seq ρ <- index_iota a b | ρ \in rem_all x xs]
END|prosa.util.list.index_iota_filter_step
BEGIN|prosa.util.list.range_iota_filter_step
range_iota_filter_step
     : forall (x : nat) (xs : seq_predType Datatypes_nat__canonical__eqtype_Equality) (k : nat), x <= k -> (forall y : nat, y \in xs -> x <= y) -> [seq ρ <- range 0 k | ρ \in x :: xs] = x :: [seq ρ <- range 0 k | ρ \in rem_all x xs]
END|prosa.util.list.range_iota_filter_step
BEGIN|prosa.util.list.iota_filter_gt
iota_filter_gt
     : forall (x a b idx : nat) (P : nat -> bool), x < a -> idx < size [seq x0 <- index_iota a b | P x0] -> x < nth 0 [seq x0 <- index_iota a b | P x0] idx
END|prosa.util.list.iota_filter_gt
BEGIN|prosa.util.list.sub_count_seq
@sub_count_seq
     : forall (X : eqType) (f g : pred X) (xs : seq X), {in xs, forall x : X, f x -> g x} -> count f xs <= count g xs
END|prosa.util.list.sub_count_seq
BEGIN|prosa.util.list.count_predUI'
count_predUI'
     : forall (P1 P2 : pred nat) (xs : seq nat), count (predU P1 P2) xs = count P1 xs + count P2 xs - count (predI P1 P2) xs
END|prosa.util.list.count_predUI'
BEGIN|prosa.util.list.prefix_of
@prefix_of
     : forall T : eqType, seq T -> seq T -> Prop
END|prosa.util.list.prefix_of
BEGIN|prosa.util.list.strict_prefix_of
@strict_prefix_of
     : forall T : eqType, seq T -> seq T -> Prop
END|prosa.util.list.strict_prefix_of
BEGIN|prosa.util.list.shift_points_pos
shift_points_pos
     : seq nat -> nat -> seq nat
END|prosa.util.list.shift_points_pos
BEGIN|prosa.util.list.shift_points_neg
shift_points_neg
     : seq nat -> nat -> seq nat
END|prosa.util.list.shift_points_neg
BEGIN|prosa.util.minmax.leq_bigmax_cond_seq
@leq_bigmax_cond_seq
     : forall (X : eqType) (F : X -> nat) (P : pred X) (xs : seq X) (x : X), x \in xs -> P x -> F x <= \max_(i <- xs | P i) F i
END|prosa.util.minmax.leq_bigmax_cond_seq
BEGIN|prosa.util.minmax.leq_bigmax_sup
@leq_bigmax_sup
     : forall (X : eqType) (P : pred X) (F : X -> nat) (xs : seq X) (n : nat), (exists x : X, x \in xs /\ P x /\ n <= F x) -> n <= \max_(x <- xs | P x) F x
END|prosa.util.minmax.leq_bigmax_sup
BEGIN|prosa.util.minmax.bigmax_leq_seqP
@bigmax_leq_seqP
     : forall (X : eqType) (F : X -> nat) (P : pred X) (xs : seq X) (m : nat), reflect (forall x : X, x \in xs -> P x -> F x <= m) (\max_(x <- xs | P x) F x <= m)
END|prosa.util.minmax.bigmax_leq_seqP
BEGIN|prosa.util.minmax.leq_big_max
@leq_big_max
     : forall (X : eqType) (F1 F2 : X -> nat) (P : pred X) (xs : seq X), (forall x : X, x \in xs -> P x -> F1 x <= F2 x) -> \max_(x <- xs | P x) F1 x <= \max_(x <- xs | P x) F2 x
END|prosa.util.minmax.leq_big_max
BEGIN|prosa.util.minmax.bigmax_ord_ltn_identity
bigmax_ord_ltn_identity
     : forall n : nat, 0 < n -> \max_(i < n) i < n
END|prosa.util.minmax.bigmax_ord_ltn_identity
BEGIN|prosa.util.minmax.bigmax_ltn_ord
bigmax_ltn_ord
     : forall (n : nat) (P : pred nat) (i0 : 'I_n), P i0 -> \max_(i < n | P i) i < n
END|prosa.util.minmax.bigmax_ltn_ord
BEGIN|prosa.util.minmax.bigmax_pred
bigmax_pred
     : forall (n : nat) (P : pred nat) (i0 : 'I_n), P i0 -> P (\max_(i < n | P i) i)
END|prosa.util.minmax.bigmax_pred
BEGIN|prosa.util.minmax.bigmax_witness
@bigmax_witness
     : forall (T : eqType) (xs : seq T) (P : pred T) (F : T -> nat), has P xs -> exists x : T, x \in xs /\ P x /\ F x = \max_(x0 <- xs | P x0) F x0
END|prosa.util.minmax.bigmax_witness
BEGIN|prosa.util.minmax.bigmax_witness_diff
@bigmax_witness_diff
     : forall (T : eqType) (xs : seq T) (P1 P2 : T -> bool) (F : T -> nat), \max_(x <- xs | P1 x) F x < \max_(x <- xs | P2 x) F x -> exists x : T, x \in xs /\ ~~ P1 x /\ P2 x
END|prosa.util.minmax.bigmax_witness_diff
BEGIN|prosa.util.minmax.bigmax_subset
@bigmax_subset
     : forall (T : eqType) (xs : seq T) (P1 P2 : pred T) (F : T -> nat), (forall x : T, x \in xs -> P1 x -> P2 x) -> \max_(x <- xs | P1 x) F x <= \max_(x <- xs | P2 x) F x
END|prosa.util.minmax.bigmax_subset
BEGIN|prosa.util.nat.subnACA
@subnACA
     : forall m n p q : nat, p <= m -> q <= n -> m + n - (p + q) = m - p + (n - q)
END|prosa.util.nat.subnACA
BEGIN|prosa.util.nat.leq_subRL_impl
@leq_subRL_impl
     : forall m n p : nat, m + n <= p -> n <= p - m
END|prosa.util.nat.leq_subRL_impl
BEGIN|prosa.util.nondecreasing.nondecreasing_sequence
nondecreasing_sequence
     : seq nat -> Prop
END|prosa.util.nondecreasing.nondecreasing_sequence
BEGIN|prosa.util.nondecreasing.increasing_sequence
increasing_sequence
     : seq nat -> Prop
END|prosa.util.nondecreasing.increasing_sequence
BEGIN|prosa.util.nondecreasing.distances
distances
     : seq nat -> seq nat
END|prosa.util.nondecreasing.distances
BEGIN|prosa.util.nondecreasing.iota_is_increasing_sequence
iota_is_increasing_sequence
     : forall (a b : nat) (P : nat -> bool), increasing_sequence [seq x <- index_iota a b | P x]
END|prosa.util.nondecreasing.iota_is_increasing_sequence
BEGIN|prosa.util.nondecreasing.increasing_implies_nondecreasing
increasing_implies_nondecreasing
     : forall xs : seq nat, increasing_sequence xs -> nondecreasing_sequence xs
END|prosa.util.nondecreasing.increasing_implies_nondecreasing
BEGIN|prosa.util.nondecreasing.nondec_seq_zero_first
nondec_seq_zero_first
     : forall xs : seq_predType Datatypes_nat__canonical__eqtype_Equality, 0 \in xs -> nondecreasing_sequence xs -> first0 xs = 0
END|prosa.util.nondecreasing.nondec_seq_zero_first
BEGIN|prosa.util.nondecreasing.nondecreasing_sequence_2cons_leVeq
nondecreasing_sequence_2cons_leVeq
     : forall (x1 x2 : nat) (xs : seq nat), nondecreasing_sequence [:: x1, x2 & xs] -> x1 = x2 \/ x1 < x2
END|prosa.util.nondecreasing.nondecreasing_sequence_2cons_leVeq
BEGIN|prosa.util.nondecreasing.nondecreasing_sequence_cons
nondecreasing_sequence_cons
     : forall (x : nat) (xs : seq nat), nondecreasing_sequence (x :: xs) -> nondecreasing_sequence xs
END|prosa.util.nondecreasing.nondecreasing_sequence_cons
BEGIN|prosa.util.nondecreasing.nondecreasing_sequence_add_min
nondecreasing_sequence_add_min
     : forall (x : nat) (xs : seq_predType Datatypes_nat__canonical__eqtype_Equality), (forall y : nat, y \in xs -> x <= y) -> nondecreasing_sequence xs -> nondecreasing_sequence (x :: xs)
END|prosa.util.nondecreasing.nondecreasing_sequence_add_min
BEGIN|prosa.util.nondecreasing.nondecreasing_sequence_cons_double
nondecreasing_sequence_cons_double
     : forall (x : nat) (xs : seq nat), nondecreasing_sequence (x :: xs) -> nondecreasing_sequence [:: x, x & xs]
END|prosa.util.nondecreasing.nondecreasing_sequence_cons_double
BEGIN|prosa.util.nondecreasing.nondecreasing_sequence_cons_min
nondecreasing_sequence_cons_min
     : forall (x : nat) (xs : seq nat), nondecreasing_sequence (x :: xs) -> forall y : Datatypes_nat__canonical__eqtype_Equality, y \in xs -> x <= y
END|prosa.util.nondecreasing.nondecreasing_sequence_cons_min
BEGIN|prosa.util.nondecreasing.nondecreasing_sequence_cons_smin
nondecreasing_sequence_cons_smin
     : forall (x1 x2 : nat) (xs : seq nat), x1 < x2 -> nondecreasing_sequence [:: x1, x2 & xs] -> forall y : Datatypes_nat__canonical__eqtype_Equality, y \in x2 :: xs -> x1 < y
END|prosa.util.nondecreasing.nondecreasing_sequence_cons_smin
BEGIN|prosa.util.nondecreasing.antidensity_of_nondecreasing_seq
antidensity_of_nondecreasing_seq
     : forall (xs : seq nat) (x n : nat), nondecreasing_sequence xs -> nth 0 xs n < x < nth 0 xs n.+1 -> x \notin xs
END|prosa.util.nondecreasing.antidensity_of_nondecreasing_seq
BEGIN|prosa.util.nondecreasing.belonging_to_segment_of_seq_is_total
belonging_to_segment_of_seq_is_total
     : forall (xs : seq nat) (x : nat), 1 < size xs -> first0 xs <= x < last0 xs -> exists n : nat, n.+1 < size xs /\ nth 0 xs n <= x < nth 0 xs n.+1
END|prosa.util.nondecreasing.belonging_to_segment_of_seq_is_total
BEGIN|prosa.util.nondecreasing.last_is_max_in_nondecreasing_seq
last_is_max_in_nondecreasing_seq
     : forall (xs : seq nat) (x : nat), nondecreasing_sequence xs -> x \in xs -> x <= last0 xs
END|prosa.util.nondecreasing.last_is_max_in_nondecreasing_seq
BEGIN|prosa.util.nondecreasing.nodup_sort_2cons_eq
@nodup_sort_2cons_eq
     : forall (X : eqType) (x : X) (xs : seq X), undup [:: x, x & xs] = undup (x :: xs)
END|prosa.util.nondecreasing.nodup_sort_2cons_eq
BEGIN|prosa.util.nondecreasing.nodup_sort_2cons_lt
nodup_sort_2cons_lt
     : forall (x1 x2 : nat) (xs : seq nat), x1 < x2 -> nondecreasing_sequence [:: x1, x2 & xs] -> undup [:: x1, x2 & xs] = x1 :: undup (x2 :: xs)
END|prosa.util.nondecreasing.nodup_sort_2cons_lt
BEGIN|prosa.util.nondecreasing.last0_undup
last0_undup
     : forall xs : seq nat, nondecreasing_sequence xs -> last0 (undup xs) = last0 xs
END|prosa.util.nondecreasing.last0_undup
BEGIN|prosa.util.nondecreasing.nondecreasing_sequence_undup
nondecreasing_sequence_undup
     : forall xs : seq nat, nondecreasing_sequence xs -> nondecreasing_sequence (undup xs)
END|prosa.util.nondecreasing.nondecreasing_sequence_undup
BEGIN|prosa.util.nondecreasing.undup_nth_le
undup_nth_le
     : forall xs : seq nat, nondecreasing_sequence xs -> nth 0 (undup xs) (size (undup xs)).-2 <= nth 0 xs (size xs).-2
END|prosa.util.nondecreasing.undup_nth_le
BEGIN|prosa.util.nondecreasing.distances_unfold_2cons
distances_unfold_2cons
     : forall (x0 x1 : nat) (xs : seq nat), distances [:: x0, x1 & xs] = x1 - x0 :: distances (x1 :: xs)
END|prosa.util.nondecreasing.distances_unfold_2cons
BEGIN|prosa.util.nondecreasing.distances_unfold_2app_last
distances_unfold_2app_last
     : forall (a b : nat) (xs : seq nat), distances (xs ++ [:: a; b]) = distances (xs ++ [:: a]) ++ [:: b - a]
END|prosa.util.nondecreasing.distances_unfold_2app_last
BEGIN|prosa.util.nondecreasing.distances_unfold_1app_last
distances_unfold_1app_last
     : forall (x : nat) (xs : seq nat), 0 < size xs -> distances (xs ++ [:: x]) = distances xs ++ [:: x - last0 xs]
END|prosa.util.nondecreasing.distances_unfold_1app_last
BEGIN|prosa.util.nondecreasing.distance_between_neighboring_elements_le_max_distance_in_seq
distance_between_neighboring_elements_le_max_distance_in_seq
     : forall (xs : seq nat) (n : nat), nth 0 xs n.+1 - nth 0 xs n <= max0 (distances xs)
END|prosa.util.nondecreasing.distance_between_neighboring_elements_le_max_distance_in_seq
BEGIN|prosa.util.nondecreasing.function_of_distances_is_correct
function_of_distances_is_correct
     : forall (xs : seq nat) (n : nat), nth 0 (distances xs) n = nth 0 xs n.+1 - nth 0 xs n
END|prosa.util.nondecreasing.function_of_distances_is_correct
BEGIN|prosa.util.nondecreasing.size_of_seq_of_distances
size_of_seq_of_distances
     : forall xs : seq nat, 1 < size xs -> size xs = size (distances xs) + 1
END|prosa.util.nondecreasing.size_of_seq_of_distances
BEGIN|prosa.util.nondecreasing.distances_of_iota_ε
distances_of_iota_ε
     : forall (n : nat) (x : Datatypes_nat__canonical__eqtype_Equality), x \in distances (index_iota 0 n) -> x = 1
END|prosa.util.nondecreasing.distances_of_iota_ε
BEGIN|prosa.util.nondecreasing.max_distance_in_nontrivial_seq_is_positive
max_distance_in_nontrivial_seq_is_positive
     : forall xs : seq nat, nondecreasing_sequence xs -> (exists x y : Datatypes_nat__canonical__eqtype_Equality, x \in xs /\ y \in xs /\ x <> y) -> 0 < max0 (distances xs)
END|prosa.util.nondecreasing.max_distance_in_nontrivial_seq_is_positive
BEGIN|prosa.util.nondecreasing.last_seq_minus_last_distance_seq
last_seq_minus_last_distance_seq
     : forall xs : seq nat, nondecreasing_sequence xs -> last0 xs - last0 (distances xs) = nth 0 xs (size xs).-2
END|prosa.util.nondecreasing.last_seq_minus_last_distance_seq
BEGIN|prosa.util.nondecreasing.max_distance_in_seq_le_last_element_of_seq
max_distance_in_seq_le_last_element_of_seq
     : forall xs : seq nat, nondecreasing_sequence xs -> max0 (distances xs) <= last0 xs
END|prosa.util.nondecreasing.max_distance_in_seq_le_last_element_of_seq
BEGIN|prosa.util.nondecreasing.distances_iota_filtered
distances_iota_filtered
     : forall (xs : seq_predType Datatypes_nat__canonical__eqtype_Equality) (k : nat), (forall x : nat, x \in xs -> x <= k) -> nondecreasing_sequence xs -> distances [seq ρ <- index_iota 0 k.+1 | ρ \in xs] = [seq x <- distances xs | 0 < x]
END|prosa.util.nondecreasing.distances_iota_filtered
BEGIN|prosa.util.nondecreasing.distances_positive_undup
distances_positive_undup
     : forall xs : seq nat, nondecreasing_sequence xs -> [seq d <- distances xs | 0 < d] = distances (undup xs)
END|prosa.util.nondecreasing.distances_positive_undup
BEGIN|prosa.util.nondecreasing.domination_of_distances_implies_domination_of_seq
domination_of_distances_implies_domination_of_seq
     : forall xs ys : seq nat, first0 xs <= first0 ys -> 1 < size xs -> 1 < size ys -> size xs = size ys -> nondecreasing_sequence xs -> nondecreasing_sequence ys -> (forall n : nat, nth 0 (distances xs) n <= nth 0 (distances ys) n) -> forall n : nat, nth 0 xs n <= nth 0 ys n
END|prosa.util.nondecreasing.domination_of_distances_implies_domination_of_seq
BEGIN|prosa.util.notation.constant
@constant
     : forall X Y : Type, Y -> X -> Y
END|prosa.util.notation.constant
BEGIN|prosa.util.poet.forall_exists_implied_by_forall_in_zip
@forall_exists_implied_by_forall_in_zip
     : forall (X Y : eqType) (P_bool : X * Y -> bool) (P_prop : X -> Y -> Prop) (xs : seq X), (forall (x : X) (y : Y), P_bool (x, y) <-> P_prop x y) -> (exists ys : seq Y, size xs = size ys /\ all P_bool (zip xs ys) == true) -> forall x : X, x \in xs -> exists y : Y, P_prop x y
END|prosa.util.poet.forall_exists_implied_by_forall_in_zip
BEGIN|prosa.util.rel.monotone
@monotone
     : forall T : Type, rel T -> (T -> T) -> Prop
END|prosa.util.rel.monotone
BEGIN|prosa.util.rel.total_over_list
@total_over_list
     : forall T : eqType, (T -> T -> bool) -> seq T -> Prop
END|prosa.util.rel.total_over_list
BEGIN|prosa.util.rel.antisymmetric_over_list
@antisymmetric_over_list
     : forall T : eqType, (T -> T -> bool) -> seq T -> Prop
END|prosa.util.rel.antisymmetric_over_list
BEGIN|prosa.util.search_arg.earliest_pred_element_exists_case
earliest_pred_element_exists_case
     : forall (P : pred nat) (t1 t2 : nat), (forall t : nat, t1 <= t < t2 -> ~~ P t) \/ (exists t : nat, t1 <= t < t2 /\ P t /\ (forall t' : nat, t1 <= t' -> P t' -> t <= t'))
END|prosa.util.search_arg.earliest_pred_element_exists_case
BEGIN|prosa.util.search_arg.search_arg
@search_arg
     : forall T : Type, (nat -> T) -> pred T -> rel T -> nat -> nat -> option nat
END|prosa.util.search_arg.search_arg
BEGIN|prosa.util.search_arg.search_arg_none
@search_arg_none
     : forall (T : Type) (f : nat -> T) (P : pred T) (R : rel T) (a b : nat), search_arg f P R a b = None <-> (forall x : nat, a <= x < b -> ~~ P (f x))
END|prosa.util.search_arg.search_arg_none
BEGIN|prosa.util.search_arg.search_arg_not_none
@search_arg_not_none
     : forall (T : Type) (f : nat -> T) (P : pred T) (R : rel T) (a b : nat), (exists x : nat, a <= x < b /\ P (f x)) -> exists y : nat, search_arg f P R a b = Some y
END|prosa.util.search_arg.search_arg_not_none
BEGIN|prosa.util.search_arg.search_arg_pred
@search_arg_pred
     : forall (T : Type) (f : nat -> T) (P : pred T) (R : rel T) (a b x : nat), search_arg f P R a b = Some x -> P (f x)
END|prosa.util.search_arg.search_arg_pred
BEGIN|prosa.util.search_arg.search_arg_in_range
@search_arg_in_range
     : forall (T : Type) (f : nat -> T) (P : pred T) (R : rel T) (a b x : nat), search_arg f P R a b = Some x -> a <= x < b
END|prosa.util.search_arg.search_arg_in_range
BEGIN|prosa.util.search_arg.search_arg_extremum
@search_arg_extremum
     : forall (T : Type) (f : nat -> T) (P : pred T) (R : rel T), reflexive (T:=T) R -> transitive (T:=T) R -> total (T:=T) R -> forall a b x : nat, search_arg f P R a b = Some x -> forall y : nat, a <= y < b -> P (f y) -> R (f x) (f y)
END|prosa.util.search_arg.search_arg_extremum
BEGIN|prosa.util.search_arg.prop_on_ex_minn
prop_on_ex_minn
     : forall (P : nat -> Prop) (pred : nat -> bool) (ex0 : exists n : nat, pred n), P (ex_minn (P:=pred) ex0) -> exists n : nat, P n /\ pred n /\ (forall n' : nat, pred n' -> n <= n')
END|prosa.util.search_arg.prop_on_ex_minn
BEGIN|prosa.util.seqset.set
@set
     : eqType -> Type
END|prosa.util.seqset.set
BEGIN|prosa.util.seqset.set_of
@set_of
     : forall T : eqType, phant T -> Type
END|prosa.util.seqset.set_of
BEGIN|prosa.util.seqset.set_uniq
@set_uniq
     : forall (T : eqType) (s : {setT}), uniq s
END|prosa.util.seqset.set_uniq
BEGIN|prosa.util.setoid.leb
leb
     : bool -> bool -> Prop
END|prosa.util.setoid.leb
BEGIN|prosa.util.setoid.leb_eq
leb_eq
     : forall a b : bool, leb a b <-> (a -> b)
END|prosa.util.setoid.leb_eq
BEGIN|prosa.util.setoid.leqRW
@leqRW
     : forall m n : nat, m <= n -> (m <= n)%coq_nat
END|prosa.util.setoid.leqRW
BEGIN|prosa.util.subadditivity.subadditive_at
subadditive_at
     : (nat -> nat) -> nat -> Prop
END|prosa.util.subadditivity.subadditive_at
BEGIN|prosa.util.subadditivity.subadditive_until
subadditive_until
     : (nat -> nat) -> nat -> Prop
END|prosa.util.subadditivity.subadditive_until
BEGIN|prosa.util.subadditivity.subadditive
subadditive
     : (nat -> nat) -> Prop
END|prosa.util.subadditivity.subadditive
BEGIN|prosa.util.subadditivity.subadditive_standard
subadditive_standard
     : (nat -> nat) -> Prop
END|prosa.util.subadditivity.subadditive_standard
BEGIN|prosa.util.subadditivity.subadditive_standard_equivalence
subadditive_standard_equivalence
     : forall f : nat -> nat, subadditive f <-> subadditive_standard f
END|prosa.util.subadditivity.subadditive_standard_equivalence
BEGIN|prosa.util.subadditivity.subadditive_leq_mul
subadditive_leq_mul
     : forall f : nat -> nat, subadditive f -> forall n m : nat, 0 < m -> f (m * n) <= m * f n
END|prosa.util.subadditivity.subadditive_leq_mul
BEGIN|prosa.util.sum.sum_nat_eq0_nat
sum_nat_eq0_nat
     : forall (I : eqType) (r : seq I) (P : pred I) (F : I -> nat), (\sum_(i <- r | P i) F i == 0) = all (fun x : I => F x == 0) [seq x <- r | P x]
END|prosa.util.sum.sum_nat_eq0_nat
BEGIN|prosa.util.sum.sum_nat_gt0
sum_nat_gt0
     : forall (I : eqType) (r : seq I) (P : pred I) (F : I -> nat), (0 < \sum_(i <- r | P i) F i) = has (fun x : I => 0 < F x) [seq x <- r | P x]
END|prosa.util.sum.sum_nat_gt0
BEGIN|prosa.util.sum.sum_majorant_constant
sum_majorant_constant
     : forall (I : eqType) (r : seq I) (P : pred I) (F : I -> nat) (c : nat), (forall a : I, a \in r -> P a -> F a <= c) -> \sum_(j <- r | P j) F j <= c * size [seq j <- r | P j]
END|prosa.util.sum.sum_majorant_constant
BEGIN|prosa.util.sum.sum_split_exhaustive_mutually_exclusive_preds
sum_split_exhaustive_mutually_exclusive_preds
     : forall (I : eqType) (r : seq I) (P : pred I) (F : I -> nat) (Q R : I -> bool), (forall x : I, P x = Q x || R x) -> (forall x : I, ~~ (Q x && R x)) -> \sum_(r0 <- r | P r0) F r0 = \sum_(r0 <- r | Q r0) F r0 + \sum_(r0 <- r | R r0) F r0
END|prosa.util.sum.sum_split_exhaustive_mutually_exclusive_preds
BEGIN|prosa.util.sum.bigmax_leq_sum
bigmax_leq_sum
     : forall (I : eqType) (r : seq I) (P : pred I) (F : I -> nat), \max_(i <- r | P i) F i <= \sum_(i <- r | P i) F i
END|prosa.util.sum.bigmax_leq_sum
BEGIN|prosa.util.sum.sum_le_subseq
sum_le_subseq
     : forall (I : eqType) (P : pred I) (F : I -> nat) (r1 r2 : seq I), subseq r1 r2 -> \sum_(x <- r1 | P x) F x <= \sum_(x <- r2 | P x) F x
END|prosa.util.sum.sum_le_subseq
BEGIN|prosa.util.sum.leq_sum_seq
leq_sum_seq
     : forall (I : eqType) (r : seq I) (P : pred I) (E1 E2 : I -> nat), (forall i : I, i \in r -> P i -> E1 i <= E2 i) -> \sum_(i <- r | P i) E1 i <= \sum_(i <- r | P i) E2 i
END|prosa.util.sum.leq_sum_seq
BEGIN|prosa.util.sum.eq_sum_seq
eq_sum_seq
     : forall (I : eqType) (r : seq I) (P : pred I) (E1 E2 : I -> nat), (forall i : I, i \in r -> P i -> E1 i == E2 i) -> \sum_(i <- r | P i) E1 i = \sum_(i <- r | P i) E2 i
END|prosa.util.sum.eq_sum_seq
BEGIN|prosa.util.sum.leq_sum_seq_pred
leq_sum_seq_pred
     : forall (I : eqType) (r : seq I) (E : I -> nat) (P1 P2 : pred I), (forall i : I, i \in r -> P1 i -> P2 i) -> \sum_(i <- r | P1 i) E i <= \sum_(i <- r | P2 i) E i
END|prosa.util.sum.leq_sum_seq_pred
BEGIN|prosa.util.sum.leq_sum_subseq
leq_sum_subseq
     : forall (I : eqType) (r r' : seq I) (P : pred I) (F : I -> nat), subseq r r' -> \sum_(i <- r | P i) F i <= \sum_(i <- r' | P i) F i
END|prosa.util.sum.leq_sum_subseq
BEGIN|prosa.util.sum.leq_sum_sub_uniq
leq_sum_sub_uniq
     : forall (I : eqType) (r : seq I) (F : I -> nat) (rs : seq I), uniq r -> {subset r <= rs} -> \sum_(i <- r) F i <= \sum_(i <- rs) F i
END|prosa.util.sum.leq_sum_sub_uniq
BEGIN|prosa.util.sum.ltn_sum_leq_seq
ltn_sum_leq_seq
     : forall (I : eqType) (r : seq I) (P : pred I) (E1 E2 : I -> nat) (j : I), j \in r -> P j -> E1 j < E2 j -> (forall i : I, i \in r -> P i -> E1 i <= E2 i) -> \sum_(x <- r | P x) E1 x < \sum_(x <- r | P x) E2 x
END|prosa.util.sum.ltn_sum_leq_seq
BEGIN|prosa.util.sum.eq_sum_leq_seq
eq_sum_leq_seq
     : forall (I : eqType) (r : seq I) (P : pred I) (E1 E2 : I -> nat), (forall i : I, i \in r -> P i -> E1 i <= E2 i) -> (\sum_(x <- r | P x) E1 x == \sum_(x <- r | P x) E2 x) = all (fun x : I => E1 x == E2 x) [seq x <- r | P x]
END|prosa.util.sum.eq_sum_leq_seq
BEGIN|prosa.util.sum.sum_of_ones
sum_of_ones
     : forall t Δ : nat, \sum_(t <= x < t + Δ) 1 = Δ
END|prosa.util.sum.sum_of_ones
BEGIN|prosa.util.sum.big_nat_eq0
big_nat_eq0
     : forall (m n : nat) (F : nat -> nat), \sum_(m <= i < n) F i = 0 <-> (forall i : nat, m <= i < n -> F i = 0)
END|prosa.util.sum.big_nat_eq0
BEGIN|prosa.util.sum.sum_le_summation_range
sum_le_summation_range
     : forall (f : nat -> nat) (t Δ : nat), \sum_(t <= x < t + Δ) f x < Δ -> exists x : nat, t <= x < t + Δ /\ f x = 0
END|prosa.util.sum.sum_le_summation_range
BEGIN|prosa.util.sum.big_sum_eq_in_eq_sized_intervals
big_sum_eq_in_eq_sized_intervals
     : forall (t1 t2 d : nat) (F1 F2 : nat -> nat), (forall g : nat, g < d -> F1 (t1 + g) = F2 (t2 + g)) -> \sum_(t1 <= t < t1 + d) F1 t = \sum_(t2 <= t < t2 + d) F2 t
END|prosa.util.sum.big_sum_eq_in_eq_sized_intervals
BEGIN|prosa.util.sum.sum_over_partitions_le
sum_over_partitions_le
     : forall (X Y : eqType) (x_to_y : X -> Y) (f : X -> nat) (P : pred X) (xs : seq X) (ys : seq Y), (forall x : X, x \in xs -> P x -> x_to_y x \in ys) -> \sum_(x <- xs | P x) f x <= \sum_(y <- ys) \sum_(x <- xs | P x && (x_to_y x == y)) f x
END|prosa.util.sum.sum_over_partitions_le
BEGIN|prosa.util.sum.reorder_summation
reorder_summation
     : forall (X Y : eqType) (x_to_y : X -> Y) (f : X -> nat) (P : pred X) (xs : seq X) (ys : seq Y), (forall x : X, x \in xs -> P x -> x_to_y x \in ys) -> forall y' : Y, \sum_(x <- xs | P x && (x_to_y x != y')) f x <= \sum_(y <- ys | y != y') \sum_(x <- xs | P x && (x_to_y x == y)) f x
END|prosa.util.sum.reorder_summation
BEGIN|prosa.util.sum.sum_over_partitions_eq
sum_over_partitions_eq
     : forall (X Y : eqType) (x_to_y : X -> Y) (f : X -> nat) (P : pred X) (xs : seq X) (ys : seq Y), (forall x : X, x \in xs -> P x -> x_to_y x \in ys) -> uniq xs -> uniq ys -> \sum_(x <- xs | P x) f x = \sum_(y <- ys) \sum_(x <- xs | P x && (x_to_y x == y)) f x
END|prosa.util.sum.sum_over_partitions_eq
BEGIN|prosa.util.sum.sum_leq_mono
sum_leq_mono
     : forall (I : eqType) (P : pred I) (F : I -> nat -> nat) (r : seq I), (forall i : I, i \in r -> monotone leq (F i)) -> monotone leq (fun x : nat => \sum_(i <- r | P i) F i x)
END|prosa.util.sum.sum_leq_mono
BEGIN|prosa.util.sum.sum_unit1
@sum_unit1
     : forall F : unit -> nat, \sum_r F r = F tt
END|prosa.util.sum.sum_unit1
BEGIN|prosa.util.sum.pigeonhole_on_interval
pigeonhole_on_interval
     : forall (P1 P2 : pred nat) (t1 t2 n1 n2 : nat), n1 <= \sum_(t1 <= t < t2) P1 t -> n2 <= \sum_(t1 <= t < t2) P2 t -> n1 + n2 - (t2 - t1) <= \sum_(t1 <= t < t2) P1 t && P2 t
END|prosa.util.sum.pigeonhole_on_interval
BEGIN|prosa.util.sum.sum_ge_2_seq
@sum_ge_2_seq
     : forall (X : eqType) (xs : seq X) (p : X -> nat), uniq xs -> (forall x : X, x \in xs -> p x <= 1) -> 1 < \sum_(x <- xs) p x -> exists x1 x2 : X, x1 != x2 /\ x1 \in xs /\ x2 \in xs /\ p x1 == 1 /\ p x2 == 1
END|prosa.util.sum.sum_ge_2_seq
BEGIN|prosa.util.sum.sum_ge_2_nat
sum_ge_2_nat
     : forall (t1 t2 : nat) (p : nat -> nat), (forall t : nat, p t <= 1) -> 1 < \sum_(t1 <= t < t2) p t -> exists to1 to2 : nat, t1 <= to1 /\ to1 < to2 /\ to2 < t2 /\ p to1 == 1 /\ p to2 == 1
END|prosa.util.sum.sum_ge_2_nat
BEGIN|prosa.util.superadditivity.superadditive_at
superadditive_at
     : (nat -> nat) -> nat -> Prop
END|prosa.util.superadditivity.superadditive_at
BEGIN|prosa.util.superadditivity.superadditive_until
superadditive_until
     : (nat -> nat) -> nat -> Prop
END|prosa.util.superadditivity.superadditive_until
BEGIN|prosa.util.superadditivity.superadditive
superadditive
     : (nat -> nat) -> Prop
END|prosa.util.superadditivity.superadditive
BEGIN|prosa.util.superadditivity.superadditive_standard
superadditive_standard
     : (nat -> nat) -> Prop
END|prosa.util.superadditivity.superadditive_standard
BEGIN|prosa.util.superadditivity.superadditive_standard_equivalence
superadditive_standard_equivalence
     : forall f : nat -> nat, superadditive f <-> superadditive_standard f
END|prosa.util.superadditivity.superadditive_standard_equivalence
BEGIN|prosa.util.superadditivity.superadditive_first_zero
superadditive_first_zero
     : forall f : nat -> nat, superadditive_at f 0 -> f 0 = 0
END|prosa.util.superadditivity.superadditive_first_zero
BEGIN|prosa.util.superadditivity.superadditive_monotone
superadditive_monotone
     : forall f : nat -> nat, superadditive f -> monotone leq f
END|prosa.util.superadditivity.superadditive_monotone
BEGIN|prosa.util.superadditivity.superadditive_leq_mul
superadditive_leq_mul
     : forall f : nat -> nat, superadditive f -> forall n m : nat, m * f n <= f (m * n)
END|prosa.util.superadditivity.superadditive_leq_mul
BEGIN|prosa.util.superadditivity.superadditive_unbounded
superadditive_unbounded
     : forall f : nat -> nat, superadditive f -> (exists n : nat, 0 < f n) -> forall t : nat, exists n' : nat, t <= f n'
END|prosa.util.superadditivity.superadditive_unbounded
BEGIN|prosa.util.superadditivity.minimal_superadditive_extension
minimal_superadditive_extension
     : (nat -> nat) -> nat -> nat
END|prosa.util.superadditivity.minimal_superadditive_extension
BEGIN|prosa.util.superadditivity.minimal_extension_superadditive_at_horizon
minimal_extension_superadditive_at_horizon
     : forall (f : nat -> nat) (h : nat), superadditive_until f h -> forall f' : nat -> nat, (forall t : nat, f' t = (if t == h then minimal_superadditive_extension f h else f t)) -> superadditive_at f' h
END|prosa.util.superadditivity.minimal_extension_superadditive_at_horizon
BEGIN|prosa.util.superadditivity.minimal_extension_superadditive_until
minimal_extension_superadditive_until
     : forall (f : nat -> nat) (h : nat), superadditive_until f h -> forall f' : nat -> nat, (forall t : nat, f' t = (if t == h then minimal_superadditive_extension f h else f t)) -> superadditive_until f' h.+1
END|prosa.util.superadditivity.minimal_extension_superadditive_until
BEGIN|prosa.util.supremum.choose_superior
@choose_superior
     : forall T : eqType, rel T -> T -> option T -> option T
END|prosa.util.supremum.choose_superior
BEGIN|prosa.util.supremum.supremum
@supremum
     : forall T : eqType, rel T -> seq T -> option T
END|prosa.util.supremum.supremum
BEGIN|prosa.util.supremum.supremum_unfold
@supremum_unfold
     : forall (T : eqType) (R : rel T) (head : T) (tail : seq T), supremum R (head :: tail) = choose_superior R head (supremum R tail)
END|prosa.util.supremum.supremum_unfold
BEGIN|prosa.util.supremum.supremum_exists
@supremum_exists
     : forall (T : eqType) (R : rel T) (x : T) (s : seq_predType T), x \in s -> supremum R s != None
END|prosa.util.supremum.supremum_exists
BEGIN|prosa.util.supremum.supremum_none
@supremum_none
     : forall (T : eqType) (R : rel T) (s : seq T), supremum R s = None -> s = [::]
END|prosa.util.supremum.supremum_none
BEGIN|prosa.util.supremum.supremum_in
@supremum_in
     : forall (T : eqType) (R : rel T) (x : T) (s : seq T), supremum R s = Some x -> x \in s
END|prosa.util.supremum.supremum_in
BEGIN|prosa.util.supremum.supremum_spec
@supremum_spec
     : forall (T : eqType) (R : rel T), reflexive (T:=T) R -> total (T:=T) R -> transitive (T:=T) R -> forall (x : T) (s : seq T), supremum R s = Some x -> forall y : T, y \in s -> R x y
END|prosa.util.supremum.supremum_spec
BEGIN|prosa.util.tactics.neqP
neqP
     : forall (T : eqType) (x y : T), reflect (x <> y) (x != y)
END|prosa.util.tactics.neqP
BEGIN|prosa.util.tactics.modusponens
modusponens
     : forall P Q : Prop, P -> (P -> Q) -> Q
END|prosa.util.tactics.modusponens
BEGIN|prosa.util.unit_growth.unit_growth_function
unit_growth_function
     : (nat -> nat) -> Prop
END|prosa.util.unit_growth.unit_growth_function
BEGIN|prosa.util.unit_growth.unit_growth_function_k_steps_bounded
unit_growth_function_k_steps_bounded
     : forall f : nat -> nat, unit_growth_function f -> forall x k : nat, f (x + k) <= k + f x
END|prosa.util.unit_growth.unit_growth_function_k_steps_bounded
BEGIN|prosa.util.unit_growth.exists_intermediate_point
exists_intermediate_point
     : forall f : nat -> nat, unit_growth_function f -> forall x1 x2 : nat, x1 <= x2 -> forall y : nat, f x1 <= y < f x2 -> exists x_mid : nat, x1 <= x_mid < x2 /\ f x_mid = y
END|prosa.util.unit_growth.exists_intermediate_point
BEGIN|prosa.util.unit_growth.exists_intermediate_point_leq
exists_intermediate_point_leq
     : forall f : nat -> nat, unit_growth_function f -> forall x1 x2 : nat, x1 <= x2 -> forall y : nat, f x1 <= y <= f x2 -> exists x_mid : nat, x1 <= x_mid <= x2 /\ f x_mid = y
END|prosa.util.unit_growth.exists_intermediate_point_leq
BEGIN|prosa.util.unit_growth.exists_first_intermediate_point
exists_first_intermediate_point
     : forall (P : nat -> bool) (t1 t2 : nat), t1 <= t2 -> ~~ P t1 -> P t2 -> exists t : nat, t1 < t <= t2 /\ (forall x : nat, t1 <= x < t -> ~~ P x) /\ P t
END|prosa.util.unit_growth.exists_first_intermediate_point
BEGIN|prosa.util.unit_growth.slowed
slowed
     : (nat -> nat) -> nat -> nat
END|prosa.util.unit_growth.slowed
BEGIN|prosa.util.unit_growth.slowed_respects_pointwise_leq
slowed_respects_pointwise_leq
     : forall (f F : nat -> nat) (Δ : nat), unit_growth_function f -> (forall x : nat, x <= Δ -> f x <= F x) -> f Δ <= slowed F Δ
END|prosa.util.unit_growth.slowed_respects_pointwise_leq
BEGIN|prosa.util.unit_growth.slowed_is_unit_step
slowed_is_unit_step
     : forall f : nat -> nat, unit_growth_function (slowed f)
END|prosa.util.unit_growth.slowed_is_unit_step
BEGIN|prosa.util.unit_growth.slowed_respects_monotone
slowed_respects_monotone
     : forall f : nat -> nat, monotone leq f -> monotone leq (slowed f)
END|prosa.util.unit_growth.slowed_respects_monotone
BEGIN|prosa.util.unit_growth.slowed_never_exceeds
slowed_never_exceeds
     : forall (f : nat -> nat) (x : nat), slowed f x <= f x
END|prosa.util.unit_growth.slowed_never_exceeds
BEGIN|prosa.util.unit_growth.bound_preserved_under_slowed
bound_preserved_under_slowed
     : forall (f : nat -> nat) (δ A F : nat), A <= F - f δ -> A <= F - slowed f δ
END|prosa.util.unit_growth.bound_preserved_under_slowed
BEGIN|prosa.util.unit_growth.slowed_subtraction_value_preservation
slowed_subtraction_value_preservation
     : forall (f : nat -> nat) (Δ : nat), monotone leq f -> exists δ : nat, δ <= Δ /\ Δ - f Δ = δ - slowed f δ
END|prosa.util.unit_growth.slowed_subtraction_value_preservation
