     : forall (Job : JobType) (sched : schedule (overheads.processor_state Job)) (t1 t2 t : instant), t1 <= t < t2 -> number_schedule_changes sched t1 t2 = 0 -> ~~ schedule_change sched t
END|prosa.analysis.facts.model.overheads.schedule_change.no_schedule_changes_implies_constant_schedule
BEGIN|prosa.analysis.facts.model.overheads.schedule_change.no_changes_implies_same_scheduled_job
@no_changes_implies_same_scheduled_job
     : forall (Job : JobType) (sched : schedule (overheads.processor_state Job)) (t1 t2 t t' : instant) (oj : option Job), no_schedule_changes_during sched t1 t2 -> t1 <= t < t2 -> t1 <= t' < t2 -> scheduled_job sched t = oj -> scheduled_job sched t' = oj
END|prosa.analysis.facts.model.overheads.schedule_change.no_changes_implies_same_scheduled_job
BEGIN|prosa.analysis.facts.model.overheads.schedule_change_bound.schedule_changes_bounded_by_total_arrivals_JLFP
@schedule_changes_bounded_by_total_arrivals_JLFP
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (JLFP : JLFP_policy Job), reflexive_job_priorities JLFP -> transitive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule (overheads.processor_state Job), valid_schedule sched arr_seq -> work_conserving arr_seq sched -> no_superfluous_preemptions sched -> respects_JLFP_policy_at_preemption_point arr_seq sched JLFP -> valid_preemption_model arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall (Task : TaskType) (H2 : MaxArrivals Task) (H3 : JobTask Job Task) (ts : seq Task), all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall Δ : duration, t1 + Δ <= t2 -> number_schedule_changes sched t1.+1 (t1 + Δ) <= 2 * (\sum_(tsk <- ts) max_arrivals tsk Δ)
END|prosa.analysis.facts.model.overheads.schedule_change_bound.schedule_changes_bounded_by_total_arrivals_JLFP
BEGIN|prosa.analysis.facts.model.overheads.schedule_change_bound.schedule_changes_bounded_by_total_arrivals_FP
@schedule_changes_bounded_by_total_arrivals_FP
     : forall (Task : TaskType) (H : MaxArrivals Task) (FP : FP_policy Task) (Job : JobType) (H0 : JobArrival Job) (H1 : JobTask Job Task) (H2 : JobCost Job) (H3 : JobPreemptable Job), reflexive_task_priorities FP -> transitive_task_priorities FP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule (overheads.processor_state Job), valid_schedule sched arr_seq -> work_conserving arr_seq sched -> no_superfluous_preemptions sched -> respects_FP_policy_at_preemption_point arr_seq sched FP -> valid_preemption_model arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall Δ : duration, t1 + Δ <= t2 -> number_schedule_changes sched t1.+1 (t1 + Δ) <= 2 * (\sum_(tsk <- ts | hep_task tsk (job_task j)) max_arrivals tsk Δ)
END|prosa.analysis.facts.model.overheads.schedule_change_bound.schedule_changes_bounded_by_total_arrivals_FP
BEGIN|prosa.analysis.facts.model.overheads.schedule_change_bound.schedule_changes_bounded_by_total_arrivals_FIFO
@schedule_changes_bounded_by_total_arrivals_FIFO
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (JLFP : JLFP_policy Job), policy_is_FIFO JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule (overheads.processor_state Job), valid_schedule sched arr_seq -> work_conserving arr_seq sched -> no_superfluous_preemptions sched -> respects_JLFP_policy_at_preemption_point arr_seq sched JLFP -> valid_preemption_model arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall (Task : TaskType) (H2 : MaxArrivals Task) (H3 : JobTask Job Task) (ts : seq Task), all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall Δ : duration, t1 + Δ <= t2 -> number_schedule_changes sched t1.+1 (t1 + Δ) <= \sum_(tsk <- ts) max_arrivals tsk Δ
END|prosa.analysis.facts.model.overheads.schedule_change_bound.schedule_changes_bounded_by_total_arrivals_FIFO
BEGIN|prosa.analysis.facts.model.preemption.preemption_time_interval_case
@preemption_time_interval_case
     : forall (Job : JobType) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : nat), (forall t : nat, t1 <= t < t2 -> ~~ preemption_time arr_seq sched t) \/ (exists t : nat, t1 <= t < t2 /\ preemption_time arr_seq sched t /\ (forall t' : nat, t1 <= t' -> preemption_time arr_seq sched t' -> t <= t'))
END|prosa.analysis.facts.model.preemption.preemption_time_interval_case
BEGIN|prosa.analysis.facts.model.preemption.idle_time_is_pt
@idle_time_is_pt
     : forall (Job : JobType) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job) (PState : ProcessorState Job) (sched : schedule PState) (t : instant), is_idle arr_seq sched t -> preemption_time arr_seq sched t
END|prosa.analysis.facts.model.preemption.idle_time_is_pt
BEGIN|prosa.analysis.facts.model.preemption.zero_is_pt
@zero_is_pt
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> valid_preemption_model arr_seq sched -> preemption_time arr_seq sched 0
END|prosa.analysis.facts.model.preemption.zero_is_pt
BEGIN|prosa.analysis.facts.model.preemption.first_moment_is_pt
@first_moment_is_pt
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> valid_preemption_model arr_seq sched -> forall (j : Job) (prt : instant), arrives_in arr_seq j -> ~~ scheduled_at sched j prt -> scheduled_at sched j prt.+1 -> preemption_time arr_seq sched prt.+1
END|prosa.analysis.facts.model.preemption.first_moment_is_pt
BEGIN|prosa.analysis.facts.model.preemption.neg_pt_scheduled_at
@neg_pt_scheduled_at
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> valid_preemption_model arr_seq sched -> forall (j : Job) (t : nat), scheduled_at sched j t.+1 -> ~~ preemption_time arr_seq sched t.+1 -> scheduled_at sched j t
END|prosa.analysis.facts.model.preemption.neg_pt_scheduled_at
BEGIN|prosa.analysis.facts.model.preemption.neg_pt_scheduled_before
@neg_pt_scheduled_before
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> valid_preemption_model arr_seq sched -> forall (j : Job) (t : instant), ~~ preemption_time arr_seq sched t -> scheduled_at sched j t.-1 -> scheduled_at sched j t
END|prosa.analysis.facts.model.preemption.neg_pt_scheduled_before
BEGIN|prosa.analysis.facts.model.preemption.neg_pt_scheduled_continuously_before
@neg_pt_scheduled_continuously_before
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> valid_preemption_model arr_seq sched -> forall (j : Job) (t1 : instant) (t2 : nat), scheduled_at sched j t1 -> t1 <= t2 -> (forall t : nat, t1 < t <= t2 -> ~~ preemption_time arr_seq sched t) -> scheduled_at sched j t2
END|prosa.analysis.facts.model.preemption.neg_pt_scheduled_continuously_before
BEGIN|prosa.analysis.facts.model.preemption.neg_pt_scheduled_continuously_after
@neg_pt_scheduled_continuously_after
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> valid_preemption_model arr_seq sched -> forall (j : Job) (t1 : nat) (t2 : instant), scheduled_at sched j t2 -> t1 <= t2 -> (forall t : nat, t1 <= t <= t2 -> ~~ preemption_time arr_seq sched t) -> scheduled_at sched j t1
END|prosa.analysis.facts.model.preemption.neg_pt_scheduled_continuously_after
BEGIN|prosa.analysis.facts.model.preemption.neg_pt_scheduled_continuous
@neg_pt_scheduled_continuous
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> valid_preemption_model arr_seq sched -> forall (j : Job) (t1 t2 t t' : nat), t1 <= t < t2 -> t1 <= t' < t2 -> (forall t0 : nat, t1 <= t0 < t2 -> ~~ preemption_time arr_seq sched t0) -> scheduled_at sched j t -> scheduled_at sched j t'
END|prosa.analysis.facts.model.preemption.neg_pt_scheduled_continuous
BEGIN|prosa.analysis.facts.model.preemption.neq_scheduled_at_pt
@neq_scheduled_at_pt
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> valid_preemption_model arr_seq sched -> forall (j : Job) (t : instant), scheduled_at sched j t -> forall (j' : Job) (t' : instant), scheduled_at sched j' t' -> j != j' -> t <= t' -> exists2 pt : instant, preemption_time arr_seq sched pt & t < pt <= t'
END|prosa.analysis.facts.model.preemption.neq_scheduled_at_pt
BEGIN|prosa.analysis.facts.model.preemption.neq_scheduled_at_pt_continuous_sched
@neq_scheduled_at_pt_continuous_sched
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> valid_preemption_model arr_seq sched -> forall (j : Job) (t : instant), scheduled_at sched j t -> forall (j' : Job) (t' : instant), scheduled_at sched j' t' -> j != j' -> t <= t' -> exists pt : instant, preemption_time arr_seq sched pt /\ t < pt <= t' /\ scheduled_at sched j' pt
END|prosa.analysis.facts.model.preemption.neq_scheduled_at_pt_continuous_sched
BEGIN|prosa.analysis.facts.model.preemption.scheduling_of_any_segment_starts_with_preemption_time
@scheduling_of_any_segment_starts_with_preemption_time
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> forall (JobReady0 : JobReady Job PState) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, valid_schedule sched arr_seq -> forall H : JobPreemptable Job, valid_preemption_model arr_seq sched -> forall (j : Job) (t : instant), scheduled_at sched j t -> exists pt : nat, job_arrival j <= pt <= t /\ preemption_time arr_seq sched pt /\ (forall t' : nat, pt <= t' <= t -> scheduled_at sched j t')
END|prosa.analysis.facts.model.preemption.scheduling_of_any_segment_starts_with_preemption_time
BEGIN|prosa.analysis.facts.model.preemption.scheduling_of_any_segment_starts_with_preemption_time_continuously_sched
@scheduling_of_any_segment_starts_with_preemption_time_continuously_sched
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> forall (JobReady0 : JobReady Job PState) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, valid_schedule sched arr_seq -> forall H : JobPreemptable Job, valid_preemption_model arr_seq sched -> forall (j : Job) (t1 t2 : nat), t1 <= t2 -> preemption_time arr_seq sched t1 -> scheduled_at sched j t2 -> exists ptst : nat, t1 <= ptst <= t2 /\ preemption_time arr_seq sched ptst /\ scheduled_at sched j ptst
END|prosa.analysis.facts.model.preemption.scheduling_of_any_segment_starts_with_preemption_time_continuously_sched
BEGIN|prosa.analysis.facts.model.preemption.priority_higher_than_pending_job_priority
@priority_higher_than_pending_job_priority
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> forall (JobReady0 : JobReady Job PState) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (H : JobPreemptable Job), valid_preemption_model arr_seq sched -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> valid_schedule sched arr_seq -> respects_JLFP_policy_at_preemption_point arr_seq sched JLFP -> forall (j : Job) (t1 t2 : instant), scheduled_at sched j t1 -> scheduled_at sched j t2 -> (forall t : nat, t1 <= t < t2 -> job_ready sched j t) -> forall t : instant, t1 <= t < t2 -> forall jhp : Job, scheduled_at sched jhp t -> hep_job jhp j
END|prosa.analysis.facts.model.preemption.priority_higher_than_pending_job_priority
BEGIN|prosa.analysis.facts.model.rbf.task_workload_between_bounded
@task_workload_between_bounded
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H1 : JobTask Job Task) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> forall (tsk : Task) (t1 t2 : instant), task_workload_between arr_seq tsk t1 t2 <= task_cost tsk * number_of_task_arrivals arr_seq tsk t1 t2
END|prosa.analysis.facts.model.rbf.task_workload_between_bounded
BEGIN|prosa.analysis.facts.model.rbf.rbf_spec
@rbf_spec
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> forall tsk : Task, respects_max_arrivals arr_seq tsk (max_arrivals tsk) -> forall (t : instant) (Δ : nat), task_workload_between arr_seq tsk t (t + Δ) <= task_request_bound_function tsk Δ
END|prosa.analysis.facts.model.rbf.rbf_spec
BEGIN|prosa.analysis.facts.model.rbf.rbf_spec'
@rbf_spec'
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> forall (P : pred Job) (tsk : Task), respects_max_arrivals arr_seq tsk (max_arrivals tsk) -> (forall j : Job, P j -> job_of_task tsk j) -> forall (t : instant) (Δ : nat), workload_of_jobs P (arrivals_between arr_seq t (t + Δ)) <= task_request_bound_function tsk Δ
END|prosa.analysis.facts.model.rbf.rbf_spec'
BEGIN|prosa.analysis.facts.model.rbf.total_workload_le_total_rbf
@total_workload_le_total_rbf
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall (t : instant) (Δ : nat), total_workload_between arr_seq t (t + Δ) <= total_request_bound_function ts Δ
END|prosa.analysis.facts.model.rbf.total_workload_le_total_rbf
BEGIN|prosa.analysis.facts.model.rbf.workload_of_jobs_bounded
@workload_of_jobs_bounded
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall (pred1 : pred Job) (pred2 : pred Task), (forall j : Job, pred1 j -> pred2 (job_task j)) -> forall (t : instant) (Δ : nat), workload_of_jobs pred1 (arrivals_between arr_seq t (t + Δ)) <= \sum_(tsk' <- ts | pred2 tsk') task_request_bound_function tsk' Δ
END|prosa.analysis.facts.model.rbf.workload_of_jobs_bounded
BEGIN|prosa.analysis.facts.model.rbf.athep_workload_le_total_ohep_rbf
@athep_workload_le_total_ohep_rbf
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (arr_seq : arrival_sequence Job) (PState : ProcessorState Job) (sched : schedule PState), arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall (FP : FP_policy Task) (tsk : Task), athep_workload_is_bounded arr_seq sched tsk (fun=> [eta total_ohep_request_bound_function_FP ts tsk])
END|prosa.analysis.facts.model.rbf.athep_workload_le_total_ohep_rbf
BEGIN|prosa.analysis.facts.model.rbf.hep_workload_le_total_hep_rbf
@hep_workload_le_total_hep_rbf
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall (FP : FP_policy Task) (tsk : Task) (j : Job), job_of_task tsk j -> forall (t : instant) (Δ : nat), workload_of_hep_jobs arr_seq j t (t + Δ) <= total_hep_request_bound_function_FP ts tsk Δ
END|prosa.analysis.facts.model.rbf.hep_workload_le_total_hep_rbf
BEGIN|prosa.analysis.facts.model.rbf.hep_workload_le_total_rbf
@hep_workload_le_total_rbf
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall (H4 : JLFP_policy Job) (j : Job) (t : instant) (Δ : nat), workload_of_hep_jobs arr_seq j t (t + Δ) <= total_request_bound_function ts Δ
END|prosa.analysis.facts.model.rbf.hep_workload_le_total_rbf
BEGIN|prosa.analysis.facts.model.rbf.task_rbf_0_zero
@task_rbf_0_zero
     : forall (Task : TaskType) (H : TaskCost Task) (tsk : Task) (H2 : MaxArrivals Task), valid_arrival_curve (max_arrivals tsk) -> task_request_bound_function tsk 0 = 0
END|prosa.analysis.facts.model.rbf.task_rbf_0_zero
BEGIN|prosa.analysis.facts.model.rbf.task_rbf_monotone
@task_rbf_monotone
     : forall (Task : TaskType) (H : TaskCost Task) (tsk : Task) (H2 : MaxArrivals Task), valid_arrival_curve (max_arrivals tsk) -> monotone leq (task_request_bound_function tsk)
END|prosa.analysis.facts.model.rbf.task_rbf_monotone
BEGIN|prosa.analysis.facts.model.rbf.task_rbf_1_ge_task_cost
@task_rbf_1_ge_task_cost
     : forall (Task : TaskType) (H : TaskCost Task) (tsk : Task) (H2 : MaxArrivals Task), 0 < max_arrivals tsk 1 -> task_cost tsk <= task_request_bound_function tsk 1
END|prosa.analysis.facts.model.rbf.task_rbf_1_ge_task_cost
BEGIN|prosa.analysis.facts.model.rbf.task_rbf_ge_task_cost
@task_rbf_ge_task_cost
     : forall (Task : TaskType) (H : TaskCost Task) (tsk : Task) (H2 : MaxArrivals Task), valid_arrival_curve (max_arrivals tsk) -> 0 < max_arrivals tsk 1 -> forall A : nat, 0 < A -> task_cost tsk <= task_request_bound_function tsk A
END|prosa.analysis.facts.model.rbf.task_rbf_ge_task_cost
BEGIN|prosa.analysis.facts.model.rbf.task_rbf_epsilon_gt_0
@task_rbf_epsilon_gt_0
     : forall (Task : TaskType) (H : TaskCost Task) (tsk : Task) (H2 : MaxArrivals Task), 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> 0 < task_request_bound_function tsk 1
END|prosa.analysis.facts.model.rbf.task_rbf_epsilon_gt_0
BEGIN|prosa.analysis.facts.model.rbf.task_cost_le_sum_rbf
@task_cost_le_sum_rbf
     : forall (Task : TaskType) (H : TaskCost Task) (tsk : Task) (H2 : MaxArrivals Task), valid_arrival_curve (max_arrivals tsk) -> 0 < max_arrivals tsk 1 -> forall ts : seq Task, tsk \in ts -> forall t : nat, 0 < t -> task_cost tsk <= total_request_bound_function ts t
END|prosa.analysis.facts.model.rbf.task_cost_le_sum_rbf
BEGIN|prosa.analysis.facts.model.rbf.total_rbf_monotone
@total_rbf_monotone
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> monotone leq (total_request_bound_function ts)
END|prosa.analysis.facts.model.rbf.total_rbf_monotone
BEGIN|prosa.analysis.facts.model.rbf.total_hep_rbf_monotone
@total_hep_rbf_monotone
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> forall (H1 : FP_policy Task) (tsk : Task), monotone leq (total_hep_request_bound_function_FP ts tsk)
END|prosa.analysis.facts.model.rbf.total_hep_rbf_monotone
BEGIN|prosa.analysis.facts.model.rbf.total_ohep_rbf_monotone
@total_ohep_rbf_monotone
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> forall (H1 : FP_policy Task) (tsk : Task), monotone leq (total_ohep_request_bound_function_FP ts tsk)
END|prosa.analysis.facts.model.rbf.total_ohep_rbf_monotone
BEGIN|prosa.analysis.facts.model.rbf.pathological_rbf_response_time_bound
@pathological_rbf_response_time_bound
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (ts : seq Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> taskset_respects_max_arrivals arr_seq ts -> forall (PState : ProcessorState Job) (sched : schedule PState) (tsk : Task), tsk \in ts -> task_request_bound_function tsk 1 = 0 -> task_response_time_bound arr_seq sched tsk 0
END|prosa.analysis.facts.model.rbf.pathological_rbf_response_time_bound
BEGIN|prosa.analysis.facts.model.rbf.pathological_total_hep_rbf_response_time_bound
@pathological_total_hep_rbf_response_time_bound
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (ts : seq Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> taskset_respects_max_arrivals arr_seq ts -> forall (PState : ProcessorState Job) (sched : schedule PState) (FP : FP_policy Task), reflexive_task_priorities FP -> forall tsk : Task, tsk \in ts -> total_hep_request_bound_function_FP ts tsk 1 = 0 -> task_response_time_bound arr_seq sched tsk 0
END|prosa.analysis.facts.model.rbf.pathological_total_hep_rbf_response_time_bound
BEGIN|prosa.analysis.facts.model.rbf.pathological_total_hep_rbf_any_bound
@pathological_total_hep_rbf_any_bound
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (ts : seq Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> taskset_respects_max_arrivals arr_seq ts -> forall (PState : ProcessorState Job) (sched : schedule PState) (FP : FP_policy Task), reflexive_task_priorities FP -> forall tsk : Task, tsk \in ts -> total_hep_request_bound_function_FP ts tsk 1 = 0 -> forall R : duration, task_response_time_bound arr_seq sched tsk R
END|prosa.analysis.facts.model.rbf.pathological_total_hep_rbf_any_bound
BEGIN|prosa.analysis.facts.model.rbf.hep_rbf_taskwise_partitioning
@hep_rbf_taskwise_partitioning
     : forall (Task : TaskType) (H : TaskCost Task) (H2 : MaxArrivals Task) (FP : FP_policy Task) (ts : seq Task) (tsk : Task) (L : duration), total_hep_request_bound_function_FP ts tsk L = total_hp_request_bound_function_FP ts tsk L + total_ep_request_bound_function_FP ts tsk L
END|prosa.analysis.facts.model.rbf.hep_rbf_taskwise_partitioning
BEGIN|prosa.analysis.facts.model.rbf.split_hep_rbf
@split_hep_rbf
     : forall (Task : TaskType) (H : TaskCost Task) (H2 : MaxArrivals Task) (FP : FP_policy Task) (ts : seq Task) (tsk : Task), reflexive_task_priorities FP -> forall Δ : duration, tsk \in ts -> uniq ts -> total_hep_request_bound_function_FP ts tsk Δ = total_ohep_request_bound_function_FP ts tsk Δ + task_request_bound_function tsk Δ
END|prosa.analysis.facts.model.rbf.split_hep_rbf
BEGIN|prosa.analysis.facts.model.rbf.split_hep_rbf_weaken
@split_hep_rbf_weaken
     : forall (Task : TaskType) (H : TaskCost Task) (H2 : MaxArrivals Task) (FP : FP_policy Task) (ts : seq Task) (tsk : Task), reflexive_task_priorities FP -> forall Δ : duration, tsk \in ts -> total_ohep_request_bound_function_FP ts tsk Δ + task_request_bound_function tsk Δ <= total_hep_request_bound_function_FP ts tsk Δ
END|prosa.analysis.facts.model.rbf.split_hep_rbf_weaken
BEGIN|prosa.analysis.facts.model.rbf.total_ohep_rbf0
@total_ohep_rbf0
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> forall (H1 : FP_policy Task) (tsk : Task), total_ohep_request_bound_function_FP ts tsk 0 = 0
END|prosa.analysis.facts.model.rbf.total_ohep_rbf0
BEGIN|prosa.analysis.facts.model.rbf.ohep_workload_le_rbf
@ohep_workload_le_rbf
     : forall (Task : TaskType) (H : TaskCost Task) (ts : seq Task) (H1 : FP_policy Task) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H4 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall (j : Job) (tsk : Task), job_of_task tsk j -> forall (Δ : nat) (t1 : instant), workload_of_jobs (another_task_hep_job^~ j) (arrivals_between arr_seq t1 (t1 + Δ)) <= total_ohep_request_bound_function_FP ts tsk Δ
END|prosa.analysis.facts.model.rbf.ohep_workload_le_rbf
BEGIN|prosa.analysis.facts.model.rbf.task_rbf_without_job_under_analysis_from_arrival
@task_rbf_without_job_under_analysis_from_arrival
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall (tsk : Task) (j : Job), job_of_task tsk j -> arrives_in arr_seq j -> forall (t1 : instant) (Δ : duration), job_arrival j < t1 + Δ -> task_workload_between arr_seq tsk (job_arrival j) (t1 + Δ) - job_cost j <= task_cost tsk * number_of_task_arrivals arr_seq tsk (job_arrival j) (t1 + Δ) - task_cost tsk
END|prosa.analysis.facts.model.rbf.task_rbf_without_job_under_analysis_from_arrival
BEGIN|prosa.analysis.facts.model.rbf.task_rbf_without_job_under_analysis
@task_rbf_without_job_under_analysis
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall (tsk : Task) (H3 : MaxArrivals Task), respects_max_arrivals arr_seq tsk (max_arrivals tsk) -> forall j : Job, job_of_task tsk j -> arrives_in arr_seq j -> forall (t1 : instant) (Δ : duration), job_arrival j < t1 + Δ -> t1 <= job_arrival j -> task_workload_between arr_seq tsk t1 (t1 + Δ) - job_cost j <= task_request_bound_function tsk Δ - task_cost tsk
END|prosa.analysis.facts.model.rbf.task_rbf_without_job_under_analysis
BEGIN|prosa.analysis.facts.model.restricted_supply.schedule.rs_proc_model_is_a_uniprocessor_model
@rs_proc_model_is_a_uniprocessor_model
     : forall Job : JobType, uniprocessor_model (rs_processor_state Job)
END|prosa.analysis.facts.model.restricted_supply.schedule.rs_proc_model_is_a_uniprocessor_model
BEGIN|prosa.analysis.facts.model.restricted_supply.schedule.rs_proc_is_unit_supply
@rs_proc_is_unit_supply
     : forall Job : JobType, unit_supply_proc_model (rs_processor_state Job)
END|prosa.analysis.facts.model.restricted_supply.schedule.rs_proc_is_unit_supply
BEGIN|prosa.analysis.facts.model.restricted_supply.schedule.rs_proc_model_fully_consuming
@rs_proc_model_fully_consuming
     : forall Job : JobType, fully_consuming_proc_model (rs_processor_state Job)
END|prosa.analysis.facts.model.restricted_supply.schedule.rs_proc_model_fully_consuming
BEGIN|prosa.analysis.facts.model.sbf.average.arm_sbf_monotone
arm_sbf_monotone
     : forall Π Θ ν : duration, sbf_is_monotone (arm_sbf Π Θ ν)
END|prosa.analysis.facts.model.sbf.average.arm_sbf_monotone
BEGIN|prosa.analysis.facts.model.sbf.average.arm_sbf_unit
@arm_sbf_unit
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (Π Θ ν : duration), average_resource_model Π Θ ν sched -> unit_supply_bound_function (arm_sbf Π Θ ν)
END|prosa.analysis.facts.model.sbf.average.arm_sbf_unit
BEGIN|prosa.analysis.facts.model.sbf.average.arm_sbf_valid
@arm_sbf_valid
     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (Π Θ ν : duration), average_resource_model Π Θ ν sched -> valid_supply_bound_function arr_seq sched (arm_sbf Π Θ ν)
END|prosa.analysis.facts.model.sbf.average.arm_sbf_valid
BEGIN|prosa.analysis.facts.model.sbf.periodic.prm_sbf_monotone
@prm_sbf_monotone
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (Π γ : duration), periodic_resource_model Π γ sched -> sbf_is_monotone (prm_sbf Π γ)
END|prosa.analysis.facts.model.sbf.periodic.prm_sbf_monotone
BEGIN|prosa.analysis.facts.model.sbf.periodic.prm_sbf_unit
@prm_sbf_unit
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (Π γ : duration), periodic_resource_model Π γ sched -> unit_supply_bound_function (prm_sbf Π γ)
END|prosa.analysis.facts.model.sbf.periodic.prm_sbf_unit
BEGIN|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_1
@prm_sbf_valid_aux_1
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (Π γ : duration), periodic_resource_model Π γ sched -> forall (k : nat) (q1 q2 : duration), q1 < Π -> q2 < Π -> prm_sbf Π γ (k * Π + q2 - (k * Π + q1)) <= supply_during sched (k * Π + q1) (k * Π + q2)
END|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_1
BEGIN|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_21
@prm_sbf_valid_aux_21
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (Π : duration) (k1 k2 : nat) (q1 q2 : duration), q1 < Π -> q2 < Π -> k1 < k2 -> supply_during sched (k1 * Π + q1) (k2 * Π + q2) = supply_during sched (k1 * Π + q1) ((k1 + 1) * Π) + supply_during sched ((k1 + 1) * Π) (k2 * Π) + supply_during sched (k2 * Π) (k2 * Π + q2)
END|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_21
BEGIN|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_22
@prm_sbf_valid_aux_22
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (Π γ : duration), periodic_resource_model Π γ sched -> forall (k1 k2 : nat) (q1 q2 : duration), q1 < Π -> q2 < Π -> k1 < k2 -> Π - q1 - (Π - γ) <= supply_during sched (k1 * Π + q1) ((k1 + 1) * Π)
END|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_22
BEGIN|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_23
@prm_sbf_valid_aux_23
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (Π γ : duration), periodic_resource_model Π γ sched -> forall (k1 k2 : nat) (q1 q2 : duration), q1 < Π -> q2 < Π -> k1 < k2 -> (k2 - (k1 + 1)) * γ <= supply_during sched ((k1 + 1) * Π) (k2 * Π)
END|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_23
BEGIN|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_24
@prm_sbf_valid_aux_24
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (Π γ : duration), periodic_resource_model Π γ sched -> forall (k1 k2 : nat) (q1 q2 : duration), q1 < Π -> q2 < Π -> k1 < k2 -> q2 - (Π - γ) <= supply_during sched (k2 * Π) (k2 * Π + q2)
END|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_24
BEGIN|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_2
@prm_sbf_valid_aux_2
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (Π γ : duration), periodic_resource_model Π γ sched -> forall (k1 k2 : nat) (q1 q2 : duration), q1 < Π -> q2 < Π -> k1 < k2 -> prm_sbf Π γ (k2 * Π + q2 - (k1 * Π + q1)) <= supply_during sched (k1 * Π + q1) (k2 * Π + q2)
END|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid_aux_2
BEGIN|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid
@prm_sbf_valid
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState) (Π γ : duration), periodic_resource_model Π γ sched -> valid_supply_bound_function arr_seq sched (prm_sbf Π γ)
END|prosa.analysis.facts.model.sbf.periodic.prm_sbf_valid
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_iff
@scheduled_jobs_at_iff
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (j : Job) (t : instant), (j \in scheduled_jobs_at arr_seq sched t) = scheduled_at sched j t
END|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_iff
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_nil
@scheduled_jobs_at_nil
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall t : instant, nilp (scheduled_jobs_at arr_seq sched t) <-> (forall j : Job, ~~ scheduled_at sched j t)
END|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_nil
BEGIN|prosa.analysis.facts.model.scheduled.not_scheduled_when_idle
@not_scheduled_when_idle
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (j : Job) (t : instant), is_idle arr_seq sched t -> ~~ scheduled_at sched j t
END|prosa.analysis.facts.model.scheduled.not_scheduled_when_idle
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_at_implies_in_served_at
@scheduled_at_implies_in_served_at
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> ideal_progress_proc_model PState -> forall (j : Job) (t : instant), scheduled_at sched j t -> j \in served_jobs_at arr_seq sched t
END|prosa.analysis.facts.model.scheduled.scheduled_at_implies_in_served_at
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_seq1
@scheduled_jobs_at_seq1
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> uniprocessor_model PState -> forall t : instant, size (scheduled_jobs_at arr_seq sched t) <= 1
END|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_seq1
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_uni_cases
@scheduled_jobs_at_uni_cases
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> uniprocessor_model PState -> forall t : instant, scheduled_jobs_at arr_seq sched t == [::] \/ (exists j : Job, scheduled_jobs_at arr_seq sched t == [:: j])
END|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_uni_cases
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_uni
@scheduled_jobs_at_uni
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> uniprocessor_model PState -> forall (j : Job) (t : instant), (scheduled_jobs_at arr_seq sched t == [:: j]) = (scheduled_job_at arr_seq sched t == Some j)
END|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_uni
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_job_at_scheduled_at
@scheduled_job_at_scheduled_at
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> uniprocessor_model PState -> forall (j : Job) (t : instant), (scheduled_job_at arr_seq sched t == Some j) = scheduled_at sched j t
END|prosa.analysis.facts.model.scheduled.scheduled_job_at_scheduled_at
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_scheduled_at
@scheduled_jobs_at_scheduled_at
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> uniprocessor_model PState -> forall (j : Job) (t : instant), (scheduled_jobs_at arr_seq sched t == [:: j]) = scheduled_at sched j t
END|prosa.analysis.facts.model.scheduled.scheduled_jobs_at_scheduled_at
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_job_at_none
@scheduled_job_at_none
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall t : instant, scheduled_job_at arr_seq sched t = None <-> (forall j : Job, ~~ scheduled_at sched j t)
END|prosa.analysis.facts.model.scheduled.scheduled_job_at_none
BEGIN|prosa.analysis.facts.model.scheduled.is_idle_iff
@is_idle_iff
     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (t : instant), is_idle arr_seq sched t = (scheduled_job_at arr_seq sched t == None)
END|prosa.analysis.facts.model.scheduled.is_idle_iff
BEGIN|prosa.analysis.facts.model.scheduled.is_nonidle_iff
@is_nonidle_iff
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> uniprocessor_model PState -> forall t : instant, ~~ is_idle arr_seq sched t <-> (exists j : Job, scheduled_at sched j t)
END|prosa.analysis.facts.model.scheduled.is_nonidle_iff
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_at_dec
@scheduled_at_dec
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall t : instant, {exists j : Job, scheduled_at sched j t} + {forall j : Job, ~~ scheduled_at sched j t}
END|prosa.analysis.facts.model.scheduled.scheduled_at_dec
BEGIN|prosa.analysis.facts.model.scheduled.scheduled_at_cases
@scheduled_at_cases
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall t : instant, is_idle arr_seq sched t \/ (exists j : Job, scheduled_at sched j t)
END|prosa.analysis.facts.model.scheduled.scheduled_at_cases
BEGIN|prosa.analysis.facts.model.sequential.scheduler_executes_job_with_earliest_arrival
@scheduler_executes_job_with_earliest_arrival
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (H1 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState), sequential_tasks arr_seq sched -> forall (j1 j2 : Job) (t : instant), arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> same_task j1 j2 -> ~~ completed_by sched j2 t -> scheduled_at sched j1 t -> job_arrival j1 <= job_arrival j2
END|prosa.analysis.facts.model.sequential.scheduler_executes_job_with_earliest_arrival
BEGIN|prosa.analysis.facts.model.sequential.sequential_tasks_different_tasks
@sequential_tasks_different_tasks
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (H1 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState), sequential_tasks arr_seq sched -> forall (j1 j2 : Job) (t : instant), arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_arrival j1 < job_arrival j2 -> ~~ completed_by sched j1 t -> scheduled_at sched j2 t -> ~~ same_task j1 j2
END|prosa.analysis.facts.model.sequential.sequential_tasks_different_tasks
BEGIN|prosa.analysis.facts.model.sequential.sequential_tasks_from_readiness
@sequential_tasks_from_readiness
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (H1 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall JR : JobReady Job PState, readiness.sequential_readiness JR arr_seq -> forall sched : schedule PState, valid_schedule sched arr_seq -> sequential_tasks arr_seq sched
END|prosa.analysis.facts.model.sequential.sequential_tasks_from_readiness
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_cat_scheduling_interval
@service_of_jobs_cat_scheduling_interval
     : forall (Job : JobType) (H0 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall sched : schedule PState, jobs_must_arrive_to_execute sched -> forall (P : pred Job) (t1 t2 t : nat), t1 <= t <= t2 -> service_of_jobs sched P (arrivals_between arr_seq t1 t2) t1 t2 = service_of_jobs sched P (arrivals_between arr_seq t1 t) t1 t + service_of_jobs sched P (arrivals_between arr_seq t1 t) t t2 + service_of_jobs sched P (arrivals_between arr_seq t t2) t t2
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_cat_scheduling_interval
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_cat_arrival_interval
@service_of_jobs_cat_arrival_interval
     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (P : pred Job) (t1 t2 t : nat), t1 <= t <= t2 -> service_of_jobs sched P (arrivals_between arr_seq t1 t2) t t2 = service_of_jobs sched P (arrivals_between arr_seq t1 t) t t2 + service_of_jobs sched P (arrivals_between arr_seq t t2) t t2
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_cat_arrival_interval
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_case_on_pred
@service_of_jobs_case_on_pred
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (jobs : seq Job) (t1 t2 : instant) (P1 P2 : pred Job), service_of_jobs sched P1 jobs t1 t2 = service_of_jobs sched (fun j : Job => P1 j && P2 j) jobs t1 t2 + service_of_jobs sched (fun j : Job => P1 j && ~~ P2 j) jobs t1 t2
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_case_on_pred
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_negate_pred
@service_of_jobs_negate_pred
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (P : pred Job) (jobs : seq Job) (t1 t2 : instant), service_of_jobs sched P jobs t1 t2 = total_service_of_jobs_in sched jobs t1 t2 - service_of_jobs sched (fun j : Job => ~~ P j) jobs t1 t2
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_negate_pred
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_pred_impl
@service_of_jobs_pred_impl
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (jobs : seq Job) (t1 t2 : instant) (P1 P2 : pred Job), (forall j : Job, j \in jobs -> P1 j -> P2 j) -> service_of_jobs sched P1 jobs t1 t2 <= service_of_jobs sched P2 jobs t1 t2
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_pred_impl
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_equiv_pred
@service_of_jobs_equiv_pred
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (jobs : seq Job) (t1 t2 : instant) (P1 P2 : pred Job), {in jobs, P1 =1 P2} -> service_of_jobs sched P1 jobs t1 t2 = service_of_jobs sched P2 jobs t1 t2
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_equiv_pred
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_sum_over_time_interval
@service_of_jobs_sum_over_time_interval
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (P : pred Job) (jobs : seq Job) (t1 t2 : instant), service_of_jobs sched P jobs t1 t2 = \sum_(t1 <= t < t2) service_of_jobs_at sched P jobs t
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_sum_over_time_interval
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_pred0
@service_of_jobs_pred0
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (jobs : seq Job) (t1 t2 : instant), service_of_jobs sched pred0 jobs t1 t2 = 0
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_pred0
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_nsched_or_unsat
@service_of_jobs_nsched_or_unsat
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (P : pred Job) (jobs : seq Job) (t : instant), (forall j : Job, j \in jobs -> ~~ (P j && scheduled_at sched j t)) -> service_of_jobs_at sched P jobs t = 0
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_nsched_or_unsat
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_geq
@service_of_jobs_geq
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (P : pred Job) (jobs : seq Job) (t1 t2 : instant), t2 <= t1 -> service_of_jobs sched P jobs t1 t2 = 0
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_geq
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_cat_last
@service_of_jobs_cat_last
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (P : pred Job) (js : seq Job) (t1 t2 : nat), t1 <= t2 -> service_of_jobs sched P js t1 t2.+1 = service_of_jobs sched P js t1 t2 + service_of_jobs_at sched P js t2
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_cat_last
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_plus_ahep_eq_service_hep
@service_plus_ahep_eq_service_hep
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_must_arrive_to_execute sched -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall (t1 t2 : instant) (j : Job), arrives_in arr_seq j -> t1 <= job_arrival j -> service_during sched j t1 t2 + service_of_other_hep_jobs arr_seq sched j t1 t2 = service_of_hep_jobs arr_seq sched j t1 t2
END|prosa.analysis.facts.model.service_of_jobs.service_plus_ahep_eq_service_hep
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_le_workload
@service_of_jobs_le_workload
     : forall (Job : JobType) (H1 : JobCost Job) (PState : ProcessorState Job), unit_service_proc_model PState -> forall sched : schedule PState, completed_jobs_dont_execute sched -> forall (P : pred Job) (jobs : seq Job) (t1 t2 : instant), service_of_jobs sched P jobs t1 t2 <= workload_of_jobs P jobs
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_le_workload
BEGIN|prosa.analysis.facts.model.service_of_jobs.workload_eq_service_impl_all_jobs_have_completed
@workload_eq_service_impl_all_jobs_have_completed
     : forall (Job : JobType) (H0 : JobArrival Job) (H1 : JobCost Job) (PState : ProcessorState Job), unit_service_proc_model PState -> forall arr_seq : arrival_sequence Job, consistent_arrival_times arr_seq -> forall sched : schedule PState, jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall (P : pred Job) (t1 t2 t_compl : instant), workload_of_jobs P (arrivals_between arr_seq t1 t2) = service_of_jobs sched P (arrivals_between arr_seq t1 t2) t1 t_compl -> forall j : Job, j \in arrivals_between arr_seq t1 t2 -> P j -> completed_by sched j t_compl
END|prosa.analysis.facts.model.service_of_jobs.workload_eq_service_impl_all_jobs_have_completed
BEGIN|prosa.analysis.facts.model.service_of_jobs.all_jobs_have_completed_impl_workload_eq_service
@all_jobs_have_completed_impl_workload_eq_service
     : forall (Job : JobType) (H0 : JobArrival Job) (H1 : JobCost Job) (PState : ProcessorState Job), unit_service_proc_model PState -> forall arr_seq : arrival_sequence Job, consistent_arrival_times arr_seq -> forall sched : schedule PState, jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall (P : pred Job) (t1 t2 t_compl : instant), (forall j : Job, j \in arrivals_between arr_seq t1 t2 -> P j -> completed_by sched j t_compl) -> workload_of_jobs P (arrivals_between arr_seq t1 t2) = service_of_jobs sched P (arrivals_between arr_seq t1 t2) t1 t_compl
END|prosa.analysis.facts.model.service_of_jobs.all_jobs_have_completed_impl_workload_eq_service
BEGIN|prosa.analysis.facts.model.service_of_jobs.all_jobs_have_completed_equiv_workload_eq_service
@all_jobs_have_completed_equiv_workload_eq_service
     : forall (Job : JobType) (H0 : JobArrival Job) (H1 : JobCost Job) (PState : ProcessorState Job), unit_service_proc_model PState -> forall arr_seq : arrival_sequence Job, consistent_arrival_times arr_seq -> forall sched : schedule PState, jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall (P : pred Job) (t1 t2 t_compl : instant), (forall j : Job, j \in arrivals_between arr_seq t1 t2 -> P j -> completed_by sched j t_compl) <-> workload_of_jobs P (arrivals_between arr_seq t1 t2) = service_of_jobs sched P (arrivals_between arr_seq t1 t2) t1 t_compl
END|prosa.analysis.facts.model.service_of_jobs.all_jobs_have_completed_equiv_workload_eq_service
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_le_1
@service_of_jobs_le_1
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> uniprocessor_model PState -> forall (sched : schedule PState) (P : pred Job) (jobs : seq Job), uniq jobs -> forall t : instant, service_of_jobs_at sched P jobs t <= 1
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_le_1
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_le_length_of_interval
@service_of_jobs_le_length_of_interval
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> uniprocessor_model PState -> forall (sched : schedule PState) (P : pred Job) (jobs : seq Job), uniq jobs -> forall (t : instant) (Δ : duration), service_of_jobs sched P jobs t (t + Δ) <= Δ
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_le_length_of_interval
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_le_length_of_interval'
@service_of_jobs_le_length_of_interval'
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> uniprocessor_model PState -> forall (sched : schedule PState) (P : pred Job) (jobs : seq Job), uniq jobs -> forall t1 t2 : instant, service_of_jobs sched P jobs t1 t2 <= t2 - t1
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_le_length_of_interval'
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_at_scheduled1
@service_of_jobs_at_scheduled1
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> uniprocessor_model PState -> forall (sched : schedule PState) (P : pred Job), ideal_progress_proc_model PState -> forall js : seq Job, uniq js -> forall t : instant, (exists j : Job, j \in js /\ scheduled_at sched j t /\ P j) -> service_of_jobs_at sched P js t = 1
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_at_scheduled1
BEGIN|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_always_scheduled
@service_of_jobs_always_scheduled
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> uniprocessor_model PState -> forall (sched : schedule PState) (P : pred Job), ideal_progress_proc_model PState -> forall js : seq Job, uniq js -> forall t1 t2 : nat, (forall t : nat, t1 <= t < t2 -> exists j : Job, j \in js /\ scheduled_at sched j t /\ P j) -> service_of_jobs sched P js t1 t2 = t2 - t1
END|prosa.analysis.facts.model.service_of_jobs.service_of_jobs_always_scheduled
BEGIN|prosa.analysis.facts.model.service_of_jobs.cumulative_pred_served_eq_service
@cumulative_pred_served_eq_service
     : forall (Job : JobType) (H0 : JobArrival Job) (H1 : JobCost Job) (PState : ProcessorState Job), unit_service_proc_model PState -> uniprocessor_model PState -> forall arr_seq : arrival_sequence Job, consistent_arrival_times arr_seq -> forall sched : schedule PState, jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall P : pred Job, arrival_sequence_uniq arr_seq -> forall (JLFP : JLFP_policy Job) (j : Job) (t1 t : instant), quiet_time arr_seq sched j t1 -> (forall j' : Job, P j' -> hep_job j' j) -> \sum_(t1 <= t' < t) has P (served_jobs_at arr_seq sched t') = service_of_jobs sched P (arrivals_between arr_seq t1 t) t1 t
END|prosa.analysis.facts.model.service_of_jobs.cumulative_pred_served_eq_service
BEGIN|prosa.analysis.facts.model.task_arrivals.num_arrivals_of_task_cat
@num_arrivals_of_task_cat
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (t t1 t2 : nat), t1 <= t <= t2 -> number_of_task_arrivals arr_seq tsk t1 t2 = number_of_task_arrivals arr_seq tsk t1 t + number_of_task_arrivals arr_seq tsk t t2
END|prosa.analysis.facts.model.task_arrivals.num_arrivals_of_task_cat
BEGIN|prosa.analysis.facts.model.task_arrivals.task_arrivals_between_cat
@task_arrivals_between_cat
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (t1 t t2 : nat), t1 <= t -> t <= t2 -> task_arrivals_between arr_seq tsk t1 t2 = task_arrivals_between arr_seq tsk t1 t ++ task_arrivals_between arr_seq tsk t t2
END|prosa.analysis.facts.model.task_arrivals.task_arrivals_between_cat
BEGIN|prosa.analysis.facts.model.task_arrivals.task_arrivals_up_to_prefix_cat
@task_arrivals_up_to_prefix_cat
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (j1 j2 : Job), arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = job_task j2 -> job_arrival j1 <= job_arrival j2 -> prefix_of (task_arrivals_up_to_job_arrival arr_seq j1) (task_arrivals_up_to_job_arrival arr_seq j2)
END|prosa.analysis.facts.model.task_arrivals.task_arrivals_up_to_prefix_cat
BEGIN|prosa.analysis.facts.model.task_arrivals.arrives_in_task_arrivals_up_to
@arrives_in_task_arrivals_up_to
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall j : Job, arrives_in arr_seq j -> j \in task_arrivals_up_to_job_arrival arr_seq j
END|prosa.analysis.facts.model.task_arrivals.arrives_in_task_arrivals_up_to
BEGIN|prosa.analysis.facts.model.task_arrivals.arrives_in_task_arrivals_at
@arrives_in_task_arrivals_at
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall j : Job, arrives_in arr_seq j -> j \in task_arrivals_at_job_arrival arr_seq j
END|prosa.analysis.facts.model.task_arrivals.arrives_in_task_arrivals_at
BEGIN|prosa.analysis.facts.model.task_arrivals.task_arrivals_cat
@task_arrivals_cat
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (t_m t : nat), t_m <= t -> task_arrivals_up_to arr_seq tsk t = task_arrivals_up_to arr_seq tsk t_m ++ task_arrivals_between arr_seq tsk t_m.+1 t.+1
END|prosa.analysis.facts.model.task_arrivals.task_arrivals_cat
BEGIN|prosa.analysis.facts.model.task_arrivals.task_arrivals_up_to_cat
@task_arrivals_up_to_cat
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (j : Job), arrives_in arr_seq j -> task_arrivals_up_to_job_arrival arr_seq j = task_arrivals_before_job_arrival arr_seq j ++ task_arrivals_at_job_arrival arr_seq j
END|prosa.analysis.facts.model.task_arrivals.task_arrivals_up_to_cat
BEGIN|prosa.analysis.facts.model.task_arrivals.job_in_task_arrivals_between
@job_in_task_arrivals_between
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (tsk : Task) (j : Job) (t1 t2 : nat), arrives_in arr_seq j -> job_task j = tsk -> t1 <= job_arrival j < t2 -> j \in task_arrivals_between arr_seq tsk t1 t2
END|prosa.analysis.facts.model.task_arrivals.job_in_task_arrivals_between
BEGIN|prosa.analysis.facts.model.task_arrivals.task_arrivals_between_subset
@task_arrivals_between_subset
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (t1 t2 : instant) (j : Job), j \in task_arrivals_between arr_seq tsk t1 t2 -> j \in arrivals_between arr_seq t1 t2
END|prosa.analysis.facts.model.task_arrivals.task_arrivals_between_subset
BEGIN|prosa.analysis.facts.model.task_arrivals.arrives_in_task_arrivals_implies_arrived
@arrives_in_task_arrivals_implies_arrived
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (t1 t2 : instant) (j : Job), j \in task_arrivals_between arr_seq tsk t1 t2 -> arrives_in arr_seq j
END|prosa.analysis.facts.model.task_arrivals.arrives_in_task_arrivals_implies_arrived
BEGIN|prosa.analysis.facts.model.task_arrivals.arrives_in_task_arrivals_before_implies_arrives_before
@arrives_in_task_arrivals_before_implies_arrives_before
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (tsk : Task) (j : Job) (t : instant), j \in task_arrivals_before arr_seq tsk t -> job_arrival j < t
END|prosa.analysis.facts.model.task_arrivals.arrives_in_task_arrivals_before_implies_arrives_before
BEGIN|prosa.analysis.facts.model.task_arrivals.arrives_in_task_arrivals_implies_job_task
@arrives_in_task_arrivals_implies_job_task
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (j : Job) (t : instant), j \in task_arrivals_before arr_seq tsk t -> job_task j == tsk
END|prosa.analysis.facts.model.task_arrivals.arrives_in_task_arrivals_implies_job_task
BEGIN|prosa.analysis.facts.model.task_arrivals.in_task_arrivals_between_implies_job_of_task
@in_task_arrivals_between_implies_job_of_task
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (t1 t2 : instant) (j : Job), j \in task_arrivals_between arr_seq tsk t1 t2 -> job_task j = tsk
END|prosa.analysis.facts.model.task_arrivals.in_task_arrivals_between_implies_job_of_task
BEGIN|prosa.analysis.facts.model.task_arrivals.task_arrivals_nonempty
@task_arrivals_nonempty
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (t1 t2 : instant) (j : Job), j \in task_arrivals_between arr_seq tsk t1 t2 -> t1 < t2
END|prosa.analysis.facts.model.task_arrivals.task_arrivals_nonempty
BEGIN|prosa.analysis.facts.model.task_arrivals.number_of_task_arrivals_nonzero
@number_of_task_arrivals_nonzero
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (t1 t2 : instant), 0 < number_of_task_arrivals arr_seq tsk t1 t2 -> t1 < t2
END|prosa.analysis.facts.model.task_arrivals.number_of_task_arrivals_nonzero
BEGIN|prosa.analysis.facts.model.task_arrivals.uniq_task_arrivals
@uniq_task_arrivals
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (tsk : Task) (t : instant), arrival_sequence_uniq arr_seq -> uniq (task_arrivals_up_to arr_seq tsk t)
END|prosa.analysis.facts.model.task_arrivals.uniq_task_arrivals
BEGIN|prosa.analysis.facts.model.task_arrivals.task_arrivals_between_uniq
@task_arrivals_between_uniq
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (tsk : Task) (t1 t2 : instant), arrival_sequence_uniq arr_seq -> uniq (task_arrivals_between arr_seq tsk t1 t2)
END|prosa.analysis.facts.model.task_arrivals.task_arrivals_between_uniq
BEGIN|prosa.analysis.facts.model.task_arrivals.job_notin_task_arrivals_before
@job_notin_task_arrivals_before
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t : nat), arrives_in arr_seq j -> t < job_arrival j -> j \notin task_arrivals_up_to arr_seq (job_task j) t
END|prosa.analysis.facts.model.task_arrivals.job_notin_task_arrivals_before
BEGIN|prosa.analysis.facts.model.task_arrivals.arrival_lt_implies_strict_prefix
@arrival_lt_implies_strict_prefix
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (tsk : Task) (j1 j2 : Job), job_task j1 = tsk -> job_task j2 = tsk -> arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_arrival j1 < job_arrival j2 -> strict_prefix_of (task_arrivals_up_to_job_arrival arr_seq j1) (task_arrivals_up_to_job_arrival arr_seq j2)
END|prosa.analysis.facts.model.task_arrivals.arrival_lt_implies_strict_prefix
BEGIN|prosa.analysis.facts.model.task_arrivals.nth_job_of_task_arrivals
@nth_job_of_task_arrivals
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (tsk : Task) (n : nat) (j_def j : Job) (t : nat), arrives_in arr_seq j -> job_task j = tsk -> job_index arr_seq j = n -> job_arrival j <= t -> nth j_def (task_arrivals_up_to arr_seq tsk t) n = j
END|prosa.analysis.facts.model.task_arrivals.nth_job_of_task_arrivals
BEGIN|prosa.analysis.facts.model.task_arrivals.task_arrivals_between_is_cat_of_task_arrivals_at
@task_arrivals_between_is_cat_of_task_arrivals_at
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (t1 t2 : instant), task_arrivals_between arr_seq tsk t1 t2 = \cat_(t1<=t<t2)task_arrivals_at arr_seq tsk t
END|prosa.analysis.facts.model.task_arrivals.task_arrivals_between_is_cat_of_task_arrivals_at
BEGIN|prosa.analysis.facts.model.task_arrivals.size_of_task_arrivals_between
@size_of_task_arrivals_between
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (arr_seq : arrival_sequence Job) (tsk : Task) (t1 t2 : instant), size (task_arrivals_between arr_seq tsk t1 t2) = \sum_(t1 <= t < t2) size (task_arrivals_at arr_seq tsk t)
END|prosa.analysis.facts.model.task_arrivals.size_of_task_arrivals_between
BEGIN|prosa.analysis.facts.model.task_arrivals.task_arrivals_between_sorted
@task_arrivals_between_sorted
     : forall (Job : JobType) (Task : TaskType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (tsk : Task) (t1 t2 : instant), sorted by_arrival_times (task_arrivals_between arr_seq tsk t1 t2)
END|prosa.analysis.facts.model.task_arrivals.task_arrivals_between_sorted
BEGIN|prosa.analysis.facts.model.task_cost.job_cost_positive_implies_task_cost_positive
@job_cost_positive_implies_task_cost_positive
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobCost Job) (H1 : TaskCost Task) (tsk : Task) (j : Job), job_of_task tsk j -> job_cost_positive j -> valid_job_cost j -> 0 < task_cost tsk
END|prosa.analysis.facts.model.task_cost.job_cost_positive_implies_task_cost_positive
BEGIN|prosa.analysis.facts.model.task_cost.sum_job_costs_bounded
@sum_job_costs_bounded
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobCost Job) (H1 : JobTask Job Task) (tsk : Task) (js : seq Job), {in js, forall j : Job, job_of_task tsk j && valid_job_cost j} -> \sum_(j <- js) job_cost j <= task_cost tsk * size js
END|prosa.analysis.facts.model.task_cost.sum_job_costs_bounded
BEGIN|prosa.analysis.facts.model.task_schedule.task_served_task_scheduled
@task_served_task_scheduled
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (arr_seq : arrival_sequence Job) (PState : ProcessorState Job) (sched : schedule PState) (tsk : Task) (t : instant), task_served_at arr_seq sched tsk t -> task_scheduled_at arr_seq sched tsk t
END|prosa.analysis.facts.model.task_schedule.task_served_task_scheduled
BEGIN|prosa.analysis.facts.model.task_schedule.task_served_eq_task_scheduled
@task_served_eq_task_scheduled
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (PState : ProcessorState Job) (sched : schedule PState), jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall tsk : Task, ideal_progress_proc_model PState -> forall t : instant, task_served_at arr_seq sched tsk t = task_scheduled_at arr_seq sched tsk t
END|prosa.analysis.facts.model.task_schedule.task_served_eq_task_scheduled
BEGIN|prosa.analysis.facts.model.task_schedule.no_task_scheduled_when_idle
@no_task_scheduled_when_idle
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (PState : ProcessorState Job) (sched : schedule PState), jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (tsk : Task) (t : instant), is_idle arr_seq sched t -> ~~ task_scheduled_at arr_seq sched tsk t
END|prosa.analysis.facts.model.task_schedule.no_task_scheduled_when_idle
BEGIN|prosa.analysis.facts.model.task_schedule.no_task_served_when_idle
@no_task_served_when_idle
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (PState : ProcessorState Job) (sched : schedule PState), jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (tsk : Task) (t : instant), is_idle arr_seq sched t -> ~~ task_served_at arr_seq sched tsk t
END|prosa.analysis.facts.model.task_schedule.no_task_served_when_idle
BEGIN|prosa.analysis.facts.model.task_schedule.job_of_scheduled_task
@job_of_scheduled_task
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (tsk : Task) (j : Job) (t : instant), scheduled_at sched j t -> task_scheduled_at arr_seq sched tsk t = job_of_task tsk j
END|prosa.analysis.facts.model.task_schedule.job_of_scheduled_task
BEGIN|prosa.analysis.facts.model.task_schedule.job_of_task_scheduled
@job_of_task_scheduled
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (tsk : Task) (j : Job) (t : instant), job_of_task tsk j -> scheduled_at sched j t -> task_scheduled_at arr_seq sched tsk t
END|prosa.analysis.facts.model.task_schedule.job_of_task_scheduled
BEGIN|prosa.analysis.facts.model.task_schedule.job_of_other_task_scheduled
@job_of_other_task_scheduled
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (tsk : Task) (j : Job) (t : instant), ~~ job_of_task tsk j -> scheduled_at sched j t -> ~~ task_scheduled_at arr_seq sched tsk t
END|prosa.analysis.facts.model.task_schedule.job_of_other_task_scheduled
BEGIN|prosa.analysis.facts.model.task_schedule.job_of_other_task_scheduled'
@job_of_other_task_scheduled'
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (tsk : Task) (j : Job) (t : instant), ~~ job_of_task tsk j -> scheduled_at sched j t -> ~~ task_served_at arr_seq sched tsk t
END|prosa.analysis.facts.model.task_schedule.job_of_other_task_scheduled'
BEGIN|prosa.analysis.facts.model.task_schedule.job_of_task_not_served
@job_of_task_not_served
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (tsk : Task) (j : Job) (t : instant), scheduled_at sched j t -> job_of_task tsk j -> service_at sched j t = 0 -> ~~ task_served_at arr_seq sched tsk t
END|prosa.analysis.facts.model.task_schedule.job_of_task_not_served
BEGIN|prosa.analysis.facts.model.task_schedule.task_served_at_eq_job_of_task
@task_served_at_eq_job_of_task
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall tsk : Task, fully_consuming_proc_model PState -> forall t : instant, has_supply sched t -> forall j : Job, scheduled_at sched j t -> task_served_at arr_seq sched tsk t = job_of_task tsk j
END|prosa.analysis.facts.model.task_schedule.task_served_at_eq_job_of_task
BEGIN|prosa.analysis.facts.model.uniprocessor.scheduled_job_at_neq
@scheduled_job_at_neq
     : forall (Job : JobType) (PState : ProcessorState Job), uniprocessor_model PState -> forall (sched : schedule PState) (j j' : Job) (t : instant), j != j' -> scheduled_at sched j t -> ~~ scheduled_at sched j' t
END|prosa.analysis.facts.model.uniprocessor.scheduled_job_at_neq
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs_filter
@workload_of_jobs_filter
     : forall (Job : JobType) (H2 : JobCost Job) (P1 P2 : pred Job) (jobs : seq Job), (forall j : Job, j \in jobs -> P1 j -> P2 j) -> workload_of_jobs P1 jobs = workload_of_jobs P1 [seq j <- jobs | P2 j]
END|prosa.analysis.facts.model.workload.workload_of_jobs_filter
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs_weaken
@workload_of_jobs_weaken
     : forall (Job : JobType) (H2 : JobCost Job) (P1 P2 : pred Job) (jobs : seq Job), (forall j : Job, P1 j -> P2 j) -> workload_of_jobs P1 jobs <= workload_of_jobs P2 jobs
END|prosa.analysis.facts.model.workload.workload_of_jobs_weaken
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs0
@workload_of_jobs0
     : forall (Job : JobType) (H2 : JobCost Job) (P : pred Job), workload_of_jobs P [::] = 0
END|prosa.analysis.facts.model.workload.workload_of_jobs0
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs_le_sum_over_partitions
@workload_of_jobs_le_sum_over_partitions
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H2 : JobCost Job) (P : pred Job) (Q : pred Task) (js : seq Job) (ts : seq Task), {in js, forall j : Job, job_task j \in ts} -> {in js, forall j : Job, P j -> Q (job_task j)} -> let P_and_job_of := fun (tsk_o : Task) (j : Job) => P j && (job_task j == tsk_o) in workload_of_jobs P js <= \sum_(tsk_o <- ts | Q tsk_o) workload_of_jobs (P_and_job_of tsk_o) js
END|prosa.analysis.facts.model.workload.workload_of_jobs_le_sum_over_partitions
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs_partitioned_by_tasks
@workload_of_jobs_partitioned_by_tasks
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H2 : JobCost Job) (P : pred Job) (Q : pred Task) (js : seq Job) (ts : seq Task), {in js, forall j : Job, job_task j \in ts} -> {in js, forall j : Job, P j -> Q (job_task j)} -> uniq js -> uniq ts -> let P_and_job_of := fun (tsk_o : Task) (j : Job) => P j && (job_task j == tsk_o) in workload_of_jobs P js = \sum_(tsk_o <- ts | Q tsk_o) workload_of_jobs (P_and_job_of tsk_o) js
END|prosa.analysis.facts.model.workload.workload_of_jobs_partitioned_by_tasks
BEGIN|prosa.analysis.facts.model.workload.workload_of_other_jobs_split
@workload_of_other_jobs_split
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H2 : JobCost Job) (H3 : JLFP_policy Job) (jobs : seq Job) (j : Job), workload_of_jobs (another_hep_job^~ j) jobs = workload_of_jobs (another_task_hep_job^~ j) jobs + workload_of_jobs (another_hep_job_of_same_task^~ j) jobs
END|prosa.analysis.facts.model.workload.workload_of_other_jobs_split
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs_pred0
@workload_of_jobs_pred0
     : forall (Job : JobType) (H2 : JobCost Job) (jobs : seq Job), workload_of_jobs pred0 jobs = 0
END|prosa.analysis.facts.model.workload.workload_of_jobs_pred0
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs_case_on_pred
@workload_of_jobs_case_on_pred
     : forall (Job : JobType) (H2 : JobCost Job) (jobs : seq Job) (P P' : pred Job), workload_of_jobs P jobs = workload_of_jobs (fun j : Job => P j && P' j) jobs + workload_of_jobs (fun j : Job => P j && ~~ P' j) jobs
END|prosa.analysis.facts.model.workload.workload_of_jobs_case_on_pred
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs_equiv_pred
@workload_of_jobs_equiv_pred
     : forall (Job : JobType) (H2 : JobCost Job) (jobs : seq Job) (P P' : pred Job), {in jobs, P =1 P'} -> workload_of_jobs P jobs = workload_of_jobs P' jobs
END|prosa.analysis.facts.model.workload.workload_of_jobs_equiv_pred
BEGIN|prosa.analysis.facts.model.workload.workload_of_job_eq_job_arrival
@workload_of_job_eq_job_arrival
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> arrival_sequence_uniq arr_seq -> forall (j : Job) (t1 t2 : instant), arrives_in arr_seq j -> workload_of_job arr_seq j t1 t2 = (if t1 <= job_arrival j < t2 then job_cost j else 0)
END|prosa.analysis.facts.model.workload.workload_of_job_eq_job_arrival
BEGIN|prosa.analysis.facts.model.workload.workload_job_and_ahep_eq_workload_hep
@workload_job_and_ahep_eq_workload_hep
     : forall (Job : JobType) (H2 : JobCost Job) (arr_seq : arrival_sequence Job) (JLFP : JLFP_policy Job), reflexive_job_priorities JLFP -> forall (j : Job) (t1 t2 : instant), workload_of_job arr_seq j t1 t2 + workload_of_other_hep_jobs arr_seq j t1 t2 = workload_of_hep_jobs arr_seq j t1 t2
END|prosa.analysis.facts.model.workload.workload_job_and_ahep_eq_workload_hep
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs_nil_tail
@workload_of_jobs_nil_tail
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (P : Job -> bool) (t1 : instant) (t2 t : nat), t <= t2 -> (forall j : Job, j \in arrivals_between arr_seq t1 t2 -> t <= job_arrival j -> ~~ P j) -> workload_of_jobs P (arrivals_between arr_seq t1 t2) = workload_of_jobs P (arrivals_between arr_seq t1 t)
END|prosa.analysis.facts.model.workload.workload_of_jobs_nil_tail
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs_cat
@workload_of_jobs_cat
     : forall (Job : JobType) (H2 : JobCost Job) (arr_seq : arrival_sequence Job) (t t1 t2 : nat) (P : pred Job), t1 <= t <= t2 -> workload_of_jobs P (arrivals_between arr_seq t1 t2) = workload_of_jobs P (arrivals_between arr_seq t1 t) + workload_of_jobs P (arrivals_between arr_seq t t2)
END|prosa.analysis.facts.model.workload.workload_of_jobs_cat
BEGIN|prosa.analysis.facts.model.workload.workload_of_jobs_reduce_range
@workload_of_jobs_reduce_range
     : forall (Job : JobType) (H2 : JobCost Job) (arr_seq : arrival_sequence Job) (t1 t2 t3 : nat) (P : pred Job), t1 <= t2 -> t2 <= t3 -> workload_of_jobs P (arrivals_between arr_seq t1 t2) <= workload_of_jobs P (arrivals_between arr_seq t1 t3)
END|prosa.analysis.facts.model.workload.workload_of_jobs_reduce_range
BEGIN|prosa.analysis.facts.model.workload.workload_minus_job_cost'
@workload_minus_job_cost'
     : forall (Job : JobType) (H2 : JobCost Job) (j : Job) (jobs : seq Job), uniq jobs -> j \in jobs -> forall P : Job -> bool, workload_of_jobs (fun jhp : Job => P jhp && (jhp != j)) jobs = workload_of_jobs P jobs - (if P j then job_cost j else 0)
END|prosa.analysis.facts.model.workload.workload_minus_job_cost'
BEGIN|prosa.analysis.facts.model.workload.workload_minus_job_cost
@workload_minus_job_cost
     : forall (Job : JobType) (H2 : JobCost Job) (j : Job) (jobs : seq Job), uniq jobs -> j \in jobs -> workload_of_jobs (fun jhp : Job => jhp != j) jobs = workload_of_jobs predT jobs - job_cost j
END|prosa.analysis.facts.model.workload.workload_minus_job_cost
BEGIN|prosa.analysis.facts.model.workload.workload_equal_subset
@workload_equal_subset
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> valid_arrival_sequence arr_seq -> forall (t1 t2 t : instant) (P : pred Job), workload_of_jobs (fun j : Job => (job_arrival j <= t) && P j) (arrivals_between arr_seq t1 t2) <= workload_of_jobs [eta P] (arrivals_between arr_seq t1 (t + 1))
END|prosa.analysis.facts.model.workload.workload_equal_subset
BEGIN|prosa.analysis.facts.periodic.arrival_separation.consecutive_job_separation
@consecutive_job_separation
     : forall (Task : TaskType) (H : PeriodicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_periodic_task_model arr_seq tsk -> valid_period tsk -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = tsk -> job_task j2 = tsk -> job_index arr_seq j2 = job_index arr_seq j1 + 1 -> job_arrival j2 = job_arrival j1 + task_period tsk
END|prosa.analysis.facts.periodic.arrival_separation.consecutive_job_separation
BEGIN|prosa.analysis.facts.periodic.arrival_separation.job_arrival_separation_when_index_diff_is_k
@job_arrival_separation_when_index_diff_is_k
     : forall (Task : TaskType) (H : PeriodicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_periodic_task_model arr_seq tsk -> valid_period tsk -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = tsk -> job_task j2 = tsk -> forall k : nat, job_index arr_seq j1 + k = job_index arr_seq j2 -> job_arrival j1 < job_arrival j2 -> exists n : nat, 0 < n /\ job_arrival j2 = job_arrival j1 + n * task_period tsk
END|prosa.analysis.facts.periodic.arrival_separation.job_arrival_separation_when_index_diff_is_k
BEGIN|prosa.analysis.facts.periodic.arrival_separation.job_sep_periodic
@job_sep_periodic
     : forall (Task : TaskType) (H : PeriodicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_periodic_task_model arr_seq tsk -> valid_period tsk -> forall j1 j2 : Job, j1 <> j2 -> arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = tsk -> job_task j2 = tsk -> job_arrival j1 <= job_arrival j2 -> exists n : nat, 0 < n /\ job_arrival j2 = job_arrival j1 + n * task_period tsk
END|prosa.analysis.facts.periodic.arrival_separation.job_sep_periodic
BEGIN|prosa.analysis.facts.periodic.arrival_times.periodic_arrival_times
@periodic_arrival_times
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> forall (n : nat) (j : Job), arrives_in arr_seq j -> job_task j = tsk -> job_index arr_seq j = n -> job_arrival j = task_offset tsk + n * task_period tsk
END|prosa.analysis.facts.periodic.arrival_times.periodic_arrival_times
BEGIN|prosa.analysis.facts.periodic.arrival_times.job_arrival_times
@job_arrival_times
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> forall j : Job, arrives_in arr_seq j -> job_task j = tsk -> exists n : nat, job_arrival j = task_offset tsk + n * task_period tsk
END|prosa.analysis.facts.periodic.arrival_times.job_arrival_times
BEGIN|prosa.analysis.facts.periodic.arrival_times.job_arr_index
@job_arr_index
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> forall (n : nat) (j : Job), arrives_in arr_seq j -> job_task j = tsk -> job_arrival j = task_offset tsk + n * task_period tsk -> job_index arr_seq j = n
END|prosa.analysis.facts.periodic.arrival_times.job_arr_index
BEGIN|prosa.analysis.facts.periodic.max_inter_arrival.max_inter_eq_period
@max_inter_eq_period
     : forall Task : TaskType, PeriodicModel Task -> TaskMaxInterArrival Task
END|prosa.analysis.facts.periodic.max_inter_arrival.max_inter_eq_period
BEGIN|prosa.analysis.facts.periodic.max_inter_arrival.valid_period_is_valid_max_inter_arrival_time
@valid_period_is_valid_max_inter_arrival_time
     : forall (Task : TaskType) (H : PeriodicModel Task) (tsk : Task), valid_period tsk -> positive_task_max_inter_arrival_time tsk
END|prosa.analysis.facts.periodic.max_inter_arrival.valid_period_is_valid_max_inter_arrival_time
BEGIN|prosa.analysis.facts.periodic.max_inter_arrival.periodic_model_respects_max_inter_arrival_model
@periodic_model_respects_max_inter_arrival_model
     : forall (Task : TaskType) (H : PeriodicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (tsk : Task), valid_period tsk -> respects_periodic_task_model arr_seq tsk -> valid_task_max_inter_arrival_time arr_seq tsk
END|prosa.analysis.facts.periodic.max_inter_arrival.periodic_model_respects_max_inter_arrival_model
BEGIN|prosa.analysis.facts.periodic.task_arrivals_size.task_arrivals_size_at_non_arrival
@task_arrivals_size_at_non_arrival
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> forall t : nat, (forall n : nat, t <> task_offset tsk + n * task_period tsk) -> task_arrivals_at arr_seq tsk t = [::]
END|prosa.analysis.facts.periodic.task_arrivals_size.task_arrivals_size_at_non_arrival
BEGIN|prosa.analysis.facts.periodic.task_arrivals_size.task_arrivals_at_size_cases
@task_arrivals_at_size_cases
     : forall (Task : TaskType) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_period tsk -> respects_periodic_task_model arr_seq tsk -> forall t : instant, size (task_arrivals_at arr_seq tsk t) = 0 \/ size (task_arrivals_at arr_seq tsk t) = 1
END|prosa.analysis.facts.periodic.task_arrivals_size.task_arrivals_at_size_cases
BEGIN|prosa.analysis.facts.periodic.task_arrivals_size.size_task_arrivals_between_eq0
@size_task_arrivals_between_eq0
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> forall n : nat, let l := (task_offset tsk + n * task_period tsk).+1 in let r := task_offset tsk + n.+1 * task_period tsk in size (task_arrivals_between arr_seq tsk l r) = 0
END|prosa.analysis.facts.periodic.task_arrivals_size.size_task_arrivals_between_eq0
BEGIN|prosa.analysis.facts.periodic.task_arrivals_size.jobs_exists_later
@jobs_exists_later
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> infinite_jobs arr_seq -> forall n : nat, exists j : Job, arrives_in arr_seq j /\ job_task j = tsk /\ job_arrival j = task_offset tsk + n * task_period tsk /\ job_index arr_seq j = n
END|prosa.analysis.facts.periodic.task_arrivals_size.jobs_exists_later
BEGIN|prosa.analysis.facts.periodic.task_arrivals_size.task_arrivals_at_size
@task_arrivals_at_size
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> infinite_jobs arr_seq -> forall n : nat, let l := task_offset tsk + n * task_period tsk in size (task_arrivals_at arr_seq tsk l) = 1
END|prosa.analysis.facts.periodic.task_arrivals_size.task_arrivals_at_size
BEGIN|prosa.analysis.facts.periodic.task_arrivals_size.size_task_arrivals_up_to_offset
@size_task_arrivals_up_to_offset
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> infinite_jobs arr_seq -> size (task_arrivals_up_to arr_seq tsk (task_offset tsk)) = 1
END|prosa.analysis.facts.periodic.task_arrivals_size.size_task_arrivals_up_to_offset
BEGIN|prosa.analysis.facts.periodic.task_arrivals_size.task_arrivals_up_to_size
@task_arrivals_up_to_size
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> infinite_jobs arr_seq -> forall n : nat, let l := task_offset tsk + n * task_period tsk in let r := task_offset tsk + n.+1 * task_period tsk in size (task_arrivals_up_to arr_seq tsk l) = n + 1
END|prosa.analysis.facts.periodic.task_arrivals_size.task_arrivals_up_to_size
BEGIN|prosa.analysis.facts.periodic.task_arrivals_size.eq_size_of_task_arrivals_seperated_by_period
@eq_size_of_task_arrivals_seperated_by_period
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> infinite_jobs arr_seq -> forall n t : nat, task_offset tsk <= t -> size (task_arrivals_at arr_seq tsk t) = size (task_arrivals_at arr_seq tsk (t + n * task_period tsk))
END|prosa.analysis.facts.periodic.task_arrivals_size.eq_size_of_task_arrivals_seperated_by_period
BEGIN|prosa.analysis.facts.preemption.job.limited.zero_in_preemption_points
@limited.zero_in_preemption_points
     : forall (Job : JobType) (H2 : JobCost Job) (H3 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job), valid_limited_preemptions_job_model arr_seq -> forall j : Job, arrives_in arr_seq j -> 0 \in job_preemptive_points j
END|prosa.analysis.facts.preemption.job.limited.zero_in_preemption_points
BEGIN|prosa.analysis.facts.preemption.job.limited.zero_is_first_element
@zero_is_first_element
     : forall (Job : JobType) (H2 : JobCost Job) (H3 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job), valid_limited_preemptions_job_model arr_seq -> forall j : Job, arrives_in arr_seq j -> first0 (job_preemptive_points j) = 0
END|prosa.analysis.facts.preemption.job.limited.zero_is_first_element
BEGIN|prosa.analysis.facts.preemption.job.limited.list_of_preemption_point_is_not_empty
@list_of_preemption_point_is_not_empty
     : forall (Job : JobType) (H2 : JobCost Job) (H3 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job), valid_limited_preemptions_job_model arr_seq -> forall j : Job, arrives_in arr_seq j -> 0 < size (job_preemptive_points j)
END|prosa.analysis.facts.preemption.job.limited.list_of_preemption_point_is_not_empty
BEGIN|prosa.analysis.facts.preemption.job.limited.job_cost_in_nonpreemptive_points
@job_cost_in_nonpreemptive_points
     : forall (Job : JobType) (H2 : JobCost Job) (H3 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job), valid_limited_preemptions_job_model arr_seq -> forall j : Job, arrives_in arr_seq j -> job_cost j \in job_preemptive_points j
END|prosa.analysis.facts.preemption.job.limited.job_cost_in_nonpreemptive_points
BEGIN|prosa.analysis.facts.preemption.job.limited.number_of_preemption_points_at_least_two
@number_of_preemption_points_at_least_two
     : forall (Job : JobType) (H2 : JobCost Job) (H3 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job), valid_limited_preemptions_job_model arr_seq -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> 1 < size (job_preemptive_points j)
END|prosa.analysis.facts.preemption.job.limited.number_of_preemption_points_at_least_two
BEGIN|prosa.analysis.facts.preemption.job.limited.antidensity_of_preemption_points
@antidensity_of_preemption_points
     : forall (Job : JobType) (H2 : JobCost Job) (H3 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job), valid_limited_preemptions_job_model arr_seq -> forall j : Job, arrives_in arr_seq j -> forall ρ : work, ρ <= job_cost j -> ρ \notin job_preemptive_points j -> first0 (job_preemptive_points j) <= ρ < last0 (job_preemptive_points j)
END|prosa.analysis.facts.preemption.job.limited.antidensity_of_preemption_points
BEGIN|prosa.analysis.facts.preemption.job.limited.work_belongs_to_some_nonpreemptive_segment
@work_belongs_to_some_nonpreemptive_segment
     : forall (Job : JobType) (H2 : JobCost Job) (H3 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job), valid_limited_preemptions_job_model arr_seq -> forall j : Job, arrives_in arr_seq j -> forall ρ : work, ρ <= job_cost j -> ρ \notin job_preemptive_points j -> exists n : nat, n.+1 < size (job_preemptive_points j) /\ nth 0 (job_preemptive_points j) n < ρ < nth 0 (job_preemptive_points j) n.+1
END|prosa.analysis.facts.preemption.job.limited.work_belongs_to_some_nonpreemptive_segment
BEGIN|prosa.analysis.facts.preemption.job.limited.job_parameters_last_np_to_job_limited
@job_parameters_last_np_to_job_limited
     : forall (Job : JobType) (H2 : JobCost Job) (H3 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job), valid_limited_preemptions_job_model arr_seq -> forall j : Job, arrives_in arr_seq j -> last0 (distances (job_preemption_points j)) = last0 [seq x <- distances (job_preemptive_points j) | 0 < x]
END|prosa.analysis.facts.preemption.job.limited.job_parameters_last_np_to_job_limited
BEGIN|prosa.analysis.facts.preemption.job.limited.job_parameters_max_np_to_job_limited
@job_parameters_max_np_to_job_limited
     : forall (Job : JobType) (H2 : JobCost Job) (H3 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job), valid_limited_preemptions_job_model arr_seq -> forall j : Job, arrives_in arr_seq j -> max0 (distances (job_preemption_points j)) = max0 (distances (job_preemptive_points j))
END|prosa.analysis.facts.preemption.job.limited.job_parameters_max_np_to_job_limited
BEGIN|prosa.analysis.facts.preemption.job.limited.valid_fixed_preemption_points_model_lemma
@valid_fixed_preemption_points_model_lemma
     : forall (Job : JobType) (H2 : JobCost Job) (H3 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job) (PState : ProcessorState Job) (sched : schedule PState), schedule_respects_preemption_model arr_seq sched -> valid_limited_preemptions_job_model arr_seq -> valid_preemption_model arr_seq sched
END|prosa.analysis.facts.preemption.job.limited.valid_fixed_preemption_points_model_lemma
BEGIN|prosa.analysis.facts.preemption.job.nonpreemptive.valid_fully_nonpreemptive_model
@valid_fully_nonpreemptive_model
     : forall (Job : JobType) (H0 : JobCost Job) (arr_seq : arrival_sequence Job) (PState : ProcessorState Job), unit_service_proc_model PState -> forall sched : schedule PState, nonpreemptive_schedule sched -> completed_jobs_dont_execute sched -> valid_preemption_model arr_seq sched
END|prosa.analysis.facts.preemption.job.nonpreemptive.valid_fully_nonpreemptive_model
