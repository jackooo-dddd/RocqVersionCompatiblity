BEGIN|prosa.results.rta.ideal.fp.bounded_pi.instantiated_task_interference_is_bounded
@instantiated_task_interference_is_bounded
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H1 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (FP : FP_policy Task), reflexive_task_priorities FP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule (ideal.processor_state Job)) (JobReady0 : JobReady Job (ideal.processor_state Job)), valid_schedule sched arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> forall H3 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall (tsk : Task) (priority_inversion_bound : duration), priority_inversion_is_bounded_by arr_seq sched tsk (constant priority_inversion_bound) -> task_interference_is_bounded_by arr_seq sched tsk (fun=> (fun R : duration => priority_inversion_bound + total_ohep_request_bound_function_FP ts tsk R))
