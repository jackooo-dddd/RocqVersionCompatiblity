BEGIN|prosa.analysis.facts.delay_propagation.propagated_arrival_sequence_uniq
@propagated_arrival_sequence_uniq
     : forall (Task2 : TaskType) (Job1 Job2 : JobType) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2) (arr_seq1 : arrival_sequence Job1), valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> valid_arrival_sequence arr_seq1 -> arrival_sequence_uniq (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay)
END|prosa.analysis.facts.delay_propagation.propagated_arrival_sequence_uniq
BEGIN|prosa.analysis.facts.delay_propagation.valid_propagated_arrival_sequence
@valid_propagated_arrival_sequence
     : forall (Task2 : TaskType) (Job1 Job2 : JobType) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2) (arr_seq1 : arrival_sequence Job1), valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> valid_arrival_sequence arr_seq1 -> valid_arrival_sequence (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay)
END|prosa.analysis.facts.delay_propagation.valid_propagated_arrival_sequence
BEGIN|prosa.analysis.facts.delay_propagation.arrives_in_propagated_if
@arrives_in_propagated_if
     : forall (Task2 : TaskType) (Job1 Job2 : JobType) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2) (arr_seq1 : arrival_sequence Job1), valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> forall j2 : Job2, consistent_arrival_times arr_seq1 -> arrives_in arr_seq1 (job1_of j2) -> arrives_in (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay) j2
END|prosa.analysis.facts.delay_propagation.arrives_in_propagated_if
BEGIN|prosa.analysis.facts.delay_propagation.arrives_in_propagated_only_if
@arrives_in_propagated_only_if
     : forall (Task2 : TaskType) (Job1 Job2 : JobType) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2) (arr_seq1 : arrival_sequence Job1), valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> forall j2 : Job2, arrives_in (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay) j2 -> arrives_in arr_seq1 (job1_of j2)
END|prosa.analysis.facts.delay_propagation.arrives_in_propagated_only_if
BEGIN|prosa.analysis.facts.delay_propagation.propagated_arrival_curve_valid
@propagated_arrival_curve_valid
     : forall (Task1 Task2 : TaskType) (task1_of : Task2 -> Task1) (delay_bound : Task2 -> duration) (ts2 : seq Task2) (max_arrivals1 : MaxArrivals Task1), (forall tsk2 : Task2, tsk2 \in ts2 -> monotone leq (max_arrivals (task1_of tsk2))) -> valid_taskset_arrival_curve ts2 (max_arrivals2 task1_of delay_bound)
END|prosa.analysis.facts.delay_propagation.propagated_arrival_curve_valid
BEGIN|prosa.analysis.facts.delay_propagation.trigger_job_arrival_bounded
@trigger_job_arrival_bounded
     : forall (Task2 : TaskType) (Job1 Job2 : JobType) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2) (arr_seq1 : arrival_sequence Job1), valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> forall t1 t2 : instant, t1 <= t2 -> forall tsk2 : Task2, tsk2 \in ts2 -> forall j1 : Job1, j1 \in [seq job1_of j2 | j2 <- task_arrivals_between (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay) tsk2 t1 t2] -> t1 - delay_bound tsk2 <= job_arrival j1 < t2
END|prosa.analysis.facts.delay_propagation.trigger_job_arrival_bounded
BEGIN|prosa.analysis.facts.delay_propagation.subset_trigger_jobs
@subset_trigger_jobs
     : forall (Task1 Task2 : TaskType) (Job1 Job2 : JobType) (H : JobTask Job1 Task1) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (task1_of : Task2 -> Task1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2), valid_delay_propagation_mapping JA1 JA2 job1_of task1_of delay_bound ts2 -> forall arr_seq1 : arrival_sequence Job1, valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> valid_arrival_sequence arr_seq1 -> forall t1 t2 : instant, t1 <= t2 -> forall tsk2 : Task2, tsk2 \in ts2 -> {subset [seq job1_of j2 | j2 <- task_arrivals_between (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay) tsk2 t1 t2] <= task_arrivals_between arr_seq1 (task1_of tsk2) (t1 - delay_bound tsk2) t2}
END|prosa.analysis.facts.delay_propagation.subset_trigger_jobs
BEGIN|prosa.analysis.facts.delay_propagation.job1_of_inj
@job1_of_inj
     : forall (Task1 Task2 : TaskType) (Job1 Job2 : JobType) (H : JobTask Job1 Task1) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (task1_of : Task2 -> Task1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2), valid_delay_propagation_mapping JA1 JA2 job1_of task1_of delay_bound ts2 -> forall arr_seq1 : arrival_sequence Job1, valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> (forall tsk1 : Task1, tsk1 \in [seq task1_of tsk2 | tsk2 <- ts2] -> forall j1 : Job1, job_task j1 = tsk1 -> size (job2_of j1) <= 1) -> forall (t1 t2 : instant) (tsk2 : Task2), tsk2 \in ts2 -> {in task_arrivals_between (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay) tsk2 t1 t2 &, injective [eta job1_of]}
END|prosa.analysis.facts.delay_propagation.job1_of_inj
BEGIN|prosa.analysis.facts.delay_propagation.uniq_trigger_jobs
@uniq_trigger_jobs
     : forall (Task1 Task2 : TaskType) (Job1 Job2 : JobType) (H : JobTask Job1 Task1) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (task1_of : Task2 -> Task1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2), valid_delay_propagation_mapping JA1 JA2 job1_of task1_of delay_bound ts2 -> forall arr_seq1 : arrival_sequence Job1, valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> (forall tsk1 : Task1, tsk1 \in [seq task1_of tsk2 | tsk2 <- ts2] -> forall j1 : Job1, job_task j1 = tsk1 -> size (job2_of j1) <= 1) -> valid_arrival_sequence arr_seq1 -> forall (t1 t2 : instant) (tsk2 : Task2), tsk2 \in ts2 -> uniq [seq job1_of j2 | j2 <- task_arrivals_between (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay) tsk2 t1 t2]
END|prosa.analysis.facts.delay_propagation.uniq_trigger_jobs
BEGIN|prosa.analysis.facts.delay_propagation.trigger_job_size
@trigger_job_size
     : forall (Task1 Task2 : TaskType) (Job1 Job2 : JobType) (H : JobTask Job1 Task1) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (task1_of : Task2 -> Task1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2), valid_delay_propagation_mapping JA1 JA2 job1_of task1_of delay_bound ts2 -> forall arr_seq1 : arrival_sequence Job1, valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> (forall tsk1 : Task1, tsk1 \in [seq task1_of tsk2 | tsk2 <- ts2] -> forall j1 : Job1, job_task j1 = tsk1 -> size (job2_of j1) <= 1) -> valid_arrival_sequence arr_seq1 -> forall t1 t2 : instant, t1 <= t2 -> forall tsk2 : Task2, tsk2 \in ts2 -> size [seq job1_of j2 | j2 <- task_arrivals_between (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay) tsk2 t1 t2] <= size (task_arrivals_between arr_seq1 (task1_of tsk2) (t1 - delay_bound tsk2) t2)
END|prosa.analysis.facts.delay_propagation.trigger_job_size
BEGIN|prosa.analysis.facts.delay_propagation.propagated_arrival_curve_respected
@propagated_arrival_curve_respected
     : forall (Task1 Task2 : TaskType) (Job1 Job2 : JobType) (H : JobTask Job1 Task1) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (task1_of : Task2 -> Task1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2), valid_delay_propagation_mapping JA1 JA2 job1_of task1_of delay_bound ts2 -> forall (max_arrivals1 : MaxArrivals Task1) (arr_seq1 : arrival_sequence Job1), valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> (forall tsk1 : Task1, tsk1 \in [seq task1_of tsk2 | tsk2 <- ts2] -> forall j1 : Job1, job_task j1 = tsk1 -> size (job2_of j1) <= 1) -> valid_arrival_sequence arr_seq1 -> valid_taskset_arrival_curve [seq task1_of tsk2 | tsk2 <- ts2] max_arrivals1 -> taskset_respects_max_arrivals arr_seq1 [seq task1_of tsk2 | tsk2 <- ts2] -> taskset_respects_max_arrivals (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay) ts2
END|prosa.analysis.facts.delay_propagation.propagated_arrival_curve_respected
BEGIN|prosa.analysis.facts.edf_definitions.EDF_schedule_implies_respects_policy_at_preemption_point
@EDF_schedule_implies_respects_policy_at_preemption_point
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)), all_deadlines_of_arrivals_met arr_seq sched -> EDF_schedule sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job)
END|prosa.analysis.facts.edf_definitions.EDF_schedule_implies_respects_policy_at_preemption_point
BEGIN|prosa.analysis.facts.edf_definitions.respects_policy_at_preemption_point_implies_EDF_schedule
@respects_policy_at_preemption_point_implies_EDF_schedule
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule (ideal.processor_state Job), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> jobs_come_from_arrival_sequence sched arr_seq -> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job) -> EDF_schedule sched
END|prosa.analysis.facts.edf_definitions.respects_policy_at_preemption_point_implies_EDF_schedule
BEGIN|prosa.analysis.facts.edf_definitions.EDF_schedule_equiv
@EDF_schedule_equiv
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule (ideal.processor_state Job), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> jobs_come_from_arrival_sequence sched arr_seq -> all_deadlines_of_arrivals_met arr_seq sched -> EDF_schedule sched <-> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job)
END|prosa.analysis.facts.edf_definitions.EDF_schedule_equiv
BEGIN|prosa.analysis.facts.hyperperiod.hyperperiod_int_mult_of_any_task
@hyperperiod_int_mult_of_any_task
     : forall (Task : TaskType) (H : PeriodicModel Task) (ts : TaskSet Task) (tsk : Task), tsk \in ts -> exists k : nat, hyperperiod ts = k * task_period tsk
END|prosa.analysis.facts.hyperperiod.hyperperiod_int_mult_of_any_task
BEGIN|prosa.analysis.facts.hyperperiod.valid_periods_imply_pos_hp
@valid_periods_imply_pos_hp
     : forall (Task : TaskType) (H : PeriodicModel Task) (ts : TaskSet Task), valid_periods ts -> 0 < hyperperiod ts
END|prosa.analysis.facts.hyperperiod.valid_periods_imply_pos_hp
BEGIN|prosa.analysis.facts.hyperperiod.corresponding_jobs_have_same_task
@corresponding_jobs_have_same_task
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job) (ts : TaskSet Task) (j1 j2 : Job), job_task (corresponding_job_in_hyperperiod ts arr_seq j1 (starting_instant_of_corresponding_hyperperiod ts j2) (job_task j1)) = job_task j1
END|prosa.analysis.facts.hyperperiod.corresponding_jobs_have_same_task
BEGIN|prosa.analysis.facts.hyperperiod.all_jobs_arrive_within_hyperperiod
@all_jobs_arrive_within_hyperperiod
     : forall (Task : TaskType) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (ts : TaskSet Task) (tsk : Task) (j : Job) (t : instant), j \in jobs_in_hyperperiod ts arr_seq t tsk -> t <= job_arrival j < t + hyperperiod ts
END|prosa.analysis.facts.hyperperiod.all_jobs_arrive_within_hyperperiod
BEGIN|prosa.analysis.facts.hyperperiod.eq_size_hyp_lt
@eq_size_hyp_lt
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (ts : TaskSet Task) (tsk : Task), tsk \in ts -> valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> infinite_jobs arr_seq -> forall n1 n2 : nat, n1 <= n2 -> size (jobs_in_hyperperiod ts arr_seq (n1 * hyperperiod ts + max_task_offset ts) tsk) = size (jobs_in_hyperperiod ts arr_seq (n2 * hyperperiod ts + max_task_offset ts) tsk)
END|prosa.analysis.facts.hyperperiod.eq_size_hyp_lt
BEGIN|prosa.analysis.facts.hyperperiod.eq_size_of_arrivals_in_hyperperiod
@eq_size_of_arrivals_in_hyperperiod
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (ts : TaskSet Task) (tsk : Task), tsk \in ts -> valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> infinite_jobs arr_seq -> forall n1 n2 : nat, size (jobs_in_hyperperiod ts arr_seq (n1 * hyperperiod ts + max_task_offset ts) tsk) = size (jobs_in_hyperperiod ts arr_seq (n2 * hyperperiod ts + max_task_offset ts) tsk)
END|prosa.analysis.facts.hyperperiod.eq_size_of_arrivals_in_hyperperiod
BEGIN|prosa.analysis.facts.hyperperiod.job_in_hp_arrives_in_task_arrivals_up_to
@job_in_hp_arrives_in_task_arrivals_up_to
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (ts : TaskSet Task) (tsk : Task), tsk \in ts -> valid_period tsk -> forall j1 j2 : Job, max_task_offset ts <= job_arrival j1 -> max_task_offset ts <= job_arrival j2 -> forall j : Job, j \in jobs_in_hyperperiod ts arr_seq ((job_arrival j2 - max_task_offset ts) %/ hyperperiod ts * hyperperiod ts + max_task_offset ts) tsk -> j \in task_arrivals_up_to arr_seq tsk (job_arrival j2 + hyperperiod ts)
END|prosa.analysis.facts.hyperperiod.job_in_hp_arrives_in_task_arrivals_up_to
BEGIN|prosa.analysis.facts.hyperperiod.job_in_own_hp
@job_in_own_hp
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : TaskSet Task, valid_periods ts -> forall tsk : Task, tsk \in ts -> valid_period tsk -> forall j1 j2 : Job, arrives_in arr_seq j1 -> job_task j1 = tsk -> max_task_offset ts <= job_arrival j1 -> max_task_offset ts <= job_arrival j2 -> j1 \in jobs_in_hyperperiod ts arr_seq ((job_arrival j1 - max_task_offset ts) %/ hyperperiod ts * hyperperiod ts + max_task_offset ts) tsk
END|prosa.analysis.facts.hyperperiod.job_in_own_hp
BEGIN|prosa.analysis.facts.hyperperiod.corr_job_in_task_arrivals_up_to
@corr_job_in_task_arrivals_up_to
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : TaskSet Task, valid_periods ts -> forall tsk : Task, tsk \in ts -> valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> infinite_jobs arr_seq -> forall j1 j2 : Job, arrives_in arr_seq j1 -> job_task j1 = tsk -> max_task_offset ts <= job_arrival j1 -> max_task_offset ts <= job_arrival j2 -> corresponding_job_in_hyperperiod ts arr_seq j1 (starting_instant_of_corresponding_hyperperiod ts j2) tsk \in task_arrivals_up_to arr_seq tsk (job_arrival j2 + hyperperiod ts)
END|prosa.analysis.facts.hyperperiod.corr_job_in_task_arrivals_up_to
BEGIN|prosa.analysis.facts.hyperperiod.corresponding_job_arrives
@corresponding_job_arrives
     : forall (Task : TaskType) (H : TaskOffset Task) (H0 : PeriodicModel Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : TaskSet Task, valid_periods ts -> forall tsk : Task, tsk \in ts -> valid_offset arr_seq tsk -> valid_period tsk -> respects_periodic_task_model arr_seq tsk -> infinite_jobs arr_seq -> forall j1 j2 : Job, arrives_in arr_seq j1 -> job_task j1 = tsk -> max_task_offset ts <= job_arrival j1 -> max_task_offset ts <= job_arrival j2 -> arrives_in arr_seq (corresponding_job_in_hyperperiod ts arr_seq j1 (starting_instant_of_corresponding_hyperperiod ts j2) tsk)
END|prosa.analysis.facts.hyperperiod.corresponding_job_arrives
BEGIN|prosa.analysis.facts.interference.another_task_hep_job_split_hp_ep
@another_task_hep_job_split_hp_ep
     : forall (Task : TaskType) (Job : JobType) (jt : JobTask Job Task) (FP : FP_policy Task) (JLFP : JLFP_policy Job), JLFP_FP_compatible JLFP FP -> forall j1 j2 : Job, another_task_hep_job j1 j2 = hp_task_hep_job j1 j2 || other_ep_task_hep_job j1 j2
END|prosa.analysis.facts.interference.another_task_hep_job_split_hp_ep
BEGIN|prosa.analysis.facts.interference.hep_interference_another_task_split
@hep_interference_another_task_split
     : forall (Task : TaskType) (Job : JobType) (jt : JobTask Job Task) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (FP : FP_policy Task) (JLFP : JLFP_policy Job), JLFP_FP_compatible JLFP FP -> forall (j : Job) (t : instant), another_task_hep_job_interference arr_seq sched j t = hep_job_from_hp_task_interference arr_seq sched j t || hep_job_from_other_ep_task_interference arr_seq sched j t
END|prosa.analysis.facts.interference.hep_interference_another_task_split
BEGIN|prosa.analysis.facts.interference.cumulative_hep_interference_split_tasks_new
@cumulative_hep_interference_split_tasks_new
     : forall (Task : TaskType) (Job : JobType) (jt : JobTask Job Task) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (FP : FP_policy Task) (JLFP : JLFP_policy Job), JLFP_FP_compatible JLFP FP -> uniprocessor_model PState -> forall (j : Job) (t1 : instant) (Δ : nat), cumulative_another_task_hep_job_interference arr_seq sched j t1 (t1 + Δ) = cumulative_interference_from_hep_jobs_from_hp_tasks arr_seq sched j t1 (t1 + Δ) + cumulative_interference_from_hep_jobs_from_other_ep_tasks arr_seq sched j t1 (t1 + Δ)
END|prosa.analysis.facts.interference.cumulative_hep_interference_split_tasks_new
BEGIN|prosa.analysis.facts.interference.no_hep_job_interference_without_supply
@no_hep_job_interference_without_supply
     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLFP : JLFP_policy Job) (t : instant), ~~ has_supply sched t -> forall j : Job, ~~ another_hep_job_interference arr_seq sched j t
END|prosa.analysis.facts.interference.no_hep_job_interference_without_supply
BEGIN|prosa.analysis.facts.interference.no_hep_task_interference_without_supply
@no_hep_task_interference_without_supply
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLFP : JLFP_policy Job) (t : instant), ~~ has_supply sched t -> forall j : Job, ~~ another_task_hep_job_interference arr_seq sched j t
END|prosa.analysis.facts.interference.no_hep_task_interference_without_supply
BEGIN|prosa.analysis.facts.interference.no_hep_job_interference_when_idle
@no_hep_job_interference_when_idle
     : forall (Job : JobType) (H1 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (t : instant), is_idle arr_seq sched t -> forall j : Job, ~~ another_hep_job_interference arr_seq sched j t
END|prosa.analysis.facts.interference.no_hep_job_interference_when_idle
BEGIN|prosa.analysis.facts.interference.no_hep_task_interference_when_idle
@no_hep_task_interference_when_idle
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (t : instant), is_idle arr_seq sched t -> forall j : Job, ~~ another_task_hep_job_interference arr_seq sched j t
END|prosa.analysis.facts.interference.no_hep_task_interference_when_idle
BEGIN|prosa.analysis.facts.interference.interference_ahep_def
@interference_ahep_def
     : forall (Job : JobType) (H1 : JobArrival Job) (PState : ProcessorState Job), uniprocessor_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (j : Job) (t : instant), has_supply sched t -> forall j' : Job, scheduled_at sched j' t -> another_hep_job_interference arr_seq sched j t = another_hep_job j' j
END|prosa.analysis.facts.interference.interference_ahep_def
BEGIN|prosa.analysis.facts.interference.interference_athep_def
@interference_athep_def
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (PState : ProcessorState Job), uniprocessor_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (j : Job) (t : instant), has_supply sched t -> forall j' : Job, scheduled_at sched j' t -> another_task_hep_job_interference arr_seq sched j t = another_task_hep_job j' j
END|prosa.analysis.facts.interference.interference_athep_def
BEGIN|prosa.analysis.facts.interference.no_ahep_interference_when_scheduled
@no_ahep_interference_when_scheduled
     : forall (Job : JobType) (PState : ProcessorState Job), uniprocessor_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLFP : JLFP_policy Job) (j : Job) (t : instant), scheduled_at sched j t -> ~~ another_hep_job_interference arr_seq sched j t
END|prosa.analysis.facts.interference.no_ahep_interference_when_scheduled
BEGIN|prosa.analysis.facts.interference.no_ahep_interference_when_served
@no_ahep_interference_when_served
     : forall (Job : JobType) (H1 : JobArrival Job) (PState : ProcessorState Job), uniprocessor_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (j : Job) (t : instant), has_supply sched t -> receives_service_at sched j t -> ~~ another_hep_job_interference arr_seq sched j t
END|prosa.analysis.facts.interference.no_ahep_interference_when_served
BEGIN|prosa.analysis.facts.interference.no_athep_interference_when_scheduled
@no_athep_interference_when_scheduled
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (PState : ProcessorState Job), uniprocessor_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState) (tsk : Task) (JLFP : JLFP_policy Job) (j : Job), job_of_task tsk j -> forall (t : instant) (j' : Job), job_of_task tsk j' -> scheduled_at sched j' t -> ~~ another_task_hep_job_interference arr_seq sched j t
END|prosa.analysis.facts.interference.no_athep_interference_when_scheduled
BEGIN|prosa.analysis.facts.interference.athep_interference_iff
@athep_interference_iff
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (PState : ProcessorState Job), uniprocessor_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (tsk : Task) (JLFP : JLFP_policy Job) (j : Job), job_of_task tsk j -> forall t : instant, has_supply sched t -> forall j' : Job, ~~ job_of_task tsk j' -> scheduled_at sched j' t -> another_task_hep_job_interference arr_seq sched j t = hep_job j' j
END|prosa.analysis.facts.interference.athep_interference_iff
BEGIN|prosa.analysis.facts.interference.athep_interference_if
@athep_interference_if
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (PState : ProcessorState Job), uniprocessor_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (tsk : Task) (JLFP : JLFP_policy Job) (j : Job), job_of_task tsk j -> forall t : instant, has_supply sched t -> forall j' : Job, ~~ job_of_task tsk j' -> scheduled_at sched j' t -> hep_job j' j -> another_task_hep_job_interference arr_seq sched j t
END|prosa.analysis.facts.interference.athep_interference_if
BEGIN|prosa.analysis.facts.interference.no_ahep_interference_when_scheduled_lp
@no_ahep_interference_when_scheduled_lp
     : forall (Job : JobType) (PState : ProcessorState Job), uniprocessor_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLFP : JLFP_policy Job) (j : Job) (t : instant) (j' : Job), scheduled_at sched j' t -> ~~ hep_job j' j -> ~~ another_hep_job_interference arr_seq sched j t
END|prosa.analysis.facts.interference.no_ahep_interference_when_scheduled_lp
BEGIN|prosa.analysis.facts.interference.cumulative_i_ohep_eq_service_of_ohep
@cumulative_i_ohep_eq_service_of_ohep
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall JLFP : JLFP_policy Job, unit_service_proc_model PState -> forall (j : Job) (t1 t : instant), quiet_time arr_seq sched j t1 -> cumulative_another_hep_job_interference arr_seq sched j t1 t = service_of_other_hep_jobs arr_seq sched j t1 t
END|prosa.analysis.facts.interference.cumulative_i_ohep_eq_service_of_ohep
BEGIN|prosa.analysis.facts.interference.cumulative_i_thep_eq_service_of_othep
@cumulative_i_thep_eq_service_of_othep
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall JLFP : JLFP_policy Job, unit_service_proc_model PState -> forall (j : Job) (t1 t : instant), quiet_time arr_seq sched j t1 -> cumulative_another_task_hep_job_interference arr_seq sched j t1 t = service_of_other_task_hep_jobs arr_seq sched j t1 t
END|prosa.analysis.facts.interference.cumulative_i_thep_eq_service_of_othep
BEGIN|prosa.analysis.facts.jitter.jitter_arrives_in_iff
@jitter_arrives_in_iff
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> forall j : Job, arrives_in arr_seq j <-> arrives_in (release_sequence arr_seq) j
END|prosa.analysis.facts.jitter.jitter_arrives_in_iff
BEGIN|prosa.analysis.facts.jitter.valid_release_sequence
@valid_release_sequence
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> valid_arrival_sequence (release_sequence arr_seq)
END|prosa.analysis.facts.jitter.valid_release_sequence
BEGIN|prosa.analysis.facts.jitter.valid_release_curve
@valid_release_curve
     : forall (Task : TaskType) (arrival_curve : MaxArrivals Task) (H0 : TaskJitter Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> valid_taskset_arrival_curve ts release_curve
END|prosa.analysis.facts.jitter.valid_release_curve
BEGIN|prosa.analysis.facts.jitter.release_curve_respected
@release_curve_respected
     : forall (Task : TaskType) (arrival_curve : MaxArrivals Task) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> taskset_respects_max_arrivals (release_sequence arr_seq) ts
END|prosa.analysis.facts.jitter.release_curve_respected
