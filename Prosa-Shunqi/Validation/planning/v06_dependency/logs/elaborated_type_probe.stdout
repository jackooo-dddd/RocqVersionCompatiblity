BEGIN|prosa.analysis.facts.workload.edf_athep_bound.total_workload_shorten_range
@total_workload_shorten_range
     : forall (Task : TaskType) (H0 : TaskDeadline Task) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobArrival Job) (H4 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (ts : seq Task) (tsk : Task) (j : Job), job_of_task tsk j -> job_cost_positive j -> forall t1 t2 Δ : duration, t1 + Δ < t2 -> forall tsk_o : Task, tsk_o \in ts -> tsk_o != tsk -> job_arrival j - t1 + 1 + task_deadline tsk - task_deadline tsk_o <= Δ -> workload_of_jobs (fun jo : Job => EDF Job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + Δ)) <= workload_of_jobs (fun jo : Job => EDF Job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + (job_arrival j - t1 + 1 + task_deadline tsk - task_deadline tsk_o)))
END|prosa.analysis.facts.workload.edf_athep_bound.total_workload_shorten_range
BEGIN|prosa.analysis.facts.workload.edf_athep_bound.sum_of_workloads_is_at_most_bound_on_total_hep_workload
@edf_athep_bound.sum_of_workloads_is_at_most_bound_on_total_hep_workload
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (H1 : MaxArrivals Task) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobArrival Job) (H4 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, taskset_respects_max_arrivals arr_seq ts -> forall (tsk : Task) (j : Job), job_of_task tsk j -> job_cost_positive j -> forall t1 t2 Δ : duration, t1 + Δ < t2 -> \sum_(tsk_o <- ts | tsk_o != tsk) workload_of_jobs (fun jo : Job => EDF Job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + Δ)) <= edf_athep_bound.bound_on_athep_workload ts tsk (job_arrival j - t1) Δ
END|prosa.analysis.facts.workload.edf_athep_bound.sum_of_workloads_is_at_most_bound_on_total_hep_workload
BEGIN|prosa.analysis.facts.workload.edf_athep_bound.bound_on_athep_workload_is_valid
@edf_athep_bound.bound_on_athep_workload_is_valid
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (H1 : MaxArrivals Task) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobArrival Job) (H4 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall (tsk : Task) (sched : schedule PState), athep_workload_is_bounded arr_seq sched tsk (edf_athep_bound.bound_on_athep_workload ts tsk)
END|prosa.analysis.facts.workload.edf_athep_bound.bound_on_athep_workload_is_valid
BEGIN|prosa.analysis.facts.workload.edf_athep_bound.bound_on_athep_workload_monotone
@bound_on_athep_workload_monotone
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (H1 : MaxArrivals Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> forall (tsk : Task) (A : nat), monotone leq (edf_athep_bound.bound_on_athep_workload ts tsk A)
END|prosa.analysis.facts.workload.edf_athep_bound.bound_on_athep_workload_monotone
BEGIN|prosa.analysis.facts.workload.elf_athep_bound.total_ep_tsk_workload_shorten_range
@total_ep_tsk_workload_shorten_range
     : forall (Task : TaskType) (H1 : PriorityPoint Task) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobArrival Job) (H4 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (tsk : Task) (FP : FP_policy Task) (j : Job), job_of_task tsk j -> forall (t1 delta : duration) (tsk_o : Task), (ep_task_interfering_interval_length tsk tsk_o (job_arrival j - t1)%N <= delta%:R)%R -> ep_task tsk tsk_o -> workload_of_jobs (fun jo : Job => hep_job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + delta)) <= workload_of_jobs (fun jo : Job => hep_job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 `|Order.Def.max 0%R (t1%:R + ep_task_interfering_interval_length tsk tsk_o (job_arrival j - t1)%N)%R|)
END|prosa.analysis.facts.workload.elf_athep_bound.total_ep_tsk_workload_shorten_range
BEGIN|prosa.analysis.facts.workload.elf_athep_bound.sum_of_ep_tsk_workloads_is_at_most_bound_on_ep_task_workload
@sum_of_ep_tsk_workloads_is_at_most_bound_on_ep_task_workload
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (H1 : PriorityPoint Task) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobArrival Job) (H4 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, taskset_respects_max_arrivals arr_seq ts -> forall (tsk : Task) (FP : FP_policy Task) (j : Job), job_of_task tsk j -> forall t1 t2 delta : duration, t1 + delta < t2 -> \sum_(tsk_o <- ts | ep_task tsk tsk_o && (tsk_o != tsk)) workload_of_jobs (fun jo : Job => hep_job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + delta)) <= bound_on_ep_task_workload ts tsk (job_arrival j - t1) delta
END|prosa.analysis.facts.workload.elf_athep_bound.sum_of_ep_tsk_workloads_is_at_most_bound_on_ep_task_workload
BEGIN|prosa.analysis.facts.workload.elf_athep_bound.sum_of_hp_tsk_workloads_is_at_most_bound_on_hp_task_workload
@sum_of_hp_tsk_workloads_is_at_most_bound_on_hp_task_workload
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (H1 : PriorityPoint Task) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobArrival Job) (H4 : JobCost Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, taskset_respects_max_arrivals arr_seq ts -> forall (tsk : Task) (FP : FP_policy Task) (j : Job) (t1 delta : duration), \sum_(tsk_o <- ts | hp_task tsk_o tsk) workload_of_jobs (fun jo : Job => hep_job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + delta)) <= bound_on_hp_task_workload ts tsk delta
END|prosa.analysis.facts.workload.elf_athep_bound.sum_of_hp_tsk_workloads_is_at_most_bound_on_hp_task_workload
BEGIN|prosa.analysis.facts.workload.elf_athep_bound.sum_of_hep_workloads_partitioned
@sum_of_hep_workloads_partitioned
     : forall (Task : TaskType) (H1 : PriorityPoint Task) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobArrival Job) (H4 : JobCost Job) (arr_seq : arrival_sequence Job) (ts : seq Task) (tsk : Task) (FP : FP_policy Task) (j : Job), job_of_task tsk j -> forall t1 delta : duration, \sum_(tsk_o <- ts | tsk_o != tsk) workload_of_jobs (fun jo : Job => hep_job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + delta)) = \sum_(tsk_o <- ts | ep_task tsk tsk_o && (tsk_o != tsk)) workload_of_jobs (fun jo : Job => hep_job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + delta)) + \sum_(tsk_o <- ts | hp_task tsk_o tsk) workload_of_jobs (fun jo : Job => hep_job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + delta))
END|prosa.analysis.facts.workload.elf_athep_bound.sum_of_hep_workloads_partitioned
