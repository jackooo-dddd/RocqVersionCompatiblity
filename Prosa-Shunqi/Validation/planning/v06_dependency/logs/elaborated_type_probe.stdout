BEGIN|prosa.results.rta.ideal.elf.bounded_pi.response_time_recurrence_solution_exists
@response_time_recurrence_solution_exists
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (H2 : MaxArrivals Task) (H3 : PriorityPoint Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall (FP : FP_policy Task) (priority_inversion_lp_tasks_bound : duration) (priority_inversion_ep_tasks_bound : duration -> duration) (L : duration), 0 < L -> forall R : duration, (forall A : duration, elf.bounded_pi.is_in_search_space ts tsk FP priority_inversion_lp_tasks_bound priority_inversion_ep_tasks_bound L A -> exists F : duration, priority_inversion_bound priority_inversion_lp_tasks_bound priority_inversion_ep_tasks_bound A + bound_on_total_ep_workload ts tsk FP A (A + F) + total_hp_rbf ts tsk FP (A + F) + (task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk)) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : nat, search_space.is_in_search_space L (fun A0 Δ : duration => task_request_bound_function tsk (A0 + 1) - task_cost tsk + task_IBF ts tsk FP priority_inversion_lp_tasks_bound priority_inversion_ep_tasks_bound A0 Δ) A -> exists F : nat, task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk) + task_IBF ts tsk FP priority_inversion_lp_tasks_bound priority_inversion_ep_tasks_bound A (A + F) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R
END|prosa.results.rta.ideal.elf.bounded_pi.response_time_recurrence_solution_exists
BEGIN|prosa.results.rta.ideal.elf.bounded_pi.uniprocessor_response_time_bound_elf
@uniprocessor_response_time_bound_elf
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (H2 : MaxArrivals Task) (H3 : PriorityPoint Task) (Job : JobType) (H4 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (H5 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, uniq ts -> all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> valid_task_run_to_completion_threshold arr_seq tsk -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> forall FP : FP_policy Task, reflexive_task_priorities FP -> transitive_task_priorities FP -> total_task_priorities FP -> valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (ELF FP) -> work_conserving arr_seq sched -> forall priority_inversion_lp_tasks_bound : duration, priority_inversion_cond_is_bounded_by arr_seq sched tsk (fun j' : Job => hp_task tsk (job_task j')) (constant priority_inversion_lp_tasks_bound) -> forall priority_inversion_ep_tasks_bound : duration -> duration, priority_inversion_cond_is_bounded_by arr_seq sched tsk (fun j' : Job => ep_task tsk (job_task j')) priority_inversion_ep_tasks_bound -> (forall (j : Job) (t1 : nat), job_task j = tsk -> priority_inversion_ep_tasks_bound (job_arrival j - t1) <= \max_(i <- ts | [&& ep_task i tsk && ~~ (0 <= (job_arrival j)%:R - t1%:R + task_priority_point tsk - task_priority_point i)%R, 0 < max_arrivals i 1 & 0 < task_cost i]) task_cost i) -> forall L : duration, 0 < L -> L = priority_inversion_lp_tasks_bound + total_hep_request_bound_function_FP ts tsk L -> forall R : duration, (forall A : duration, elf.bounded_pi.is_in_search_space ts tsk FP priority_inversion_lp_tasks_bound priority_inversion_ep_tasks_bound L A -> exists F : duration, priority_inversion_bound priority_inversion_lp_tasks_bound priority_inversion_ep_tasks_bound A + bound_on_total_ep_workload ts tsk FP A (A + F) + total_hp_rbf ts tsk FP (A + F) + (task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk)) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> task_response_time_bound arr_seq sched tsk R
END|prosa.results.rta.ideal.elf.bounded_pi.uniprocessor_response_time_bound_elf
BEGIN|prosa.results.rta.ideal.fifo.bounded_nps.abstractly_work_conserving
@abstractly_work_conserving
     : forall (Job : JobType) (H3 : JobArrival Job) (H4 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> work_conserving arr_seq sched -> definitions.work_conserving arr_seq sched
END|prosa.results.rta.ideal.fifo.bounded_nps.abstractly_work_conserving
BEGIN|prosa.results.rta.ideal.fifo.bounded_nps.busy_windows_are_bounded
@busy_windows_are_bounded
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobArrival Job) (H4 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall (tsk : Task) (sched : schedule (ideal.processor_state Job)), valid_schedule sched arr_seq -> work_conserving arr_seq sched -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> busy_intervals_are_bounded_by arr_seq sched tsk L
END|prosa.results.rta.ideal.fifo.bounded_nps.busy_windows_are_bounded
BEGIN|prosa.results.rta.ideal.fifo.bounded_nps.no_priority_inversion
@no_priority_inversion
     : forall (Task : TaskType) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobArrival Job) (H4 : JobCost Job) (H5 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (tsk : Task) (sched : schedule (ideal.processor_state Job)), valid_schedule sched arr_seq -> valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (FIFO Job) -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : duration, definitions.busy_interval sched j t1 t2 -> forall Δ : duration, t1 + Δ < t2 -> cumulative_priority_inversion arr_seq sched j t1 (t1 + Δ) = 0
END|prosa.results.rta.ideal.fifo.bounded_nps.no_priority_inversion
BEGIN|prosa.results.rta.ideal.fifo.bounded_nps.IBF_correct
@IBF_correct
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H2 : JobTask Job Task) (H3 : JobArrival Job) (H4 : JobCost Job) (H5 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (FIFO Job) -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> job_interference_is_bounded_by arr_seq sched tsk (fun A : duration => fun=> \sum_(tsko <- ts) task_request_bound_function tsko (A + 1) - task_cost tsk) (relative_arrival_time_of_job_is_A sched)
END|prosa.results.rta.ideal.fifo.bounded_nps.IBF_correct
