     : forall (Job : JobType) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule (ideal.processor_state Job), jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall (j : Job) (t : instant) (j' : Job), scheduled_at sched j' t -> priority_inversion arr_seq sched j t = ~~ hep_job j' j
