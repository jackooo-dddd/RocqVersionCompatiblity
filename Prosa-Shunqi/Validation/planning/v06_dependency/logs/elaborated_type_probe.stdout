BEGIN|prosa.analysis.facts.behavior.arrivals.jobs_must_arrive_to_be_ready
@jobs_must_arrive_to_be_ready
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job) (H0 : JobArrival Job) (jr : JobReady Job PState), jobs_must_be_ready_to_execute sched -> jobs_must_arrive_to_execute sched
END|prosa.analysis.facts.behavior.arrivals.jobs_must_arrive_to_be_ready
BEGIN|prosa.analysis.facts.behavior.arrivals.valid_schedule_implies_jobs_must_arrive_to_execute
@valid_schedule_implies_jobs_must_arrive_to_execute
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job) (H0 : JobArrival Job) (jr : JobReady Job PState) (arr_seq : arrival_sequence Job), valid_schedule sched arr_seq -> jobs_must_arrive_to_execute sched
END|prosa.analysis.facts.behavior.arrivals.valid_schedule_implies_jobs_must_arrive_to_execute
BEGIN|prosa.analysis.facts.behavior.arrivals.backlogged_implies_arrived
@backlogged_implies_arrived
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job) (H0 : JobArrival Job) (jr : JobReady Job PState) (j : Job) (t : instant), backlogged sched j t -> has_arrived j t
END|prosa.analysis.facts.behavior.arrivals.backlogged_implies_arrived
BEGIN|prosa.analysis.facts.behavior.arrivals.backlogged_implies_incomplete
@backlogged_implies_incomplete
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job) (H0 : JobArrival Job) (jr : JobReady Job PState) (j : Job) (t : instant), backlogged sched j t -> ~~ completed_by sched j t
END|prosa.analysis.facts.behavior.arrivals.backlogged_implies_incomplete
BEGIN|prosa.analysis.facts.behavior.arrivals.job_scheduled_implies_ready
@job_scheduled_implies_ready
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job) (H0 : JobArrival Job) (jr : JobReady Job PState), jobs_must_be_ready_to_execute sched -> forall (j : Job) (t : instant), scheduled_at sched j t -> job_ready sched j t
END|prosa.analysis.facts.behavior.arrivals.job_scheduled_implies_ready
BEGIN|prosa.analysis.facts.behavior.arrivals.valid_schedule_jobs_come_from_arrival_sequence
@valid_schedule_jobs_come_from_arrival_sequence
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job) (H0 : JobArrival Job) (jr : JobReady Job PState) (arr_seq : arrival_sequence Job), valid_schedule sched arr_seq -> jobs_come_from_arrival_sequence sched arr_seq
END|prosa.analysis.facts.behavior.arrivals.valid_schedule_jobs_come_from_arrival_sequence
BEGIN|prosa.analysis.facts.behavior.arrivals.valid_schedule_jobs_must_be_ready_to_execute
@valid_schedule_jobs_must_be_ready_to_execute
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job) (H0 : JobArrival Job) (jr : JobReady Job PState) (arr_seq : arrival_sequence Job), valid_schedule sched arr_seq -> jobs_must_be_ready_to_execute sched
END|prosa.analysis.facts.behavior.arrivals.valid_schedule_jobs_must_be_ready_to_execute
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_between_cat
@arrivals_between_cat
     : forall (Job : JobType) (arr_seq : arrival_sequence Job) (t1 t t2 : nat), t1 <= t -> t <= t2 -> arrivals_between arr_seq t1 t2 = arrivals_between arr_seq t1 t ++ arrivals_between arr_seq t t2
END|prosa.analysis.facts.behavior.arrivals.arrivals_between_cat
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_P_cat
@arrivals_P_cat
     : forall (Job : JobType) (arr_seq : arrival_sequence Job) (P : Job -> bool) (t t1 t2 : nat), t1 <= t < t2 -> arrivals_between_P arr_seq P t1 t2 = arrivals_between_P arr_seq P t1 t ++ arrivals_between_P arr_seq P t t2
END|prosa.analysis.facts.behavior.arrivals.arrivals_P_cat
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_between_mem_cat
@arrivals_between_mem_cat
     : forall (Job : JobType) (arr_seq : arrival_sequence Job) (j : Job) (t1 t t2 : nat), t1 <= t -> t <= t2 -> (j \in arrivals_between arr_seq t1 t2) = (j \in arrivals_between arr_seq t1 t ++ arrivals_between arr_seq t t2)
END|prosa.analysis.facts.behavior.arrivals.arrivals_between_mem_cat
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_between_sub
@arrivals_between_sub
     : forall (Job : JobType) (arr_seq : arrival_sequence Job) (j : Job) (t1 t1' t2 t2' : nat), t1' <= t1 -> t2 <= t2' -> j \in arrivals_between arr_seq t1 t2 -> j \in arrivals_between arr_seq t1' t2'
END|prosa.analysis.facts.behavior.arrivals.arrivals_between_sub
BEGIN|prosa.analysis.facts.behavior.arrivals.job_arrival_arrives_at
@job_arrival_arrives_at
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t : instant), arrives_at arr_seq j t -> job_arrival j = t
END|prosa.analysis.facts.behavior.arrivals.job_arrival_arrives_at
BEGIN|prosa.analysis.facts.behavior.arrivals.job_arrival_at
@job_arrival_at
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t : instant), j \in arrivals_at arr_seq t -> job_arrival j = t
END|prosa.analysis.facts.behavior.arrivals.job_arrival_at
BEGIN|prosa.analysis.facts.behavior.arrivals.job_in_arrivals_at
@job_in_arrivals_at
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t : instant), arrives_in arr_seq j -> job_arrival j = t -> j \in arrivals_at arr_seq t
END|prosa.analysis.facts.behavior.arrivals.job_in_arrivals_at
BEGIN|prosa.analysis.facts.behavior.arrivals.job_arrival_between
@job_arrival_between
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t1 t2 : instant), j \in arrivals_between arr_seq t1 t2 -> t1 <= job_arrival j < t2
END|prosa.analysis.facts.behavior.arrivals.job_arrival_between
BEGIN|prosa.analysis.facts.behavior.arrivals.job_arrival_between_ge
@job_arrival_between_ge
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t1 t2 : instant), j \in arrivals_between arr_seq t1 t2 -> t1 <= job_arrival j
END|prosa.analysis.facts.behavior.arrivals.job_arrival_between_ge
BEGIN|prosa.analysis.facts.behavior.arrivals.job_arrival_between_lt
@job_arrival_between_lt
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t1 t2 : instant), j \in arrivals_between arr_seq t1 t2 -> job_arrival j < t2
END|prosa.analysis.facts.behavior.arrivals.job_arrival_between_lt
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_between_filter_nil
@arrivals_between_filter_nil
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (t1 : nat) (t2 : instant) (t : nat), t < t1 -> [seq j <- arrivals_between arr_seq t1 t2 | job_arrival j < t] = [::]
END|prosa.analysis.facts.behavior.arrivals.arrivals_between_filter_nil
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_between_filter
@arrivals_between_filter
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (t1 : instant) (t2 t : nat), t <= t2 -> arrivals_between arr_seq t1 t = [seq j <- arrivals_between arr_seq t1 t2 | job_arrival j < t]
END|prosa.analysis.facts.behavior.arrivals.arrivals_between_filter
BEGIN|prosa.analysis.facts.behavior.arrivals.in_arrivals_implies_arrived
@in_arrivals_implies_arrived
     : forall (Job : JobType) (arr_seq : arrival_sequence Job) (j : Job) (t1 t2 : instant), j \in arrivals_between arr_seq t1 t2 -> arrives_in arr_seq j
END|prosa.analysis.facts.behavior.arrivals.in_arrivals_implies_arrived
BEGIN|prosa.analysis.facts.behavior.arrivals.in_arrseq_implies_arrives
@in_arrseq_implies_arrives
     : forall (Job : JobType) (arr_seq : arrival_sequence Job) (t : instant) (j : Job), j \in arr_seq t -> arrives_in arr_seq j
END|prosa.analysis.facts.behavior.arrivals.in_arrseq_implies_arrives
BEGIN|prosa.analysis.facts.behavior.arrivals.in_arrivals_implies_arrived_between
@in_arrivals_implies_arrived_between
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t1 t2 : instant), j \in arrivals_between arr_seq t1 t2 -> arrived_between j t1 t2
END|prosa.analysis.facts.behavior.arrivals.in_arrivals_implies_arrived_between
BEGIN|prosa.analysis.facts.behavior.arrivals.in_arrivals_implies_arrived_before
@in_arrivals_implies_arrived_before
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t : instant), j \in arrivals_before arr_seq t -> arrived_before j t
END|prosa.analysis.facts.behavior.arrivals.in_arrivals_implies_arrived_before
BEGIN|prosa.analysis.facts.behavior.arrivals.arrived_between_implies_in_arrivals
@arrived_between_implies_in_arrivals
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t1 t2 : instant), arrives_in arr_seq j -> arrived_between j t1 t2 -> j \in arrivals_between arr_seq t1 t2
END|prosa.analysis.facts.behavior.arrivals.arrived_between_implies_in_arrivals
BEGIN|prosa.analysis.facts.behavior.arrivals.job_arrival_between_P
@job_arrival_between_P
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (P : Job -> bool) (t1 t2 : instant), j \in arrivals_between_P arr_seq P t1 t2 -> t1 <= job_arrival j < t2
END|prosa.analysis.facts.behavior.arrivals.job_arrival_between_P
BEGIN|prosa.analysis.facts.behavior.arrivals.job_in_arrivals_between
@job_in_arrivals_between
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t1 t2 : nat), arrives_in arr_seq j -> t1 <= job_arrival j -> job_arrival j < t2 -> j \in arrivals_between arr_seq t1 t2
END|prosa.analysis.facts.behavior.arrivals.job_in_arrivals_between
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_uniq
@arrivals_uniq
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> arrival_sequence_uniq arr_seq -> forall t1 t2 : instant, uniq (arrivals_between arr_seq t1 t2)
END|prosa.analysis.facts.behavior.arrivals.arrivals_uniq
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_between_geq
@arrivals_between_geq
     : forall (Job : JobType) (arr_seq : arrival_sequence Job) (t1 t2 : nat), t2 <= t1 -> arrivals_between arr_seq t1 t2 = [::]
END|prosa.analysis.facts.behavior.arrivals.arrivals_between_geq
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_between_nonempty
@arrivals_between_nonempty
     : forall (Job : JobType) (arr_seq : arrival_sequence Job) (t1 t2 : instant) (j : Job), j \in arrivals_between arr_seq t1 t2 -> t1 < t2
END|prosa.analysis.facts.behavior.arrivals.arrivals_between_nonempty
BEGIN|prosa.analysis.facts.behavior.arrivals.arrival_lt_implies_job_in_arrivals_between_P
@arrival_lt_implies_job_in_arrivals_between_P
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j1 j2 : Job) (P : Job -> bool) (t1 t2 : instant), j1 \in arrivals_between_P arr_seq P t1 t2 -> j2 \in arrivals_between_P arr_seq P t1 t2 -> job_arrival j2 < job_arrival j1 -> j2 \in arrivals_between_P arr_seq P t1 (job_arrival j1)
END|prosa.analysis.facts.behavior.arrivals.arrival_lt_implies_job_in_arrivals_between_P
BEGIN|prosa.analysis.facts.behavior.arrivals.job_arrival_in_bounds
@job_arrival_in_bounds
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall (j : Job) (t1 t2 : instant), j \in arrivals_between arr_seq t1 t2 <-> arrives_in arr_seq j /\ t1 <= job_arrival j < t2
END|prosa.analysis.facts.behavior.arrivals.job_arrival_in_bounds
BEGIN|prosa.analysis.facts.behavior.arrivals.by_arrival_times
@by_arrival_times
     : forall Job : JobType, JobArrival Job -> Job -> Job -> bool
END|prosa.analysis.facts.behavior.arrivals.by_arrival_times
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_at_sorted
@arrivals_at_sorted
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall t : instant, sorted by_arrival_times (arrivals_at arr_seq t)
END|prosa.analysis.facts.behavior.arrivals.arrivals_at_sorted
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_between_sorted
@arrivals_between_sorted
     : forall (Job : JobType) (H : JobArrival Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall t1 t2 : instant, sorted by_arrival_times (arrivals_between arr_seq t1 t2)
END|prosa.analysis.facts.behavior.arrivals.arrivals_between_sorted
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_between_partitioned_by_task
@arrivals_between_partitioned_by_task
     : forall (Job : JobType) (Task : TaskType) (H0 : JobTask Job Task) (arr_seq : arrival_sequence Job) (ts : seq Task), all_jobs_from_taskset arr_seq ts -> forall (t1 t2 : instant) (j : Job), (j \in arrivals_between arr_seq t1 t2) = (j \in \cat_(tsk<-ts)task_arrivals_between arr_seq tsk t1 t2)
END|prosa.analysis.facts.behavior.arrivals.arrivals_between_partitioned_by_task
BEGIN|prosa.analysis.facts.behavior.arrivals.arrives_in_jobs_come_from_arrival_sequence
@arrives_in_jobs_come_from_arrival_sequence
     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState), jobs_come_from_arrival_sequence sched arr_seq -> forall (j : Job) (t : instant), scheduled_at sched j t -> arrives_in arr_seq j
END|prosa.analysis.facts.behavior.arrivals.arrives_in_jobs_come_from_arrival_sequence
BEGIN|prosa.analysis.facts.behavior.arrivals.arrived_between_jobs_must_arrive_to_execute
@arrived_between_jobs_must_arrive_to_execute
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (sched : schedule PState), jobs_must_arrive_to_execute sched -> forall (j : Job) (t : instant), scheduled_at sched j t -> has_arrived j t
END|prosa.analysis.facts.behavior.arrivals.arrived_between_jobs_must_arrive_to_execute
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_before_scheduled_at
@arrivals_before_scheduled_at
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (j : Job) (t : instant), scheduled_at sched j t -> forall t' : nat, t < t' -> j \in arrivals_before arr_seq t'
END|prosa.analysis.facts.behavior.arrivals.arrivals_before_scheduled_at
BEGIN|prosa.analysis.facts.behavior.arrivals.arrivals_up_to_scheduled_at
@arrivals_up_to_scheduled_at
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), consistent_arrival_times arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (j : Job) (t : instant), scheduled_at sched j t -> forall t' : nat, t <= t' -> j \in arrivals_up_to arr_seq t'
END|prosa.analysis.facts.behavior.arrivals.arrivals_up_to_scheduled_at
BEGIN|prosa.analysis.facts.behavior.completion.completion_monotonic
@completion_monotonic
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t t' : nat), t <= t' -> completed_by sched j t -> completed_by sched j t'
END|prosa.analysis.facts.behavior.completion.completion_monotonic
BEGIN|prosa.analysis.facts.behavior.completion.incompletion_monotonic
@incompletion_monotonic
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t t' : nat), t <= t' -> ~~ completed_by sched j t' -> ~~ completed_by sched j t
END|prosa.analysis.facts.behavior.completion.incompletion_monotonic
BEGIN|prosa.analysis.facts.behavior.completion.less_service_than_cost_is_incomplete
@less_service_than_cost_is_incomplete
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), service sched j t < job_cost j <-> ~~ completed_by sched j t
END|prosa.analysis.facts.behavior.completion.less_service_than_cost_is_incomplete
BEGIN|prosa.analysis.facts.behavior.completion.incomplete_is_positive_remaining_cost
@incomplete_is_positive_remaining_cost
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), ~~ completed_by sched j t <-> 0 < remaining_cost sched j t
END|prosa.analysis.facts.behavior.completion.incomplete_is_positive_remaining_cost
BEGIN|prosa.analysis.facts.behavior.completion.incomplete_implies_positive_cost
@incomplete_implies_positive_cost
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), ~~ completed_by sched j t -> job_cost_positive j
END|prosa.analysis.facts.behavior.completion.incomplete_implies_positive_cost
BEGIN|prosa.analysis.facts.behavior.completion.scheduled_implies_positive_cost
@scheduled_implies_positive_cost
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), completed_jobs_dont_execute sched -> forall t : instant, scheduled_at sched j t -> 0 < job_cost j
END|prosa.analysis.facts.behavior.completion.scheduled_implies_positive_cost
BEGIN|prosa.analysis.facts.behavior.completion.service_lt_cost
@service_lt_cost
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), completed_jobs_dont_execute sched -> forall t : instant, scheduled_at sched j t -> service sched j t < job_cost j
END|prosa.analysis.facts.behavior.completion.service_lt_cost
BEGIN|prosa.analysis.facts.behavior.completion.completed_on_arrival_implies_zero_cost
@completed_on_arrival_implies_zero_cost
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), jobs_must_arrive_to_execute sched -> completed_by sched j (job_arrival j) -> job_cost j = 0
END|prosa.analysis.facts.behavior.completion.completed_on_arrival_implies_zero_cost
BEGIN|prosa.analysis.facts.behavior.completion.serviced_implies_positive_remaining_cost
@serviced_implies_positive_remaining_cost
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), completed_jobs_dont_execute sched -> forall t : instant, 0 < service_at sched j t -> 0 < remaining_cost sched j t
END|prosa.analysis.facts.behavior.completion.serviced_implies_positive_remaining_cost
BEGIN|prosa.analysis.facts.behavior.completion.scheduled_implies_serviced
@scheduled_implies_serviced
     : forall (Job : JobType) (PState : ProcessorState Job) (j : Job), ideal_progress_proc_model PState -> forall s : PState, scheduled_in j s -> 0 < service_in j s
END|prosa.analysis.facts.behavior.completion.scheduled_implies_serviced
BEGIN|prosa.analysis.facts.behavior.completion.scheduled_implies_positive_remaining_cost
@scheduled_implies_positive_remaining_cost
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), completed_jobs_dont_execute sched -> ideal_progress_proc_model PState -> forall t : instant, scheduled_at sched j t -> 0 < remaining_cost sched j t
END|prosa.analysis.facts.behavior.completion.scheduled_implies_positive_remaining_cost
BEGIN|prosa.analysis.facts.behavior.completion.scheduled_implies_not_completed
@scheduled_implies_not_completed
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), completed_jobs_dont_execute sched -> forall t : instant, scheduled_at sched j t -> ~~ completed_by sched j t
END|prosa.analysis.facts.behavior.completion.scheduled_implies_not_completed
BEGIN|prosa.analysis.facts.behavior.completion.not_scheduled_remains_incomplete
@not_scheduled_remains_incomplete
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), ~~ completed_by sched j t -> ~~ scheduled_at sched j t -> ~~ completed_by sched j t.+1
END|prosa.analysis.facts.behavior.completion.not_scheduled_remains_incomplete
BEGIN|prosa.analysis.facts.behavior.completion.completed_implies_not_scheduled
@completed_implies_not_scheduled
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), completed_jobs_dont_execute sched -> forall t : instant, completed_by sched j t -> ~~ scheduled_at sched j t
END|prosa.analysis.facts.behavior.completion.completed_implies_not_scheduled
BEGIN|prosa.analysis.facts.behavior.completion.not_pending_earlier_and_at_0
@not_pending_earlier_and_at_0
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), ~~ pending_earlier_and_at sched j 0
END|prosa.analysis.facts.behavior.completion.not_pending_earlier_and_at_0
BEGIN|prosa.analysis.facts.behavior.completion.unit_service
@unit_service
     : forall (Job : JobType) (PState : ProcessorState Job) (j : Job), unit_service_proc_model PState -> forall s : PState, service_in j s <= 1
END|prosa.analysis.facts.behavior.completion.unit_service
BEGIN|prosa.analysis.facts.behavior.completion.service_at_most_cost
@service_at_most_cost
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState), completed_jobs_dont_execute sched -> forall j : Job, unit_service_proc_model PState -> forall t : instant, service sched j t <= job_cost j
END|prosa.analysis.facts.behavior.completion.service_at_most_cost
BEGIN|prosa.analysis.facts.behavior.completion.service_cost_invariant
@service_cost_invariant
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState), completed_jobs_dont_execute sched -> forall j : Job, unit_service_proc_model PState -> forall t : instant, service sched j t + remaining_cost sched j t = job_cost j
END|prosa.analysis.facts.behavior.completion.service_cost_invariant
BEGIN|prosa.analysis.facts.behavior.completion.cumulative_service_le_job_cost
@cumulative_service_le_job_cost
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState), completed_jobs_dont_execute sched -> forall j : Job, unit_service_proc_model PState -> forall t t' : instant, service_during sched j t t' <= job_cost j
END|prosa.analysis.facts.behavior.completion.cumulative_service_le_job_cost
BEGIN|prosa.analysis.facts.behavior.completion.job_doesnt_complete_before_remaining_cost
@job_doesnt_complete_before_remaining_cost
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState), completed_jobs_dont_execute sched -> forall j : Job, unit_service_proc_model PState -> forall t : instant, ~~ completed_by sched j t -> ~~ completed_by sched j (t + remaining_cost sched j t - 1)
END|prosa.analysis.facts.behavior.completion.job_doesnt_complete_before_remaining_cost
BEGIN|prosa.analysis.facts.behavior.completion.has_arrived_scheduled
@has_arrived_scheduled
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (H0 : JobArrival Job), jobs_must_arrive_to_execute sched -> forall t : instant, scheduled_at sched j t -> has_arrived j t
END|prosa.analysis.facts.behavior.completion.has_arrived_scheduled
BEGIN|prosa.analysis.facts.behavior.completion.scheduled_implies_pending
@scheduled_implies_pending
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState), completed_jobs_dont_execute sched -> forall (j : Job) (H0 : JobArrival Job), jobs_must_arrive_to_execute sched -> forall t : instant, scheduled_at sched j t -> pending sched j t
END|prosa.analysis.facts.behavior.completion.scheduled_implies_pending
BEGIN|prosa.analysis.facts.behavior.completion.completed_implies_scheduled_before
@completed_implies_scheduled_before
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), 0 < job_cost j -> jobs_must_arrive_to_execute sched -> forall t : instant, completed_by sched j t -> exists t' : nat, job_arrival j <= t' < t /\ scheduled_at sched j t'
END|prosa.analysis.facts.behavior.completion.completed_implies_scheduled_before
BEGIN|prosa.analysis.facts.behavior.completion.job_pending_at_arrival
@job_pending_at_arrival
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), 0 < job_cost j -> jobs_must_arrive_to_execute sched -> pending sched j (job_arrival j)
END|prosa.analysis.facts.behavior.completion.job_pending_at_arrival
BEGIN|prosa.analysis.facts.behavior.completion.ready_implies_incomplete
@ready_implies_incomplete
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job) (H0 : JobArrival Job) (jr : JobReady Job PState) (j : Job) (t : instant), job_ready sched j t -> ~~ completed_by sched j t
END|prosa.analysis.facts.behavior.completion.ready_implies_incomplete
BEGIN|prosa.analysis.facts.behavior.completion.completed_jobs_are_not_ready
@completed_jobs_are_not_ready
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job) (H0 : JobArrival Job) (jr : JobReady Job PState), jobs_must_be_ready_to_execute sched -> completed_jobs_dont_execute sched
END|prosa.analysis.facts.behavior.completion.completed_jobs_are_not_ready
BEGIN|prosa.analysis.facts.behavior.completion.valid_schedule_implies_completed_jobs_dont_execute
@valid_schedule_implies_completed_jobs_dont_execute
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job) (H0 : JobArrival Job) (jr : JobReady Job PState) (arr_seq : arrival_sequence Job), valid_schedule sched arr_seq -> completed_jobs_dont_execute sched
END|prosa.analysis.facts.behavior.completion.valid_schedule_implies_completed_jobs_dont_execute
BEGIN|prosa.analysis.facts.behavior.completion.ideal_progress_completed_jobs
@ideal_progress_completed_jobs
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (H : JobCost Job), ideal_progress_proc_model PState -> (forall (j : Job) (t : instant), service sched j t <= job_cost j) -> completed_jobs_dont_execute sched
END|prosa.analysis.facts.behavior.completion.ideal_progress_completed_jobs
BEGIN|prosa.analysis.facts.behavior.completion.identical_prefix_completed_by
@identical_prefix_completed_by
     : forall (Job : JobType) (PState : ProcessorState Job) (jc : JobCost Job) (sched1 sched2 : schedule PState) (h : instant), identical_prefix sched1 sched2 h -> forall (j : Job) (t : nat), t <= h -> completed_by sched1 j t = completed_by sched2 j t
END|prosa.analysis.facts.behavior.completion.identical_prefix_completed_by
BEGIN|prosa.analysis.facts.behavior.completion.identical_prefix_pending
@identical_prefix_pending
     : forall (Job : JobType) (PState : ProcessorState Job) (jc : JobCost Job) (ja : JobArrival Job) (sched1 sched2 : schedule PState) (h : instant), identical_prefix sched1 sched2 h -> forall (j : Job) (t : nat), t <= h -> pending sched1 j t = pending sched2 j t
END|prosa.analysis.facts.behavior.completion.identical_prefix_pending
BEGIN|prosa.analysis.facts.behavior.deadlines.incomplete_implies_later_deadline
@incomplete_implies_later_deadline
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), job_meets_deadline sched j -> ~~ completed_by sched j t -> t < job_deadline j
END|prosa.analysis.facts.behavior.deadlines.incomplete_implies_later_deadline
BEGIN|prosa.analysis.facts.behavior.deadlines.incomplete_implies_scheduled_later
@incomplete_implies_scheduled_later
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), job_meets_deadline sched j -> ~~ completed_by sched j t -> exists t' : nat, t <= t' < job_deadline j /\ scheduled_at sched j t'
END|prosa.analysis.facts.behavior.deadlines.incomplete_implies_scheduled_later
BEGIN|prosa.analysis.facts.behavior.deadlines.scheduled_at_implies_later_deadline
@scheduled_at_implies_later_deadline
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (PState : ProcessorState Job) (sched : schedule PState), completed_jobs_dont_execute sched -> forall (j : Job) (t : instant), job_meets_deadline sched j -> scheduled_at sched j t -> t < job_deadline j
END|prosa.analysis.facts.behavior.deadlines.scheduled_at_implies_later_deadline
BEGIN|prosa.analysis.facts.behavior.deadlines.service_invariant_implies_deadline_met
@service_invariant_implies_deadline_met
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (PState : ProcessorState Job) (sched sched' : schedule PState) (j : Job), service sched j (job_deadline j) = service sched' j (job_deadline j) -> job_meets_deadline sched j <-> job_meets_deadline sched' j
END|prosa.analysis.facts.behavior.deadlines.service_invariant_implies_deadline_met
BEGIN|prosa.analysis.facts.behavior.service.service_during_geq
@service_during_geq
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : nat), t2 <= t1 -> service_during sched j t1 t2 = 0
END|prosa.analysis.facts.behavior.service.service_during_geq
BEGIN|prosa.analysis.facts.behavior.service.service_during_ge
@service_during_ge
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant) (k : nat), k < service_during sched j t1 t2 -> t1 < t2
END|prosa.analysis.facts.behavior.service.service_during_ge
BEGIN|prosa.analysis.facts.behavior.service.service0
@service0
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), service sched j 0 = 0
END|prosa.analysis.facts.behavior.service.service0
BEGIN|prosa.analysis.facts.behavior.service.service_during_instant
@service_during_instant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), service_during sched j t t.+1 = service_at sched j t
END|prosa.analysis.facts.behavior.service.service_during_instant
BEGIN|prosa.analysis.facts.behavior.service.service_during_cat
@service_during_cat
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 t3 : nat), t1 <= t2 <= t3 -> service_during sched j t1 t2 + service_during sched j t2 t3 = service_during sched j t1 t3
END|prosa.analysis.facts.behavior.service.service_during_cat
BEGIN|prosa.analysis.facts.behavior.service.service_cat
@service_cat
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : nat), t1 <= t2 -> service sched j t1 + service_during sched j t1 t2 = service sched j t2
END|prosa.analysis.facts.behavior.service.service_cat
BEGIN|prosa.analysis.facts.behavior.service.service_during_first_plus_later
@service_during_first_plus_later
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : nat), t1 < t2 -> service_at sched j t1 + service_during sched j t1.+1 t2 = service_during sched j t1 t2
END|prosa.analysis.facts.behavior.service.service_during_first_plus_later
BEGIN|prosa.analysis.facts.behavior.service.service_during_last_plus_before
@service_during_last_plus_before
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : nat), t1 <= t2 -> service_during sched j t1 t2 + service_at sched j t2 = service_during sched j t1 t2.+1
END|prosa.analysis.facts.behavior.service.service_during_last_plus_before
BEGIN|prosa.analysis.facts.behavior.service.service_last_plus_before
@service_last_plus_before
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), service sched j t + service_at sched j t = service sched j t.+1
END|prosa.analysis.facts.behavior.service.service_last_plus_before
BEGIN|prosa.analysis.facts.behavior.service.service_split_at_point
@service_split_at_point
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 t3 : nat), t1 <= t2 < t3 -> service_during sched j t1 t2 + service_at sched j t2 + service_during sched j t2.+1 t3 = service_during sched j t1 t3
END|prosa.analysis.facts.behavior.service.service_split_at_point
BEGIN|prosa.analysis.facts.behavior.service.service_at_most_one
@service_at_most_one
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> forall (sched : schedule PState) (j : Job) (t : instant), service_at sched j t <= 1
END|prosa.analysis.facts.behavior.service.service_at_most_one
BEGIN|prosa.analysis.facts.behavior.service.service_is_zero_or_one
@service_is_zero_or_one
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> forall (sched : schedule PState) (j : Job) (t : instant), service_at sched j t = 0 \/ service_at sched j t = 1
END|prosa.analysis.facts.behavior.service.service_is_zero_or_one
BEGIN|prosa.analysis.facts.behavior.service.cumulative_service_le_delta
@cumulative_service_le_delta
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> forall (sched : schedule PState) (j : Job) (t : instant) (delta : nat), service_during sched j t (t + delta) <= delta
END|prosa.analysis.facts.behavior.service.cumulative_service_le_delta
BEGIN|prosa.analysis.facts.behavior.service.cumulative_service_ge_delta
@cumulative_service_ge_delta
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> forall (sched : schedule PState) (j : Job) (t : instant) (delta ρ : nat), ρ <= service_during sched j t (t + delta) -> ρ <= delta
END|prosa.analysis.facts.behavior.service.cumulative_service_ge_delta
BEGIN|prosa.analysis.facts.behavior.service.service_during_is_unit_growth_function
@service_during_is_unit_growth_function
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> forall (sched : schedule PState) (j : Job) (t0 : instant), unit_growth_function (service_during sched j t0)
END|prosa.analysis.facts.behavior.service.service_during_is_unit_growth_function
BEGIN|prosa.analysis.facts.behavior.service.service_is_unit_growth_function
@service_is_unit_growth_function
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> forall (sched : schedule PState) (j : Job), unit_growth_function (service sched j)
END|prosa.analysis.facts.behavior.service.service_is_unit_growth_function
BEGIN|prosa.analysis.facts.behavior.service.exists_intermediate_service_during
@exists_intermediate_service_during
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> forall (sched : schedule PState) (j : Job) (t0 t1 t2 s : nat), t0 <= t1 <= t2 -> service_during sched j t0 t1 <= s < service_during sched j t0 t2 -> exists t : nat, t1 <= t < t2 /\ service_during sched j t0 t = s
END|prosa.analysis.facts.behavior.service.exists_intermediate_service_during
BEGIN|prosa.analysis.facts.behavior.service.exists_intermediate_service
@exists_intermediate_service
     : forall (Job : JobType) (PState : ProcessorState Job), unit_service_proc_model PState -> forall (sched : schedule PState) (j : Job) (t : instant) (s : duration), s < service sched j t -> exists t' : nat, t' < t /\ service sched j t' = s
END|prosa.analysis.facts.behavior.service.exists_intermediate_service
BEGIN|prosa.analysis.facts.behavior.service.ideal_progress_inside_supplies
@ideal_progress_inside_supplies
     : forall (Job : JobType) (PState : ProcessorState Job), fully_consuming_proc_model PState -> forall (sched : schedule PState) (j : Job) (t : instant), has_supply sched t -> scheduled_at sched j t -> receives_service_at sched j t
END|prosa.analysis.facts.behavior.service.ideal_progress_inside_supplies
BEGIN|prosa.analysis.facts.behavior.service.service_monotonic
@service_monotonic
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : nat), t1 <= t2 -> service sched j t1 <= service sched j t2
END|prosa.analysis.facts.behavior.service.service_monotonic
BEGIN|prosa.analysis.facts.behavior.service.service_in_implies_scheduled_in
@service_in_implies_scheduled_in
     : forall (Job : JobType) (PState : ProcessorState Job) (j : Job) (s : PState), ~~ scheduled_in j s -> service_in j s = 0
END|prosa.analysis.facts.behavior.service.service_in_implies_scheduled_in
BEGIN|prosa.analysis.facts.behavior.service.not_scheduled_implies_no_service
@not_scheduled_implies_no_service
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), ~~ scheduled_at sched j t -> service_at sched j t = 0
END|prosa.analysis.facts.behavior.service.not_scheduled_implies_no_service
BEGIN|prosa.analysis.facts.behavior.service.not_scheduled_during_implies_zero_service
@not_scheduled_during_implies_zero_service
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : nat), (forall t : nat, t1 <= t < t2 -> ~~ scheduled_at sched j t) -> service_during sched j t1 t2 = 0
END|prosa.analysis.facts.behavior.service.not_scheduled_during_implies_zero_service
BEGIN|prosa.analysis.facts.behavior.service.service_at_implies_scheduled_at
@service_at_implies_scheduled_at
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), 0 < service_at sched j t -> scheduled_at sched j t
END|prosa.analysis.facts.behavior.service.service_at_implies_scheduled_at
BEGIN|prosa.analysis.facts.behavior.service.service_delta_implies_scheduled
@service_delta_implies_scheduled
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), service sched j t < service sched j t.+1 -> scheduled_at sched j t
END|prosa.analysis.facts.behavior.service.service_delta_implies_scheduled
BEGIN|prosa.analysis.facts.behavior.service.service_during_service_at
@service_during_service_at
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant), 0 < service_during sched j t1 t2 <-> (exists t : nat, t1 <= t < t2 /\ 0 < service_at sched j t)
END|prosa.analysis.facts.behavior.service.service_during_service_at
BEGIN|prosa.analysis.facts.behavior.service.cumulative_service_implies_scheduled
@cumulative_service_implies_scheduled
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant), 0 < service_during sched j t1 t2 -> exists t : nat, t1 <= t < t2 /\ scheduled_at sched j t
END|prosa.analysis.facts.behavior.service.cumulative_service_implies_scheduled
BEGIN|prosa.analysis.facts.behavior.service.positive_service_implies_scheduled_before
@positive_service_implies_scheduled_before
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), 0 < service sched j t -> exists t' : nat, t' < t /\ scheduled_at sched j t'
END|prosa.analysis.facts.behavior.service.positive_service_implies_scheduled_before
BEGIN|prosa.analysis.facts.behavior.service.service_during_service_at_earliest
@service_during_service_at_earliest
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant), 0 < service_during sched j t1 t2 -> exists t : nat, t1 <= t < t2 /\ 0 < service_at sched j t /\ service_during sched j t1 t = 0
END|prosa.analysis.facts.behavior.service.service_during_service_at_earliest
BEGIN|prosa.analysis.facts.behavior.service.service_during_scheduled_at_earliest
@service_during_scheduled_at_earliest
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant), 0 < service_during sched j t1 t2 -> exists t : nat, t1 <= t < t2 /\ scheduled_at sched j t /\ service_during sched j t1 t = 0
END|prosa.analysis.facts.behavior.service.service_during_scheduled_at_earliest
BEGIN|prosa.analysis.facts.behavior.service.no_service_not_scheduled
@no_service_not_scheduled
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), ideal_progress_proc_model PState -> forall t : instant, ~~ scheduled_at sched j t <-> service_at sched j t = 0
END|prosa.analysis.facts.behavior.service.no_service_not_scheduled
BEGIN|prosa.analysis.facts.behavior.service.no_service_during_implies_not_scheduled
@no_service_during_implies_not_scheduled
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), ideal_progress_proc_model PState -> forall t1 t2 : instant, service_during sched j t1 t2 = 0 -> forall t : nat, t1 <= t < t2 -> ~~ scheduled_at sched j t
END|prosa.analysis.facts.behavior.service.no_service_during_implies_not_scheduled
BEGIN|prosa.analysis.facts.behavior.service.scheduled_implies_cumulative_service
@scheduled_implies_cumulative_service
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), ideal_progress_proc_model PState -> forall t1 t2 : nat, (exists t : nat, t1 <= t < t2 /\ scheduled_at sched j t) -> 0 < service_during sched j t1 t2
END|prosa.analysis.facts.behavior.service.scheduled_implies_cumulative_service
BEGIN|prosa.analysis.facts.behavior.service.scheduled_implies_nonzero_service
@scheduled_implies_nonzero_service
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), ideal_progress_proc_model PState -> forall t : nat, (exists t' : nat, t' < t /\ scheduled_at sched j t') -> 0 < service sched j t
END|prosa.analysis.facts.behavior.service.scheduled_implies_nonzero_service
BEGIN|prosa.analysis.facts.behavior.service.unit_service_at1
@unit_service_at1
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job), ideal_progress_proc_model PState -> unit_service_proc_model PState -> forall t : instant, scheduled_at sched j t -> service_at sched j t = 1
END|prosa.analysis.facts.behavior.service.unit_service_at1
BEGIN|prosa.analysis.facts.behavior.service.not_scheduled_before_arrival
@not_scheduled_before_arrival
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (H : JobArrival Job), jobs_must_arrive_to_execute sched -> forall t : nat, t < job_arrival j -> ~~ scheduled_at sched j t
END|prosa.analysis.facts.behavior.service.not_scheduled_before_arrival
BEGIN|prosa.analysis.facts.behavior.service.positive_service_implies_scheduled_since_arrival
@positive_service_implies_scheduled_since_arrival
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (H : JobArrival Job), jobs_must_arrive_to_execute sched -> forall t : instant, 0 < service sched j t -> exists t' : nat, job_arrival j <= t' < t /\ scheduled_at sched j t'
END|prosa.analysis.facts.behavior.service.positive_service_implies_scheduled_since_arrival
BEGIN|prosa.analysis.facts.behavior.service.service_before_job_arrival_zero
@service_before_job_arrival_zero
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (H : JobArrival Job), jobs_must_arrive_to_execute sched -> forall t : nat, t < job_arrival j -> service_at sched j t = 0
END|prosa.analysis.facts.behavior.service.service_before_job_arrival_zero
BEGIN|prosa.analysis.facts.behavior.service.cumulative_service_before_job_arrival_zero
@cumulative_service_before_job_arrival_zero
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (H : JobArrival Job), jobs_must_arrive_to_execute sched -> forall t1 t2 : instant, t2 <= job_arrival j -> service_during sched j t1 t2 = 0
END|prosa.analysis.facts.behavior.service.cumulative_service_before_job_arrival_zero
BEGIN|prosa.analysis.facts.behavior.service.ignore_service_before_arrival
@ignore_service_before_arrival
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (H : JobArrival Job), jobs_must_arrive_to_execute sched -> forall t1 t2 : nat, t1 <= job_arrival j -> job_arrival j <= t2 -> service_during sched j t1 t2 = service_during sched j (job_arrival j) t2
END|prosa.analysis.facts.behavior.service.ignore_service_before_arrival
BEGIN|prosa.analysis.facts.behavior.service.no_service_before_arrival
@no_service_before_arrival
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (H : JobArrival Job), jobs_must_arrive_to_execute sched -> forall t : nat, t <= job_arrival j -> service sched j t = 0
END|prosa.analysis.facts.behavior.service.no_service_before_arrival
BEGIN|prosa.analysis.facts.behavior.service.constant_service_implies_no_service_during
@constant_service_implies_no_service_during
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant), t1 <= t2 -> service sched j t1 = service sched j t2 -> service_during sched j t1 t2 = 0
END|prosa.analysis.facts.behavior.service.constant_service_implies_no_service_during
BEGIN|prosa.analysis.facts.behavior.service.constant_service_implies_not_scheduled
@constant_service_implies_not_scheduled
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant), t1 <= t2 -> service sched j t1 = service sched j t2 -> forall t : nat, t1 <= t < t2 -> service_at sched j t = 0
END|prosa.analysis.facts.behavior.service.constant_service_implies_not_scheduled
BEGIN|prosa.analysis.facts.behavior.service.same_service_implies_serviced_at_earlier_times
@same_service_implies_serviced_at_earlier_times
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant), t1 <= t2 -> service sched j t1 = service sched j t2 -> [exists t, 0 < service_at sched j t] = [exists t', 0 < service_at sched j t']
END|prosa.analysis.facts.behavior.service.same_service_implies_serviced_at_earlier_times
BEGIN|prosa.analysis.facts.behavior.service.same_service_implies_scheduled_at_earlier_times
@same_service_implies_scheduled_at_earlier_times
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant), t1 <= t2 -> service sched j t1 = service sched j t2 -> ideal_progress_proc_model PState -> [exists t, scheduled_at sched j t] = [exists t', scheduled_at sched j t']
END|prosa.analysis.facts.behavior.service.same_service_implies_scheduled_at_earlier_times
BEGIN|prosa.analysis.facts.behavior.service.receives_service_and_served_at_consistent
@receives_service_and_served_at_consistent
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (j : Job) (t : instant), receives_service_at sched j t -> j \in served_jobs_at arr_seq sched t
END|prosa.analysis.facts.behavior.service.receives_service_and_served_at_consistent
BEGIN|prosa.analysis.facts.behavior.service.served_at_and_receives_service_consistent
@served_at_and_receives_service_consistent
     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (j : Job) (t : instant), j \in served_jobs_at arr_seq sched t -> receives_service_at sched j t
END|prosa.analysis.facts.behavior.service.served_at_and_receives_service_consistent
BEGIN|prosa.analysis.facts.behavior.service.no_service_received_when_idle
@no_service_received_when_idle
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (j : Job) (t : instant), is_idle arr_seq sched t -> ~~ receives_service_at sched j t
END|prosa.analysis.facts.behavior.service.no_service_received_when_idle
BEGIN|prosa.analysis.facts.behavior.service.receives_service_implies_has_supply
@receives_service_implies_has_supply
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), receives_service_at sched j t -> has_supply sched t
END|prosa.analysis.facts.behavior.service.receives_service_implies_has_supply
BEGIN|prosa.analysis.facts.behavior.service.no_blackout_when_service_received
@no_blackout_when_service_received
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), receives_service_at sched j t -> ~~ is_blackout sched t
END|prosa.analysis.facts.behavior.service.no_blackout_when_service_received
BEGIN|prosa.analysis.facts.behavior.service.no_service_during_blackout
@no_service_during_blackout
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), is_blackout sched t -> service_at sched j t = 0
END|prosa.analysis.facts.behavior.service.no_service_during_blackout
BEGIN|prosa.analysis.facts.behavior.service.only_one_job_receives_service_at_uni
@only_one_job_receives_service_at_uni
     : forall (Job : JobType) (PState : ProcessorState Job), uniprocessor_model PState -> forall (sched : schedule PState) (j1 j2 : Job) (t : instant), receives_service_at sched j1 t -> receives_service_at sched j2 t -> j1 = j2
END|prosa.analysis.facts.behavior.service.only_one_job_receives_service_at_uni
BEGIN|prosa.analysis.facts.behavior.service.incremental_service_during
@incremental_service_during
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState), unit_service_proc_model PState -> forall (j : Job) (t1 t2 : instant) (k : nat), k < service_during sched j t1 t2 -> exists t : nat, t1 <= t < t2 /\ scheduled_at sched j t /\ service_during sched j t1 t = k
END|prosa.analysis.facts.behavior.service.incremental_service_during
BEGIN|prosa.analysis.facts.behavior.service.kth_scheduling_time
@kth_scheduling_time
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t t' : instant) (k : nat), service sched j t = k -> k < service sched j t' -> exists st : nat, t <= st < t' /\ service sched j st = k /\ scheduled_at sched j st
END|prosa.analysis.facts.behavior.service.kth_scheduling_time
BEGIN|prosa.analysis.facts.behavior.service.same_service_during
@same_service_during
     : forall (Job : JobType) (PState : ProcessorState Job) (sched1 sched2 : schedule PState) (t1 t2 : instant) (j : Job), (forall t : nat, t1 <= t < t2 -> service_at sched1 j t = service_at sched2 j t) -> service_during sched1 j t1 t2 = service_during sched2 j t1 t2
END|prosa.analysis.facts.behavior.service.same_service_during
BEGIN|prosa.analysis.facts.behavior.service.equal_prefix_implies_same_service_during
@equal_prefix_implies_same_service_during
     : forall (Job : JobType) (PState : ProcessorState Job) (sched1 sched2 : schedule PState) (t1 t2 : nat), (forall t : nat, t1 <= t < t2 -> sched1 t = sched2 t) -> forall j : Job, service_during sched1 j t1 t2 = service_during sched2 j t1 t2
END|prosa.analysis.facts.behavior.service.equal_prefix_implies_same_service_during
BEGIN|prosa.analysis.facts.behavior.service.identical_prefix_service
@identical_prefix_service
     : forall (Job : JobType) (PState : ProcessorState Job) (sched1 sched2 : schedule PState) (h : instant), identical_prefix sched1 sched2 h -> forall j : Job, service sched1 j h = service sched2 j h
END|prosa.analysis.facts.behavior.service.identical_prefix_service
BEGIN|prosa.analysis.facts.behavior.supply.service_at_le_supply_at
@service_at_le_supply_at
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), service_at sched j t <= supply_at sched t
END|prosa.analysis.facts.behavior.supply.service_at_le_supply_at
BEGIN|prosa.analysis.facts.behavior.supply.pos_service_impl_pos_supply
@pos_service_impl_pos_supply
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), 0 < service_at sched j t -> 0 < supply_at sched t
END|prosa.analysis.facts.behavior.supply.pos_service_impl_pos_supply
BEGIN|prosa.analysis.facts.behavior.supply.blackout_or_supply
@blackout_or_supply
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t : instant), is_blackout sched t \/ has_supply sched t
END|prosa.analysis.facts.behavior.supply.blackout_or_supply
BEGIN|prosa.analysis.facts.behavior.supply.supply_at_complement
@supply_at_complement
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (t : instant), supply_at sched t = 1 - is_blackout sched t
END|prosa.analysis.facts.behavior.supply.supply_at_complement
BEGIN|prosa.analysis.facts.behavior.supply.is_blackout_complement
@is_blackout_complement
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (t : instant), is_blackout sched t = 1 - supply_at sched t
END|prosa.analysis.facts.behavior.supply.is_blackout_complement
BEGIN|prosa.analysis.facts.behavior.supply.supply_at_le_1
@supply_at_le_1
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (t : instant), supply_at sched t <= 1
END|prosa.analysis.facts.behavior.supply.supply_at_le_1
BEGIN|prosa.analysis.facts.behavior.supply.unit_supply_proc_service_case
@unit_supply_proc_service_case
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (j : Job) (t : instant), service_at sched j t = 0 \/ service_at sched j t = 1
END|prosa.analysis.facts.behavior.supply.unit_supply_proc_service_case
BEGIN|prosa.analysis.facts.behavior.supply.supply_during_bound
@supply_during_bound
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (t : instant) (δ : nat), supply_during sched t (t + δ) <= δ
END|prosa.analysis.facts.behavior.supply.supply_during_bound
BEGIN|prosa.analysis.facts.behavior.supply.blackout_during_bound
@blackout_during_bound
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t : instant) (δ : nat), blackout_during sched t (t + δ) <= δ
END|prosa.analysis.facts.behavior.supply.blackout_during_bound
BEGIN|prosa.analysis.facts.behavior.supply.supply_during_last_plus_before
@supply_during_last_plus_before
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : nat), t1 <= t2 -> supply_during sched t1 t2.+1 = supply_during sched t1 t2 + supply_at sched t2
END|prosa.analysis.facts.behavior.supply.supply_during_last_plus_before
BEGIN|prosa.analysis.facts.behavior.supply.blackout_during_last_plus_before
@blackout_during_last_plus_before
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : nat), t1 <= t2 -> blackout_during sched t1 t2.+1 = blackout_during sched t1 t2 + is_blackout sched t2
END|prosa.analysis.facts.behavior.supply.blackout_during_last_plus_before
BEGIN|prosa.analysis.facts.behavior.supply.supply_during_complement
@supply_during_complement
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (t : instant) (δ : nat), supply_during sched t (t + δ) = δ - blackout_during sched t (t + δ)
END|prosa.analysis.facts.behavior.supply.supply_during_complement
BEGIN|prosa.analysis.facts.behavior.supply.blackout_during_complement
@blackout_during_complement
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (sched : schedule PState) (t : instant) (δ : nat), blackout_during sched t (t + δ) = δ - supply_during sched t (t + δ)
END|prosa.analysis.facts.behavior.supply.blackout_during_complement
BEGIN|prosa.analysis.facts.behavior.supply.blackout_during_cat
@blackout_during_cat
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 t : instant), t1 <= t <= t2 -> blackout_during sched t1 t + blackout_during sched t t2 = blackout_during sched t1 t2
END|prosa.analysis.facts.behavior.supply.blackout_during_cat
BEGIN|prosa.analysis.facts.behavior.supply.blackout_during_unit_growth
@blackout_during_unit_growth
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t : instant), unit_growth_function (blackout_during sched t)
END|prosa.analysis.facts.behavior.supply.blackout_during_unit_growth
BEGIN|prosa.analysis.facts.behavior.supply.progress_inside_supplies
@progress_inside_supplies
     : forall (Job : JobType) (PState : ProcessorState Job), fully_consuming_proc_model PState -> forall (sched : schedule PState) (j : Job) (t : instant), has_supply sched t -> scheduled_at sched j t -> 0 < service_at sched j t
END|prosa.analysis.facts.behavior.supply.progress_inside_supplies
BEGIN|prosa.analysis.facts.blocking_bound.edf.nonpreemptive_segments_bounded_by_blocking
@edf.nonpreemptive_segments_bounded_by_blocking
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (H1 : TaskDeadline Task) (H2 : TaskMaxNonpreemptiveSegment Task) (Job : JobType) (H3 : JobTask Job Task) (H4 : JobCost Job) (H5 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, arrivals_have_valid_job_costs arr_seq -> forall H6 : JobPreemptable Job, valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> forall tsk : Task, tsk \in ts -> taskset_respects_max_arrivals arr_seq ts -> forall j : Job, job_of_task tsk j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> max_lp_nonpreemptive_segment arr_seq j t1 <= edf.blocking_bound ts tsk (job_arrival j - t1)
END|prosa.analysis.facts.blocking_bound.edf.nonpreemptive_segments_bounded_by_blocking
BEGIN|prosa.analysis.facts.blocking_bound.elf.nonpreemptive_segments_bounded_by_blocking
@elf.nonpreemptive_segments_bounded_by_blocking
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (H1 : TaskMaxNonpreemptiveSegment Task) (H2 : PriorityPoint Task) (Job : JobType) (H3 : JobTask Job Task) (H4 : JobCost Job) (H5 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, arrivals_have_valid_job_costs arr_seq -> forall H6 : JobPreemptable Job, valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> forall tsk : Task, tsk \in ts -> taskset_respects_max_arrivals arr_seq ts -> forall j : Job, job_of_task tsk j -> forall FP : FP_policy Task, total_task_priorities FP -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> max_lp_nonpreemptive_segment arr_seq j t1 <= elf.blocking_bound ts tsk (job_arrival j - t1)
END|prosa.analysis.facts.blocking_bound.elf.nonpreemptive_segments_bounded_by_blocking
BEGIN|prosa.analysis.facts.blocking_bound.fp.nonpreemptive_segments_bounded_by_blocking
@nonpreemptive_segments_bounded_by_blocking
     : forall (Task : TaskType) (H0 : TaskMaxNonpreemptiveSegment Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobCost Job) (PState : ProcessorState Job) (FP : FP_policy Task) (arr_seq : arrival_sequence Job) (sched : schedule PState) (H3 : JobPreemptable Job), valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> forall (tsk : Task) (j : Job), job_of_task tsk j -> forall t : instant, max_lp_nonpreemptive_segment arr_seq j t <= blocking_bound ts tsk
END|prosa.analysis.facts.blocking_bound.fp.nonpreemptive_segments_bounded_by_blocking
BEGIN|prosa.analysis.facts.busy_interval.arrival.busy_interval_prefix_job_arrival
@busy_interval_prefix_job_arrival
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JLFP_policy Job) (PState : ProcessorState Job) (sched : schedule PState) (arr_seq : arrival_sequence Job) (j : Job) (t t' : instant), busy_interval_prefix arr_seq sched j t t' -> t <= job_arrival j
END|prosa.analysis.facts.busy_interval.arrival.busy_interval_prefix_job_arrival
BEGIN|prosa.analysis.facts.busy_interval.arrival.busy_interval_job_arrival
@busy_interval_job_arrival
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JLFP_policy Job) (PState : ProcessorState Job) (sched : schedule PState) (arr_seq : arrival_sequence Job) (j : Job) (t t' : instant), busy_interval arr_seq sched j t t' -> t <= job_arrival j
END|prosa.analysis.facts.busy_interval.arrival.busy_interval_job_arrival
BEGIN|prosa.analysis.facts.busy_interval.arrival.busy_prefix_starts_when_hep_job_arrives
@busy_prefix_starts_when_hep_job_arrives
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (JLFP : JLFP_policy Job), reflexive_job_priorities JLFP -> forall (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_must_arrive_to_execute sched -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> exists j_a : Job, arrives_at arr_seq j_a t1 /\ hep_job j_a j
END|prosa.analysis.facts.busy_interval.arrival.busy_prefix_starts_when_hep_job_arrives
BEGIN|prosa.analysis.facts.busy_interval.carry_in.no_carry_in_at_zero
@no_carry_in_at_zero
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job) (PState : ProcessorState Job) (sched : schedule PState), no_carry_in arr_seq sched 0
END|prosa.analysis.facts.busy_interval.carry_in.no_carry_in_at_zero
BEGIN|prosa.analysis.facts.busy_interval.carry_in.pending_job_not_idle
@pending_job_not_idle
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (PState : ProcessorState Job) (sched : schedule PState), jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> work_conserving arr_seq sched -> forall (j : Job) (t : instant), arrives_in arr_seq j -> pending sched j t -> ~ is_idle arr_seq sched t
END|prosa.analysis.facts.busy_interval.carry_in.pending_job_not_idle
BEGIN|prosa.analysis.facts.busy_interval.carry_in.idle_instant_no_carry_in
@idle_instant_no_carry_in
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (PState : ProcessorState Job) (sched : schedule PState), jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> work_conserving arr_seq sched -> forall t : instant, is_idle arr_seq sched t -> no_carry_in arr_seq sched t
END|prosa.analysis.facts.busy_interval.carry_in.idle_instant_no_carry_in
BEGIN|prosa.analysis.facts.busy_interval.carry_in.idle_instant_next_no_carry_in
@idle_instant_next_no_carry_in
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (PState : ProcessorState Job) (sched : schedule PState), jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> work_conserving arr_seq sched -> forall t : instant, is_idle arr_seq sched t -> no_carry_in arr_seq sched t.+1
END|prosa.analysis.facts.busy_interval.carry_in.idle_instant_next_no_carry_in
BEGIN|prosa.analysis.facts.busy_interval.carry_in.total_service_is_bounded_by_Δ
@total_service_is_bounded_by_Δ
     : forall (Job : JobType) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall (sched : schedule PState) (Δ : duration), unit_service_proc_model PState -> forall t : duration, blackout_during sched t (t + Δ) + service_of_jobs sched predT (arrivals_between arr_seq 0 (t + Δ)) t (t + Δ) <= Δ
END|prosa.analysis.facts.busy_interval.carry_in.total_service_is_bounded_by_Δ
BEGIN|prosa.analysis.facts.busy_interval.carry_in.low_total_service_implies_existence_of_time_with_no_carry_in
@low_total_service_implies_existence_of_time_with_no_carry_in
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> fully_consuming_proc_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> work_conserving arr_seq sched -> forall Δ : duration, 0 < Δ -> forall t : duration, blackout_during sched t (t + Δ) + service_of_jobs sched predT (arrivals_between arr_seq 0 (t + Δ)) t (t + Δ) < Δ -> exists δ : nat, δ < Δ /\ no_carry_in arr_seq sched (t.+1 + δ)
END|prosa.analysis.facts.busy_interval.carry_in.low_total_service_implies_existence_of_time_with_no_carry_in
BEGIN|prosa.analysis.facts.busy_interval.carry_in.completion_of_all_jobs_implies_no_carry_in
@completion_of_all_jobs_implies_no_carry_in
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (PState : ProcessorState Job) (sched : schedule PState), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall Δ : duration, (forall t : instant, no_carry_in arr_seq sched t -> blackout_during sched t (t + Δ) + total_workload_between arr_seq t (t + Δ) <= Δ) -> unit_service_proc_model PState -> forall t : duration, no_carry_in arr_seq sched t -> blackout_during sched t (t + Δ) + service_of_jobs sched predT (arrivals_between arr_seq 0 (t + Δ)) t (t + Δ) = Δ -> no_carry_in arr_seq sched (t + Δ)
END|prosa.analysis.facts.busy_interval.carry_in.completion_of_all_jobs_implies_no_carry_in
BEGIN|prosa.analysis.facts.busy_interval.carry_in.processor_is_not_too_busy
@processor_is_not_too_busy
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> fully_consuming_proc_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall (JLFP : JLFP_policy Job) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> work_conserving arr_seq sched -> forall Δ : duration, 0 < Δ -> (forall t : instant, no_carry_in arr_seq sched t -> blackout_during sched t (t + Δ) + total_workload_between arr_seq t (t + Δ) <= Δ) -> unit_service_proc_model PState -> forall t : nat, exists δ : nat, δ < Δ /\ no_carry_in arr_seq sched (t + δ)
END|prosa.analysis.facts.busy_interval.carry_in.processor_is_not_too_busy
BEGIN|prosa.analysis.facts.busy_interval.carry_in.busy_interval_from_total_workload_bound
@busy_interval_from_total_workload_bound
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> fully_consuming_proc_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall JobReady0 : JobReady Job PState, work_bearing_readiness arr_seq sched -> work_conserving arr_seq sched -> forall Δ : duration, 0 < Δ -> (forall t : instant, no_carry_in arr_seq sched t -> blackout_during sched t (t + Δ) + total_workload_between arr_seq t (t + Δ) <= Δ) -> unit_service_proc_model PState -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> exists t1 t2 : nat, t1 <= job_arrival j < t2 /\ t2 <= t1 + Δ /\ busy_interval arr_seq sched j t1 t2
END|prosa.analysis.facts.busy_interval.carry_in.busy_interval_from_total_workload_bound
BEGIN|prosa.analysis.facts.busy_interval.existence.job_completes_within_busy_interval
@job_completes_within_busy_interval
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job) (PState : ProcessorState Job) (sched : schedule PState) (JLFP : JLFP_policy Job) (j : Job), arrives_in arr_seq j -> reflexive_job_priorities JLFP -> forall t1 t2 : instant, busy_interval arr_seq sched j t1 t2 -> completed_by sched j t2
END|prosa.analysis.facts.busy_interval.existence.job_completes_within_busy_interval
BEGIN|prosa.analysis.facts.busy_interval.existence.not_quiet_implies_exists_pending_job
@not_quiet_implies_exists_pending_job
