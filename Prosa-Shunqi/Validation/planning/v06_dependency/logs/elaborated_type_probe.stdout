BEGIN|prosa.results.rta.ideal.edf.fully_nonpreemptive.uniprocessor_response_time_bound_fully_nonpreemptive_edf
@ideal.edf.fully_nonpreemptive.uniprocessor_response_time_bound_fully_nonpreemptive_edf
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H4 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> nonpreemptive_schedule sched -> work_conserving arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job) -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> forall R : nat, (forall A : duration, bounded_nps.is_in_search_space ts tsk L A -> exists F : nat, \max_(tsk_o <- ts | blocking_relevant tsk_o && (task_deadline tsk + A < task_deadline tsk_o)) (task_cost tsk_o - 1) + (task_request_bound_function tsk (A + 1) - (task_cost tsk - 1)) + edf_athep_bound.bound_on_athep_workload ts tsk A (A + F) <= A + F /\ F + (task_cost tsk - 1) <= R) -> task_response_time_bound arr_seq sched tsk R
END|prosa.results.rta.ideal.edf.fully_nonpreemptive.uniprocessor_response_time_bound_fully_nonpreemptive_edf
