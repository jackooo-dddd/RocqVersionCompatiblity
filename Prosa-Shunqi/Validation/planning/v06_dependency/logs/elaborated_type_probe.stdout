     : forall (Job : JobType) (H1 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (j : Job) (t : instant), is_idle arr_seq sched t -> ~~ priority_inversion arr_seq sched j t
END|prosa.analysis.facts.priority.inversion.no_priority_inversion_when_idle
BEGIN|prosa.analysis.facts.priority.inversion.priority_inversion_hep_job
@priority_inversion_hep_job
     : forall (Job : JobType) (H1 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall j : Job, uniprocessor_model PState -> forall (t : instant) (j' : Job), scheduled_at sched j' t -> priority_inversion arr_seq sched j t = ~~ hep_job j' j
END|prosa.analysis.facts.priority.inversion.priority_inversion_hep_job
BEGIN|prosa.analysis.facts.priority.inversion.no_priority_inversion_when_hep_job_scheduled
@no_priority_inversion_when_hep_job_scheduled
     : forall (Job : JobType) (H1 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall j : Job, uniprocessor_model PState -> forall (t : instant) (j' : Job), scheduled_at sched j' t -> hep_job j' j -> ~~ priority_inversion arr_seq sched j t
END|prosa.analysis.facts.priority.inversion.no_priority_inversion_when_hep_job_scheduled
BEGIN|prosa.analysis.facts.priority.inversion.uni_priority_inversion_P
@uni_priority_inversion_P
     : forall (Job : JobType) (H1 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall j : Job, uniprocessor_model PState -> forall t : instant, reflect (exists2 j' : Job, scheduled_at sched j' t & ~~ hep_job j' j) (priority_inversion arr_seq sched j t)
END|prosa.analysis.facts.priority.inversion.uni_priority_inversion_P
BEGIN|prosa.analysis.facts.priority.inversion.cumulative_priority_inversion_cat
@cumulative_priority_inversion_cat
     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLFP : JLFP_policy Job) (j : Job) (t_mid t1 t2 : instant), t1 <= t_mid -> t_mid <= t2 -> cumulative_priority_inversion arr_seq sched j t1 t2 = cumulative_priority_inversion arr_seq sched j t1 t_mid + cumulative_priority_inversion arr_seq sched j t_mid t2
END|prosa.analysis.facts.priority.inversion.cumulative_priority_inversion_cat
BEGIN|prosa.analysis.facts.priority.jlfp_with_fp.other_ep_task
@other_ep_task
     : forall Task : TaskType, FP_policy Task -> Task -> Task -> bool
END|prosa.analysis.facts.priority.jlfp_with_fp.other_ep_task
BEGIN|prosa.analysis.facts.priority.jlfp_with_fp.hep_job_of_ep_other_task
@hep_job_of_ep_other_task
     : forall (Task : TaskType) (Job : JobType), JobTask Job Task -> FP_policy Task -> JLFP_policy Job -> Job -> Job -> bool
END|prosa.analysis.facts.priority.jlfp_with_fp.hep_job_of_ep_other_task
BEGIN|prosa.analysis.facts.priority.jlfp_with_fp.hep_workload_from_other_ep_partitioned_by_tasks
@hep_workload_from_other_ep_partitioned_by_tasks
     : forall (Task : TaskType) (Job : JobType) (H0 : JobArrival Job) (H1 : JobTask Job Task) (H2 : JobCost Job) (FP : FP_policy Task) (JLFP : JLFP_policy Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, uniq ts -> all_jobs_from_taskset arr_seq ts -> forall (tsk : Task) (j : Job), job_of_task tsk j -> forall t1 t2 : duration, workload_of_jobs (hep_job_of_ep_other_task j) (arrivals_between arr_seq t1 t2) = \sum_(tsk_o <- ts | other_ep_task tsk tsk_o) workload_of_jobs (fun j0 : Job => hep_job_of_ep_other_task j j0 && (job_task j0 == tsk_o)) (arrivals_between arr_seq t1 t2)
END|prosa.analysis.facts.priority.jlfp_with_fp.hep_workload_from_other_ep_partitioned_by_tasks
BEGIN|prosa.analysis.facts.priority.jlfp_with_fp.from_hp_task
@from_hp_task
     : forall (Task : TaskType) (Job : JobType), JobTask Job Task -> FP_policy Task -> Job -> Job -> bool
END|prosa.analysis.facts.priority.jlfp_with_fp.from_hp_task
BEGIN|prosa.analysis.facts.priority.jlfp_with_fp.hep_from_hp_task
@hep_from_hp_task
     : forall (Task : TaskType) (Job : JobType), JobTask Job Task -> FP_policy Task -> JLFP_policy Job -> Job -> Job -> bool
END|prosa.analysis.facts.priority.jlfp_with_fp.hep_from_hp_task
BEGIN|prosa.analysis.facts.priority.jlfp_with_fp.hep_from_ep_task
@hep_from_ep_task
     : forall (Task : TaskType) (Job : JobType), JobTask Job Task -> FP_policy Task -> JLFP_policy Job -> Job -> Job -> bool
END|prosa.analysis.facts.priority.jlfp_with_fp.hep_from_ep_task
BEGIN|prosa.analysis.facts.priority.jlfp_with_fp.hep_hp_workload_hp
@hep_hp_workload_hp
     : forall (Task : TaskType) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobCost Job) (FP : FP_policy Task) (JLFP : JLFP_policy Job), JLFP_FP_compatible JLFP FP -> forall (arr_seq : arrival_sequence Job) (j : Job) (t1 t2 : duration), workload_of_jobs (hep_from_hp_task j) (arrivals_between arr_seq t1 t2) = workload_of_jobs (from_hp_task j) (arrivals_between arr_seq t1 t2)
END|prosa.analysis.facts.priority.jlfp_with_fp.hep_hp_workload_hp
BEGIN|prosa.analysis.facts.priority.jlfp_with_fp.hep_workload_partitioning_taskwise
@hep_workload_partitioning_taskwise
     : forall (Task : TaskType) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobCost Job) (FP : FP_policy Task) (JLFP : JLFP_policy Job), JLFP_FP_compatible JLFP FP -> forall (arr_seq : arrival_sequence Job) (j : Job) (t1 t2 : duration), workload_of_hep_jobs arr_seq j t1 t2 = workload_of_jobs (hep_from_hp_task j) (arrivals_between arr_seq t1 t2) + workload_of_jobs (hep_from_ep_task j) (arrivals_between arr_seq t1 t2)
END|prosa.analysis.facts.priority.jlfp_with_fp.hep_workload_partitioning_taskwise
BEGIN|prosa.analysis.facts.priority.sequential.early_hep_job_is_scheduled
@early_hep_job_is_scheduled
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall JLFP : JLFP_policy Job, transitive_job_priorities JLFP -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall (sched : schedule PState) (H : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall H0 : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched JLFP -> forall j1 j2 : Job, arrives_in arr_seq j1 -> job_arrival j1 < job_arrival j2 -> always_higher_priority j1 j2 -> forall t : instant, scheduled_at sched j2 t -> completed_by sched j1 t
END|prosa.analysis.facts.priority.sequential.early_hep_job_is_scheduled
BEGIN|prosa.analysis.facts.readiness.backlogged.mem_backlogged_jobs
