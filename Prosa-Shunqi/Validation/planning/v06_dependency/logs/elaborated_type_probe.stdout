END|prosa.analysis.facts.readiness.backlogged.backlogged_job_arrives_in
BEGIN|prosa.analysis.facts.readiness.backlogged.backlogged_prefix_invariance
@backlogged_prefix_invariance
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (PState : ProcessorState Job) (RM : JobReady Job PState), nonclairvoyant_readiness RM -> forall (sched sched' : schedule PState) (h : instant), identical_prefix sched sched' h -> forall (t : nat) (j : Job), t < h -> backlogged sched j t = backlogged sched' j t
END|prosa.analysis.facts.readiness.backlogged.backlogged_prefix_invariance
BEGIN|prosa.analysis.facts.readiness.backlogged.backlogged_prefix_invariance'
@backlogged_prefix_invariance'
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (PState : ProcessorState Job) (RM : JobReady Job PState), nonclairvoyant_readiness RM -> forall (sched sched' : schedule PState) (h : instant), identical_prefix sched sched' h -> forall (t : instant) (j : Job), ~~ scheduled_at sched j t -> ~~ scheduled_at sched' j t -> t <= h -> backlogged sched j t = backlogged sched' j t
END|prosa.analysis.facts.readiness.backlogged.backlogged_prefix_invariance'
BEGIN|prosa.analysis.facts.readiness.backlogged.backlogged_jobs_prefix_invariance
@backlogged_jobs_prefix_invariance
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (PState : ProcessorState Job) (RM : JobReady Job PState), nonclairvoyant_readiness RM -> forall (arr_seq : arrival_sequence Job) (sched sched' : schedule PState) (h : instant), identical_prefix sched sched' h -> forall t : nat, t < h -> jobs_backlogged_at arr_seq sched t = jobs_backlogged_at arr_seq sched' t
END|prosa.analysis.facts.readiness.backlogged.backlogged_jobs_prefix_invariance
