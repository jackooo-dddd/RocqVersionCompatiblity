     : forall Job : JobType, schedule (ideal.processor_state Job) -> schedule (ideal.processor_state Job) -> JobCost Job -> JobCost Job -> Prop
END|prosa.results.transfer_schedulability.criterion.schedulability_transferred
BEGIN|prosa.results.transfer_schedulability.criterion.deadlines_met
@deadlines_met
     : forall (Job : JobType) (H0 : JobDeadline Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job), schedulability_transferred ref_sched online_sched ref_job_cost online_job_cost -> forall j : Job, job_meets_deadline ref_sched j -> job_meets_deadline online_sched j
END|prosa.results.transfer_schedulability.criterion.deadlines_met
BEGIN|prosa.results.transfer_schedulability.criterion.ref_cost_bounds_online_cost
@ref_cost_bounds_online_cost
     : forall (Job : JobType) (ref_job_cost online_job_cost job_cost_bound : JobCost Job), (forall j : Job, online_job_cost j <= job_cost_bound j) -> (forall j : Job, job_cost_bound j <= ref_job_cost j) -> forall j : Job, online_job_cost j <= ref_job_cost j
END|prosa.results.transfer_schedulability.criterion.ref_cost_bounds_online_cost
BEGIN|prosa.results.transfer_schedulability.criterion.remaining_cost_bound
@remaining_cost_bound
     : forall Job : JobType, schedule (ideal.processor_state Job) -> JobCost Job -> Job -> instant -> nat
END|prosa.results.transfer_schedulability.criterion.remaining_cost_bound
BEGIN|prosa.results.transfer_schedulability.criterion.remcost_service
@remcost_service
     : forall (Job : JobType) (online_sched : schedule (ideal.processor_state Job)) (online_job_cost : JobCost Job), completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall (j : Job) (t : instant), remaining_cost_bound online_sched job_cost_bound j t = remaining_cost_bound online_sched job_cost_bound j t.+1 + service_at online_sched j t
END|prosa.results.transfer_schedulability.criterion.remcost_service
BEGIN|prosa.results.transfer_schedulability.criterion.remcost_service_during
@remcost_service_during
     : forall (Job : JobType) (online_sched : schedule (ideal.processor_state Job)) (online_job_cost : JobCost Job), completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall (j : Job) (t1 t2 : nat), t1 <= t2 -> remaining_cost_bound online_sched job_cost_bound j t1 = remaining_cost_bound online_sched job_cost_bound j t2 + service_during online_sched j t1 t2
END|prosa.results.transfer_schedulability.criterion.remcost_service_during
BEGIN|prosa.results.transfer_schedulability.criterion.remcost_total_service_during
@remcost_total_service_during
     : forall (Job : JobType) (online_sched : schedule (ideal.processor_state Job)) (online_job_cost : JobCost Job), completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall (js : seq Job) (t1 t2 : nat), t1 <= t2 -> \sum_(j <- js) remaining_cost_bound online_sched job_cost_bound j t1 = \sum_(j <- js) remaining_cost_bound online_sched job_cost_bound j t2 + service_of_jobs online_sched xpredT js t1 t2
END|prosa.results.transfer_schedulability.criterion.remcost_total_service_during
BEGIN|prosa.results.transfer_schedulability.criterion.remaining_cost_invariant
@remaining_cost_invariant
     : forall (Job : JobType) (online_sched : schedule (ideal.processor_state Job)) (online_job_cost : JobCost Job), completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall (js : seq Job) (t1 t2 : nat), t1 <= t2 -> uniq js -> (forall t : nat, t1 <= t < t2 -> exists j : Job, (j \in js) && scheduled_at online_sched j t) -> \sum_(j <- js) remaining_cost_bound online_sched job_cost_bound j t1 = \sum_(j <- js) remaining_cost_bound online_sched job_cost_bound j t2 + (t2 - t1)
END|prosa.results.transfer_schedulability.criterion.remaining_cost_invariant
BEGIN|prosa.results.transfer_schedulability.criterion.online_remaining_cost_bounded
@online_remaining_cost_bounded
     : forall (Job : JobType) (online_sched : schedule (ideal.processor_state Job)) (online_job_cost : JobCost Job), completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall (j : Job) (t : instant), remaining_cost online_sched j t <= remaining_cost_bound online_sched job_cost_bound j t
END|prosa.results.transfer_schedulability.criterion.online_remaining_cost_bounded
BEGIN|prosa.results.transfer_schedulability.criterion.remaining_cost_positive
@remaining_cost_positive
     : forall (Job : JobType) (online_sched : schedule (ideal.processor_state Job)) (online_job_cost job_cost_bound : JobCost Job), (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall (j : Job) (t : instant), ~~ completed_by online_sched j t -> 0 < remaining_cost_bound online_sched job_cost_bound j t
END|prosa.results.transfer_schedulability.criterion.remaining_cost_positive
BEGIN|prosa.results.transfer_schedulability.criterion.remaining_cost_zero
@remaining_cost_zero
     : forall (Job : JobType) (online_sched : schedule (ideal.processor_state Job)) (online_job_cost : JobCost Job), completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall (js : seq Job) (t : instant), \sum_(j <- js) remaining_cost_bound online_sched job_cost_bound j t == 0 -> forall j : Job, j \in js -> completed_by online_sched j t
END|prosa.results.transfer_schedulability.criterion.remaining_cost_zero
BEGIN|prosa.results.transfer_schedulability.criterion.critical_jobs
@critical_jobs
     : forall Job : JobType, schedule (ideal.processor_state Job) -> schedule (ideal.processor_state Job) -> JobCost Job -> JobCost Job -> arrival_sequence Job -> instant -> instant -> seq Job
END|prosa.results.transfer_schedulability.criterion.critical_jobs
BEGIN|prosa.results.transfer_schedulability.criterion.critical_jobs_monotonicity
@critical_jobs_monotonicity
     : forall (Job : JobType) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job) (t1 t2 t3 : nat), t1 <= t2 <= t3 -> forall j : Job, j \in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t2 t3 -> j \in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t3
END|prosa.results.transfer_schedulability.criterion.critical_jobs_monotonicity
BEGIN|prosa.results.transfer_schedulability.criterion.critical_jobs_dropout
@critical_jobs_dropout
     : forall (Job : JobType) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job) (t1 t2 t3 : nat), t1 <= t2 <= t3 -> forall j : Job, j \in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t3 -> j \notin critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t2 t3 -> completed_by online_sched j t2
END|prosa.results.transfer_schedulability.criterion.critical_jobs_dropout
BEGIN|prosa.results.transfer_schedulability.criterion.critical_jobs_filter_complete
@critical_jobs_filter_complete
     : forall (Job : JobType) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job) (t1 t2 : nat) (t3 : instant), t1 <= t2 -> critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t2 t3 = [seq j <- critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t3 | ~~ completed_by online_sched j t2]
END|prosa.results.transfer_schedulability.criterion.critical_jobs_filter_complete
BEGIN|prosa.results.transfer_schedulability.criterion.critical_jobs_uniq
@critical_jobs_uniq
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall t1 t2 : instant, uniq (critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t2)
END|prosa.results.transfer_schedulability.criterion.critical_jobs_uniq
BEGIN|prosa.results.transfer_schedulability.criterion.critical_jobs_min_completion_time
@critical_jobs_min_completion_time
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> completed_jobs_dont_execute ref_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, job_cost_bound j <= ref_job_cost j) -> forall t : instant, \sum_(j <- critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq 0 t) job_cost_bound j <= t
END|prosa.results.transfer_schedulability.criterion.critical_jobs_min_completion_time
BEGIN|prosa.results.transfer_schedulability.criterion.critical_jobs_remaining_cost_monotonic
@critical_jobs_remaining_cost_monotonic
     : forall (Job : JobType) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall t1 t2 t3 : nat, t1 <= t2 <= t3 -> \sum_(j <- critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t2 t3) remaining_cost_bound online_sched job_cost_bound j t2 <= \sum_(j <- critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t3) remaining_cost_bound online_sched job_cost_bound j t1
END|prosa.results.transfer_schedulability.criterion.critical_jobs_remaining_cost_monotonic
BEGIN|prosa.results.transfer_schedulability.criterion.slackless_interval
@slackless_interval
     : forall Job : JobType, schedule (ideal.processor_state Job) -> schedule (ideal.processor_state Job) -> JobCost Job -> JobCost Job -> arrival_sequence Job -> JobCost Job -> nat -> nat -> bool
END|prosa.results.transfer_schedulability.criterion.slackless_interval
BEGIN|prosa.results.transfer_schedulability.criterion.contiguously_slackless_interval
@contiguously_slackless_interval
     : forall Job : JobType, schedule (ideal.processor_state Job) -> schedule (ideal.processor_state Job) -> JobCost Job -> JobCost Job -> arrival_sequence Job -> JobCost Job -> nat -> nat -> bool
END|prosa.results.transfer_schedulability.criterion.contiguously_slackless_interval
BEGIN|prosa.results.transfer_schedulability.criterion.transfer_schedulability_criterion
@transfer_schedulability_criterion
     : forall Job : JobType, schedule (ideal.processor_state Job) -> schedule (ideal.processor_state Job) -> JobCost Job -> JobCost Job -> arrival_sequence Job -> JobCost Job -> Prop
END|prosa.results.transfer_schedulability.criterion.transfer_schedulability_criterion
BEGIN|prosa.results.transfer_schedulability.criterion.late_in_critical_jobs
@late_in_critical_jobs
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> jobs_come_from_arrival_sequence ref_sched arr_seq -> jobs_must_arrive_to_execute ref_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> (forall j : Job, job_cost_bound j <= ref_job_cost j) -> forall (j : Job) (t : instant), completed_by ref_sched j t -> ~~ completed_by online_sched j t -> j \in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t t
END|prosa.results.transfer_schedulability.criterion.late_in_critical_jobs
BEGIN|prosa.results.transfer_schedulability.criterion.late_not_at_start
@late_not_at_start
     : forall (Job : JobType) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost job_cost_bound : JobCost Job), (forall j : Job, online_job_cost j <= job_cost_bound j) -> (forall j : Job, job_cost_bound j <= ref_job_cost j) -> forall (j : Job) (t : instant), completed_by ref_sched j t -> ~~ completed_by online_sched j t -> 0 < t
END|prosa.results.transfer_schedulability.criterion.late_not_at_start
BEGIN|prosa.results.transfer_schedulability.criterion.nonpositive_slack
@nonpositive_slack
     : forall Job : JobType, schedule (ideal.processor_state Job) -> schedule (ideal.processor_state Job) -> JobCost Job -> JobCost Job -> arrival_sequence Job -> JobCost Job -> nat -> nat -> bool
END|prosa.results.transfer_schedulability.criterion.nonpositive_slack
BEGIN|prosa.results.transfer_schedulability.criterion.contiguously_nps
@contiguously_nps
     : forall Job : JobType, schedule (ideal.processor_state Job) -> schedule (ideal.processor_state Job) -> JobCost Job -> JobCost Job -> arrival_sequence Job -> JobCost Job -> nat -> nat -> bool
END|prosa.results.transfer_schedulability.criterion.contiguously_nps
BEGIN|prosa.results.transfer_schedulability.criterion.contiguously_nps_start
@contiguously_nps_start
     : forall (Job : JobType) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job) (job_cost_bound : JobCost Job) (t0 t2 : nat), ~~ contiguously_nps ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t0 t2 -> contiguously_nps ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t0.+1 t2 -> ~~ nonpositive_slack ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t0 t2
END|prosa.results.transfer_schedulability.criterion.contiguously_nps_start
BEGIN|prosa.results.transfer_schedulability.criterion.contiguously_nps_existence
@contiguously_nps_existence
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> jobs_come_from_arrival_sequence ref_sched arr_seq -> jobs_must_arrive_to_execute ref_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> (forall j : Job, job_cost_bound j <= ref_job_cost j) -> forall (j : Job) (t2 : instant), completed_by ref_sched j t2 -> ~~ completed_by online_sched j t2 -> exists t1 : nat, contiguously_nps ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1 t2 /\ t1 < t2 /\ (t1 = 0 \/ ~~ nonpositive_slack ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1.-1 t2)
END|prosa.results.transfer_schedulability.criterion.contiguously_nps_existence
BEGIN|prosa.results.transfer_schedulability.criterion.slackless_interval_step_case_completed_job_rem
@slackless_interval_step_case_completed_job_rem
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall t1 t2 : nat, slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1 t2 -> nonpositive_slack ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1.+1 t2 -> forall j : Job, scheduled_at online_sched j t1 -> j \in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t2 -> completed_by online_sched j t1.+1 -> remaining_cost_bound online_sched job_cost_bound j t1.+1 = 0
END|prosa.results.transfer_schedulability.criterion.slackless_interval_step_case_completed_job_rem
BEGIN|prosa.results.transfer_schedulability.criterion.slackless_interval_step_case_completed_job
@slackless_interval_step_case_completed_job
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall t1 t2 : nat, slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1 t2 -> t1.+1 < t2 -> nonpositive_slack ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1.+1 t2 -> forall j : Job, scheduled_at online_sched j t1 -> j \in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t2 -> completed_by online_sched j t1.+1 -> slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1.+1 t2
END|prosa.results.transfer_schedulability.criterion.slackless_interval_step_case_completed_job
BEGIN|prosa.results.transfer_schedulability.criterion.slackless_interval_step_case_incomplete_job
@slackless_interval_step_case_incomplete_job
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> forall t1 t2 : nat, slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1 t2 -> t1.+1 < t2 -> nonpositive_slack ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1.+1 t2 -> forall j : Job, scheduled_at online_sched j t1 -> j \in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t2 -> ~~ completed_by online_sched j t1.+1 -> slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1.+1 t2
END|prosa.results.transfer_schedulability.criterion.slackless_interval_step_case_incomplete_job
BEGIN|prosa.results.transfer_schedulability.criterion.slackless_interval_step
@slackless_interval_step
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> transfer_schedulability_criterion ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound -> forall t1 t2 : nat, slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1 t2 -> t1.+1 < t2 -> nonpositive_slack ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1.+1 t2 -> slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1.+1 t2
END|prosa.results.transfer_schedulability.criterion.slackless_interval_step
BEGIN|prosa.results.transfer_schedulability.criterion.slackless_interval_continuation
@slackless_interval_continuation
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> transfer_schedulability_criterion ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound -> forall t1 t2 : nat, slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1 t2 -> contiguously_nps ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1 t2 -> [forall delta, slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound (t1 + delta) t2]
END|prosa.results.transfer_schedulability.criterion.slackless_interval_continuation
BEGIN|prosa.results.transfer_schedulability.criterion.slackless_interval_existence
@slackless_interval_existence
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> jobs_come_from_arrival_sequence ref_sched arr_seq -> jobs_must_arrive_to_execute ref_sched -> completed_jobs_dont_execute ref_sched -> completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> (forall j : Job, job_cost_bound j <= ref_job_cost j) -> transfer_schedulability_criterion ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound -> forall (j : Job) (t2 : instant), completed_by ref_sched j t2 -> ~~ completed_by online_sched j t2 -> exists t1 : instant, contiguously_slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1 t2 && (j \in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t2)
END|prosa.results.transfer_schedulability.criterion.slackless_interval_existence
BEGIN|prosa.results.transfer_schedulability.criterion.slackless_interval_completion
@slackless_interval_completion
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> completed_jobs_dont_execute online_sched -> forall job_cost_bound : JobCost Job, (forall j : Job, online_job_cost j <= job_cost_bound j) -> transfer_schedulability_criterion ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound -> forall (j : Job) (t1 t2 : nat), contiguously_slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq job_cost_bound t1 t2 -> j \in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t2 -> completed_by online_sched j t2
END|prosa.results.transfer_schedulability.criterion.slackless_interval_completion
BEGIN|prosa.results.transfer_schedulability.criterion.online_transfer_schedulability_criterion_sufficiency
@online_transfer_schedulability_criterion_sufficiency
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> jobs_come_from_arrival_sequence ref_sched arr_seq -> jobs_must_arrive_to_execute ref_sched -> completed_jobs_dont_execute ref_sched -> completed_jobs_dont_execute online_sched -> (forall j : Job, online_job_cost j <= ref_job_cost j) -> transfer_schedulability_criterion ref_sched online_sched ref_job_cost online_job_cost arr_seq online_job_cost -> schedulability_transferred ref_sched online_sched ref_job_cost online_job_cost
END|prosa.results.transfer_schedulability.criterion.online_transfer_schedulability_criterion_sufficiency
BEGIN|prosa.results.transfer_schedulability.criterion.online_transfer_schedulability_criterion_ensures_schedulability
@online_transfer_schedulability_criterion_ensures_schedulability
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobDeadline Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> jobs_come_from_arrival_sequence ref_sched arr_seq -> jobs_must_arrive_to_execute ref_sched -> completed_jobs_dont_execute ref_sched -> completed_jobs_dont_execute online_sched -> (forall j : Job, online_job_cost j <= ref_job_cost j) -> transfer_schedulability_criterion ref_sched online_sched ref_job_cost online_job_cost arr_seq online_job_cost -> forall j : Job, job_meets_deadline ref_sched j -> job_meets_deadline online_sched j
END|prosa.results.transfer_schedulability.criterion.online_transfer_schedulability_criterion_ensures_schedulability
BEGIN|prosa.results.transfer_schedulability.criterion.delay_if_no_critical_job_is_scheduled
@delay_if_no_critical_job_is_scheduled
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> completed_jobs_dont_execute online_sched -> forall t1 t2 : nat, slackless_interval ref_sched online_sched ref_job_cost online_job_cost arr_seq online_job_cost t1 t2 -> {in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t2, forall j : Job, ~~ scheduled_at online_sched j t1} -> exists j : Job, j \in critical_jobs ref_sched online_sched ref_job_cost online_job_cost arr_seq t1 t2 /\ ~~ completed_by online_sched j t2
END|prosa.results.transfer_schedulability.criterion.delay_if_no_critical_job_is_scheduled
BEGIN|prosa.results.transfer_schedulability.criterion.online_transfer_schedulability_criterion_necessity
@online_transfer_schedulability_criterion_necessity
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> completed_jobs_dont_execute online_sched -> schedulability_transferred ref_sched online_sched ref_job_cost online_job_cost -> transfer_schedulability_criterion ref_sched online_sched ref_job_cost online_job_cost arr_seq online_job_cost
END|prosa.results.transfer_schedulability.criterion.online_transfer_schedulability_criterion_necessity
BEGIN|prosa.results.transfer_schedulability.criterion.ref_transfer_schedulability_criterion_sufficiency
@ref_transfer_schedulability_criterion_sufficiency
     : forall (Job : JobType) (H : JobArrival Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> jobs_come_from_arrival_sequence ref_sched arr_seq -> jobs_must_arrive_to_execute ref_sched -> completed_jobs_dont_execute ref_sched -> completed_jobs_dont_execute online_sched -> (forall j : Job, online_job_cost j <= ref_job_cost j) -> transfer_schedulability_criterion ref_sched online_sched ref_job_cost online_job_cost arr_seq ref_job_cost -> schedulability_transferred ref_sched online_sched ref_job_cost online_job_cost
END|prosa.results.transfer_schedulability.criterion.ref_transfer_schedulability_criterion_sufficiency
BEGIN|prosa.results.transfer_schedulability.criterion.ref_transfer_schedulability_criterion_ensures_schedulability
@ref_transfer_schedulability_criterion_ensures_schedulability
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobDeadline Job) (ref_sched online_sched : schedule (ideal.processor_state Job)) (ref_job_cost online_job_cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> jobs_come_from_arrival_sequence ref_sched arr_seq -> jobs_must_arrive_to_execute ref_sched -> completed_jobs_dont_execute ref_sched -> completed_jobs_dont_execute online_sched -> (forall j : Job, online_job_cost j <= ref_job_cost j) -> transfer_schedulability_criterion ref_sched online_sched ref_job_cost online_job_cost arr_seq ref_job_cost -> forall j : Job, job_meets_deadline ref_sched j -> job_meets_deadline online_sched j
END|prosa.results.transfer_schedulability.criterion.ref_transfer_schedulability_criterion_ensures_schedulability
