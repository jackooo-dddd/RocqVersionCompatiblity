@prefix_map_property_invariance
     : forall (Job : JobType) (PState : ProcessorState Job) (P : schedule PState -> Prop) (f : schedule PState -> instant -> schedule PState), (forall (sched : schedule PState) (t : instant), P sched -> P (f sched t)) -> forall (sched : schedule PState) (h : instant), P sched -> P (prefix_map sched f h)
