BEGIN|prosa.results.rta.ideal.fifo.bounded_nps.soln_abstract_response_time_recurrence
@bounded_nps.soln_abstract_response_time_recurrence
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (H1 : TaskRunToCompletionThreshold Task) (Job : JobType) (H2 : JobTask Job Task) (H4 : JobCost Job) (H5 : JobPreemptable Job) (arr_seq : arrival_sequence Job) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> valid_task_run_to_completion_threshold arr_seq tsk -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> forall R : duration, (forall A : duration, bounded_nps.is_in_concrete_search_space ts L A -> exists F : nat, \sum_(tsko <- ts) task_request_bound_function tsko (A + 1) <= A + F /\ F <= R) -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : nat, search_space.is_in_search_space L (fun A0 : duration => fun=> \sum_(tsko <- ts) task_request_bound_function tsko (A0 + 1) - task_cost tsk) A -> exists F : nat, task_rtct tsk + (\sum_(tsko <- ts) task_request_bound_function tsko (A + 1) - task_cost tsk) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R
END|prosa.results.rta.ideal.fifo.bounded_nps.soln_abstract_response_time_recurrence
