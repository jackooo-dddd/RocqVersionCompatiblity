     : forall (Job : JobType) (sched : schedule (overheads.processor_state Job)) (t1 t2 : instant), no_schedule_changes_during sched t1 t2 -> exists oj : option Job, total_time_in_dispatch sched t1 t2 = time_spent_in_dispatch sched oj t1 t2
END|prosa.analysis.facts.model.overheads.blackout_bound.total_dispatch_time_eq_job_dispatch_time
BEGIN|prosa.analysis.facts.model.overheads.blackout_bound.total_cswitch_time_eq_job_cswitch_time
