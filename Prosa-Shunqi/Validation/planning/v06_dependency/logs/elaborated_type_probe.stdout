BEGIN|prosa.results.generality.elf.elf_generalizes_gel
@elf_generalizes_gel
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H1 : JobTask Job Task) (PState : ProcessorState Job) (Arrival : JobArrival Job) (Cost : JobCost Job) (H2 : JobPreemptable Job) (JR : JobReady Job PState) (fp : FP_policy Task), (forall tsk1 tsk2 : Task, ep_task tsk1 tsk2) -> forall (sched : schedule PState) (arr_seq : arrival_sequence Job), respects_JLFP_policy_at_preemption_point arr_seq sched (ELF fp) <-> respects_JLFP_policy_at_preemption_point arr_seq sched (GEL Job Task)
END|prosa.results.generality.elf.elf_generalizes_gel
BEGIN|prosa.results.generality.elf.elf_is_fixed_priority
@elf_is_fixed_priority
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H1 : JobTask Job Task) (PState : ProcessorState Job) (Arrival : JobArrival Job) (Cost : JobCost Job) (H2 : JobPreemptable Job) (JR : JobReady Job PState) (fp : FP_policy Task) (sched : schedule PState) (arr_seq : arrival_sequence Job), respects_JLFP_policy_at_preemption_point arr_seq sched (ELF fp) -> respects_FP_policy_at_preemption_point arr_seq sched fp
