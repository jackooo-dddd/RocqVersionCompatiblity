     : forall (Job : JobType) (arr_seq : arrival_sequence Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> valid_arrival_sequence arr_seq -> forall t : instant, is_idle arr_seq sched t = ideal_is_idle sched t
END|prosa.analysis.facts.model.ideal.schedule.is_idle_def
BEGIN|prosa.analysis.facts.model.ideal.service_of_jobs.low_service_implies_existence_of_idle_time_rs
@low_service_implies_existence_of_idle_time_rs
     : forall (Job : JobType) (H0 : JobArrival Job) (PState : ProcessorState Job), uniprocessor_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall t1 t2 : instant, blackout_during sched t1 t2 + service_of_jobs sched predT (arrivals_between arr_seq 0 t2) t1 t2 < t2 - t1 -> exists t : nat, t1 <= t < t2 /\ is_idle arr_seq sched t
END|prosa.analysis.facts.model.ideal.service_of_jobs.low_service_implies_existence_of_idle_time_rs
BEGIN|prosa.analysis.facts.model.ideal.service_of_jobs.low_service_implies_existence_of_idle_time
@low_service_implies_existence_of_idle_time
     : forall (Job : JobType) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> ideal_progress_proc_model PState -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall t1 t2 : instant, service_of_jobs sched predT (arrivals_between arr_seq 0 t2) t1 t2 < t2 - t1 -> exists t : nat, t1 <= t < t2 /\ is_idle arr_seq sched t
END|prosa.analysis.facts.model.ideal.service_of_jobs.low_service_implies_existence_of_idle_time
