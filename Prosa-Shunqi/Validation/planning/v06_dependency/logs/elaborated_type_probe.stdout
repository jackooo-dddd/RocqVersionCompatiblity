BEGIN|prosa.results.rta.ideal.fifo.bounded_nps.search_space_refinement
@search_space_refinement
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall L : duration, 0 < L -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : nat, search_space.is_in_search_space L (fun A0 : duration => fun=> \sum_(tsko <- ts) task_request_bound_function tsko (A0 + 1) - task_cost tsk) A -> bounded_nps.is_in_concrete_search_space ts L A
