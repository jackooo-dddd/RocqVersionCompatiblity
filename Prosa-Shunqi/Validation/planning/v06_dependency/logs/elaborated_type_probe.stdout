BEGIN|prosa.results.rta.ideal.edf.bounded_nps.blocking_bound_decreasing
@blocking_bound_decreasing
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (H2 : TaskMaxNonpreemptiveSegment Task) (ts : seq Task) (H5 : MaxArrivals Task) (tsk : Task), tsk \in ts -> forall A1 A2 : nat, A1 <= A2 -> edf.blocking_bound ts tsk A2 <= edf.blocking_bound ts tsk A1
END|prosa.results.rta.ideal.edf.bounded_nps.blocking_bound_decreasing
BEGIN|prosa.results.rta.ideal.edf.bounded_nps.task_with_equal_deadline_exists
@task_with_equal_deadline_exists
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (H2 : TaskMaxNonpreemptiveSegment Task) (ts : seq Task) (H5 : MaxArrivals Task) (tsk : Task), tsk \in ts -> forall A : duration, priority_inversion_changes_at (edf.blocking_bound ts tsk) A -> exists tsk_o : Task, (tsk_o \in ts) && blocking_relevant tsk_o && (tsk_o != tsk) && (task_deadline tsk_o == task_deadline tsk + A)
END|prosa.results.rta.ideal.edf.bounded_nps.task_with_equal_deadline_exists
BEGIN|prosa.results.rta.ideal.edf.bounded_nps.search_space_inclusion
@search_space_inclusion
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (H2 : TaskMaxNonpreemptiveSegment Task) (ts : seq Task) (H5 : MaxArrivals Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall A L : duration, edf.bounded_pi.is_in_search_space ts tsk (edf.blocking_bound ts tsk) L A -> bounded_nps.is_in_search_space ts tsk L A
END|prosa.results.rta.ideal.edf.bounded_nps.search_space_inclusion
BEGIN|prosa.results.rta.ideal.edf.bounded_nps.uniprocessor_response_time_bound_edf_with_bounded_nonpreemptive_segments
@uniprocessor_response_time_bound_edf_with_bounded_nonpreemptive_segments
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (H1 : TaskRunToCompletionThreshold Task) (H2 : TaskMaxNonpreemptiveSegment Task) (Job : JobType) (H3 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> forall H4 : JobPreemptable Job, valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> work_conserving arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job) -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H5 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> forall R : duration, (forall A : duration, bounded_nps.is_in_search_space ts tsk L A -> exists F : duration, edf.blocking_bound ts tsk A + (task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk)) + edf_athep_bound.bound_on_athep_workload ts tsk A (A + F) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> task_response_time_bound arr_seq sched tsk R
END|prosa.results.rta.ideal.edf.bounded_nps.uniprocessor_response_time_bound_edf_with_bounded_nonpreemptive_segments
