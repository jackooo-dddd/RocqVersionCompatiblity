BEGIN|prosa.analysis.abstract.restricted_supply.bounded_bi.jlfp.busy_intervals_are_bounded_rs_jlfp
@busy_intervals_are_bounded_rs_jlfp
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> fully_consuming_proc_model PState -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), valid_schedule sched arr_seq -> definitions.work_conserving arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H5 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall SBF : SupplyBoundFunction, valid_busy_sbf arr_seq sched tsk SBF -> unit_supply_bound_function SBF -> forall blocking_bound : duration -> duration, service_inversion_is_bounded_by arr_seq sched tsk blocking_bound -> (forall A : duration, blocking_bound A <= blocking_bound 0) -> forall L : duration, 0 < L -> blocking_bound 0 + total_request_bound_function ts L <= SBF L -> busy_intervals_are_bounded_by arr_seq sched tsk L
END|prosa.analysis.abstract.restricted_supply.bounded_bi.jlfp.busy_intervals_are_bounded_rs_jlfp
