BEGIN|prosa.analysis.abstract.restricted_supply.iw_instantiation.cumulative_interference_split
@cumulative_interference_split
     : forall (Job : JobType) (H1 : JobArrival Job) (PState : ProcessorState Job), uniprocessor_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall (j : Job) (t1 t2 : nat), cumulative_interference j t1 t2 = blackout_during sched t1 t2 + cumulative_service_inversion arr_seq sched j t1 t2 + cumulative_another_hep_job_interference arr_seq sched j t1 t2
END|prosa.analysis.abstract.restricted_supply.iw_instantiation.cumulative_interference_split
BEGIN|prosa.analysis.abstract.restricted_supply.iw_instantiation.cumulative_interfering_workload_split
@cumulative_interfering_workload_split
     : forall (Job : JobType) (H2 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLFP : JLFP_policy Job) (j : Job) (t1 t2 : nat), cumulative_interfering_workload j t1 t2 = blackout_during sched t1 t2 + cumulative_service_inversion arr_seq sched j t1 t2 + cumulative_other_hep_jobs_interfering_workload arr_seq j t1 t2
END|prosa.analysis.abstract.restricted_supply.iw_instantiation.cumulative_interfering_workload_split
BEGIN|prosa.analysis.abstract.restricted_supply.iw_instantiation.cumulative_task_interference_split
@cumulative_task_interference_split
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall (tsk : Task) (j : Job) (t1 : nat) (t2 : instant), arrives_in arr_seq j -> job_of_task tsk j -> ~~ completed_by sched j t2 -> cumul_cond_interference (nonself_intra arr_seq sched) j t1 t2 <= cumulative_service_inversion arr_seq sched j t1 t2 + cumulative_another_task_hep_job_interference arr_seq sched j t1 t2
END|prosa.analysis.abstract.restricted_supply.iw_instantiation.cumulative_task_interference_split
BEGIN|prosa.analysis.abstract.restricted_supply.iw_instantiation.cumulative_intra_interference_split
@cumulative_intra_interference_split
     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLFP : JLFP_policy Job) (j : Job) (t1 t2 : nat), cumul_cond_interference (fun=> [eta has_supply sched]) j t1 t2 <= cumulative_service_inversion arr_seq sched j t1 t2 + cumulative_another_hep_job_interference arr_seq sched j t1 t2
END|prosa.analysis.abstract.restricted_supply.iw_instantiation.cumulative_intra_interference_split
