     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (JLFP : JLFP_policy Job), reflexive_job_priorities JLFP -> transitive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule (overheads.processor_state Job), valid_schedule sched arr_seq -> work_conserving arr_seq sched -> forall H1 : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched JLFP -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall t t_arr : instant, t1 <= t -> t < t_arr -> t_arr <= t2 -> priority_bump sched t -> exists jhp : Job, scheduled_at sched jhp t /\ jhp \in arrivals_between arr_seq t1 t_arr
END|prosa.analysis.facts.model.overheads.priority_bump.priority_bump_implies_hp_arrival_in_prefix
