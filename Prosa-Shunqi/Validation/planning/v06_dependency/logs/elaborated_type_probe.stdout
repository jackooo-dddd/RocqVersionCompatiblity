BEGIN|prosa.analysis.facts.model.exceedance.SBF.blackout_during_bounded
@blackout_during_bounded
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobCost Job) (H2 : JobArrival Job) (H3 : JLFP_policy Job) (arr_seq : arrival_sequence Job) (sched : schedule (exceedance_proc_state Job)) (e : work) (tsk : Task), (forall (j : Job) (t1 t2 : instant), arrives_in arr_seq j -> job_of_task tsk j -> busy_interval_prefix arr_seq sched j t1 t2 -> \sum_(t1 <= t < t2) is_exceedance_exec (sched t) <= e) -> forall (j : Job) (t1 t2 : instant) (t : nat), arrives_in arr_seq j -> job_of_task tsk j -> busy_interval_prefix arr_seq sched j t1 t2 -> t1 <= t <= t2 -> blackout_during sched t1 t <= e
END|prosa.analysis.facts.model.exceedance.SBF.blackout_during_bounded
