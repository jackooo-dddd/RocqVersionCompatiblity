BEGIN|prosa.analysis.abstract.restricted_supply.bounded_bi.aux.service_lt_workload_in_busy
@service_lt_workload_in_busy
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (JLFP : JLFP_policy Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), valid_schedule sched arr_seq -> forall j : Job, job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall t : nat, t1 < t < t2 -> service_of_hep_jobs arr_seq sched j t1 t < workload_of_hep_jobs arr_seq j t1 t
