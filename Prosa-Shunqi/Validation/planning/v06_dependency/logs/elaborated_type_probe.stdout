BEGIN|prosa.analysis.abstract.IBF.task.cumulative_job_interference_bound
@cumulative_job_interference_bound
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (jc : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_service_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> arrivals_have_valid_job_costs arr_seq -> forall (ts : seq Task) (tsk : Task), tsk \in ts -> forall H2 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall (H3 : Interference Job) (H4 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> sequential_tasks arr_seq sched -> interference_and_workload_consistent_with_sequential_tasks arr_seq sched tsk -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, definitions.busy_interval sched j t1 t2 -> forall x : duration, t1 + x < t2 -> ~~ completed_by sched j (t1 + x) -> cumulative_interference j t1 (t1 + x) <= task_request_bound_function tsk (job_arrival j - t1 + 1) - task_cost tsk + cumul_task_interference arr_seq sched j t1 (t1 + x)
END|prosa.analysis.abstract.IBF.task.cumulative_job_interference_bound
BEGIN|prosa.analysis.abstract.IBF.task.task_IBF_implies_job_IBF
@task_IBF_implies_job_IBF
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (jc : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_service_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> arrivals_have_valid_job_costs arr_seq -> forall (ts : seq Task) (tsk : Task), tsk \in ts -> forall H2 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall (H3 : Interference Job) (H4 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> sequential_tasks arr_seq sched -> interference_and_workload_consistent_with_sequential_tasks arr_seq sched tsk -> forall task_IBF : duration -> duration -> duration, task_interference_is_bounded_by arr_seq sched tsk task_IBF -> job_interference_is_bounded_by arr_seq sched tsk (fun A R : duration => task_request_bound_function tsk (A + 1) - task_cost tsk + task_IBF A R) (relative_arrival_time_of_job_is_A sched)
