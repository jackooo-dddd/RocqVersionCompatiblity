BEGIN|prosa.results.rta.ideal.fp.nonseq.bounded_pi.self_intf_bound_case1
@self_intf_bound_case1
     : forall (Task : TaskType) (H : TaskCost Task) (MaxArrivals0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall FP : FP_policy Task, reflexive_task_priorities FP -> forall ts : seq Task, taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall priority_inversion_bound L : duration, 0 < L -> L = priority_inversion_bound + total_hep_request_bound_function_FP ts tsk L -> forall (t1 : instant) (Δ : duration) (j : Job), job_cost_positive j -> job_of_task tsk j -> arrives_in arr_seq j -> t1 <= job_arrival j -> job_arrival j < t1 + Δ -> workload_of_jobs (another_hep_job_of_same_task^~ j) (arrivals_between arr_seq t1 (t1 + Δ)) <= task_request_bound_function tsk Δ - task_cost tsk
END|prosa.results.rta.ideal.fp.nonseq.bounded_pi.self_intf_bound_case1
BEGIN|prosa.results.rta.ideal.fp.nonseq.bounded_pi.self_intf_bound_case2
@self_intf_bound_case2
     : forall (Task : TaskType) (H : TaskCost Task) (MaxArrivals0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall FP : FP_policy Task, reflexive_task_priorities FP -> forall ts : seq Task, taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall priority_inversion_bound L : duration, 0 < L -> L = priority_inversion_bound + total_hep_request_bound_function_FP ts tsk L -> forall (t1 : instant) (Δ : duration) (j : Job), job_cost_positive j -> job_of_task tsk j -> arrives_in arr_seq j -> t1 <= job_arrival j -> t1 + Δ <= job_arrival j -> workload_of_jobs (another_hep_job_of_same_task^~ j) (arrivals_between arr_seq t1 (t1 + Δ)) <= task_request_bound_function tsk (job_arrival j - t1 + 1) - task_cost tsk
END|prosa.results.rta.ideal.fp.nonseq.bounded_pi.self_intf_bound_case2
BEGIN|prosa.results.rta.ideal.fp.nonseq.bounded_pi.self_intf_bound
@self_intf_bound
     : forall (Task : TaskType) (H : TaskCost Task) (MaxArrivals0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall FP : FP_policy Task, reflexive_task_priorities FP -> forall ts : seq Task, taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall priority_inversion_bound L : duration, 0 < L -> L = priority_inversion_bound + total_hep_request_bound_function_FP ts tsk L -> forall (t1 : instant) (Δ : duration) (j : Job), job_cost_positive j -> job_of_task tsk j -> arrives_in arr_seq j -> t1 <= job_arrival j -> workload_of_jobs (another_hep_job_of_same_task^~ j) (arrivals_between arr_seq t1 (t1 + Δ)) <= task_request_bound_function tsk (maxn (job_arrival j - t1 + 1) Δ) - task_cost tsk
END|prosa.results.rta.ideal.fp.nonseq.bounded_pi.self_intf_bound
BEGIN|prosa.results.rta.ideal.fp.nonseq.bounded_pi.instantiated_task_interference_is_bounded
@nonseq.bounded_pi.instantiated_task_interference_is_bounded
     : forall (Task : TaskType) (H : TaskCost Task) (MaxArrivals0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (JobReady0 : JobReady Job (ideal.processor_state Job)) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall FP : FP_policy Task, reflexive_task_priorities FP -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall priority_inversion_bound : duration, priority_inversion_is_bounded_by arr_seq sched tsk (constant priority_inversion_bound) -> forall L : duration, 0 < L -> L = priority_inversion_bound + total_hep_request_bound_function_FP ts tsk L -> job_interference_is_bounded_by arr_seq sched tsk (IBF ts tsk priority_inversion_bound) (relative_arrival_time_of_job_is_A sched)
