     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLDP : JLDP_policy Job) (j : Job) (al ar bl br : instant), bl <= al -> ar <= br -> cumulative_service_inversion arr_seq sched j al ar <= cumulative_service_inversion arr_seq sched j bl br
END|prosa.analysis.facts.busy_interval.service_inversion.service_inversion_widen
BEGIN|prosa.analysis.facts.busy_interval.service_inversion.service_inversion_supply_sched
@service_inversion_supply_sched
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job), uniprocessor_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall JLDP : JLDP_policy Job, reflexive_priorities JLDP -> forall t : instant, has_supply sched t -> forall j j' : Job, scheduled_at sched j t -> service_inversion arr_seq sched j' t = ~~ hep_job_at t j j'
