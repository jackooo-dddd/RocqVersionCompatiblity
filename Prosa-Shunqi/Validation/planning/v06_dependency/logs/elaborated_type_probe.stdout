     : forall (Job : JobType) (H : JobArrival Job) (H1 : JobDeadline Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)) (t : instant), ideal_is_idle sched t -> forall t_swap : instant, search_result arr_seq sched t = Some t_swap -> exists j : Job, swapped sched t t_swap t = Some j
