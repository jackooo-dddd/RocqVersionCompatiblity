BEGIN|prosa.analysis.abstract.restricted_supply.bounded_bi.aux.workload_exceeds_interval
@workload_exceeds_interval
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> fully_consuming_proc_model PState -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), valid_schedule sched arr_seq -> definitions.work_conserving arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall Δ : nat, 0 < Δ -> t1 + Δ < t2 -> Δ < workload_of_job arr_seq j t1 (t1 + Δ) + cumulative_interfering_workload j t1 (t1 + Δ)
END|prosa.analysis.abstract.restricted_supply.bounded_bi.aux.workload_exceeds_interval
BEGIN|prosa.analysis.abstract.restricted_supply.bounded_bi.edf.longest_bi_with_pi_bound_is_valid
@longest_bi_with_pi_bound_is_valid
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall (H4 : JobPreemptable Job) (H5 : TaskMaxNonpreemptiveSegment Task), valid_preemption_model arr_seq sched -> valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job) -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H6 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall SBF : SupplyBoundFunction, valid_busy_sbf arr_seq sched tsk SBF -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall δ : duration, t1 + δ <= t2 -> 0 < cumulative_service_inversion arr_seq sched j t1 (t1 + δ) -> cumulative_service_inversion arr_seq sched j t1 (t1 + δ) + (cumulative_other_hep_jobs_interfering_workload arr_seq j t1 (t1 + δ) + workload_of_job arr_seq j t1 (t1 + δ)) <= longest_busy_interval_with_pi ts tsk
END|prosa.analysis.abstract.restricted_supply.bounded_bi.edf.longest_bi_with_pi_bound_is_valid
BEGIN|prosa.analysis.abstract.restricted_supply.bounded_bi.edf.busy_intervals_are_bounded_rs_edf
@busy_intervals_are_bounded_rs_edf
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall (H4 : JobPreemptable Job) (H5 : TaskMaxNonpreemptiveSegment Task), valid_preemption_model arr_seq sched -> valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job) -> definitions.work_conserving arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H6 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall SBF : SupplyBoundFunction, valid_busy_sbf arr_seq sched tsk SBF -> unit_supply_bound_function SBF -> forall L : duration, 0 < L -> longest_busy_interval_with_pi ts tsk <= SBF L -> total_request_bound_function ts L <= SBF L -> busy_intervals_are_bounded_by arr_seq sched tsk L
END|prosa.analysis.abstract.restricted_supply.bounded_bi.edf.busy_intervals_are_bounded_rs_edf
BEGIN|prosa.analysis.abstract.restricted_supply.bounded_bi.elf.busy_intervals_are_bounded_rs_elf
@busy_intervals_are_bounded_rs_elf
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : PriorityPoint Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> fully_consuming_proc_model PState -> forall FP : FP_policy Task, reflexive_task_priorities FP -> transitive_task_priorities FP -> total_task_priorities FP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall (H4 : JobPreemptable Job) (H5 : TaskMaxNonpreemptiveSegment Task), valid_preemption_model arr_seq sched -> valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (ELF FP) -> definitions.work_conserving arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H6 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall SBF : SupplyBoundFunction, valid_busy_sbf arr_seq sched tsk SBF -> unit_supply_bound_function SBF -> forall L : duration, 0 < L -> (forall A : duration, elf.blocking_bound ts tsk A + total_hep_request_bound_function_FP ts tsk L <= SBF L) -> busy_intervals_are_bounded_by arr_seq sched tsk L
END|prosa.analysis.abstract.restricted_supply.bounded_bi.elf.busy_intervals_are_bounded_rs_elf
BEGIN|prosa.analysis.abstract.restricted_supply.bounded_bi.fp.busy_intervals_are_bounded_rs_fp
@busy_intervals_are_bounded_rs_fp
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> fully_consuming_proc_model PState -> forall FP : FP_policy Task, reflexive_task_priorities FP -> transitive_task_priorities FP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall (H3 : JobPreemptable Job) (H4 : TaskMaxNonpreemptiveSegment Task), valid_preemption_model arr_seq sched -> valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> respects_FP_policy_at_preemption_point arr_seq sched FP -> definitions.work_conserving arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H5 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall SBF : SupplyBoundFunction, valid_busy_sbf arr_seq sched tsk SBF -> unit_supply_bound_function SBF -> forall L : duration, 0 < L -> blocking_bound ts tsk + total_hep_request_bound_function_FP ts tsk L <= SBF L -> busy_intervals_are_bounded_by arr_seq sched tsk L
