     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobCost Job) (H3 : JobArrival Job) (arr_seq : arrival_sequence Job) (ts : seq Task), valid_task_arrival_sequence ts arr_seq -> forall sched : schedule (exceedance_proc_state Job), valid_schedule sched arr_seq -> work_conserving arr_seq sched -> nonpreemptive_schedule sched -> forall FP : FP_policy Task, reflexive_task_priorities FP -> transitive_task_priorities FP -> respects_FP_policy_at_preemption_point arr_seq sched FP -> forall (e : work) (tsk : Task), tsk \in ts -> (forall (j : Job) (t1 t2 : instant), arrives_in arr_seq j -> job_of_task tsk j -> busy_interval_prefix arr_seq sched j t1 t2 -> \sum_(t1 <= t < t2) is_exceedance_exec (sched t) <= e) -> forall L : duration, exc.fp.fully_nonpreemptive.busy_window_recurrence_solution ts e tsk L -> forall R : duration, exc.fp.fully_nonpreemptive.rta_recurrence_solution ts e tsk L R -> task_response_time_bound arr_seq sched tsk R
