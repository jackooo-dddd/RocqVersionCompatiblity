END|prosa.analysis.facts.SBF.valid_pred_sbf_switch_predicate
BEGIN|prosa.analysis.facts.SBF.blackout_during_bound_SBF
@blackout_during_bound_SBF
     : forall (Job : JobType) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState) (P : Job -> instant -> instant -> Prop) (SBF : SupplyBoundFunction), valid_pred_sbf arr_seq sched P SBF -> forall j : Job, arrives_in arr_seq j -> forall t1 t2 : instant, P j t1 t2 -> forall Δ : duration, t1 + Δ <= t2 -> blackout_during sched t1 (t1 + Δ) <= Δ - SBF Δ
END|prosa.analysis.facts.SBF.blackout_during_bound_SBF
BEGIN|prosa.analysis.facts.SBF.complement_SBF_monotone
