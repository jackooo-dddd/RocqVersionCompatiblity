     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H2 : JobArrival Job) (jc : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (tsk : Task) (H3 : Interference Job) (H4 : InterferingWorkload Job) (IBF_NP : duration -> duration -> duration), (forall (F : nat) (Δ : duration), F <= task_cost tsk + IBF_NP F Δ) -> forall (R : duration) (j : Job) (t1 t2 : instant), definitions.busy_interval sched j t1 t2 -> forall A_sp : duration, A_sp <= job_arrival j - t1 -> forall F : duration, task_cost tsk + IBF_NP F (A_sp + R) <= A_sp + R -> t2 <= t1 + F -> t2 <= job_arrival j + R
