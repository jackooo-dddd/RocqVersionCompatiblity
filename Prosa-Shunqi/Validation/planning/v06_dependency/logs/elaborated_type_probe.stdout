BEGIN|prosa.results.rta.ideal.fp.bounded_pi.A_is_in_concrete_search_space
@A_is_in_concrete_search_space
     : forall (Task : TaskType) (H : TaskCost Task) (FP : FP_policy Task) (ts : seq Task) (H3 : MaxArrivals Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall priority_inversion_bound L : duration, 0 < L -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : duration, search_space.is_in_search_space L (fun (A0 : nat) (Δ : duration) => task_request_bound_function tsk (A0 + 1) - task_cost tsk + (priority_inversion_bound + total_ohep_request_bound_function_FP ts tsk Δ)) A -> fp.bounded_pi.is_in_search_space tsk L A
END|prosa.results.rta.ideal.fp.bounded_pi.A_is_in_concrete_search_space
BEGIN|prosa.results.rta.ideal.fp.bounded_pi.correct_search_space
@correct_search_space
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (FP : FP_policy Task) (ts : seq Task) (H3 : MaxArrivals Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall priority_inversion_bound L : duration, 0 < L -> forall R : duration, (forall A : duration, fp.bounded_pi.is_in_search_space tsk L A -> exists F : duration, priority_inversion_bound + (task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk)) + total_ohep_request_bound_function_FP ts tsk (A + F) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : duration, search_space.is_in_search_space L (fun (A0 : nat) (Δ : duration) => task_request_bound_function tsk (A0 + 1) - task_cost tsk + (priority_inversion_bound + total_ohep_request_bound_function_FP ts tsk Δ)) A -> exists F : duration, task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk) + (priority_inversion_bound + total_ohep_request_bound_function_FP ts tsk (A + F)) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R
END|prosa.results.rta.ideal.fp.bounded_pi.correct_search_space
BEGIN|prosa.results.rta.ideal.fp.bounded_pi.uniprocessor_response_time_bound_fp
@uniprocessor_response_time_bound_fp
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (H2 : JobPreemptable Job) (FP : FP_policy Task), reflexive_task_priorities FP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule (ideal.processor_state Job)) (JobReady0 : JobReady Job (ideal.processor_state Job)), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> work_conserving arr_seq sched -> sequential_tasks arr_seq sched -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> forall H3 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall priority_inversion_bound : duration, priority_inversion_is_bounded_by arr_seq sched tsk (constant priority_inversion_bound) -> forall L : duration, 0 < L -> L = priority_inversion_bound + total_hep_request_bound_function_FP ts tsk L -> forall R : duration, (forall A : duration, fp.bounded_pi.is_in_search_space tsk L A -> exists F : duration, priority_inversion_bound + (task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk)) + total_ohep_request_bound_function_FP ts tsk (A + F) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> task_response_time_bound arr_seq sched tsk R
