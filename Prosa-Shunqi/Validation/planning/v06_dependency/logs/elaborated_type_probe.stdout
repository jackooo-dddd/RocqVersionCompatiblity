BEGIN|prosa.implementation.facts.extrapolated_arrival_curve.value_at_monotone
value_at_monotone
     : forall ac_prefix : ArrivalCurvePrefix, sorted_leq_steps ac_prefix -> monotone leq (value_at ac_prefix)
END|prosa.implementation.facts.extrapolated_arrival_curve.value_at_monotone
BEGIN|prosa.implementation.facts.extrapolated_arrival_curve.value_at_change_is_in_steps_of
value_at_change_is_in_steps_of
     : forall ac_prefix : ArrivalCurvePrefix, sorted_leq_steps ac_prefix -> no_inf_arrivals ac_prefix -> forall t : duration, value_at ac_prefix t < value_at ac_prefix (t + 1) -> exists v : Datatypes_nat__canonical__eqtype_Equality, (t + 1, v) \in steps_of ac_prefix
END|prosa.implementation.facts.extrapolated_arrival_curve.value_at_change_is_in_steps_of
BEGIN|prosa.implementation.facts.extrapolated_arrival_curve.sorted_ltn_steps_imply_sorted_leq_steps_steps
