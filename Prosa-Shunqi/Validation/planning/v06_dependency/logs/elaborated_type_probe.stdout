BEGIN|prosa.analysis.facts.transform.edf_wc.non_idle_swap_maintains_work_conservation_t1
@non_idle_swap_maintains_work_conservation_t1
     : forall (Job : JobType) (H : JobCost Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)) (t1 t2 : instant) (j2 : Job), scheduled_at sched j2 t2 -> forall t : instant, work_conserving arr_seq sched -> t = t1 -> exists j_other : Job, scheduled_at (swapped sched t1 t2) j_other t
END|prosa.analysis.facts.transform.edf_wc.non_idle_swap_maintains_work_conservation_t1
BEGIN|prosa.analysis.facts.transform.edf_wc.non_idle_swap_maintains_work_conservation_t2
@non_idle_swap_maintains_work_conservation_t2
     : forall (Job : JobType) (H : JobCost Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)) (t1 t2 : instant) (j1 : Job), scheduled_at sched j1 t1 -> forall t : instant, work_conserving arr_seq sched -> t = t2 -> exists j_other : Job, scheduled_at (swapped sched t1 t2) j_other t
END|prosa.analysis.facts.transform.edf_wc.non_idle_swap_maintains_work_conservation_t2
BEGIN|prosa.analysis.facts.transform.edf_wc.non_idle_swap_maintains_work_conservation_LEQ_t1
@non_idle_swap_maintains_work_conservation_LEQ_t1
     : forall (Job : JobType) (H : JobCost Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)) (t1 t2 : instant), t1 <= t2 -> forall j1 j2 : Job, scheduled_at sched j1 t1 -> scheduled_at sched j2 t2 -> forall (j : Job) (t : instant), arrives_in arr_seq j -> backlogged (swapped sched t1 t2) j t -> work_conserving arr_seq sched -> t <= t1 -> exists j_other : Job, scheduled_at (swapped sched t1 t2) j_other t
END|prosa.analysis.facts.transform.edf_wc.non_idle_swap_maintains_work_conservation_LEQ_t1
BEGIN|prosa.analysis.facts.transform.edf_wc.non_idle_swap_maintains_work_conservation_GT_t2
@non_idle_swap_maintains_work_conservation_GT_t2
     : forall (Job : JobType) (H : JobCost Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)) (t1 t2 : instant), t1 <= t2 -> forall j1 j2 : Job, scheduled_at sched j1 t1 -> scheduled_at sched j2 t2 -> forall (j : Job) (t : instant), arrives_in arr_seq j -> backlogged (swapped sched t1 t2) j t -> work_conserving arr_seq sched -> t2 < t -> exists j_other : Job, scheduled_at (swapped sched t1 t2) j_other t
END|prosa.analysis.facts.transform.edf_wc.non_idle_swap_maintains_work_conservation_GT_t2
BEGIN|prosa.analysis.facts.transform.edf_wc.non_idle_swap_maintains_work_conservation_BET_t1_t2
@non_idle_swap_maintains_work_conservation_BET_t1_t2
     : forall (Job : JobType) (H : JobCost Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)), completed_jobs_dont_execute sched -> jobs_come_from_arrival_sequence sched arr_seq -> forall (t1 t2 : instant) (j1 j2 : Job), job_arrival j2 <= t1 -> scheduled_at sched j1 t1 -> scheduled_at sched j2 t2 -> forall t : instant, work_conserving arr_seq sched -> t1 < t <= t2 -> exists j_other : Job, scheduled_at (swapped sched t1 t2) j_other t
END|prosa.analysis.facts.transform.edf_wc.non_idle_swap_maintains_work_conservation_BET_t1_t2
BEGIN|prosa.analysis.facts.transform.edf_wc.fsc_swap_maintains_work_conservation
@fsc_swap_maintains_work_conservation
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> jobs_come_from_arrival_sequence sched arr_seq -> forall (j1 : Job) (t1 : instant), scheduled_at sched j1 t1 -> t1 < job_deadline j1 -> work_conserving arr_seq sched -> work_conserving arr_seq (swapped sched t1 (edf_trans.find_swap_candidate sched t1 j1))
END|prosa.analysis.facts.transform.edf_wc.fsc_swap_maintains_work_conservation
BEGIN|prosa.analysis.facts.transform.edf_wc.mea_maintains_work_conservation
@mea_maintains_work_conservation
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)), jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall t_edf : instant, work_conserving arr_seq sched -> work_conserving arr_seq (make_edf_at sched t_edf)
END|prosa.analysis.facts.transform.edf_wc.mea_maintains_work_conservation
BEGIN|prosa.analysis.facts.transform.edf_wc.scheduled_behavior_premises
@scheduled_behavior_premises
     : forall Job : JobType, JobCost Job -> JobDeadline Job -> JobArrival Job -> arrival_sequence Job -> schedule (ideal.processor_state Job) -> Prop
END|prosa.analysis.facts.transform.edf_wc.scheduled_behavior_premises
BEGIN|prosa.analysis.facts.transform.edf_wc.edf_transform_prefix_maintains_work_conservation
@edf_transform_prefix_maintains_work_conservation
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)) (horizon : instant), scheduled_behavior_premises arr_seq sched /\ work_conserving arr_seq sched -> scheduled_behavior_premises arr_seq (edf_transform_prefix sched horizon) /\ work_conserving arr_seq (edf_transform_prefix sched horizon)
END|prosa.analysis.facts.transform.edf_wc.edf_transform_prefix_maintains_work_conservation
BEGIN|prosa.analysis.facts.transform.edf_wc.sched_satisfies_behavior_premises
@sched_satisfies_behavior_premises
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)), valid_schedule sched arr_seq -> all_deadlines_met sched -> scheduled_behavior_premises arr_seq sched
END|prosa.analysis.facts.transform.edf_wc.sched_satisfies_behavior_premises
BEGIN|prosa.analysis.facts.transform.edf_wc.edf_transform_maintains_work_conservation
@edf_transform_maintains_work_conservation
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)), valid_schedule sched arr_seq -> all_deadlines_met sched -> work_conserving arr_seq sched -> work_conserving arr_seq (edf_transform sched)
END|prosa.analysis.facts.transform.edf_wc.edf_transform_maintains_work_conservation
BEGIN|prosa.analysis.facts.transform.replace_at.replace_at_def
@replace_at_def
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t' : instant) (nstate : PState), replace_at sched t' nstate t' = nstate
END|prosa.analysis.facts.transform.replace_at.replace_at_def
BEGIN|prosa.analysis.facts.transform.replace_at.rest_of_schedule_invariant
@rest_of_schedule_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t' : instant) (nstate : PState) (t : instant), t <> t' -> replace_at sched t' nstate t = sched t
END|prosa.analysis.facts.transform.replace_at.rest_of_schedule_invariant
BEGIN|prosa.analysis.facts.transform.replace_at.service_at_other_times_invariant
@service_at_other_times_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t' : instant) (nstate : PState) (t1 t2 : nat), t2 <= t' \/ t' < t1 -> forall j : Job, service_during sched j t1 t2 = service_during (replace_at sched t' nstate) j t1 t2
END|prosa.analysis.facts.transform.replace_at.service_at_other_times_invariant
BEGIN|prosa.analysis.facts.transform.replace_at.service_delta
@service_delta
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t' : instant) (nstate : PState) (t1 t2 : nat), t1 <= t' < t2 -> forall j : Job, service_during sched j t1 t2 + service_at (replace_at sched t' nstate) j t' = service_during (replace_at sched t' nstate) j t1 t2 + service_at sched j t'
END|prosa.analysis.facts.transform.replace_at.service_delta
BEGIN|prosa.analysis.facts.transform.replace_at.service_in_replaced
@service_in_replaced
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t' : instant) (nstate : PState) (t1 t2 : nat), t1 <= t' < t2 -> forall j : Job, service_during (replace_at sched t' nstate) j t1 t2 = service_during sched j t1 t2 + service_at (replace_at sched t' nstate) j t' - service_at sched j t'
END|prosa.analysis.facts.transform.replace_at.service_in_replaced
BEGIN|prosa.analysis.facts.transform.replace_at.service_at_of_others_invariant
@service_at_of_others_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t' : instant) (nstate : PState) (j : Job), ~~ scheduled_in j (replace_at sched t' nstate t') -> ~~ scheduled_in j (sched t') -> forall t : instant, service_at sched j t = service_at (replace_at sched t' nstate) j t
END|prosa.analysis.facts.transform.replace_at.service_at_of_others_invariant
BEGIN|prosa.analysis.facts.transform.replace_at.service_during_of_others_invariant
@service_during_of_others_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t' : instant) (nstate : PState) (j : Job), ~~ scheduled_in j (replace_at sched t' nstate t') -> ~~ scheduled_in j (sched t') -> forall t1 t2 : instant, service_during sched j t1 t2 = service_during (replace_at sched t' nstate) j t1 t2
END|prosa.analysis.facts.transform.replace_at.service_during_of_others_invariant
BEGIN|prosa.analysis.facts.transform.swaps.trivial_swap
@trivial_swap
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 = t2 -> forall t : instant, sched t = swapped sched t1 t2 t
END|prosa.analysis.facts.transform.swaps.trivial_swap
BEGIN|prosa.analysis.facts.transform.swaps.trivial_swap_service_invariant
@trivial_swap_service_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 = t2 -> forall (t : instant) (j : Job), service sched j t = service (swapped sched t1 t2) j t
END|prosa.analysis.facts.transform.swaps.trivial_swap_service_invariant
BEGIN|prosa.analysis.facts.transform.swaps.swap_other_times_invariant
@swap_other_times_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 t : instant), t <> t1 -> t <> t2 -> sched t = swapped sched t1 t2 t
END|prosa.analysis.facts.transform.swaps.swap_other_times_invariant
BEGIN|prosa.analysis.facts.transform.swaps.swap_job_scheduled_t1
@swap_job_scheduled_t1
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant) (j : Job), scheduled_at (swapped sched t1 t2) j t1 = scheduled_at sched j t2
END|prosa.analysis.facts.transform.swaps.swap_job_scheduled_t1
BEGIN|prosa.analysis.facts.transform.swaps.swap_job_scheduled_t2
@swap_job_scheduled_t2
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant) (j : Job), scheduled_at (swapped sched t1 t2) j t2 = scheduled_at sched j t1
END|prosa.analysis.facts.transform.swaps.swap_job_scheduled_t2
BEGIN|prosa.analysis.facts.transform.swaps.swap_job_scheduled_other_times
@swap_job_scheduled_other_times
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant) (j : Job) (t : Datatypes_nat__canonical__eqtype_Equality), t1 != t -> t2 != t -> scheduled_at (swapped sched t1 t2) j t = scheduled_at sched j t
END|prosa.analysis.facts.transform.swaps.swap_job_scheduled_other_times
BEGIN|prosa.analysis.facts.transform.swaps.swap_job_scheduled_cases
@swap_job_scheduled_cases
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant) (j : Job) (t : instant), scheduled_at (swapped sched t1 t2) j t -> scheduled_at (swapped sched t1 t2) j t = scheduled_at sched j t \/ t = t1 /\ scheduled_at (swapped sched t1 t2) j t = scheduled_at sched j t2 \/ t = t2 /\ scheduled_at (swapped sched t1 t2) j t = scheduled_at sched j t1
END|prosa.analysis.facts.transform.swaps.swap_job_scheduled_cases
BEGIN|prosa.analysis.facts.transform.swaps.swap_job_scheduled
@swap_job_scheduled
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant) (j : Job) (t : instant), scheduled_at (swapped sched t1 t2) j t -> exists t' : instant, scheduled_at sched j t'
END|prosa.analysis.facts.transform.swaps.swap_job_scheduled
BEGIN|prosa.analysis.facts.transform.swaps.swap_job_scheduled_original_cases
@swap_job_scheduled_original_cases
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant) (j : Job) (t : instant), scheduled_at sched j t -> scheduled_at (swapped sched t1 t2) j t = scheduled_at sched j t \/ t = t1 /\ scheduled_at (swapped sched t1 t2) j t2 = scheduled_at sched j t \/ t = t2 /\ scheduled_at (swapped sched t1 t2) j t1 = scheduled_at sched j t
END|prosa.analysis.facts.transform.swaps.swap_job_scheduled_original_cases
BEGIN|prosa.analysis.facts.transform.swaps.swap_job_scheduled_original
@swap_job_scheduled_original
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant) (j : Job) (t : instant), scheduled_at sched j t -> exists t' : instant, scheduled_at (swapped sched t1 t2) j t'
END|prosa.analysis.facts.transform.swaps.swap_job_scheduled_original
BEGIN|prosa.analysis.facts.transform.swaps.swap_before_invariant
@swap_before_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 <= t2 -> forall t : nat, t < t1 -> sched t = swapped sched t1 t2 t
END|prosa.analysis.facts.transform.swaps.swap_before_invariant
BEGIN|prosa.analysis.facts.transform.swaps.swap_after_invariant
@swap_after_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 <= t2 -> forall t : nat, t2 < t -> sched t = swapped sched t1 t2 t
END|prosa.analysis.facts.transform.swaps.swap_after_invariant
BEGIN|prosa.analysis.facts.transform.swaps.service_before_swap_invariant
@service_before_swap_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 <= t2 -> forall t : nat, t <= t1 -> forall j : Job, service sched j t = service (swapped sched t1 t2) j t
END|prosa.analysis.facts.transform.swaps.service_before_swap_invariant
BEGIN|prosa.analysis.facts.transform.swaps.service_after_swap_invariant
@service_after_swap_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 <= t2 -> forall t : nat, t2 < t -> forall j : Job, service sched j t = service (swapped sched t1 t2) j t
END|prosa.analysis.facts.transform.swaps.service_after_swap_invariant
BEGIN|prosa.analysis.facts.transform.swaps.service_of_others_invariant
@service_of_others_invariant
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 <= t2 -> forall (t : instant) (j : Job), ~~ scheduled_in j (sched t1) -> ~~ scheduled_in j (sched t2) -> service sched j t = service (swapped sched t1 t2) j t
END|prosa.analysis.facts.transform.swaps.service_of_others_invariant
BEGIN|prosa.analysis.facts.transform.swaps.swapped_service_bound
@swapped_service_bound
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 <= t2 -> (forall (j : Job) (t : instant), service sched j t <= job_cost j) -> forall (j : Job) (t : instant), service (swapped sched t1 t2) j t <= job_cost j
END|prosa.analysis.facts.transform.swaps.swapped_service_bound
BEGIN|prosa.analysis.facts.transform.swaps.swapped_completed_jobs_dont_execute
@swapped_completed_jobs_dont_execute
     : forall (Job : JobType) (H : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 <= t2 -> unit_service_proc_model PState -> ideal_progress_proc_model PState -> completed_jobs_dont_execute sched -> completed_jobs_dont_execute (swapped sched t1 t2)
END|prosa.analysis.facts.transform.swaps.swapped_completed_jobs_dont_execute
BEGIN|prosa.analysis.facts.transform.swaps.swapped_jobs_come_from_arrival_sequence
@swapped_jobs_come_from_arrival_sequence
     : forall (Job : JobType) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant) (arr_seq : arrival_sequence Job), jobs_come_from_arrival_sequence sched arr_seq -> jobs_come_from_arrival_sequence (swapped sched t1 t2) arr_seq
END|prosa.analysis.facts.transform.swaps.swapped_jobs_come_from_arrival_sequence
BEGIN|prosa.analysis.facts.transform.swaps.uninvolved_implies_deadline_met
@uninvolved_implies_deadline_met
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 <= t2 -> forall j : Job, job_meets_deadline sched j -> ~~ scheduled_at sched j t1 -> ~~ scheduled_at sched j t2 -> job_meets_deadline (swapped sched t1 t2) j
END|prosa.analysis.facts.transform.swaps.uninvolved_implies_deadline_met
BEGIN|prosa.analysis.facts.transform.swaps.moved_earlier_implies_deadline_met
@moved_earlier_implies_deadline_met
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (PState : ProcessorState Job) (sched : schedule PState), completed_jobs_dont_execute sched -> forall t1 t2 : instant, t1 <= t2 -> forall j : Job, job_meets_deadline sched j -> scheduled_at sched j t2 -> job_meets_deadline (swapped sched t1 t2) j
END|prosa.analysis.facts.transform.swaps.moved_earlier_implies_deadline_met
BEGIN|prosa.analysis.facts.transform.swaps.moved_later_implies_deadline_met
@moved_later_implies_deadline_met
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (PState : ProcessorState Job) (sched : schedule PState) (t1 t2 : instant), t1 <= t2 -> (forall j1 j2 : Job, scheduled_at sched j1 t1 -> scheduled_at sched j2 t2 -> job_deadline j2 <= job_deadline j1) -> (forall j1 : Job, scheduled_at sched j1 t1 -> exists j2 : Job, scheduled_at sched j2 t2 /\ t2 < job_deadline j2) -> forall j : Job, job_meets_deadline sched j -> scheduled_at sched j t1 -> job_meets_deadline (swapped sched t1 t2) j
END|prosa.analysis.facts.transform.swaps.moved_later_implies_deadline_met
BEGIN|prosa.analysis.facts.transform.swaps.edf_swap_no_deadline_misses_introduced
@edf_swap_no_deadline_misses_introduced
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (PState : ProcessorState Job) (sched : schedule PState), completed_jobs_dont_execute sched -> forall t1 t2 : instant, t1 <= t2 -> (forall j1 j2 : Job, scheduled_at sched j1 t1 -> scheduled_at sched j2 t2 -> job_deadline j2 <= job_deadline j1) -> (forall j1 : Job, scheduled_at sched j1 t1 -> exists j2 : Job, scheduled_at sched j2 t2 /\ t2 < job_deadline j2) -> forall j : Job, job_meets_deadline sched j -> job_meets_deadline (swapped sched t1 t2) j
END|prosa.analysis.facts.transform.swaps.edf_swap_no_deadline_misses_introduced
