     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobPredecessors Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (Omega : Type) (H1 : SystemEvolutions Omega Job) (omega_0 : Omega), (forall (omega : Omega) (j : Job), job_cost j <= job_cost j) -> forall algA algB : Scheduler Omega Job, valid_schedule (algA omega_0) arr_seq -> (forall omega : Omega, valid_schedule (algB omega) arr_seq) -> clairvoyant_criterion arr_seq Omega omega_0 algA algB -> forall omega : Omega, schedulability_transferred_AB Omega omega_0 algA algB omega
