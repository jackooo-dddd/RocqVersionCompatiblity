     : forall (Job : JobType) (sched : schedule (overheads.processor_state Job)) (DB CSB CRPDB : duration), overhead_resource_model sched DB CSB CRPDB -> forall (k : nat) (t1 t2 : instant), schedule_change sched t1 -> number_schedule_changes sched t1 t2 = k -> blackout_during sched t1 t2 <= (DB + CSB + CRPDB) * k
END|prosa.analysis.facts.model.overheads.blackout_bound.fin_sched_changes_start_busy_pref_bounded_overheads_blackout
