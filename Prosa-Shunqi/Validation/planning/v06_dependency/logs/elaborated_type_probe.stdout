BEGIN|prosa.results.rta.ideal.fp.bounded_pi.instantiated_busy_intervals_are_bounded
@instantiated_busy_intervals_are_bounded
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H1 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (FP : FP_policy Task), reflexive_task_priorities FP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule (ideal.processor_state Job)) (JobReady0 : JobReady Job (ideal.processor_state Job)), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> work_conserving arr_seq sched -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> forall H3 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall (tsk : Task) (priority_inversion_bound : duration), priority_inversion_is_bounded_by arr_seq sched tsk (constant priority_inversion_bound) -> forall L : duration, 0 < L -> L = priority_inversion_bound + total_hep_request_bound_function_FP ts tsk L -> busy_intervals_are_bounded_by arr_seq sched tsk L
