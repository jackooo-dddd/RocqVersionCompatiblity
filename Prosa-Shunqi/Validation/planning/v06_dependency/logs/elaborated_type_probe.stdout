     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall (horizon : instant) (j : Job) (t : instant), scheduled_at (edf_transform_prefix sched horizon) j t -> t < job_deadline j
