END|prosa.analysis.facts.jitter.jitter_prop_same_jobs'
BEGIN|prosa.analysis.facts.jitter.jitter_prop_valid_costs
@jitter_prop_valid_costs
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> forall (H2 : JobCost Job) (H3 : TaskCost Task), arrivals_have_valid_job_costs arr_seq -> arrivals_have_valid_job_costs (release_sequence arr_seq)
END|prosa.analysis.facts.jitter.jitter_prop_valid_costs
BEGIN|prosa.analysis.facts.jitter.jitter_ready_to_execute
@jitter_ready_to_execute
     : forall (Job : JobType) (original_arrival : JobArrival Job) (H1 : JobJitter Job) (PState : ProcessorState Job) (sched : schedule PState) (H2 : JobCost Job), jobs_must_be_ready_to_execute sched -> jobs_must_be_ready_to_execute sched
END|prosa.analysis.facts.jitter.jitter_ready_to_execute
BEGIN|prosa.analysis.facts.jitter.jitter_work_conservation
@jitter_work_conservation
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> forall (PState : ProcessorState Job) (sched : schedule PState) (H2 : JobCost Job), work_conserving arr_seq sched -> work_conserving (release_sequence arr_seq) sched
END|prosa.analysis.facts.jitter.jitter_work_conservation
BEGIN|prosa.analysis.facts.jitter.jitter_valid_schedule
@jitter_valid_schedule
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> forall (PState : ProcessorState Job) (sched : schedule PState) (H2 : JobCost Job), valid_schedule sched arr_seq -> valid_schedule sched (release_sequence arr_seq)
END|prosa.analysis.facts.jitter.jitter_valid_schedule
BEGIN|prosa.analysis.facts.jitter.jitter_scheduled_jobs_at_equiv
@jitter_scheduled_jobs_at_equiv
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> forall (PState : ProcessorState Job) (sched : schedule PState) (H2 : JobCost Job), valid_schedule sched arr_seq -> forall (t : instant) (j : Job), (j \in scheduled_jobs_at (release_sequence arr_seq) sched t) = (j \in scheduled_jobs_at arr_seq sched t)
END|prosa.analysis.facts.jitter.jitter_scheduled_jobs_at_equiv
BEGIN|prosa.analysis.facts.jitter.jitter_scheduled_job_at_eq
@jitter_scheduled_job_at_eq
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> forall (PState : ProcessorState Job) (sched : schedule PState) (H2 : JobCost Job), valid_schedule sched arr_seq -> forall t : instant, uniprocessor_model PState -> scheduled_job_at arr_seq sched t = scheduled_job_at (release_sequence arr_seq) sched t
END|prosa.analysis.facts.jitter.jitter_scheduled_job_at_eq
BEGIN|prosa.analysis.facts.jitter.jitter_FP_compliance
@jitter_FP_compliance
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> forall (PState : ProcessorState Job) (sched : schedule PState) (H2 : JobCost Job), valid_schedule sched arr_seq -> forall (FP : FP_policy Task) (H4 : JobPreemptable Job), uniprocessor_model PState -> respects_FP_policy_at_preemption_point arr_seq sched FP -> respects_FP_policy_at_preemption_point (release_sequence arr_seq) sched FP
END|prosa.analysis.facts.jitter.jitter_FP_compliance
BEGIN|prosa.analysis.facts.jitter.jitter_response_time_bound
@jitter_response_time_bound
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> forall (PState : ProcessorState Job) (sched : schedule PState) (H2 : JobCost Job) (tsk : Task) (R : duration), tsk \in ts -> task_response_time_bound (release_sequence arr_seq) sched tsk R -> task_response_time_bound arr_seq sched tsk (task_jitter tsk + R)
END|prosa.analysis.facts.jitter.jitter_response_time_bound
BEGIN|prosa.analysis.facts.job_index.case_arrival_lte_implies_equal_job
@case_arrival_lte_implies_equal_job
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = job_task j2 -> job_index arr_seq j1 = job_index arr_seq j2 -> job_arrival j1 <= job_arrival j2 -> j1 = j2
END|prosa.analysis.facts.job_index.case_arrival_lte_implies_equal_job
BEGIN|prosa.analysis.facts.job_index.case_arrival_gt_implies_equal_job
@case_arrival_gt_implies_equal_job
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = job_task j2 -> job_index arr_seq j1 = job_index arr_seq j2 -> job_arrival j2 < job_arrival j1 -> j1 = j2
END|prosa.analysis.facts.job_index.case_arrival_gt_implies_equal_job
BEGIN|prosa.analysis.facts.job_index.equal_index_implies_equal_jobs
@equal_index_implies_equal_jobs
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = job_task j2 -> job_index arr_seq j1 = job_index arr_seq j2 -> j1 = j2
END|prosa.analysis.facts.job_index.equal_index_implies_equal_jobs
BEGIN|prosa.analysis.facts.job_index.diff_jobs_iff_diff_indices
@diff_jobs_iff_diff_indices
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = job_task j2 -> j1 <> j2 <-> job_index arr_seq j1 <> job_index arr_seq j2
END|prosa.analysis.facts.job_index.diff_jobs_iff_diff_indices
BEGIN|prosa.analysis.facts.job_index.index_as_sum_size_and_index
@index_as_sum_size_and_index
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 : Job, arrives_in arr_seq j1 -> job_index arr_seq j1 = size (task_arrivals_before_job_arrival arr_seq j1) + index j1 (task_arrivals_at_job_arrival arr_seq j1)
END|prosa.analysis.facts.job_index.index_as_sum_size_and_index
BEGIN|prosa.analysis.facts.job_index.arrival_lt_implies_job_in_arrivals_between_P
@job_index.arrival_lt_implies_job_in_arrivals_between_P
     : forall (Job : JobType) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (j1 j2 : Job) (P : Job -> bool) (t1 t2 : instant), j1 \in arrivals_between_P arr_seq P t1 t2 -> j2 \in arrivals_between_P arr_seq P t1 t2 -> job_arrival j2 < job_arrival j1 -> j2 \in arrivals_between_P arr_seq P t1 (job_arrival j1)
END|prosa.analysis.facts.job_index.arrival_lt_implies_job_in_arrivals_between_P
BEGIN|prosa.analysis.facts.job_index.index_lte_implies_arrival_lte_P
@index_lte_implies_arrival_lte_P
     : forall (Job : JobType) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (j1 j2 : Job) (P : Job -> bool) (t1 t2 : instant), j1 \in arrivals_between_P arr_seq P t1 t2 -> j2 \in arrivals_between_P arr_seq P t1 t2 -> index j1 (arrivals_between_P arr_seq P t1 t2) <= index j2 (arrivals_between_P arr_seq P t1 t2) -> job_arrival j1 <= job_arrival j2
END|prosa.analysis.facts.job_index.index_lte_implies_arrival_lte_P
BEGIN|prosa.analysis.facts.job_index.job_index_same_in_task_arrivals
@job_index_same_in_task_arrivals
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = job_task j2 -> job_arrival j1 <= job_arrival j2 -> index j1 (task_arrivals_up_to_job_arrival arr_seq j1) = index j1 (task_arrivals_up_to_job_arrival arr_seq j2)
END|prosa.analysis.facts.job_index.job_index_same_in_task_arrivals
BEGIN|prosa.analysis.facts.job_index.index_job_lt_size_task_arrivals_up_to_job
@index_job_lt_size_task_arrivals_up_to_job
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 : Job, arrives_in arr_seq j1 -> job_index arr_seq j1 < size (task_arrivals_up_to_job_arrival arr_seq j1)
END|prosa.analysis.facts.job_index.index_job_lt_size_task_arrivals_up_to_job
BEGIN|prosa.analysis.facts.job_index.index_lte_implies_arrival_lte
@index_lte_implies_arrival_lte
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = job_task j2 -> job_index arr_seq j2 <= job_index arr_seq j1 -> job_arrival j2 <= job_arrival j1
END|prosa.analysis.facts.job_index.index_lte_implies_arrival_lte
BEGIN|prosa.analysis.facts.job_index.earlier_arrival_implies_lower_index
@earlier_arrival_implies_lower_index
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = job_task j2 -> job_arrival j1 < job_arrival j2 -> job_index arr_seq j1 < job_index arr_seq j2
END|prosa.analysis.facts.job_index.earlier_arrival_implies_lower_index
BEGIN|prosa.analysis.facts.job_index.job_index_minus_one_lt_size_task_arrivals_up_to
@job_index_minus_one_lt_size_task_arrivals_up_to
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 : Job, arrives_in arr_seq j1 -> job_index arr_seq j1 - 1 < size (task_arrivals_up_to_job_arrival arr_seq j1)
END|prosa.analysis.facts.job_index.job_index_minus_one_lt_size_task_arrivals_up_to
BEGIN|prosa.analysis.facts.job_index.positive_job_index_implies_positive_size_of_task_arrivals
@positive_job_index_implies_positive_size_of_task_arrivals
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j1 : Job, arrives_in arr_seq j1 -> 0 < size (task_arrivals_up_to_job_arrival arr_seq j1)
END|prosa.analysis.facts.job_index.positive_job_index_implies_positive_size_of_task_arrivals
BEGIN|prosa.analysis.facts.job_index.prev_job_arr
@prev_job_arr
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (j : Job), arrives_in arr_seq j -> arrives_in arr_seq (prev_job arr_seq j)
END|prosa.analysis.facts.job_index.prev_job_arr
BEGIN|prosa.analysis.facts.job_index.prev_job_index
@prev_job_index
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j : Job, arrives_in arr_seq j -> 0 < job_index arr_seq j -> index (prev_job arr_seq j) (task_arrivals_up_to_job_arrival arr_seq j) = job_index arr_seq j - 1
END|prosa.analysis.facts.job_index.prev_job_index
BEGIN|prosa.analysis.facts.job_index.prev_job_task
@prev_job_task
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j : Job, arrives_in arr_seq j -> 0 < job_index arr_seq j -> job_task (prev_job arr_seq j) = job_task j
END|prosa.analysis.facts.job_index.prev_job_task
BEGIN|prosa.analysis.facts.job_index.prev_job_in_task_arrivals_up_to_j
@prev_job_in_task_arrivals_up_to_j
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j : Job, arrives_in arr_seq j -> prev_job arr_seq j \in task_arrivals_up_to_job_arrival arr_seq j
END|prosa.analysis.facts.job_index.prev_job_in_task_arrivals_up_to_j
BEGIN|prosa.analysis.facts.job_index.prev_job_arr_lte
@prev_job_arr_lte
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j : Job, arrives_in arr_seq j -> 0 < job_index arr_seq j -> job_arrival (prev_job arr_seq j) <= job_arrival j
END|prosa.analysis.facts.job_index.prev_job_arr_lte
BEGIN|prosa.analysis.facts.job_index.prev_job_index_j
@prev_job_index_j
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j : Job, arrives_in arr_seq j -> 0 < job_index arr_seq j -> 0 < job_index arr_seq j -> job_index arr_seq (prev_job arr_seq j) = job_index arr_seq j - 1
END|prosa.analysis.facts.job_index.prev_job_index_j
BEGIN|prosa.analysis.facts.job_index.no_jobs_between_consecutive_jobs
@no_jobs_between_consecutive_jobs
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j : Job, arrives_in arr_seq j -> 0 < job_index arr_seq j -> 0 < job_index arr_seq j -> task_arrivals_between arr_seq (job_task j) (job_arrival (prev_job arr_seq j)).+1 (job_arrival j) = [::]
END|prosa.analysis.facts.job_index.no_jobs_between_consecutive_jobs
BEGIN|prosa.analysis.facts.job_index.exists_jobs_before_j
@exists_jobs_before_j
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall j : Job, arrives_in arr_seq j -> forall k : nat, k < job_index arr_seq j -> exists j' : Job, j <> j' /\ job_task j' = job_task j /\ arrives_in arr_seq j' /\ job_index arr_seq j' = k
END|prosa.analysis.facts.job_index.exists_jobs_before_j
BEGIN|prosa.analysis.facts.model.arrival_curves.non_pathological_max_arrivals
@non_pathological_max_arrivals
     : forall (Task : TaskType) (H : MaxArrivals Task) (Job : JobType) (H0 : JobTask Job Task) (tsk : Task) (arr_seq : arrival_sequence Job), respects_max_arrivals arr_seq tsk (max_arrivals tsk) -> forall j : Job, job_of_task tsk j -> arrives_in arr_seq j -> 0 < max_arrivals tsk 1
END|prosa.analysis.facts.model.arrival_curves.non_pathological_max_arrivals
BEGIN|prosa.analysis.facts.model.arrival_curves.jlfp_hep_arrivals_bounded_by_sum_max_arrivals
@jlfp_hep_arrivals_bounded_by_sum_max_arrivals
     : forall (Task : TaskType) (H : MaxArrivals Task) (Job : JobType) (H0 : JobTask Job Task) (H2 : JLFP_policy Job) (arr_seq : arrival_sequence Job) (ts : seq Task), all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall (j : Job) (t1 : instant) (Δ : duration), size [seq jhp <- arrivals_between arr_seq t1 (t1 + Δ) | hep_job jhp j] <= \sum_(tsk <- ts) max_arrivals tsk Δ
END|prosa.analysis.facts.model.arrival_curves.jlfp_hep_arrivals_bounded_by_sum_max_arrivals
BEGIN|prosa.analysis.facts.model.arrival_curves.fp_hep_arrivals_bounded_by_sum_max_arrivals
@fp_hep_arrivals_bounded_by_sum_max_arrivals
     : forall (Task : TaskType) (H : MaxArrivals Task) (Job : JobType) (H0 : JobTask Job Task) (H2 : FP_policy Task) (arr_seq : arrival_sequence Job) (ts : seq Task), all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall (j : Job) (t1 : instant) (Δ : duration), size [seq jhp <- arrivals_between arr_seq t1 (t1 + Δ) | hep_job jhp j] <= \sum_(tsk <- ts | hep_task tsk (job_task j)) max_arrivals tsk Δ
END|prosa.analysis.facts.model.arrival_curves.fp_hep_arrivals_bounded_by_sum_max_arrivals
BEGIN|prosa.analysis.facts.model.dbf.task_arrivals_with_deadline_within_eq
@task_arrivals_with_deadline_within_eq
     : forall (Task : TaskType) (H : TaskDeadline Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (tsk : Task) (t : instant) (delta : duration), task_arrivals_with_deadline_within arr_seq tsk t (t + delta) = task_arrivals_between arr_seq tsk t (t + (delta - (task_deadline tsk - 1)))
END|prosa.analysis.facts.model.dbf.task_arrivals_with_deadline_within_eq
BEGIN|prosa.analysis.facts.model.dbf.num_task_arrivals_with_deadline_within_eq
@num_task_arrivals_with_deadline_within_eq
     : forall (Task : TaskType) (H : TaskDeadline Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (tsk : Task) (t : instant) (delta : duration), number_of_task_arrivals_with_deadline_within arr_seq tsk t (t + delta) = number_of_task_arrivals arr_seq tsk t (t + (delta - (task_deadline tsk - 1)))
END|prosa.analysis.facts.model.dbf.num_task_arrivals_with_deadline_within_eq
BEGIN|prosa.analysis.facts.model.dbf.task_demand_within
@task_demand_within
     : forall Task : TaskType, TaskDeadline Task -> forall Job : JobType, JobTask Job Task -> JobArrival Job -> arrival_sequence Job -> JobCost Job -> Task -> instant -> instant -> nat
END|prosa.analysis.facts.model.dbf.task_demand_within
BEGIN|prosa.analysis.facts.model.dbf.task_demand_within_le_task_dbf
@task_demand_within_le_task_dbf
