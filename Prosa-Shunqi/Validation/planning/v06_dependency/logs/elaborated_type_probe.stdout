     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (JLFP : JLFP_policy Job), reflexive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule (overheads.processor_state Job), valid_schedule sched arr_seq -> forall H1 : JobPreemptable Job, valid_preemption_model arr_seq sched -> forall t : instant, priority_bump sched t -> preemption_time arr_seq sched t
