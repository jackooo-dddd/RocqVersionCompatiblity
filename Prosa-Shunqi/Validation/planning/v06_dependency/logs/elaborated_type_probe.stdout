BEGIN|prosa.analysis.facts.preemption.job.nonpreemptive.job_last_nps_is_job_cost
@job_last_nps_is_job_cost
     : forall (Job : JobType) (H0 : JobCost Job) (j : Job), job_last_nonpreemptive_segment j = job_cost j
END|prosa.analysis.facts.preemption.job.nonpreemptive.job_last_nps_is_job_cost
BEGIN|prosa.analysis.facts.preemption.job.nonpreemptive.no_preemptions_equiv_nonpreemptive
@no_preemptions_equiv_nonpreemptive
     : forall (Job : JobType) (H0 : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState), (forall (j : Job) (t : instant), ~~ preempted_at sched j t) <-> nonpreemptive_schedule sched
END|prosa.analysis.facts.preemption.job.nonpreemptive.no_preemptions_equiv_nonpreemptive
BEGIN|prosa.analysis.facts.preemption.job.preemptive.valid_fully_preemptive_model
