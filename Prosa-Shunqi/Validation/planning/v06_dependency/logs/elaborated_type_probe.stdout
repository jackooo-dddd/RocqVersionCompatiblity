     : forall (Job : JobType) (H0 : JobCost Job) (H1 : JobPreemptable Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState), valid_preemption_model arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> 0 < job_rtct j
