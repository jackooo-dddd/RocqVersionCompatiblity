BEGIN|prosa.results.rta.ideal.fp.nonseq.bounded_pi.is_in_concrete_search_space
@is_in_concrete_search_space
     : forall Task : TaskType, TaskCost Task -> MaxArrivals Task -> Task -> duration -> nat -> bool
END|prosa.results.rta.ideal.fp.nonseq.bounded_pi.is_in_concrete_search_space
BEGIN|prosa.results.rta.ideal.fp.nonseq.bounded_pi.A_is_in_concrete_search_space
@nonseq.bounded_pi.A_is_in_concrete_search_space
     : forall (Task : TaskType) (H : TaskCost Task) (MaxArrivals0 : MaxArrivals Task) (FP : FP_policy Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall priority_inversion_bound L : duration, 0 < L -> L = priority_inversion_bound + total_hep_request_bound_function_FP ts tsk L -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : duration, search_space.is_in_search_space L (IBF ts tsk priority_inversion_bound) A -> is_in_concrete_search_space tsk L A
END|prosa.results.rta.ideal.fp.nonseq.bounded_pi.A_is_in_concrete_search_space
BEGIN|prosa.results.rta.ideal.fp.nonseq.bounded_pi.correct_search_space
@nonseq.bounded_pi.correct_search_space
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (MaxArrivals0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (Cost : JobCost Job) (JobPreemptable0 : JobPreemptable Job) (arr_seq : arrival_sequence Job) (FP : FP_policy Task), reflexive_task_priorities FP -> forall ts : seq Task, valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> valid_task_run_to_completion_threshold arr_seq tsk -> forall priority_inversion_bound L : duration, 0 < L -> L = priority_inversion_bound + total_hep_request_bound_function_FP ts tsk L -> forall R : duration, (forall A : duration, is_in_concrete_search_space tsk L A -> exists F : duration, 0 < F /\ priority_inversion_bound + total_hep_request_bound_function_FP ts tsk (A + F) - (task_cost tsk - task_rtct tsk) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : nat, search_space.is_in_search_space L (IBF ts tsk priority_inversion_bound) A -> exists F : nat, task_rtct tsk + IBF ts tsk priority_inversion_bound A (A + F) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R
END|prosa.results.rta.ideal.fp.nonseq.bounded_pi.correct_search_space
BEGIN|prosa.results.rta.ideal.fp.nonseq.bounded_pi.uniprocessor_response_time_bound_fp
@bounded_pi.uniprocessor_response_time_bound_fp
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (MaxArrivals0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (JobPreemptable0 : JobPreemptable Job) (JobReady0 : JobReady Job (ideal.processor_state Job)) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall FP : FP_policy Task, reflexive_task_priorities FP -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> work_bearing_readiness arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall priority_inversion_bound : duration, priority_inversion_is_bounded_by arr_seq sched tsk (constant priority_inversion_bound) -> work_conserving arr_seq sched -> forall L : duration, 0 < L -> L = priority_inversion_bound + total_hep_request_bound_function_FP ts tsk L -> forall R : duration, (forall A : duration, is_in_concrete_search_space tsk L A -> exists F : duration, 0 < F /\ priority_inversion_bound + total_hep_request_bound_function_FP ts tsk (A + F) - (task_cost tsk - task_rtct tsk) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> task_response_time_bound arr_seq sched tsk R
END|prosa.results.rta.ideal.fp.nonseq.bounded_pi.uniprocessor_response_time_bound_fp
BEGIN|prosa.results.rta.ideal.gel.bounded_pi.total_workload_shorten_range
@bounded_pi.total_workload_shorten_range
     : forall (Task : TaskType) (H : TaskCost Task) (H2 : MaxArrivals Task) (Job : JobType) (H3 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (H5 : PriorityPoint Task) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (ts : seq Task) (tsk : Task), tsk \in ts -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> forall j : Job, job_of_task tsk j -> job_cost_positive j -> forall t1 t2 Δ : duration, t1 + Δ < t2 -> forall tsk_o : Task, tsk_o \in ts -> tsk_o != tsk -> ((job_arrival j - t1 + 1)%:R + task_priority_point tsk - task_priority_point tsk_o <= Δ%:R)%R -> workload_of_jobs (fun jo : Job => hep_job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + Δ)) <= workload_of_jobs (fun jo : Job => hep_job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 `|Order.Def.max 0%R (t1%:R + ((job_arrival j - t1 + 1)%:R + task_priority_point tsk - task_priority_point tsk_o))%R|)
END|prosa.results.rta.ideal.gel.bounded_pi.total_workload_shorten_range
BEGIN|prosa.results.rta.ideal.gel.bounded_pi.sum_of_workloads_is_at_most_bound_on_total_hep_workload
@bounded_pi.sum_of_workloads_is_at_most_bound_on_total_hep_workload
     : forall (Task : TaskType) (H : TaskCost Task) (H2 : MaxArrivals Task) (Job : JobType) (H3 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (H5 : PriorityPoint Task) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> forall j : Job, job_of_task tsk j -> job_cost_positive j -> forall t1 t2 Δ : duration, t1 + Δ < t2 -> \sum_(tsk_o <- ts | tsk_o != tsk) workload_of_jobs (fun jo : Job => hep_job jo j && (job_task jo == tsk_o)) (arrivals_between arr_seq t1 (t1 + Δ)) <= \sum_(tsk_o <- ts | tsk_o != tsk) task_request_bound_function tsk_o (minn `|Order.Def.max 0%R ((job_arrival j - t1 + 1)%:R + task_priority_point tsk - task_priority_point tsk_o)%R| Δ)
END|prosa.results.rta.ideal.gel.bounded_pi.sum_of_workloads_is_at_most_bound_on_total_hep_workload
BEGIN|prosa.results.rta.ideal.gel.bounded_pi.instantiated_task_interference_is_bounded
@bounded_pi.instantiated_task_interference_is_bounded
     : forall (Task : TaskType) (H : TaskCost Task) (H2 : MaxArrivals Task) (Job : JobType) (H3 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (H5 : PriorityPoint Task) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall priority_inversion_bound : duration -> duration, priority_inversion_is_bounded_by arr_seq sched tsk priority_inversion_bound -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> task_interference_is_bounded_by arr_seq sched tsk (fun A R : duration => priority_inversion_bound A + \sum_(tsk_o <- ts | tsk_o != tsk) task_request_bound_function tsk_o (minn `|Order.Def.max 0%R ((A + 1)%:R + task_priority_point tsk - task_priority_point tsk_o)%R| R))
END|prosa.results.rta.ideal.gel.bounded_pi.instantiated_task_interference_is_bounded
