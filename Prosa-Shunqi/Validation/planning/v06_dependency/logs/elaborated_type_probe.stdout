@ideal.fp.fully_preemptive.uniprocessor_response_time_bound_fully_preemptive_fp
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H3 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> forall FP : FP_policy Task, reflexive_task_priorities FP -> transitive_task_priorities FP -> work_conserving arr_seq sched -> respects_FP_policy_at_preemption_point arr_seq sched FP -> forall L : duration, 0 < L -> L = total_hep_request_bound_function_FP ts tsk L -> forall R : duration, (forall A : duration, fp.bounded_pi.is_in_search_space tsk L A -> exists F : duration, task_request_bound_function tsk (A + 1) + total_ohep_request_bound_function_FP ts tsk (A + F) <= A + F /\ F <= R) -> task_response_time_bound arr_seq sched tsk R
