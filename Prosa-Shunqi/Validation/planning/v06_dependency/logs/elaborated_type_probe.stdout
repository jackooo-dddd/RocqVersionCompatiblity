     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (H4 : JobPreemptable Job) (PState : ProcessorState Job), ideal_progress_proc_model PState -> unit_service_proc_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall (ts : seq Task) (tsk : Task), tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall interference_bound_function : duration -> duration -> duration, job_interference_is_bounded_by arr_seq sched tsk (fun F : duration => fun=> F - task_rtct tsk) (relative_time_to_reach_rtct sched tsk interference_bound_function)
END|prosa.analysis.abstract.ideal.abstract_rta.nonpreemptive_interference_is_bounded
BEGIN|prosa.analysis.abstract.ideal.abstract_rta.uniprocessor_response_time_bound_ideal
@uniprocessor_response_time_bound_ideal
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (H4 : JobPreemptable Job) (PState : ProcessorState Job), ideal_progress_proc_model PState -> unit_service_proc_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> arrivals_have_valid_job_costs arr_seq -> forall (ts : seq Task) (tsk : Task), tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall L : duration, busy_intervals_are_bounded_by arr_seq sched tsk L -> forall interference_bound_function : duration -> duration -> duration, job_interference_is_bounded_by arr_seq sched tsk interference_bound_function (relative_arrival_time_of_job_is_A sched) -> forall R : duration, (forall A : nat, search_space.is_in_search_space L interference_bound_function A -> exists F : nat, task_rtct tsk + interference_bound_function A (A + F) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> task_response_time_bound arr_seq sched tsk R
END|prosa.analysis.abstract.ideal.abstract_rta.uniprocessor_response_time_bound_ideal
BEGIN|prosa.analysis.abstract.ideal.abstract_seq_rta.max_in_seq_hypothesis_implies_max_in_nonseq_hypothesis
@max_in_seq_hypothesis_implies_max_in_nonseq_hypothesis
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (H3 : JobCost Job) (H4 : JobPreemptable Job) (arr_seq : arrival_sequence Job) (ts : seq Task) (tsk : Task), tsk \in ts -> valid_task_run_to_completion_threshold arr_seq tsk -> forall H5 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> forall (L : duration) (task_IBF : duration -> duration -> duration) (R : duration), (forall A : duration, search_space.is_in_search_space L (fun A0 Δ : duration => task_request_bound_function tsk (A0 + 1) - task_cost tsk + task_IBF A0 Δ) A -> exists F : duration, task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk) + task_IBF A (A + F) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> 0 < max_arrivals tsk 1 -> forall A : duration, search_space.is_in_search_space L (fun A0 Δ : duration => task_request_bound_function tsk (A0 + 1) - task_cost tsk + task_IBF A0 Δ) A -> exists F : duration, task_rtct tsk + (task_request_bound_function tsk (A + 1) - task_cost tsk + task_IBF A (A + F)) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R
END|prosa.analysis.abstract.ideal.abstract_seq_rta.max_in_seq_hypothesis_implies_max_in_nonseq_hypothesis
