BEGIN|prosa.analysis.facts.busy_interval.pi_cond.cum_task_pi_eq
@cum_task_pi_eq
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall (sched : schedule PState) (JLFP : JLFP_policy Job), reflexive_job_priorities JLFP -> transitive_job_priorities JLFP -> forall H2 : JobPreemptable Job, valid_preemption_model arr_seq sched -> forall H3 : JobReady Job PState, work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> respects_JLFP_policy_at_preemption_point arr_seq sched JLFP -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall (jlp : Job) (P : pred Job), scheduled_at sched jlp t1 -> P jlp -> cumulative_priority_inversion arr_seq sched j t1 t2 = cumulative_priority_inversion_cond arr_seq sched j P t1 t2
END|prosa.analysis.facts.busy_interval.pi_cond.cum_task_pi_eq
BEGIN|prosa.analysis.facts.busy_interval.quiet_time.zero_is_quiet_time
@zero_is_quiet_time
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JLFP_policy Job) (PState : ProcessorState Job) (sched : schedule PState) (arr_seq : arrival_sequence Job) (j : Job), quiet_time arr_seq sched j 0
END|prosa.analysis.facts.busy_interval.quiet_time.zero_is_quiet_time
BEGIN|prosa.analysis.facts.busy_interval.quiet_time.no_carry_in_implies_quiet_time
@no_carry_in_implies_quiet_time
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JLFP_policy Job) (PState : ProcessorState Job) (sched : schedule PState) (arr_seq : arrival_sequence Job) (j : Job) (t : instant), no_carry_in arr_seq sched t -> quiet_time arr_seq sched j t
END|prosa.analysis.facts.busy_interval.quiet_time.no_carry_in_implies_quiet_time
BEGIN|prosa.analysis.facts.busy_interval.quiet_time.busy_interval_prefix_no_quiet_time
@busy_interval_prefix_no_quiet_time
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JLFP_policy Job) (PState : ProcessorState Job) (sched : schedule PState) (arr_seq : arrival_sequence Job) (j : Job) (t1 t2 : instant), busy_interval_prefix arr_seq sched j t1 t2 -> forall t : nat, t1 < t < t2 -> ~ quiet_time arr_seq sched j t
END|prosa.analysis.facts.busy_interval.quiet_time.busy_interval_prefix_no_quiet_time
BEGIN|prosa.analysis.facts.busy_interval.quiet_time.busy_interval_no_quiet_time
@busy_interval_no_quiet_time
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JLFP_policy Job) (PState : ProcessorState Job) (sched : schedule PState) (arr_seq : arrival_sequence Job) (j : Job) (t1 t2 : instant), busy_interval arr_seq sched j t1 t2 -> forall t : nat, t1 < t < t2 -> ~ quiet_time arr_seq sched j t
END|prosa.analysis.facts.busy_interval.quiet_time.busy_interval_no_quiet_time
BEGIN|prosa.analysis.facts.busy_interval.service_inversion.blackout_implies_no_service_inversion
@blackout_implies_no_service_inversion
     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLDP : JLDP_policy Job) (j : Job) (t : instant), is_blackout sched t -> ~~ service_inversion arr_seq sched j t
END|prosa.analysis.facts.busy_interval.service_inversion.blackout_implies_no_service_inversion
BEGIN|prosa.analysis.facts.busy_interval.service_inversion.idle_implies_no_service_inversion
@idle_implies_no_service_inversion
     : forall (Job : JobType) (H : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLDP : JLDP_policy Job) (j : Job) (t : instant), is_idle arr_seq sched t -> ~~ service_inversion arr_seq sched j t
END|prosa.analysis.facts.busy_interval.service_inversion.idle_implies_no_service_inversion
BEGIN|prosa.analysis.facts.busy_interval.service_inversion.receives_service_implies_no_service_inversion
@receives_service_implies_no_service_inversion
     : forall (Job : JobType) (PState : ProcessorState Job), uniprocessor_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLDP : JLDP_policy Job), reflexive_priorities JLDP -> forall (j : Job) (t : instant), receives_service_at sched j t -> ~~ service_inversion arr_seq sched j t
END|prosa.analysis.facts.busy_interval.service_inversion.receives_service_implies_no_service_inversion
BEGIN|prosa.analysis.facts.busy_interval.service_inversion.service_inversion_cat
@service_inversion_cat
     : forall (Job : JobType) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (JLDP : JLDP_policy Job) (j : Job) (t1 t2 t : instant), t1 <= t -> t <= t2 -> cumulative_service_inversion arr_seq sched j t1 t2 = cumulative_service_inversion arr_seq sched j t1 t + cumulative_service_inversion arr_seq sched j t t2
END|prosa.analysis.facts.busy_interval.service_inversion.service_inversion_cat
BEGIN|prosa.analysis.facts.busy_interval.service_inversion.service_inversion_widen
