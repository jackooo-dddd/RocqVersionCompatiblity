BEGIN|prosa.analysis.abstract.search_space.representative_exists
representative_exists
     : forall (B : duration) (interference_bound_function : duration -> duration -> duration) (A : duration), A < B -> exists A_sp : nat, A_sp <= A /\ are_equivalent_at_values_less_than (interference_bound_function A) (interference_bound_function A_sp) B /\ search_space.is_in_search_space B interference_bound_function A_sp
END|prosa.analysis.abstract.search_space.representative_exists
BEGIN|prosa.analysis.abstract.search_space.solution_for_A_exists
solution_for_A_exists
     : forall (B : duration) (interference_bound_function : duration -> duration -> duration) (A_sp F_sp : duration), A_sp + F_sp < B -> interference_bound_function A_sp (A_sp + F_sp) <= A_sp + F_sp -> forall A : duration, A_sp <= A <= A_sp + F_sp -> are_equivalent_at_values_less_than (interference_bound_function A) (interference_bound_function A_sp) B -> exists F : nat, A_sp + F_sp = A + F /\ F <= F_sp /\ interference_bound_function A (A + F) <= A + F
END|prosa.analysis.abstract.search_space.solution_for_A_exists
BEGIN|prosa.analysis.abstract.search_space.search_space_switch_IBF
search_space_switch_IBF
     : forall (B : duration) (IBF1 IBF2 : nat -> duration -> duration), (forall (A : nat) (Δ : duration), A < B -> IBF1 A Δ = IBF2 A Δ) -> forall A : nat, search_space.is_in_search_space B IBF1 A -> search_space.is_in_search_space B IBF2 A
END|prosa.analysis.abstract.search_space.search_space_switch_IBF
