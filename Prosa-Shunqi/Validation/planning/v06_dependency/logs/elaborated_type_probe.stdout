BEGIN|prosa.results.rta.ideal.gel.bounded_pi.is_in_search_space
@bounded_pi.is_in_search_space
     : forall Task : TaskType, TaskCost Task -> MaxArrivals Task -> PriorityPoint Task -> seq Task -> Task -> (duration -> duration) -> duration -> duration -> bool
END|prosa.results.rta.ideal.gel.bounded_pi.is_in_search_space
BEGIN|prosa.results.rta.ideal.gel.bounded_pi.A_is_in_concrete_search_space
@bounded_pi.A_is_in_concrete_search_space
     : forall (Task : TaskType) (H : TaskCost Task) (H2 : MaxArrivals Task) (H5 : PriorityPoint Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall (priority_inversion_bound : duration -> duration) (L : duration), 0 < L -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : duration, search_space.is_in_search_space L (fun A0 Δ : duration => task_request_bound_function tsk (A0 + 1) - task_cost tsk + (priority_inversion_bound A0 + \sum_(tsk_o <- ts | tsk_o != tsk) task_request_bound_function tsk_o (minn `|Order.Def.max 0%R ((A0 + 1)%:R + task_priority_point tsk - task_priority_point tsk_o)%R| Δ))) A -> bounded_pi.is_in_search_space ts tsk priority_inversion_bound L A
END|prosa.results.rta.ideal.gel.bounded_pi.A_is_in_concrete_search_space
BEGIN|prosa.results.rta.ideal.gel.bounded_pi.correct_search_space
@bounded_pi.correct_search_space
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (H2 : MaxArrivals Task) (H5 : PriorityPoint Task) (ts : seq Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall (priority_inversion_bound : duration -> duration) (L : duration), 0 < L -> forall R : duration, (forall A : duration, bounded_pi.is_in_search_space ts tsk priority_inversion_bound L A -> exists F : duration, priority_inversion_bound A + (task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk)) + \sum_(tsk_o <- ts | tsk_o != tsk) task_request_bound_function tsk_o (minn `|Order.Def.max 0%R ((A + 1)%:R + task_priority_point tsk - task_priority_point tsk_o)%R| (A + F)) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : nat, search_space.is_in_search_space L (fun A0 Δ : duration => task_request_bound_function tsk (A0 + 1) - task_cost tsk + (priority_inversion_bound A0 + \sum_(tsk_o <- ts | tsk_o != tsk) task_request_bound_function tsk_o (minn `|Order.Def.max 0%R ((A0 + 1)%:R + task_priority_point tsk - task_priority_point tsk_o)%R| Δ))) A -> exists F : nat, task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk) + (priority_inversion_bound A + \sum_(tsk_o <- ts | tsk_o != tsk) task_request_bound_function tsk_o (minn `|Order.Def.max 0%R ((A + 1)%:R + task_priority_point tsk - task_priority_point tsk_o)%R| (A + F))) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R
END|prosa.results.rta.ideal.gel.bounded_pi.correct_search_space
BEGIN|prosa.results.rta.ideal.gel.bounded_pi.uniprocessor_response_time_bound_edf
@bounded_pi.uniprocessor_response_time_bound_edf
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (H2 : MaxArrivals Task) (Job : JobType) (H3 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (H4 : JobPreemptable Job) (H5 : PriorityPoint Task) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> respects_JLFP_policy_at_preemption_point arr_seq sched (GEL Job Task) -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall priority_inversion_bound : duration -> duration, priority_inversion_is_bounded_by arr_seq sched tsk priority_inversion_bound -> work_conserving arr_seq sched -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> forall R : duration, (forall A : duration, bounded_pi.is_in_search_space ts tsk priority_inversion_bound L A -> exists F : duration, priority_inversion_bound A + (task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk)) + \sum_(tsk_o <- ts | tsk_o != tsk) task_request_bound_function tsk_o (minn `|Order.Def.max 0%R ((A + 1)%:R + task_priority_point tsk - task_priority_point tsk_o)%R| (A + F)) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> task_response_time_bound arr_seq sched tsk R
END|prosa.results.rta.ideal.gel.bounded_pi.uniprocessor_response_time_bound_edf
