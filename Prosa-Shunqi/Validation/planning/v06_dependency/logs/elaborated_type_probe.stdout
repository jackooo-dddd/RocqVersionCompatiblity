BEGIN|prosa.results.rta.ideal.fp.bounded_nps.priority_inversion_is_bounded
@bounded_nps.priority_inversion_is_bounded
     : forall (Task : TaskType) (H1 : TaskMaxNonpreemptiveSegment Task) (Job : JobType) (H2 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (FP : FP_policy Task), transitive_task_priorities FP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule (ideal.processor_state Job)) (H3 : JobReady Job (ideal.processor_state Job)), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall H4 : JobPreemptable Job, valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> respects_FP_policy_at_preemption_point arr_seq sched FP -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> forall tsk : Task, valid_preemption_model arr_seq sched -> priority_inversion_is_bounded_by arr_seq sched tsk (constant (blocking_bound ts tsk))
