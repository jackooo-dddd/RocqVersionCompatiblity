BEGIN|prosa.analysis.facts.model.overheads.blackout_bound.blackout_during_split
@blackout_during_split
     : forall (Job : JobType) (sched : schedule (overheads.processor_state Job)) (t1 t2 : instant), blackout_during sched t1 t2 = total_time_in_dispatch sched t1 t2 + total_time_in_context_switch sched t1 t2 + total_time_in_CRPD sched t1 t2
END|prosa.analysis.facts.model.overheads.blackout_bound.blackout_during_split
BEGIN|prosa.analysis.facts.model.overheads.blackout_bound.total_dispatch_time_eq_job_dispatch_time
