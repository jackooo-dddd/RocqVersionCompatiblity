@uniprocessor_response_time_bound_fp_with_bounded_nonpreemptive_segments
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (H1 : TaskMaxNonpreemptiveSegment Task) (Job : JobType) (H2 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (FP : FP_policy Task), reflexive_task_priorities FP -> transitive_task_priorities FP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule (ideal.processor_state Job)) (H3 : JobReady Job (ideal.processor_state Job)), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall H4 : JobPreemptable Job, valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> work_conserving arr_seq sched -> respects_FP_policy_at_preemption_point arr_seq sched FP -> sequential_tasks arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H5 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall L : duration, 0 < L -> L = blocking_bound ts tsk + total_hep_request_bound_function_FP ts tsk L -> forall R : duration, (forall A : duration, fp.bounded_pi.is_in_search_space tsk L A -> exists F : duration, blocking_bound ts tsk + (task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk)) + total_ohep_request_bound_function_FP ts tsk (A + F) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> task_response_time_bound arr_seq sched tsk R
