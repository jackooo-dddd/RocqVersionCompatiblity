END|prosa.analysis.facts.shifted_job_costs.job_costs_shifted_valid
BEGIN|prosa.analysis.facts.sporadic.arrival_bound.max_sporadic_arrivals
@max_sporadic_arrivals
     : forall Task : TaskType, SporadicModel Task -> Task -> duration -> nat
END|prosa.analysis.facts.sporadic.arrival_bound.max_sporadic_arrivals
BEGIN|prosa.analysis.facts.sporadic.arrival_bound.arrival_of_nth_job
@arrival_of_nth_job
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall (dummy : Job) (t1 t2 : instant) (n i : nat) (j : Job), n = number_of_task_arrivals arr_seq tsk t1 t2 -> i < n -> j = nth dummy (task_arrivals_between arr_seq tsk t1 t2) i -> t1 + task_min_inter_arrival_time tsk * i <= job_arrival j
END|prosa.analysis.facts.sporadic.arrival_bound.arrival_of_nth_job
BEGIN|prosa.analysis.facts.sporadic.arrival_bound.minimum_distance_for_n_sporadic_arrivals
@minimum_distance_for_n_sporadic_arrivals
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall (t1 t2 : instant) (n : nat), number_of_task_arrivals arr_seq tsk t1 t2 = n -> 1 < n -> t1 + task_min_inter_arrival_time tsk * n.-1 < t2
END|prosa.analysis.facts.sporadic.arrival_bound.minimum_distance_for_n_sporadic_arrivals
BEGIN|prosa.analysis.facts.sporadic.arrival_bound.sporadic_task_arrivals_bound
@sporadic_task_arrivals_bound
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall t1 t2 : instant, number_of_task_arrivals arr_seq tsk t1 t2 <= max_sporadic_arrivals tsk (t2 - t1)
END|prosa.analysis.facts.sporadic.arrival_bound.sporadic_task_arrivals_bound
BEGIN|prosa.analysis.facts.sporadic.arrival_sequence.size_task_arrivals_at_leq_one
@size_task_arrivals_at_leq_one
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> ~ (exists j : Job, 1 < size (task_arrivals_at_job_arrival arr_seq j) /\ respects_sporadic_task_model arr_seq (job_task j) /\ valid_task_min_inter_arrival_time (job_task j))
END|prosa.analysis.facts.sporadic.arrival_sequence.size_task_arrivals_at_leq_one
BEGIN|prosa.analysis.facts.sporadic.arrival_sequence.only_j_in_task_arrivals_at_j
@only_j_in_task_arrivals_at_j
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall j1 : Job, arrives_in arr_seq j1 -> job_task j1 = tsk -> task_arrivals_at_job_arrival arr_seq j1 = [:: j1]
END|prosa.analysis.facts.sporadic.arrival_sequence.only_j_in_task_arrivals_at_j
BEGIN|prosa.analysis.facts.sporadic.arrival_sequence.only_j_at_job_arrival_j
@only_j_at_job_arrival_j
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall j1 : Job, arrives_in arr_seq j1 -> job_task j1 = tsk -> forall t : instant, job_arrival j1 = t -> task_arrivals_at arr_seq tsk t = [:: j1]
END|prosa.analysis.facts.sporadic.arrival_sequence.only_j_at_job_arrival_j
BEGIN|prosa.analysis.facts.sporadic.arrival_sequence.index_j_in_task_arrivals_at
@index_j_in_task_arrivals_at
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall j1 : Job, arrives_in arr_seq j1 -> job_task j1 = tsk -> index j1 (task_arrivals_at_job_arrival arr_seq j1) = 0
END|prosa.analysis.facts.sporadic.arrival_sequence.index_j_in_task_arrivals_at
BEGIN|prosa.analysis.facts.sporadic.arrival_sequence.prev_job_arr_lt
@prev_job_arr_lt
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall j1 : Job, arrives_in arr_seq j1 -> job_task j1 = tsk -> 0 < job_index arr_seq j1 -> job_arrival (prev_job arr_seq j1) < job_arrival j1
END|prosa.analysis.facts.sporadic.arrival_sequence.prev_job_arr_lt
BEGIN|prosa.analysis.facts.sporadic.arrival_sequence.task_arrivals_at_as_task_arrivals_between
@task_arrivals_at_as_task_arrivals_between
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job) (tsk : Task) (j1 : Job), job_task j1 = tsk -> task_arrivals_at_job_arrival arr_seq j1 = task_arrivals_between arr_seq tsk (job_arrival j1) (job_arrival j1).+1
END|prosa.analysis.facts.sporadic.arrival_sequence.task_arrivals_at_as_task_arrivals_between
BEGIN|prosa.analysis.facts.sporadic.arrival_sequence.prev_job_cat
@prev_job_cat
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall j1 : Job, arrives_in arr_seq j1 -> job_task j1 = tsk -> 0 < job_index arr_seq j1 -> task_arrivals_up_to_job_arrival arr_seq (prev_job arr_seq j1) ++ [:: j1] = task_arrivals_up_to_job_arrival arr_seq j1
END|prosa.analysis.facts.sporadic.arrival_sequence.prev_job_cat
BEGIN|prosa.analysis.facts.sporadic.arrival_times.lower_index_implies_earlier_arrival
@lower_index_implies_earlier_arrival
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = tsk -> job_task j2 = tsk -> job_index arr_seq j1 < job_index arr_seq j2 -> job_arrival j1 < job_arrival j2
END|prosa.analysis.facts.sporadic.arrival_times.lower_index_implies_earlier_arrival
BEGIN|prosa.analysis.facts.sporadic.arrival_times.same_jobs_iff_same_arr
@same_jobs_iff_same_arr
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = tsk -> job_task j2 = tsk -> j1 = j2 <-> job_arrival j1 = job_arrival j2
END|prosa.analysis.facts.sporadic.arrival_times.same_jobs_iff_same_arr
BEGIN|prosa.analysis.facts.sporadic.arrival_times.uneq_job_uneq_arr
@uneq_job_uneq_arr
     : forall (Task : TaskType) (H : SporadicModel Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall tsk : Task, respects_sporadic_task_model arr_seq tsk -> valid_task_min_inter_arrival_time tsk -> forall j1 j2 : Job, arrives_in arr_seq j1 -> arrives_in arr_seq j2 -> job_task j1 = tsk -> job_task j2 = tsk -> j1 <> j2 -> job_arrival j1 <> job_arrival j2
END|prosa.analysis.facts.sporadic.arrival_times.uneq_job_uneq_arr
BEGIN|prosa.analysis.facts.suspension.suspended_implies_job_not_ready
@suspended_implies_job_not_ready
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), suspended sched j t -> ~~ job_ready sched j t
END|prosa.analysis.facts.suspension.suspended_implies_job_not_ready
BEGIN|prosa.analysis.facts.suspension.suspended_implies_not_scheduled
@suspended_implies_not_scheduled
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (arr_seq : arrival_sequence Job) (PState : ProcessorState Job) (sched : schedule PState), valid_schedule sched arr_seq -> forall (j : Job) (t : instant), suspended sched j t -> ~~ scheduled_at sched j t
END|prosa.analysis.facts.suspension.suspended_implies_not_scheduled
BEGIN|prosa.analysis.facts.suspension.suspended_implies_arrived
@suspended_implies_arrived
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), suspended sched j t -> has_arrived j t
END|prosa.analysis.facts.suspension.suspended_implies_arrived
BEGIN|prosa.analysis.facts.suspension.suspended_implies_pending
@suspended_implies_pending
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), suspended sched j t -> pending sched j t
END|prosa.analysis.facts.suspension.suspended_implies_pending
BEGIN|prosa.analysis.facts.suspension.suspended_implies_not_backlogged
@suspended_implies_not_backlogged
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), suspended sched j t -> ~~ backlogged sched j t
END|prosa.analysis.facts.suspension.suspended_implies_not_backlogged
BEGIN|prosa.analysis.facts.suspension.pending_and_not_suspended_implies_ready
@pending_and_not_suspended_implies_ready
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), pending sched j t -> ~~ suspended sched j t -> job_ready sched j t
END|prosa.analysis.facts.suspension.pending_and_not_suspended_implies_ready
BEGIN|prosa.analysis.facts.suspension.suspension_bounded_trivial
@suspension_bounded_trivial
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant) (ρ : work) (tf : instant), t1 <= tf < t2 -> suspended sched j tf -> service sched j tf = ρ -> t2 - tf <= job_suspension j ρ -> \sum_(tf <= t < t2 | service sched j t == ρ) suspended sched j t <= job_suspension j ρ
END|prosa.analysis.facts.suspension.suspension_bounded_trivial
BEGIN|prosa.analysis.facts.suspension.suspension_bounded_longer_interval
@suspension_bounded_longer_interval
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant) (ρ : work) (tf : instant), t1 <= tf < t2 -> suspended sched j tf -> service sched j tf = ρ -> job_suspension j ρ < t2 - tf -> \sum_(tf <= t < t2 | service sched j t == ρ) suspended sched j t <= job_suspension j ρ
END|prosa.analysis.facts.suspension.suspension_bounded_longer_interval
BEGIN|prosa.analysis.facts.suspension.suspension_bounded_in_interval_aux
@suspension_bounded_in_interval_aux
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant) (ρ : work) (tf : instant), t1 <= tf < t2 -> suspended sched j tf -> service sched j tf = ρ -> (forall to : nat, t1 <= to < tf -> ~~ (suspended sched j to && (service sched j to == ρ))) -> \sum_(t1 <= t < t2 | service sched j t == ρ) suspended sched j t <= job_suspension j ρ
END|prosa.analysis.facts.suspension.suspension_bounded_in_interval_aux
BEGIN|prosa.analysis.facts.suspension.exists_some_point
@exists_some_point
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant) (ρ : work), (exists2 t : Datatypes_nat__canonical__eqtype_Equality, t \in index_iota t1 t2 & suspended sched j t && (service sched j t == ρ)) -> exists t' : nat, t1 <= t' < t2 /\ suspended sched j t' /\ service sched j t' = ρ /\ (forall to : nat, t1 <= to < t' -> ~~ (suspended sched j to && (service sched j to == ρ)))
END|prosa.analysis.facts.suspension.exists_some_point
BEGIN|prosa.analysis.facts.suspension.suspension_bounded_in_interval
@suspension_bounded_in_interval
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JobSuspension Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant) (ρ : work), \sum_(t1 <= t < t2 | service sched j t == ρ) suspended sched j t <= job_suspension j ρ
END|prosa.analysis.facts.suspension.suspension_bounded_in_interval
BEGIN|prosa.analysis.facts.tdma.TDMA_cycle_ge_each_time_slot
@TDMA_cycle_ge_each_time_slot
     : forall (Task : eqType) (ts : {setTask}) (H : TDMAPolicy Task) (task : Task), task \in ts -> task_time_slot task <= TDMA_cycle ts
END|prosa.analysis.facts.tdma.TDMA_cycle_ge_each_time_slot
BEGIN|prosa.analysis.facts.tdma.TDMA_cycle_positive
@TDMA_cycle_positive
     : forall (Task : eqType) (ts : {setTask}) (H : TDMAPolicy Task) (task : Task), task \in ts -> valid_time_slot ts -> 0 < TDMA_cycle ts
END|prosa.analysis.facts.tdma.TDMA_cycle_positive
BEGIN|prosa.analysis.facts.tdma.Offset_lt_cycle
@Offset_lt_cycle
     : forall (Task : eqType) (ts : {setTask}) (H : TDMAPolicy Task) (task : Task), task \in ts -> valid_time_slot ts -> task_slot_offset ts task < TDMA_cycle ts
END|prosa.analysis.facts.tdma.Offset_lt_cycle
BEGIN|prosa.analysis.facts.tdma.Offset_add_slot_leq_cycle
@Offset_add_slot_leq_cycle
     : forall (Task : eqType) (ts : {setTask}) (H : TDMAPolicy Task) (task : Task), task \in ts -> task_slot_offset ts task + task_time_slot task <= TDMA_cycle ts
END|prosa.analysis.facts.tdma.Offset_add_slot_leq_cycle
BEGIN|prosa.analysis.facts.tdma.relation_offset
@relation_offset
     : forall (Task : eqType) (ts : {setTask}) (H : TDMAPolicy Task), antisymmetric_slot_order ts -> transitive_slot_order -> forall tsk1 tsk2 : Task, tsk1 \in ts -> tsk2 \in ts -> slot_order tsk1 tsk2 -> tsk1 != tsk2 -> task_slot_offset ts tsk1 + task_time_slot tsk1 <= task_slot_offset ts tsk2
END|prosa.analysis.facts.tdma.relation_offset
BEGIN|prosa.analysis.facts.tdma.task_in_time_slot_uniq
@task_in_time_slot_uniq
     : forall (Task : eqType) (ts : {setTask}) (H : TDMAPolicy Task) (task : Task), task \in ts -> valid_time_slot ts -> total_slot_order ts -> antisymmetric_slot_order ts -> transitive_slot_order -> forall (tsk1 tsk2 : Task) (t : instant), tsk1 \in ts -> 0 < task_time_slot tsk1 -> tsk2 \in ts -> 0 < task_time_slot tsk2 -> task_in_time_slot ts tsk1 t -> task_in_time_slot ts tsk2 t -> tsk1 = tsk2
END|prosa.analysis.facts.tdma.task_in_time_slot_uniq
BEGIN|prosa.analysis.facts.transform.edf_opt.t1_relevant
@t1_relevant
     : forall (Job : JobType) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> forall (j1 : Job) (t1 : instant), scheduled_at sched j1 t1 -> edf_trans.relevant_pstate t1 (sched t1)
END|prosa.analysis.facts.transform.edf_opt.t1_relevant
BEGIN|prosa.analysis.facts.transform.edf_opt.fsc_search_successful
@fsc_search_successful
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> forall (j1 : Job) (t1 : instant), scheduled_at sched j1 t1 -> t1 < job_deadline j1 -> exists t : nat, search_arg sched (edf_trans.relevant_pstate t1) earlier_deadline t1 (job_deadline j1) = Some t
END|prosa.analysis.facts.transform.edf_opt.fsc_search_successful
BEGIN|prosa.analysis.facts.transform.edf_opt.fsc_search_result
@fsc_search_result
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> forall (j1 : Job) (t1 : instant), scheduled_at sched j1 t1 -> t1 < job_deadline j1 -> search_arg sched (edf_trans.relevant_pstate t1) earlier_deadline t1 (job_deadline j1) = Some (edf_trans.find_swap_candidate sched t1 j1)
END|prosa.analysis.facts.transform.edf_opt.fsc_search_result
BEGIN|prosa.analysis.facts.transform.edf_opt.fsc_not_idle
@fsc_not_idle
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> forall (j1 : Job) (t1 : instant), scheduled_at sched j1 t1 -> t1 < job_deadline j1 -> exists j' : Job, scheduled_at sched j' (edf_trans.find_swap_candidate sched t1 j1) /\ job_arrival j' <= t1
END|prosa.analysis.facts.transform.edf_opt.fsc_not_idle
BEGIN|prosa.analysis.facts.transform.edf_opt.fsc_found_job_arrival
@fsc_found_job_arrival
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> forall (j1 : Job) (t1 : instant), scheduled_at sched j1 t1 -> t1 < job_deadline j1 -> forall j2 : Job, scheduled_at sched j2 (edf_trans.find_swap_candidate sched t1 j1) -> job_arrival j2 <= t1
END|prosa.analysis.facts.transform.edf_opt.fsc_found_job_arrival
BEGIN|prosa.analysis.facts.transform.edf_opt.fsc_range
@fsc_range
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> forall (j1 : Job) (t1 : instant), scheduled_at sched j1 t1 -> t1 < job_deadline j1 -> t1 <= edf_trans.find_swap_candidate sched t1 j1 < job_deadline j1
END|prosa.analysis.facts.transform.edf_opt.fsc_range
BEGIN|prosa.analysis.facts.transform.edf_opt.fsc_range1
@fsc_range1
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> forall (j1 : Job) (t1 : instant), scheduled_at sched j1 t1 -> t1 < job_deadline j1 -> t1 <= edf_trans.find_swap_candidate sched t1 j1
END|prosa.analysis.facts.transform.edf_opt.fsc_range1
BEGIN|prosa.analysis.facts.transform.edf_opt.fsc_found_job_deadline
@fsc_found_job_deadline
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> forall (j1 : Job) (t1 : instant), scheduled_at sched j1 t1 -> t1 < job_deadline j1 -> forall j2 : Job, scheduled_at sched j2 (edf_trans.find_swap_candidate sched t1 j1) -> forall (j : Job) (t : nat), t1 <= t < job_deadline j1 -> scheduled_at sched j t -> job_arrival j <= t1 -> job_deadline j2 <= job_deadline j
END|prosa.analysis.facts.transform.edf_opt.fsc_found_job_deadline
BEGIN|prosa.analysis.facts.transform.edf_opt.fsc_no_later_deadline
@fsc_no_later_deadline
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> forall (j1 : Job) (t1 : instant), scheduled_at sched j1 t1 -> t1 < job_deadline j1 -> forall j2 : Job, scheduled_at sched j2 (edf_trans.find_swap_candidate sched t1 j1) -> job_deadline j2 <= job_deadline j1
END|prosa.analysis.facts.transform.edf_opt.fsc_no_later_deadline
BEGIN|prosa.analysis.facts.transform.edf_opt.scheduled_job_in_sched_has_later_deadline
@scheduled_job_in_sched_has_later_deadline
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (sched : schedule (ideal.processor_state Job)), completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall (j : Job) (t : instant), scheduled_at sched j t -> t < job_deadline j
END|prosa.analysis.facts.transform.edf_opt.scheduled_job_in_sched_has_later_deadline
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_completed_jobs
@mea_completed_jobs
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall t_edf : instant, completed_jobs_dont_execute (make_edf_at sched t_edf)
END|prosa.analysis.facts.transform.edf_opt.mea_completed_jobs
