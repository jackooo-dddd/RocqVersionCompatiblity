@priority_inversion_is_bounded_by_blocking
     : forall (Task : TaskType) (H1 : TaskMaxNonpreemptiveSegment Task) (Job : JobType) (H2 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (FP : FP_policy Task) (arr_seq : arrival_sequence Job) (sched : schedule (ideal.processor_state Job)) (H4 : JobPreemptable Job), valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> forall (tsk : Task) (j : Job) (t1 t2 : instant), arrives_in arr_seq j -> job_of_task tsk j -> busy_interval_prefix arr_seq sched j t1 t2 -> max_lp_nonpreemptive_segment arr_seq j t1 <= blocking_bound ts tsk
