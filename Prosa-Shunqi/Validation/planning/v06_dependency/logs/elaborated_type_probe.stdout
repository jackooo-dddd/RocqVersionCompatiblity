BEGIN|prosa.analysis.facts.model.dbf.total_demand_within_le_total_dbf
@total_demand_within_le_total_dbf
     : forall (Task : TaskType) (H : TaskDeadline Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (H2 : TaskCost Task) (H3 : JobCost Job), arrivals_have_valid_job_costs arr_seq -> forall (ts : seq Task) (H4 : MaxArrivals Task), taskset_respects_max_arrivals arr_seq ts -> all_jobs_from_taskset arr_seq ts -> forall (t : instant) (delta : duration), total_demand_within arr_seq t (t + delta) <= total_demand_bound_function ts delta
