     : forall (Job : JobType) (sched : schedule (overheads.processor_state Job)) (j : Job) (t : instant), scheduled_at sched j t <-> scheduled_job sched t = Some j
END|prosa.analysis.facts.model.overheads.schedule.scheduled_at_iff_scheduled_job
BEGIN|prosa.analysis.facts.model.overheads.schedule.job_scheduled_in_busy_interval_prefix
@job_scheduled_in_busy_interval_prefix
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (JLFP : JLFP_policy Job), reflexive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule (overheads.processor_state Job)) (JobReady0 : JobReady Job (overheads.processor_state Job)), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> work_conserving arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall t : nat, t1 <= t < t2 -> exists jo : Job, scheduled_at sched jo t
END|prosa.analysis.facts.model.overheads.schedule.job_scheduled_in_busy_interval_prefix
BEGIN|prosa.analysis.facts.model.overheads.schedule_change.number_schedule_changes_cat
@number_schedule_changes_cat
     : forall (Job : JobType) (sched : schedule (overheads.processor_state Job)) (t t1 t2 : instant), t1 <= t <= t2 -> number_schedule_changes sched t1 t2 = number_schedule_changes sched t1 t + number_schedule_changes sched t t2
END|prosa.analysis.facts.model.overheads.schedule_change.number_schedule_changes_cat
BEGIN|prosa.analysis.facts.model.overheads.schedule_change.first_schedule_change_exists
@first_schedule_change_exists
     : forall (Job : JobType) (sched : schedule (overheads.processor_state Job)) (t1 t2 : instant) (k : nat), 0 < k -> number_schedule_changes sched t1 t2 = k -> exists t : nat, t1 <= t < t2 /\ schedule_change sched t /\ number_schedule_changes sched t1 t = 0 /\ number_schedule_changes sched t t2 = k
END|prosa.analysis.facts.model.overheads.schedule_change.first_schedule_change_exists
BEGIN|prosa.analysis.facts.model.overheads.schedule_change.number_schedule_changes_widen
@number_schedule_changes_widen
     : forall (Job : JobType) (sched : schedule (overheads.processor_state Job)) (t1 t2 t1' t2' : instant), t1 <= t1' -> t2' <= t2 -> number_schedule_changes sched t1' t2' <= number_schedule_changes sched t1 t2
END|prosa.analysis.facts.model.overheads.schedule_change.number_schedule_changes_widen
BEGIN|prosa.analysis.facts.model.overheads.schedule_change.same_scheduled_state_merge
@same_scheduled_state_merge
     : forall (Job : JobType) (sched : schedule (overheads.processor_state Job)) (t1 t2 t : instant) (oj1 oj2 : option Job), t1 < t < t2 -> ~~ schedule_change sched t -> scheduled_job_invariant sched oj1 t1 t -> scheduled_job_invariant sched oj2 t t2 -> oj1 = oj2
END|prosa.analysis.facts.model.overheads.schedule_change.same_scheduled_state_merge
BEGIN|prosa.analysis.facts.model.overheads.schedule_change.no_schedule_changes_implies_constant_schedule
