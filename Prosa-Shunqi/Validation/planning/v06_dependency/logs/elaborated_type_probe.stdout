     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobCost Job) (H2 : JobPreemptable Job) (arr_seq : arrival_sequence Job), arrivals_have_valid_job_costs arr_seq -> forall tsk : Task, valid_task_run_to_completion_threshold arr_seq tsk
END|prosa.analysis.facts.preemption.rtc_threshold.floating.floating_preemptive_valid_task_run_to_completion_threshold
BEGIN|prosa.analysis.facts.preemption.rtc_threshold.job_preemptable.preemption_points_of_zero_cost_job
@preemption_points_of_zero_cost_job
     : forall (Job : JobType) (H0 : JobCost Job) (H1 : JobPreemptable Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState), valid_preemption_model arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_cost j = 0 -> job_preemption_points j = [:: 0]
END|prosa.analysis.facts.preemption.rtc_threshold.job_preemptable.preemption_points_of_zero_cost_job
