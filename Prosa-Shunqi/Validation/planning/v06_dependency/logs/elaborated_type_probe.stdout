     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskPreemptionPoints Task) (Job : JobType) (H1 : JobTask Job Task) (H3 : JobCost Job) (H4 : JobPreemptionPoints Job) (arr_seq : arrival_sequence Job) (ts : seq Task), valid_fixed_preemption_points_model arr_seq ts -> forall tsk : Task, tsk \in ts -> task_cost tsk - task_rtct tsk = task_last_nonpr_segment tsk - 1
