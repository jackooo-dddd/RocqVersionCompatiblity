BEGIN|prosa.analysis.abstract.iw_auxiliary.fold_cumul_interference
@fold_cumul_interference
     : forall (Job : JobType) (H3 : Interference Job) (j : Job) (t1 t2 : nat), cumul_cond_interference (fun=> xpredT) j t1 t2 = cumulative_interference j t1 t2
END|prosa.analysis.abstract.iw_auxiliary.fold_cumul_interference
BEGIN|prosa.analysis.abstract.iw_auxiliary.cumul_cond_interference_alt
@cumul_cond_interference_alt
     : forall (Job : JobType) (H3 : Interference Job) (P : Job -> instant -> bool) (j : Job) (t1 t2 : nat), cumul_cond_interference P j t1 t2 = \sum_(t1 <= t < t2 | P j t) interference j t
END|prosa.analysis.abstract.iw_auxiliary.cumul_cond_interference_alt
BEGIN|prosa.analysis.abstract.iw_auxiliary.cumulative_interference_sub
@cumulative_interference_sub
     : forall (Job : JobType) (H3 : Interference Job) (P : Job -> instant -> bool) (j : Job) (al ar bl br : instant), bl <= al -> ar <= br -> cumul_cond_interference P j al ar <= cumul_cond_interference P j bl br
END|prosa.analysis.abstract.iw_auxiliary.cumulative_interference_sub
BEGIN|prosa.analysis.abstract.iw_auxiliary.cumulative_interference_cat
@cumulative_interference_cat
     : forall (Job : JobType) (H3 : Interference Job) (P : Job -> instant -> bool) (j : Job) (t t1 t2 : nat), t1 <= t <= t2 -> cumul_cond_interference P j t1 t2 = cumul_cond_interference P j t1 t + cumul_cond_interference P j t t2
END|prosa.analysis.abstract.iw_auxiliary.cumulative_interference_cat
BEGIN|prosa.analysis.abstract.iw_auxiliary.cumul_cond_interference_ID
@cumul_cond_interference_ID
     : forall (Job : JobType) (H3 : Interference Job) (P1 P2 : Job -> instant -> bool) (j : Job) (t1 t2 : nat), cumul_cond_interference P1 j t1 t2 = cumul_cond_interference (fun (j0 : Job) (t : instant) => P1 j0 t && P2 j0 t) j t1 t2 + cumul_cond_interference (fun (j0 : Job) (t : instant) => P1 j0 t && ~~ P2 j0 t) j t1 t2
END|prosa.analysis.abstract.iw_auxiliary.cumul_cond_interference_ID
BEGIN|prosa.analysis.abstract.iw_auxiliary.cumul_cond_interference_pred_eq
@cumul_cond_interference_pred_eq
     : forall (Job : JobType) (H3 : Interference Job) (P1 P2 : Job -> instant -> bool) (j : Job) (t1 t2 : instant), (forall (j0 : Job) (t : instant), P1 j0 t <-> P2 j0 t) -> cumul_cond_interference P1 j t1 t2 = cumul_cond_interference P2 j t1 t2
END|prosa.analysis.abstract.iw_auxiliary.cumul_cond_interference_pred_eq
BEGIN|prosa.analysis.abstract.lower_bound_on_service.interference_is_complement_to_schedule
@interference_is_complement_to_schedule
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (tsk : Task) (H4 : Interference Job) (H5 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, definitions.busy_interval_prefix sched j t1 t2 -> forall (t : instant) (δ : duration), t1 <= t -> t + δ <= t2 -> δ <= service_during sched j t (t + δ) + cumulative_interference j t (t + δ)
END|prosa.analysis.abstract.lower_bound_on_service.interference_is_complement_to_schedule
BEGIN|prosa.analysis.abstract.lower_bound_on_service.service_and_interference_bounded
@service_and_interference_bounded
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (tsk : Task) (H4 : Interference Job) (H5 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, definitions.busy_interval_prefix sched j t1 t2 -> forall (t : instant) (δ : duration), t1 <= t -> t + δ <= t2 -> unit_service_proc_model PState -> service_during sched j t (t + δ) + cumulative_interference j t (t + δ) <= δ
END|prosa.analysis.abstract.lower_bound_on_service.service_and_interference_bounded
BEGIN|prosa.analysis.abstract.lower_bound_on_service.j_receives_enough_service
@j_receives_enough_service
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (tsk : Task) (H4 : Interference Job) (H5 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, definitions.busy_interval sched j t1 t2 -> forall progress_of_job : duration, progress_of_job <= job_cost j -> forall δ : duration, progress_of_job + cumulative_interference j t1 (t1 + δ) <= δ -> progress_of_job <= service sched j (t1 + δ)
END|prosa.analysis.abstract.lower_bound_on_service.j_receives_enough_service
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_rta.blackout_impl_interference
@blackout_impl_interference
     : forall (Task : TaskType) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (ts : seq Task) (tsk : Task), tsk \in ts -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, definitions.busy_interval_prefix sched j t1 t2 -> forall Δ : duration, t1 + Δ < t2 -> ~~ completed_by sched j (t1 + Δ) -> forall t : nat, t1 <= t < t2 -> is_blackout sched t -> interference j t
END|prosa.analysis.abstract.restricted_supply.abstract_rta.blackout_impl_interference
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_rta.blackout_plus_local_is_interference
@blackout_plus_local_is_interference
     : forall (Task : TaskType) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (ts : seq Task) (tsk : Task), tsk \in ts -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, definitions.busy_interval_prefix sched j t1 t2 -> forall Δ : duration, t1 + Δ < t2 -> ~~ completed_by sched j (t1 + Δ) -> forall t : nat, t1 <= t < t2 -> is_blackout sched t + intra_interference sched j t = interference j t
END|prosa.analysis.abstract.restricted_supply.abstract_rta.blackout_plus_local_is_interference
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_rta.blackout_plus_local_is_interference_cumul
@blackout_plus_local_is_interference_cumul
     : forall (Task : TaskType) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (ts : seq Task) (tsk : Task), tsk \in ts -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, definitions.busy_interval_prefix sched j t1 t2 -> forall Δ : duration, t1 + Δ < t2 -> ~~ completed_by sched j (t1 + Δ) -> blackout_during sched t1 (t1 + Δ) + cumul_intra_interference sched j t1 (t1 + Δ) = cumulative_interference j t1 (t1 + Δ)
END|prosa.analysis.abstract.restricted_supply.abstract_rta.blackout_plus_local_is_interference_cumul
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_rta.cumulative_job_interference_bound
@abstract_rta.cumulative_job_interference_bound
     : forall (Task : TaskType) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState) (ts : seq Task) (tsk : Task), tsk \in ts -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall SBF : SupplyBoundFunction, busy_sbf.valid_busy_sbf arr_seq sched tsk SBF -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, definitions.busy_interval_prefix sched j t1 t2 -> forall Δ : duration, t1 + Δ < t2 -> ~~ completed_by sched j (t1 + Δ) -> cumulative_interference j t1 (t1 + Δ) <= Δ - SBF Δ + cumul_intra_interference sched j t1 (t1 + Δ)
END|prosa.analysis.abstract.restricted_supply.abstract_rta.cumulative_job_interference_bound
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_rta.no_intra_interference_after_F
@no_intra_interference_after_F
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (H4 : JobPreemptable Job) (PState : ProcessorState Job), fully_consuming_proc_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState) (ts : seq Task) (tsk : Task), tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, definitions.busy_interval_prefix sched j t1 t2 -> forall Δ : duration, t1 + Δ < t2 -> ~~ completed_by sched j (t1 + Δ) -> forall F : duration, F <= Δ -> task_rtct tsk <= service sched j (t1 + F) -> cumul_intra_interference sched j (t1 + F) (t1 + Δ) = 0
END|prosa.analysis.abstract.restricted_supply.abstract_rta.no_intra_interference_after_F
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_rta.IBF_P_bounds_interference
@IBF_P_bounds_interference
     : forall (Task : TaskType) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job), unit_supply_proc_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState) (ts : seq Task) (tsk : Task), tsk \in ts -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall SBF : SupplyBoundFunction, busy_sbf.valid_busy_sbf arr_seq sched tsk SBF -> forall intra_IBF : duration -> duration -> duration, intra_interference_is_bounded_by arr_seq sched tsk intra_IBF -> job_interference_is_bounded_by arr_seq sched tsk (fun A Δ : duration => Δ - SBF Δ + intra_IBF A Δ) (relative_arrival_time_of_job_is_A sched)
END|prosa.analysis.abstract.restricted_supply.abstract_rta.IBF_P_bounds_interference
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_rta.IBF_NP_bounds_interference
@IBF_NP_bounds_interference
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (H4 : JobPreemptable Job) (PState : ProcessorState Job), unit_supply_proc_model PState -> fully_consuming_proc_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall (ts : seq Task) (tsk : Task), tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall SBF : SupplyBoundFunction, busy_sbf.valid_busy_sbf arr_seq sched tsk SBF -> unit_supply_bound_function SBF -> forall intra_IBF : duration -> duration -> duration, intra_interference_is_bounded_by arr_seq sched tsk intra_IBF -> job_interference_is_bounded_by arr_seq sched tsk (fun F Δ : duration => F - task_rtct tsk + (Δ - SBF Δ - (F - SBF F))) (relative_time_to_reach_rtct sched tsk (fun A Δ : duration => Δ - SBF Δ + intra_IBF A Δ))
END|prosa.analysis.abstract.restricted_supply.abstract_rta.IBF_NP_bounds_interference
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_rta.IBF_P_sol_le_IBF_NP
@IBF_P_sol_le_IBF_NP
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (H3 : JobCost Job) (H4 : JobPreemptable Job) (arr_seq : arrival_sequence Job) (ts : seq Task) (tsk : Task), tsk \in ts -> valid_task_run_to_completion_threshold arr_seq tsk -> forall (SBF : SupplyBoundFunction) (F Δ : duration), F <= task_cost tsk + (F - task_rtct tsk + (Δ - SBF Δ - (F - SBF F)))
END|prosa.analysis.abstract.restricted_supply.abstract_rta.IBF_P_sol_le_IBF_NP
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_rta.max_in_rs_hypothesis_impl_max_in_arta_hypothesis
@max_in_rs_hypothesis_impl_max_in_arta_hypothesis
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (H4 : JobPreemptable Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job) (sched : schedule PState) (ts : seq Task) (tsk : Task), tsk \in ts -> valid_task_run_to_completion_threshold arr_seq tsk -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job) (L : duration) (SBF : SupplyBoundFunction), busy_sbf.valid_busy_sbf arr_seq sched tsk SBF -> unit_supply_bound_function SBF -> forall (intra_IBF : duration -> duration -> duration) (R : duration), (forall A : duration, search_space.is_in_search_space L (fun A0 Δ : duration => Δ - SBF Δ + intra_IBF A0 Δ) A -> exists F : duration, F <= A + R /\ task_rtct tsk + intra_IBF A F <= SBF F /\ SBF F + (task_cost tsk - task_rtct tsk) <= SBF (A + R)) -> forall A : duration, search_space.is_in_search_space L (fun A0 Δ : duration => Δ - SBF Δ + intra_IBF A0 Δ) A -> exists F : duration, task_rtct tsk + (F - SBF F + intra_IBF A F) <= F /\ task_cost tsk + (F - task_rtct tsk + (A + R - SBF (A + R) - (F - SBF F))) <= A + R
END|prosa.analysis.abstract.restricted_supply.abstract_rta.max_in_rs_hypothesis_impl_max_in_arta_hypothesis
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_rta.uniprocessor_response_time_bound_restricted_supply
@uniprocessor_response_time_bound_restricted_supply
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (H4 : JobPreemptable Job) (PState : ProcessorState Job), unit_supply_proc_model PState -> fully_consuming_proc_model PState -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> arrivals_have_valid_job_costs arr_seq -> forall (ts : seq Task) (tsk : Task), tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> forall L : duration, busy_intervals_are_bounded_by arr_seq sched tsk L -> forall SBF : SupplyBoundFunction, busy_sbf.valid_busy_sbf arr_seq sched tsk SBF -> unit_supply_bound_function SBF -> forall intra_IBF : duration -> duration -> duration, intra_interference_is_bounded_by arr_seq sched tsk intra_IBF -> forall R : duration, (forall A : duration, search_space.is_in_search_space L (fun A0 Δ : duration => Δ - SBF Δ + intra_IBF A0 Δ) A -> exists F : duration, F <= A + R /\ task_rtct tsk + intra_IBF A F <= SBF F /\ SBF F + (task_cost tsk - task_rtct tsk) <= SBF (A + R)) -> task_response_time_bound arr_seq sched tsk R
END|prosa.analysis.abstract.restricted_supply.abstract_rta.uniprocessor_response_time_bound_restricted_supply
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_seq_rta.IBF_P_bounds_interference
@abstract_seq_rta.IBF_P_bounds_interference
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (jc : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> arrivals_have_valid_job_costs arr_seq -> forall (ts : seq Task) (tsk : Task), tsk \in ts -> forall H4 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> sequential_tasks arr_seq sched -> interference_and_workload_consistent_with_sequential_tasks arr_seq sched tsk -> forall task_intra_IBF : duration -> duration -> duration, task_intra_interference_is_bounded_by arr_seq sched tsk task_intra_IBF -> intra_interference_is_bounded_by arr_seq sched tsk (fun A Δ : duration => task_request_bound_function tsk (A + 1) - task_cost tsk + task_intra_IBF A Δ)
END|prosa.analysis.abstract.restricted_supply.abstract_seq_rta.IBF_P_bounds_interference
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_seq_rta.sol_seq_rs_equation_impl_sol_rs_equation
@sol_seq_rs_equation_impl_sol_rs_equation
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (jc : JobCost Job) (H3 : JobPreemptable Job) (arr_seq : arrival_sequence Job) (ts : seq Task) (tsk : Task), tsk \in ts -> valid_task_run_to_completion_threshold arr_seq tsk -> forall H4 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> forall (L : duration) (SBF : SupplyBoundFunction) (task_intra_IBF : duration -> duration -> duration) (R : duration), (forall A : duration, search_space.is_in_search_space L (fun A0 Δ : duration => task_request_bound_function tsk (A0 + 1) - task_cost tsk + task_intra_IBF A0 Δ) A -> exists F : duration, F <= A + R /\ task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk) + task_intra_IBF A F <= SBF F /\ SBF F + (task_cost tsk - task_rtct tsk) <= SBF (A + R)) -> 0 < max_arrivals tsk 1 -> forall A : duration, search_space.is_in_search_space L (fun (A0 : duration) (Δ : nat) => Δ - SBF Δ + (task_request_bound_function tsk (A0 + 1) - task_cost tsk + task_intra_IBF A0 Δ)) A -> exists F : duration, F <= A + R /\ task_rtct tsk + (task_request_bound_function tsk (A + 1) - task_cost tsk + task_intra_IBF A F) <= SBF F /\ SBF F + (task_cost tsk - task_rtct tsk) <= SBF (A + R)
END|prosa.analysis.abstract.restricted_supply.abstract_seq_rta.sol_seq_rs_equation_impl_sol_rs_equation
BEGIN|prosa.analysis.abstract.restricted_supply.abstract_seq_rta.uniprocessor_response_time_bound_restricted_supply_seq
@uniprocessor_response_time_bound_restricted_supply_seq
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskRunToCompletionThreshold Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (jc : JobCost Job) (H3 : JobPreemptable Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> fully_consuming_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> arrivals_have_valid_job_costs arr_seq -> forall (ts : seq Task) (tsk : Task), tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall H4 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> forall (H5 : Interference Job) (H6 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> sequential_tasks arr_seq sched -> interference_and_workload_consistent_with_sequential_tasks arr_seq sched tsk -> forall L : duration, busy_intervals_are_bounded_by arr_seq sched tsk L -> forall SBF : SupplyBoundFunction, busy_sbf.valid_busy_sbf arr_seq sched tsk SBF -> unit_supply_bound_function SBF -> forall task_intra_IBF : duration -> duration -> duration, task_intra_interference_is_bounded_by arr_seq sched tsk task_intra_IBF -> forall R : duration, (forall A : duration, search_space.is_in_search_space L (fun A0 Δ : duration => task_request_bound_function tsk (A0 + 1) - task_cost tsk + task_intra_IBF A0 Δ) A -> exists F : duration, F <= A + R /\ task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk) + task_intra_IBF A F <= SBF F /\ SBF F + (task_cost tsk - task_rtct tsk) <= SBF (A + R)) -> task_response_time_bound arr_seq sched tsk R
END|prosa.analysis.abstract.restricted_supply.abstract_seq_rta.uniprocessor_response_time_bound_restricted_supply_seq
BEGIN|prosa.analysis.abstract.restricted_supply.bounded_bi.aux.busy_interval_prefix_exists
@busy_interval_prefix_exists
     : forall (Job : JobType) (H1 : JobArrival Job) (H2 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> fully_consuming_proc_model PState -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), valid_schedule sched arr_seq -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> exists t1 : nat, t1 <= job_arrival j /\ busy_interval_prefix arr_seq sched j t1 (job_arrival j).+1
