@serv_of_task_le_workload_of_task_plus
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (jc : JobCost Job) (PState : ProcessorState Job), unit_service_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, completed_jobs_dont_execute sched -> forall (tsk : Task) (H3 : Interference Job) (H4 : InterferingWorkload Job) (j : Job), arrives_in arr_seq j -> job_of_task tsk j -> forall t1 t2 : instant, definitions.busy_interval sched j t1 t2 -> forall x : duration, task_service_of_jobs_in sched tsk (arrivals_between arr_seq t1 (t1 + (job_arrival j - t1) + 1)) t1 (t1 + x) - service_during sched j t1 (t1 + x) + cumul_task_interference arr_seq sched j t1 (t1 + x) <= task_workload_between arr_seq tsk t1 (t1 + (job_arrival j - t1) + 1) - job_cost j + cumul_task_interference arr_seq sched j t1 (t1 + x)
