     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JobArrival Job) (H1 : JobCost Job) (JR : JobReady Job (ideal.processor_state Job)) (JLFP : JLFP_policy Job), reflexive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> forall (tsk : Task) (j : Job), arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : duration, definitions.busy_interval sched j t1 t2 -> forall Δ : duration, t1 + Δ <= t2 -> forall priority_inversion_bound : duration -> duration, priority_inversion_is_bounded_by arr_seq sched tsk priority_inversion_bound -> cumulative_priority_inversion arr_seq sched j t1 (t1 + Δ) <= priority_inversion_bound (job_arrival j - t1)
