BEGIN|prosa.results.rta.ideal.edf.bounded_pi.instantiated_task_interference_is_bounded
@edf.bounded_pi.instantiated_task_interference_is_bounded
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (Job : JobType) (H3 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> forall H5 : MaxArrivals Task, taskset_respects_max_arrivals arr_seq ts -> forall (tsk : Task) (priority_inversion_bound : duration -> duration), priority_inversion_is_bounded_by arr_seq sched tsk priority_inversion_bound -> task_interference_is_bounded_by arr_seq sched tsk (fun A R : duration => priority_inversion_bound A + edf_athep_bound.bound_on_athep_workload ts tsk A R)
END|prosa.results.rta.ideal.edf.bounded_pi.instantiated_task_interference_is_bounded
BEGIN|prosa.results.rta.ideal.edf.bounded_pi.A_is_in_concrete_search_space
@edf.bounded_pi.A_is_in_concrete_search_space
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (ts : seq Task) (H5 : MaxArrivals Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall (priority_inversion_bound : duration -> duration) (L : duration), 0 < L -> L = total_request_bound_function ts L -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : duration, search_space.is_in_search_space L (fun A0 Δ : duration => task_request_bound_function tsk (A0 + 1) - task_cost tsk + (priority_inversion_bound A0 + edf_athep_bound.bound_on_athep_workload ts tsk A0 Δ)) A -> edf.bounded_pi.is_in_search_space ts tsk priority_inversion_bound L A
END|prosa.results.rta.ideal.edf.bounded_pi.A_is_in_concrete_search_space
BEGIN|prosa.results.rta.ideal.edf.bounded_pi.correct_search_space
@edf.bounded_pi.correct_search_space
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (H1 : TaskRunToCompletionThreshold Task) (ts : seq Task) (H5 : MaxArrivals Task), valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall (priority_inversion_bound : duration -> duration) (L : duration), 0 < L -> L = total_request_bound_function ts L -> forall R : duration, (forall A : duration, edf.bounded_pi.is_in_search_space ts tsk priority_inversion_bound L A -> exists F : duration, priority_inversion_bound A + (task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk)) + edf_athep_bound.bound_on_athep_workload ts tsk A (A + F) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> 0 < task_cost tsk -> 0 < max_arrivals tsk 1 -> forall A : duration, search_space.is_in_search_space L (fun A0 Δ : duration => task_request_bound_function tsk (A0 + 1) - task_cost tsk + (priority_inversion_bound A0 + edf_athep_bound.bound_on_athep_workload ts tsk A0 Δ)) A -> exists F : nat, task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk) + (priority_inversion_bound A + edf_athep_bound.bound_on_athep_workload ts tsk A (A + F)) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R
END|prosa.results.rta.ideal.edf.bounded_pi.correct_search_space
BEGIN|prosa.results.rta.ideal.edf.bounded_pi.uniprocessor_response_time_bound_edf
@uniprocessor_response_time_bound_edf
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (H1 : TaskRunToCompletionThreshold Task) (Job : JobType) (H3 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (H4 : JobPreemptable Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job) -> work_conserving arr_seq sched -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> forall H5 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> valid_preemption_model arr_seq sched -> valid_task_run_to_completion_threshold arr_seq tsk -> forall priority_inversion_bound : duration -> duration, priority_inversion_is_bounded_by arr_seq sched tsk priority_inversion_bound -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> forall R : duration, (forall A : duration, edf.bounded_pi.is_in_search_space ts tsk priority_inversion_bound L A -> exists F : duration, priority_inversion_bound A + (task_request_bound_function tsk (A + 1) - (task_cost tsk - task_rtct tsk)) + edf_athep_bound.bound_on_athep_workload ts tsk A (A + F) <= A + F /\ F + (task_cost tsk - task_rtct tsk) <= R) -> task_response_time_bound arr_seq sched tsk R
END|prosa.results.rta.ideal.edf.bounded_pi.uniprocessor_response_time_bound_edf
BEGIN|prosa.results.rta.ideal.edf.floating_nonpreemptive.uniprocessor_response_time_bound_edf_with_floating_nonpreemptive_regions
@uniprocessor_response_time_bound_edf_with_floating_nonpreemptive_regions
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : TaskDeadline Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (H4 : JobPreemptionPoints Job) (H5 : TaskMaxNonpreemptiveSegment Task), valid_model_with_floating_nonpreemptive_regions arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> arrivals_have_valid_job_costs arr_seq -> forall H6 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> taskset_respects_max_arrivals arr_seq ts -> forall tsk : Task, tsk \in ts -> forall sched : schedule (ideal.processor_state Job), valid_schedule sched arr_seq -> schedule_respects_preemption_model arr_seq sched -> work_conserving arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job) -> forall L : duration, 0 < L -> L = total_request_bound_function ts L -> forall R : duration, (forall A : duration, bounded_nps.is_in_search_space ts tsk L A -> exists F : duration, edf.blocking_bound ts tsk A + task_request_bound_function tsk (A + 1) + edf_athep_bound.bound_on_athep_workload ts tsk A (A + F) <= A + F /\ F <= R) -> task_response_time_bound arr_seq sched tsk R
