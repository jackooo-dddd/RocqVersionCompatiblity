BEGIN|prosa.results.generality.elf.elf_generalizes_fixed_priority
@elf_generalizes_fixed_priority
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H1 : JobTask Job Task) (PState : ProcessorState Job) (Arrival : JobArrival Job) (Cost : JobCost Job) (H2 : JobPreemptable Job) (JR : JobReady Job PState) (fp : FP_policy Task), (forall tsk1 tsk2 : Task, tsk1 != tsk2 -> ~~ ep_task tsk1 tsk2) -> forall (arr_seq : arrival_sequence Job) (sched : schedule PState), valid_schedule sched arr_seq -> sequential_tasks arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (ELF fp) <-> respects_FP_policy_at_preemption_point arr_seq sched fp
END|prosa.results.generality.elf.elf_generalizes_fixed_priority
BEGIN|prosa.results.generality.gel.gel_generalizes_edf
@gel_generalizes_edf
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H0 : JobTask Job Task) (PState : ProcessorState Job) (Arrival : JobArrival Job) (Cost : JobCost Job) (H1 : JobPreemptable Job) (JR : JobReady Job PState) (H2 : TaskDeadline Task), (forall tsk : Task, task_priority_point tsk = task_deadline tsk) -> forall (sched : schedule PState) (arr_seq : arrival_sequence Job), respects_JLFP_policy_at_preemption_point arr_seq sched (GEL Job Task) <-> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job)
