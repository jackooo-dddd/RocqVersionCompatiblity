BEGIN|prosa.analysis.facts.busy_interval.service_inversion.cumulative_service_inversion_from_one_job
@cumulative_service_inversion_from_one_job
     : forall (Job : JobType) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> transitive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall H4 : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched JLFP -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall t : instant, t <= t2 -> 0 < cumulative_service_inversion arr_seq sched j t1 t -> exists jlp : Job, job_arrival jlp < t1 /\ ~~ hep_job jlp j /\ cumulative_service_inversion arr_seq sched j t1 t = service_during sched jlp t1 t
END|prosa.analysis.facts.busy_interval.service_inversion.cumulative_service_inversion_from_one_job
BEGIN|prosa.analysis.facts.busy_interval.service_inversion.lp_job_bounded_service
@lp_job_bounded_service
     : forall (Task : TaskType) (H0 : TaskMaxNonpreemptiveSegment Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> forall JLFP : JLFP_policy Job, transitive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall H4 : JobPreemptable Job, valid_preemption_model arr_seq sched -> valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched JLFP -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall jlp : Job, arrives_in arr_seq jlp -> ~~ hep_job jlp j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall t : nat, t <= t2 -> service_during sched jlp t1 t <= job_max_nonpreemptive_segment jlp - 1
END|prosa.analysis.facts.busy_interval.service_inversion.lp_job_bounded_service
BEGIN|prosa.analysis.facts.busy_interval.service_inversion.lp_job_bounded_service_max
@lp_job_bounded_service_max
     : forall (Task : TaskType) (H0 : TaskMaxNonpreemptiveSegment Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> forall JLFP : JLFP_policy Job, transitive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall H4 : JobPreemptable Job, valid_preemption_model arr_seq sched -> valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched JLFP -> forall j : Job, arrives_in arr_seq j -> job_cost_positive j -> forall jlp : Job, arrives_in arr_seq jlp -> ~~ hep_job jlp j -> forall t1 t2 : instant, busy_interval_prefix arr_seq sched j t1 t2 -> forall t : nat, t <= t2 -> service_during sched jlp t1 t <= max_lp_nonpreemptive_segment arr_seq j t1
END|prosa.analysis.facts.busy_interval.service_inversion.lp_job_bounded_service_max
BEGIN|prosa.analysis.facts.busy_interval.service_inversion.service_inversion_is_bounded
@service_inversion_is_bounded
     : forall (Task : TaskType) (H0 : TaskMaxNonpreemptiveSegment Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobArrival Job) (H3 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> forall JLFP : JLFP_policy Job, reflexive_job_priorities JLFP -> transitive_job_priorities JLFP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall H4 : JobPreemptable Job, valid_preemption_model arr_seq sched -> valid_model_with_bounded_nonpreemptive_segments arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched JLFP -> forall (tsk : Task) (blocking_bound : duration -> duration), (forall (j : Job) (t1 t2 : instant), arrives_in arr_seq j -> job_of_task tsk j -> busy_interval_prefix arr_seq sched j t1 t2 -> max_lp_nonpreemptive_segment arr_seq j t1 <= blocking_bound (job_arrival j - t1)) -> service_inversion_is_bounded_by arr_seq sched tsk blocking_bound
END|prosa.analysis.facts.busy_interval.service_inversion.service_inversion_is_bounded
BEGIN|prosa.analysis.facts.completes_at.scheduled_at_precedes_completes_at
@scheduled_at_precedes_completes_at
     : forall (Job : JobType) (H0 : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t : instant), 0 < t -> completes_at sched j t -> scheduled_at sched j t.-1
END|prosa.analysis.facts.completes_at.scheduled_at_precedes_completes_at
BEGIN|prosa.analysis.facts.completes_at.job_completes_at_most_once
@job_completes_at_most_once
     : forall (Job : JobType) (H0 : JobCost Job) (PState : ProcessorState Job) (sched : schedule PState) (j : Job) (t1 t2 : instant), \sum_(t1 <= t < t2) completes_at sched j t <= 1
END|prosa.analysis.facts.completes_at.job_completes_at_most_once
BEGIN|prosa.analysis.facts.completes_at.only_one_job_completes_at_a_time
@only_one_job_completes_at_a_time
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (P : pred Job) (t B : instant), 0 < t -> \sum_(j <- arrivals_before arr_seq B | P j) completes_at sched j t <= 1
END|prosa.analysis.facts.completes_at.only_one_job_completes_at_a_time
BEGIN|prosa.analysis.facts.completes_at.completetion_time_is_preemption_time
@completetion_time_is_preemption_time
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall H2 : JobPreemptable Job, valid_preemption_model arr_seq sched -> forall (j : Job) (t : instant), completes_at sched j t -> preemption_time arr_seq sched t
END|prosa.analysis.facts.completes_at.completetion_time_is_preemption_time
BEGIN|prosa.analysis.facts.completes_at.no_early_hep_job_completes_during_busy_prefix
@no_early_hep_job_completes_during_busy_prefix
     : forall (Job : JobType) (H : JobArrival Job) (H0 : JobCost Job) (H1 : JLFP_policy Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (j : Job) (t t1 t2 : instant), busy_interval_prefix arr_seq sched j t1 t2 -> t1 < t <= t2 -> forall jhp : Job, jhp \in arrivals_before arr_seq t1 -> hep_job jhp j -> ~~ completes_at sched jhp t
END|prosa.analysis.facts.completes_at.no_early_hep_job_completes_during_busy_prefix
BEGIN|prosa.analysis.facts.delay_propagation.consistent_propagated_arrival_sequence
@consistent_propagated_arrival_sequence
     : forall (Task2 : TaskType) (Job1 Job2 : JobType) (H0 : JobTask Job2 Task2) (JA1 : JobArrival Job1) (JA2 : JobArrival Job2) (job1_of : Job2 -> Job1) (job2_of : Job1 -> seq Job2) (arrival_delay : Job2 -> duration) (delay_bound : Task2 -> duration) (ts2 : seq Task2) (arr_seq1 : arrival_sequence Job1), valid_arr_seq_propagation_mapping JA1 JA2 job1_of delay_bound arr_seq1 job2_of arrival_delay ts2 -> consistent_arrival_times (propagated_arrival_sequence JA1 job1_of arr_seq1 job2_of arrival_delay)
