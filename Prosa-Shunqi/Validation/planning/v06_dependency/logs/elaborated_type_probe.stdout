@mea_scheduled_job_has_later_deadline
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall (t_edf : instant) (j : Job) (t : instant), scheduled_at (make_edf_at sched t_edf) j t -> t < job_deadline j
END|prosa.analysis.facts.transform.edf_opt.mea_scheduled_job_has_later_deadline
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_guarantee_dl_orig
@mea_guarantee_dl_orig
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (sched : schedule (ideal.processor_state Job)), completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall (t_edf : instant) (j_orig : Job), scheduled_at sched j_orig t_edf -> t_edf < job_deadline j_orig
END|prosa.analysis.facts.transform.edf_opt.mea_guarantee_dl_orig
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_guarantee_fsc_is_j_edf
@mea_guarantee_fsc_is_j_edf
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)) (t_edf : instant) (j_orig : Job), scheduled_at sched j_orig t_edf -> forall j_edf : Job, scheduled_at (make_edf_at sched t_edf) j_edf t_edf -> sched (edf_trans.find_swap_candidate sched t_edf j_orig) = Some j_edf
END|prosa.analysis.facts.transform.edf_opt.mea_guarantee_fsc_is_j_edf
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_guarantee_deadlines
@mea_guarantee_deadlines
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall (t_edf : instant) (j_orig : Job), scheduled_at sched j_orig t_edf -> forall j_edf : Job, scheduled_at (make_edf_at sched t_edf) j_edf t_edf -> job_deadline j_edf <= job_deadline j_orig
END|prosa.analysis.facts.transform.edf_opt.mea_guarantee_deadlines
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_guarantee_case_t'_past_deadline
@mea_guarantee_case_t'_past_deadline
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall (t_edf : instant) (j_orig : Job), scheduled_at sched j_orig t_edf -> forall j_edf : Job, scheduled_at (make_edf_at sched t_edf) j_edf t_edf -> forall (j' : Job) (t' : instant), scheduled_at (make_edf_at sched t_edf) j' t' -> job_deadline j_orig <= t' -> job_deadline j_edf <= job_deadline j'
END|prosa.analysis.facts.transform.edf_opt.mea_guarantee_case_t'_past_deadline
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_guarantee_case_t'_before_deadline
@mea_guarantee_case_t'_before_deadline
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall (t_edf : instant) (j_orig : Job), scheduled_at sched j_orig t_edf -> forall j_edf : Job, scheduled_at (make_edf_at sched t_edf) j_edf t_edf -> forall (j' : Job) (t' : instant), t_edf <= t' -> scheduled_at (make_edf_at sched t_edf) j' t' -> job_arrival j' <= t_edf -> t' < job_deadline j_orig -> job_deadline j_edf <= job_deadline j'
END|prosa.analysis.facts.transform.edf_opt.mea_guarantee_case_t'_before_deadline
BEGIN|prosa.analysis.facts.transform.edf_opt.make_edf_at_guarantee
@make_edf_at_guarantee
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall t_edf : instant, EDF_at (make_edf_at sched t_edf) t_edf
END|prosa.analysis.facts.transform.edf_opt.make_edf_at_guarantee
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_jobs_must_arrive
@mea_jobs_must_arrive
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall t_edf : instant, jobs_must_arrive_to_execute (make_edf_at sched t_edf)
END|prosa.analysis.facts.transform.edf_opt.mea_jobs_must_arrive
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_job_scheduled
@mea_job_scheduled
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)) (t_edf : instant) (j : Job) (t : instant), scheduled_at (make_edf_at sched t_edf) j t -> exists t' : instant, scheduled_at sched j t'
END|prosa.analysis.facts.transform.edf_opt.mea_job_scheduled
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_job_scheduled'
@mea_job_scheduled'
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)) (t_edf : instant) (j : Job) (t : instant), scheduled_at sched j t -> exists t' : instant, scheduled_at (make_edf_at sched t_edf) j t'
END|prosa.analysis.facts.transform.edf_opt.mea_job_scheduled'
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_jobs_come_from_arrival_sequence
@mea_jobs_come_from_arrival_sequence
     : forall (Job : JobType) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)) (t_edf : instant) (arr_seq : arrival_sequence Job), jobs_come_from_arrival_sequence sched arr_seq -> jobs_come_from_arrival_sequence (make_edf_at sched t_edf) arr_seq
END|prosa.analysis.facts.transform.edf_opt.mea_jobs_come_from_arrival_sequence
BEGIN|prosa.analysis.facts.transform.edf_opt.mea_EDF_widen
@mea_EDF_widen
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall t_edf : instant, (forall t : nat, t < t_edf -> EDF_at sched t) -> forall t : nat, t <= t_edf -> EDF_at (make_edf_at sched t_edf) t
