@mea_no_deadline_misses
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobDeadline Job) (H1 : JobArrival Job) (sched : schedule (ideal.processor_state Job)), jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> all_deadlines_met sched -> forall t_edf : instant, all_deadlines_met (make_edf_at sched t_edf)
END|prosa.analysis.facts.transform.edf_opt.mea_no_deadline_misses
