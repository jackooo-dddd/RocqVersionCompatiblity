END|prosa.implementation.facts.extrapolated_arrival_curve.sorted_ltn_steps_imply_sorted_leq_steps_steps
BEGIN|prosa.implementation.facts.extrapolated_arrival_curve.step_at_0_is_00
step_at_0_is_00
     : forall ac_prefix : ArrivalCurvePrefix, sorted_ltn_steps ac_prefix -> no_inf_arrivals ac_prefix -> step_at ac_prefix 0 = (0, 0)
END|prosa.implementation.facts.extrapolated_arrival_curve.step_at_0_is_00
BEGIN|prosa.implementation.facts.extrapolated_arrival_curve.step_at_agrees_with_steps_of
step_at_agrees_with_steps_of
     : forall ac_prefix : ArrivalCurvePrefix, sorted_ltn_steps ac_prefix -> forall t v : Datatypes_nat__canonical__eqtype_Equality, (t, v) \in steps_of ac_prefix -> step_at ac_prefix t = (t, v)
END|prosa.implementation.facts.extrapolated_arrival_curve.step_at_agrees_with_steps_of
BEGIN|prosa.implementation.facts.extrapolated_arrival_curve.extrapolated_arrival_curve_is_monotone
extrapolated_arrival_curve_is_monotone
     : forall ac_prefix : ArrivalCurvePrefix, positive_horizon ac_prefix -> sorted_leq_steps ac_prefix -> monotone leq (extrapolated_arrival_curve ac_prefix)
END|prosa.implementation.facts.extrapolated_arrival_curve.extrapolated_arrival_curve_is_monotone
BEGIN|prosa.implementation.facts.extrapolated_arrival_curve.extrapolated_arrival_curve_change
extrapolated_arrival_curve_change
     : forall ac_prefix : ArrivalCurvePrefix, positive_horizon ac_prefix -> sorted_leq_steps ac_prefix -> forall t : duration, extrapolated_arrival_curve ac_prefix t != extrapolated_arrival_curve ac_prefix (t + 1) -> t %/ horizon_of ac_prefix < (t + 1) %/ horizon_of ac_prefix \/ t %/ horizon_of ac_prefix = (t + 1) %/ horizon_of ac_prefix /\ value_at ac_prefix (t %% horizon_of ac_prefix) < value_at ac_prefix ((t + 1) %% horizon_of ac_prefix)
END|prosa.implementation.facts.extrapolated_arrival_curve.extrapolated_arrival_curve_change
BEGIN|prosa.implementation.facts.generic_schedule.schedule_up_to_def
@schedule_up_to_def
     : forall (Job : JobType) (PState : ProcessorState Job) (policy : PointwisePolicy PState) (idle_state : PState) (t : instant), schedule_up_to policy idle_state t t = policy match t with
                                                                                                                                                                                 | 0 => empty_schedule idle_state
                                                                                                                                                                                 | t'.+1 => schedule_up_to policy idle_state t'
                                                                                                                                                                                 end t
END|prosa.implementation.facts.generic_schedule.schedule_up_to_def
BEGIN|prosa.implementation.facts.generic_schedule.schedule_up_to_unfold
@schedule_up_to_unfold
     : forall (Job : JobType) (PState : ProcessorState Job) (policy : PointwisePolicy PState) (idle_state : PState) (h t : instant), schedule_up_to policy idle_state h t = replace_at match h with
                                                                                                                                                                                       | 0 => empty_schedule idle_state
                                                                                                                                                                                       | t'.+1 => schedule_up_to policy idle_state t'
                                                                                                                                                                                       end h (policy match h with
                                                                                                                                                                                                     | 0 => empty_schedule idle_state
                                                                                                                                                                                                     | t'.+1 => schedule_up_to policy idle_state t'
                                                                                                                                                                                                     end h) t
END|prosa.implementation.facts.generic_schedule.schedule_up_to_unfold
BEGIN|prosa.implementation.facts.generic_schedule.schedule_up_to_widen
@schedule_up_to_widen
     : forall (Job : JobType) (PState : ProcessorState Job) (policy : PointwisePolicy PState) (idle_state : PState) (h t : nat), t <= h -> schedule_up_to policy idle_state h t = schedule_up_to policy idle_state h.+1 t
END|prosa.implementation.facts.generic_schedule.schedule_up_to_widen
BEGIN|prosa.implementation.facts.generic_schedule.schedule_up_to_empty
@schedule_up_to_empty
     : forall (Job : JobType) (PState : ProcessorState Job) (policy : PointwisePolicy PState) (idle_state : PState) (h t : nat), h < t -> schedule_up_to policy idle_state h t = idle_state
END|prosa.implementation.facts.generic_schedule.schedule_up_to_empty
BEGIN|prosa.implementation.facts.generic_schedule.schedule_up_to_prefix_inclusion
@schedule_up_to_prefix_inclusion
     : forall (Job : JobType) (PState : ProcessorState Job) (policy : PointwisePolicy PState) (idle_state : PState) (h1 h2 : nat), h1 <= h2 -> forall t : nat, t <= h1 -> schedule_up_to policy idle_state h1 t = schedule_up_to policy idle_state h2 t
END|prosa.implementation.facts.generic_schedule.schedule_up_to_prefix_inclusion
BEGIN|prosa.implementation.facts.generic_schedule.schedule_up_to_identical_prefix
@schedule_up_to_identical_prefix
     : forall (Job : JobType) (PState : ProcessorState Job) (policy : PointwisePolicy PState) (idle_state : PState) (h t : nat), t <= h.+1 -> identical_prefix (schedule_up_to policy idle_state h) (generic_schedule policy idle_state) t
END|prosa.implementation.facts.generic_schedule.schedule_up_to_identical_prefix
BEGIN|prosa.implementation.facts.ideal_uni.preemption_aware.allocation_at_idle
@allocation_at_idle
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (RM : JobReady Job (ideal.processor_state Job)) (H1 : JobPreemptable Job) (choose_job : instant -> seq Job -> option Job), (forall (t : instant) (s : seq Job), choose_job t s = None <-> s = [::]) -> forall (sched : schedule (ideal.processor_state Job)) (t : instant), allocation_at arr_seq choose_job sched t = None -> jobs_backlogged_at arr_seq sched t = [::]
END|prosa.implementation.facts.ideal_uni.preemption_aware.allocation_at_idle
BEGIN|prosa.implementation.facts.ideal_uni.preemption_aware.idle_schedule_no_backlogged_jobs
@idle_schedule_no_backlogged_jobs
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (RM : JobReady Job (ideal.processor_state Job)), nonclairvoyant_readiness RM -> forall (H1 : JobPreemptable Job) (choose_job : instant -> seq Job -> option Job), (forall (t : instant) (s : seq Job), choose_job t s = None <-> s = [::]) -> forall t : instant, ideal_is_idle (pmc_uni_schedule arr_seq choose_job) t -> jobs_backlogged_at arr_seq (pmc_uni_schedule arr_seq choose_job) t = [::]
END|prosa.implementation.facts.ideal_uni.preemption_aware.idle_schedule_no_backlogged_jobs
BEGIN|prosa.implementation.facts.ideal_uni.preemption_aware.np_schedule_work_conserving
@np_schedule_work_conserving
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall RM : JobReady Job (ideal.processor_state Job), nonclairvoyant_readiness RM -> forall (H1 : JobPreemptable Job) (choose_job : instant -> seq Job -> option Job), (forall (t : instant) (s : seq Job), choose_job t s = None <-> s = [::]) -> work_conserving arr_seq (pmc_uni_schedule arr_seq choose_job)
END|prosa.implementation.facts.ideal_uni.preemption_aware.np_schedule_work_conserving
BEGIN|prosa.implementation.facts.ideal_uni.preemption_aware.np_schedule_jobs_from_arrival_sequence
@np_schedule_jobs_from_arrival_sequence
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (RM : JobReady Job (ideal.processor_state Job)) (H1 : JobPreemptable Job) (choose_job : instant -> seq Job -> option Job), (forall (t : instant) (s : seq Job) (j : Job), choose_job t s = Some j -> j \in s) -> jobs_come_from_arrival_sequence (pmc_uni_schedule arr_seq choose_job) arr_seq
END|prosa.implementation.facts.ideal_uni.preemption_aware.np_schedule_jobs_from_arrival_sequence
BEGIN|prosa.implementation.facts.ideal_uni.preemption_aware.chosen_job_is_ready
@chosen_job_is_ready
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (RM : JobReady Job (ideal.processor_state Job)) (H1 : JobPreemptable Job) (choose_job : instant -> seq Job -> option Job), (forall (t : instant) (s : seq Job) (j : Job), choose_job t s = Some j -> j \in s) -> nonclairvoyant_readiness RM -> forall (j : Job) (t : instant), choose_job t (jobs_backlogged_at arr_seq match t with
                                                                                                                                                                                                                                                                                                                                                                                                                                | 0 => empty_schedule None
                                                                                                                                                                                                                                                                                                                                                                                                                                | t'.+1 => schedule_up_to (allocation_at arr_seq choose_job) None t'
                                                                                                                                                                                                                                                                                                                                                                                                                                end t) == Some j -> job_ready (pmc_uni_schedule arr_seq choose_job) j t
END|prosa.implementation.facts.ideal_uni.preemption_aware.chosen_job_is_ready
BEGIN|prosa.implementation.facts.ideal_uni.preemption_aware.jobs_must_be_ready
@jobs_must_be_ready
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (RM : JobReady Job (ideal.processor_state Job)) (H1 : JobPreemptable Job) (choose_job : instant -> seq Job -> option Job), (forall (t : instant) (s : seq Job) (j : Job), choose_job t s = Some j -> j \in s) -> nonclairvoyant_readiness RM -> jobs_must_be_ready_to_execute (pmc_uni_schedule arr_seq choose_job)
END|prosa.implementation.facts.ideal_uni.preemption_aware.jobs_must_be_ready
BEGIN|prosa.implementation.facts.ideal_uni.preemption_aware.np_schedule_valid
@np_schedule_valid
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (RM : JobReady Job (ideal.processor_state Job)) (H1 : JobPreemptable Job) (choose_job : instant -> seq Job -> option Job), (forall (t : instant) (s : seq Job) (j : Job), choose_job t s = Some j -> j \in s) -> nonclairvoyant_readiness RM -> valid_schedule (pmc_uni_schedule arr_seq choose_job) arr_seq
END|prosa.implementation.facts.ideal_uni.preemption_aware.np_schedule_valid
BEGIN|prosa.implementation.facts.ideal_uni.preemption_aware.np_job_remains_scheduled
@np_job_remains_scheduled
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (RM : JobReady Job (ideal.processor_state Job)) (H1 : JobPreemptable Job) (choose_job : instant -> seq Job -> option Job) (t : nat), prev_job_nonpreemptive match t with
                                                                                                                                                                                                                                                                   | 0 => empty_schedule None
                                                                                                                                                                                                                                                                   | t'.+1 => schedule_up_to (allocation_at arr_seq choose_job) None t'
                                                                                                                                                                                                                                                                   end t -> schedule_up_to (allocation_at arr_seq choose_job) None t t = schedule_up_to (allocation_at arr_seq choose_job) None t t.-1
END|prosa.implementation.facts.ideal_uni.preemption_aware.np_job_remains_scheduled
BEGIN|prosa.implementation.facts.ideal_uni.preemption_aware.np_consistent
@np_consistent
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall RM : JobReady Job (ideal.processor_state Job), nonclairvoyant_readiness RM -> forall (H1 : JobPreemptable Job) (choose_job : instant -> seq Job -> option Job), (forall (t : instant) (s : seq Job) (j : Job), choose_job t s = Some j -> j \in s) -> forall t : nat, prev_job_nonpreemptive match t with
                                                                                                                                                                                                                                                                                                                                                                                                                                              | 0 => empty_schedule None
                                                                                                                                                                                                                                                                                                                                                                                                                                              | t'.+1 => schedule_up_to (allocation_at arr_seq choose_job) None t'
                                                                                                                                                                                                                                                                                                                                                                                                                                              end t -> ~~ preemption_time arr_seq (pmc_uni_schedule arr_seq choose_job) t
END|prosa.implementation.facts.ideal_uni.preemption_aware.np_consistent
BEGIN|prosa.implementation.facts.ideal_uni.preemption_aware.np_respects_preemption_model
@np_respects_preemption_model
     : forall (Job : JobType) (H : JobCost Job) (H0 : JobArrival Job) (arr_seq : arrival_sequence Job) (RM : JobReady Job (ideal.processor_state Job)), nonclairvoyant_readiness RM -> forall (H1 : JobPreemptable Job) (choose_job : instant -> seq Job -> option Job), (forall j : Job, arrives_in arr_seq j -> job_cannot_become_nonpreemptive_before_execution j) -> valid_nonpreemptive_readiness RM (pmc_uni_schedule arr_seq choose_job) -> schedule_respects_preemption_model arr_seq (pmc_uni_schedule arr_seq choose_job)
END|prosa.implementation.facts.ideal_uni.preemption_aware.np_respects_preemption_model
BEGIN|prosa.implementation.facts.ideal_uni.prio_aware.uni_schedule_work_conserving
@uni_schedule_work_conserving
     : forall (Job : JobType) (JC : JobCost Job) (JA : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall RM : JobReady Job (ideal.processor_state Job), nonclairvoyant_readiness RM -> forall (H : JobPreemptable Job) (JLDP : JLDP_policy Job), work_conserving arr_seq (uni_schedule arr_seq)
END|prosa.implementation.facts.ideal_uni.prio_aware.uni_schedule_work_conserving
BEGIN|prosa.implementation.facts.ideal_uni.prio_aware.uni_schedule_valid
@uni_schedule_valid
     : forall (Job : JobType) (JC : JobCost Job) (JA : JobArrival Job) (arr_seq : arrival_sequence Job) (RM : JobReady Job (ideal.processor_state Job)), nonclairvoyant_readiness RM -> forall (H : JobPreemptable Job) (JLDP : JLDP_policy Job), valid_schedule (uni_schedule arr_seq) arr_seq
END|prosa.implementation.facts.ideal_uni.prio_aware.uni_schedule_valid
BEGIN|prosa.implementation.facts.ideal_uni.prio_aware.schedule_respects_preemption_model
@prio_aware.schedule_respects_preemption_model
     : forall (Job : JobType) (JC : JobCost Job) (JA : JobArrival Job) (arr_seq : arrival_sequence Job) (RM : JobReady Job (ideal.processor_state Job)), nonclairvoyant_readiness RM -> forall (H : JobPreemptable Job) (JLDP : JLDP_policy Job), valid_nonpreemptive_readiness RM (uni_schedule arr_seq) -> (forall j : Job, arrives_in arr_seq j -> job_cannot_become_nonpreemptive_before_execution j) -> schedule_respects_preemption_model arr_seq (uni_schedule arr_seq)
END|prosa.implementation.facts.ideal_uni.prio_aware.schedule_respects_preemption_model
BEGIN|prosa.implementation.facts.ideal_uni.prio_aware.scheduled_job_is_supremum
@scheduled_job_is_supremum
     : forall (Job : JobType) (JC : JobCost Job) (JA : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall RM : JobReady Job (ideal.processor_state Job), nonclairvoyant_readiness RM -> forall (H : JobPreemptable Job) (JLDP : JLDP_policy Job) (j : Job) (t : instant), scheduled_at (uni_schedule arr_seq) j t -> preemption_time arr_seq (uni_schedule arr_seq) t -> supremum (hep_job_at t) (jobs_backlogged_at arr_seq match t with
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     | 0 => empty_schedule None
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     | t'.+1 => schedule_up_to (allocation_at arr_seq choose_highest_prio_job) None t'
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     end t) = Some j
END|prosa.implementation.facts.ideal_uni.prio_aware.scheduled_job_is_supremum
BEGIN|prosa.implementation.facts.ideal_uni.prio_aware.schedule_respects_policy
@schedule_respects_policy
     : forall (Job : JobType) (JC : JobCost Job) (JA : JobArrival Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall RM : JobReady Job (ideal.processor_state Job), nonclairvoyant_readiness RM -> forall (H : JobPreemptable Job) (JLDP : JLDP_policy Job), reflexive_priorities JLDP -> total_priorities JLDP -> transitive_priorities JLDP -> respects_JLDP_policy_at_preemption_point arr_seq (uni_schedule arr_seq) JLDP
END|prosa.implementation.facts.ideal_uni.prio_aware.schedule_respects_policy
BEGIN|prosa.implementation.facts.job_constructor.job_generation_valid_number
job_generation_valid_number
     : forall (ts : seq Task) (tsk : Task) (n : nat) (t : instant), tsk \in ts -> size (generate_jobs_at tsk n t) = n
END|prosa.implementation.facts.job_constructor.job_generation_valid_number
BEGIN|prosa.implementation.facts.job_constructor.generate_jobs_at_unique
generate_jobs_at_unique
     : forall (tsk : concrete_task) (n : nat) (t : instant), uniq (generate_jobs_at tsk n t)
END|prosa.implementation.facts.job_constructor.generate_jobs_at_unique
BEGIN|prosa.implementation.facts.job_constructor.job_arrival_consistent
job_arrival_consistent
     : forall (ts : seq Task) (j : Job) (t : instant), j \in arrivals_at (concrete_arrival_sequence generate_jobs_at ts) t -> task.job_arrival j = t
END|prosa.implementation.facts.job_constructor.job_arrival_consistent
BEGIN|prosa.implementation.facts.job_constructor.arrivals_at_unique
arrivals_at_unique
     : forall ts : seq Task, uniq ts -> forall t : instant, uniq (arrivals_at (concrete_arrival_sequence generate_jobs_at ts) t)
END|prosa.implementation.facts.job_constructor.arrivals_at_unique
BEGIN|prosa.implementation.facts.job_constructor.arrivals_between_unique
arrivals_between_unique
     : forall ts : seq Task, uniq ts -> forall t1 t2 : instant, uniq (arrivals_between (concrete_arrival_sequence generate_jobs_at ts) t1 t2)
END|prosa.implementation.facts.job_constructor.arrivals_between_unique
BEGIN|prosa.implementation.facts.job_constructor.job_generation_valid_jobs
job_generation_valid_jobs
     : forall (tsk : concrete_task) (n : nat) (t : instant) (j : Job), j \in generate_jobs_at tsk n t -> task.job_task j = tsk /\ task.job_arrival j = t /\ task.job_cost j <= task.task_cost tsk
END|prosa.implementation.facts.job_constructor.job_generation_valid_jobs
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.arr_seq_is_a_set
@arr_seq_is_a_set
     : forall (Task : TaskType) (Job : JobType) (ts : seq Task) (H3 : MaxArrivals Task) (generate_jobs_at : Task -> nat -> instant -> seq Job), (forall t1 t2 : instant, uniq (arrivals_between (concrete_arrival_sequence generate_jobs_at ts) t1 t2)) -> arrival_sequence_uniq (concrete_arrival_sequence generate_jobs_at ts)
END|prosa.implementation.facts.maximal_arrival_sequence.arr_seq_is_a_set
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.concrete_all_jobs_from_taskset
@concrete_all_jobs_from_taskset
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (ts : seq Task) (H3 : MaxArrivals Task) (generate_jobs_at : Task -> nat -> instant -> seq Job), (forall (tsk : Task) (n : nat) (t : instant) (j : Job), j \in generate_jobs_at tsk n t -> job_task j = tsk /\ job_arrival j = t /\ job_cost j <= task_cost tsk) -> all_jobs_from_taskset (concrete_arrival_sequence generate_jobs_at ts) ts
END|prosa.implementation.facts.maximal_arrival_sequence.concrete_all_jobs_from_taskset
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.arrival_times_are_consistent
@arrival_times_are_consistent
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (ts : seq Task) (H3 : MaxArrivals Task) (generate_jobs_at : Task -> nat -> instant -> seq Job), (forall (tsk : Task) (n : nat) (t : instant) (j : Job), j \in generate_jobs_at tsk n t -> job_task j = tsk /\ job_arrival j = t /\ job_cost j <= task_cost tsk) -> consistent_arrival_times (concrete_arrival_sequence generate_jobs_at ts)
END|prosa.implementation.facts.maximal_arrival_sequence.arrival_times_are_consistent
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.concrete_valid_job_cost
@concrete_valid_job_cost
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (ts : seq Task) (H3 : MaxArrivals Task) (generate_jobs_at : Task -> nat -> instant -> seq Job), (forall (tsk : Task) (n : nat) (t : instant) (j : Job), j \in generate_jobs_at tsk n t -> job_task j = tsk /\ job_arrival j = t /\ job_cost j <= task_cost tsk) -> arrivals_have_valid_job_costs (concrete_arrival_sequence generate_jobs_at ts)
END|prosa.implementation.facts.maximal_arrival_sequence.concrete_valid_job_cost
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.task_arrivals_at_eq_generate_jobs_at
@task_arrivals_at_eq_generate_jobs_at
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (ts : seq Task), uniq ts -> forall (H3 : MaxArrivals Task) (generate_jobs_at : Task -> nat -> instant -> seq Job), (forall (tsk : Task) (n : nat) (t : instant) (j : Job), j \in generate_jobs_at tsk n t -> job_task j = tsk /\ job_arrival j = t /\ job_cost j <= task_cost tsk) -> forall tsk : Task, tsk \in ts -> forall t : instant, task_arrivals_at (concrete_arrival_sequence generate_jobs_at ts) tsk t = generate_jobs_at tsk (max_arrivals_at tsk t) t
END|prosa.implementation.facts.maximal_arrival_sequence.task_arrivals_at_eq_generate_jobs_at
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.task_arrivals_at_eq
@task_arrivals_at_eq
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (ts : seq Task), uniq ts -> forall (H3 : MaxArrivals Task) (generate_jobs_at : Task -> nat -> instant -> seq Job), (forall (tsk : Task) (n : nat) (t : instant), tsk \in ts -> size (generate_jobs_at tsk n t) = n) -> (forall (tsk : Task) (n : nat) (t : instant) (j : Job), j \in generate_jobs_at tsk n t -> job_task j = tsk /\ job_arrival j = t /\ job_cost j <= task_cost tsk) -> forall tsk : Task, tsk \in ts -> forall t : instant, size (task_arrivals_at (concrete_arrival_sequence generate_jobs_at ts) tsk t) = max_arrivals_at tsk t
END|prosa.implementation.facts.maximal_arrival_sequence.task_arrivals_at_eq
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.number_of_task_arrivals_eq
@number_of_task_arrivals_eq
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (ts : seq Task), uniq ts -> forall (H3 : MaxArrivals Task) (generate_jobs_at : Task -> nat -> instant -> seq Job), (forall (tsk : Task) (n : nat) (t : instant), tsk \in ts -> size (generate_jobs_at tsk n t) = n) -> (forall (tsk : Task) (n : nat) (t : instant) (j : Job), j \in generate_jobs_at tsk n t -> job_task j = tsk /\ job_arrival j = t /\ job_cost j <= task_cost tsk) -> forall tsk : Task, tsk \in ts -> forall t1 t2 : instant, number_of_task_arrivals (concrete_arrival_sequence generate_jobs_at ts) tsk t1 t2 = \sum_(t1 <= t < t2) max_arrivals_at tsk t
END|prosa.implementation.facts.maximal_arrival_sequence.number_of_task_arrivals_eq
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.extend_horizon_size
@extend_horizon_size
     : forall (Task : TaskType) (ts : seq Task), uniq ts -> forall (H3 : MaxArrivals Task) (tsk : Task), tsk \in ts -> forall t : nat, size (iter t (extend_arrival_prefix tsk) [::]) = t
END|prosa.implementation.facts.maximal_arrival_sequence.extend_horizon_size
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.prefix_up_to_size
@prefix_up_to_size
     : forall (Task : TaskType) (ts : seq Task), uniq ts -> forall (H3 : MaxArrivals Task) (tsk : Task), tsk \in ts -> forall t : nat, size (maximal_arrival_prefix tsk t) = t.+1
END|prosa.implementation.facts.maximal_arrival_sequence.prefix_up_to_size
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.n_arrivals_at_prefix_inclusion1
@n_arrivals_at_prefix_inclusion1
     : forall (Task : TaskType) (ts : seq Task), uniq ts -> forall (H3 : MaxArrivals Task) (tsk : Task), tsk \in ts -> forall t h : nat, t <= h -> nth 0 (maximal_arrival_prefix tsk h) t = nth 0 (maximal_arrival_prefix tsk h.+1) t
END|prosa.implementation.facts.maximal_arrival_sequence.n_arrivals_at_prefix_inclusion1
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.n_arrivals_at_prefix_inclusion
@n_arrivals_at_prefix_inclusion
     : forall (Task : TaskType) (ts : seq Task), uniq ts -> forall (H3 : MaxArrivals Task) (tsk : Task), tsk \in ts -> forall t h1 h2 : nat, t <= h1 <= h2 -> nth 0 (maximal_arrival_prefix tsk h1) t = nth 0 (maximal_arrival_prefix tsk h2) t
END|prosa.implementation.facts.maximal_arrival_sequence.n_arrivals_at_prefix_inclusion
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.max_arrivals_at_next_max_arrivals_eq
@max_arrivals_at_next_max_arrivals_eq
     : forall (Task : TaskType) (ts : seq Task), uniq ts -> forall (H3 : MaxArrivals Task) (tsk : Task), tsk \in ts -> forall t : nat, 0 < t -> max_arrivals_at tsk t = next_max_arrival tsk (maximal_arrival_prefix tsk t.-1)
END|prosa.implementation.facts.maximal_arrival_sequence.max_arrivals_at_next_max_arrivals_eq
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.n_arrivals_at_leq
@n_arrivals_at_leq
     : forall (Task : TaskType) (ts : seq Task), uniq ts -> forall H3 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall t Δ : nat, Δ <= t -> max_arrivals_at tsk t <= max_arrivals tsk Δ.+1 - \sum_(t - Δ <= i < t) max_arrivals_at tsk i
END|prosa.implementation.facts.maximal_arrival_sequence.n_arrivals_at_leq
BEGIN|prosa.implementation.facts.maximal_arrival_sequence.concrete_is_arrival_curve
@concrete_is_arrival_curve
     : forall (Task : TaskType) (H : TaskCost Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (H2 : JobCost Job) (ts : seq Task), uniq ts -> forall H3 : MaxArrivals Task, valid_taskset_arrival_curve ts max_arrivals -> forall generate_jobs_at : Task -> nat -> instant -> seq Job, (forall (tsk : Task) (n : nat) (t : instant), tsk \in ts -> size (generate_jobs_at tsk n t) = n) -> (forall (tsk : Task) (n : nat) (t : instant) (j : Job), j \in generate_jobs_at tsk n t -> job_task j = tsk /\ job_arrival j = t /\ job_cost j <= task_cost tsk) -> taskset_respects_max_arrivals (concrete_arrival_sequence generate_jobs_at ts) ts
END|prosa.implementation.facts.maximal_arrival_sequence.concrete_is_arrival_curve
