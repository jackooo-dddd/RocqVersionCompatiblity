BEGIN|prosa.analysis.facts.priority.classes.another_hep_job_diff_task
@another_hep_job_diff_task
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JLFP_policy Job) (j j' : Job), ~~ same_task j j' -> another_hep_job j j' = hep_job j j'
END|prosa.analysis.facts.priority.classes.another_hep_job_diff_task
BEGIN|prosa.analysis.facts.priority.classes.another_task_hep_job_taskwise_antireflexive
@another_task_hep_job_taskwise_antireflexive
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JLFP_policy Job) (tsk : Task) (j j' : Job), job_of_task tsk j -> job_of_task tsk j' -> ~ another_task_hep_job j' j
END|prosa.analysis.facts.priority.classes.another_task_hep_job_taskwise_antireflexive
BEGIN|prosa.analysis.facts.priority.classes.another_task_hep_job_another_hep_job
@another_task_hep_job_another_hep_job
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JLFP_policy Job) (j1 j2 : Job), another_task_hep_job j1 j2 = another_hep_job j1 j2 && (job_task j1 != job_task j2)
END|prosa.analysis.facts.priority.classes.another_task_hep_job_another_hep_job
BEGIN|prosa.analysis.facts.priority.classes.another_hep_job_split_task
@another_hep_job_split_task
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JLFP_policy Job) (j1 j2 : Job), another_hep_job j1 j2 = another_task_hep_job j1 j2 || another_hep_job_of_same_task j1 j2
END|prosa.analysis.facts.priority.classes.another_hep_job_split_task
BEGIN|prosa.analysis.facts.priority.classes.another_hep_job_exclusive
@another_hep_job_exclusive
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : JLFP_policy Job) (j1 j2 : Job), ~~ (another_task_hep_job j1 j2 && another_hep_job_of_same_task j1 j2)
END|prosa.analysis.facts.priority.classes.another_hep_job_exclusive
BEGIN|prosa.analysis.facts.priority.classes.hp_task_irrefl
@hp_task_irrefl
     : forall (Task : TaskType) (FP_policy : FP_policy Task), irreflexive (T:=Task) hp_task
END|prosa.analysis.facts.priority.classes.hp_task_irrefl
BEGIN|prosa.analysis.facts.priority.classes.hp_hep_task
@hp_hep_task
     : forall (Task : TaskType) (FP_policy : FP_policy Task) (tsk1 tsk2 : Task), hp_task tsk1 tsk2 -> hep_task tsk1 tsk2
END|prosa.analysis.facts.priority.classes.hp_hep_task
BEGIN|prosa.analysis.facts.priority.classes.ep_hep_task
@ep_hep_task
     : forall (Task : TaskType) (FP_policy : FP_policy Task) (tsk1 tsk2 : Task), ep_task tsk1 tsk2 -> hep_task tsk1 tsk2
END|prosa.analysis.facts.priority.classes.ep_hep_task
BEGIN|prosa.analysis.facts.priority.classes.ep_not_hp_task
@ep_not_hp_task
     : forall (Task : TaskType) (FP_policy : FP_policy Task) (tsk1 tsk2 : Task), ep_task tsk1 tsk2 -> ~~ hp_task tsk1 tsk2
END|prosa.analysis.facts.priority.classes.ep_not_hp_task
BEGIN|prosa.analysis.facts.priority.classes.ep_task_sym
@ep_task_sym
     : forall (Task : TaskType) (FP_policy : FP_policy Task) (tsk1 tsk2 : Task), ep_task tsk1 tsk2 = ep_task tsk2 tsk1
END|prosa.analysis.facts.priority.classes.ep_task_sym
BEGIN|prosa.analysis.facts.priority.classes.hep_hp_ep_task
@hep_hp_ep_task
     : forall (Task : TaskType) (FP_policy : FP_policy Task) (tsk1 tsk2 : Task), hep_task tsk1 tsk2 = hp_task tsk1 tsk2 || ep_task tsk1 tsk2
END|prosa.analysis.facts.priority.classes.hep_hp_ep_task
BEGIN|prosa.analysis.facts.priority.classes.eq_reflexive
@eq_reflexive
     : forall (Task : TaskType) (FP_policy : FP_policy Task), reflexive (T:=Task) hep_task -> reflexive (T:=Task) ep_task
END|prosa.analysis.facts.priority.classes.eq_reflexive
BEGIN|prosa.analysis.facts.priority.classes.hp_trans
@hp_trans
     : forall (Task : TaskType) (FP_policy : FP_policy Task), transitive (T:=Task) hep_task -> transitive (T:=Task) hp_task
END|prosa.analysis.facts.priority.classes.hp_trans
BEGIN|prosa.analysis.facts.priority.classes.hp_hep_trans
@hp_hep_trans
     : forall (Task : TaskType) (FP_policy : FP_policy Task), transitive (T:=Task) hep_task -> forall tsk1 tsk2 tsk3 : Task, hp_task tsk1 tsk2 -> hep_task tsk2 tsk3 -> hp_task tsk1 tsk3
END|prosa.analysis.facts.priority.classes.hp_hep_trans
BEGIN|prosa.analysis.facts.priority.classes.hep_hp_trans
@hep_hp_trans
     : forall (Task : TaskType) (FP_policy : FP_policy Task), transitive (T:=Task) hep_task -> forall tsk1 tsk2 tsk3 : Task, hep_task tsk1 tsk2 -> hp_task tsk2 tsk3 -> hp_task tsk1 tsk3
END|prosa.analysis.facts.priority.classes.hep_hp_trans
BEGIN|prosa.analysis.facts.priority.classes.not_hep_hp_task
@not_hep_hp_task
     : forall (Task : TaskType) (FP_policy : FP_policy Task), total (T:=Task) hep_task -> forall tsk1 tsk2 : Task, ~~ hep_task tsk1 tsk2 = hp_task tsk2 tsk1
END|prosa.analysis.facts.priority.classes.not_hep_hp_task
BEGIN|prosa.analysis.facts.priority.classes.not_hp_hep_task
@not_hp_hep_task
     : forall (Task : TaskType) (FP_policy : FP_policy Task), total (T:=Task) hep_task -> forall tsk1 tsk2 : Task, ~~ hp_task tsk1 tsk2 = hep_task tsk2 tsk1
END|prosa.analysis.facts.priority.classes.not_hp_hep_task
BEGIN|prosa.analysis.facts.priority.classes.nhp_ep_nhep_task
@nhp_ep_nhep_task
     : forall (Task : TaskType) (FP_policy : FP_policy Task), total (T:=Task) hep_task -> forall tsk1 tsk2 : Task, ~~ hp_task tsk1 tsk2 = ~~ hep_task tsk1 tsk2 || ep_task tsk1 tsk2
END|prosa.analysis.facts.priority.classes.nhp_ep_nhep_task
BEGIN|prosa.analysis.facts.priority.classes.respects_sequential_tasks
@respects_sequential_tasks
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (FP : FP_policy Task), reflexive_task_priorities FP -> policy_respects_sequential_tasks FP
END|prosa.analysis.facts.priority.classes.respects_sequential_tasks
BEGIN|prosa.analysis.facts.priority.classes.hep_job_implies_hep_task
@hep_job_implies_hep_task
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (JLFP : JLFP_policy Job) (FP : FP_policy Task), JLFP_FP_compatible JLFP FP -> forall j1 j2 : Job, hep_job j1 j2 -> hep_task (job_task j1) (job_task j2)
END|prosa.analysis.facts.priority.classes.hep_job_implies_hep_task
BEGIN|prosa.analysis.facts.priority.classes.hp_task_implies_hep_job
@hp_task_implies_hep_job
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (JLFP : JLFP_policy Job) (FP : FP_policy Task), JLFP_FP_compatible JLFP FP -> forall j1 j2 : Job, hp_task (job_task j1) (job_task j2) -> hep_job j1 j2
END|prosa.analysis.facts.priority.classes.hp_task_implies_hep_job
BEGIN|prosa.analysis.facts.priority.edf.hep_job_deadline
@hep_job_deadline
     : forall (Job : JobType) (H0 : JobDeadline Job) (j j' : Job), hep_job j j' = (job_deadline j <= job_deadline j')
END|prosa.analysis.facts.priority.edf.hep_job_deadline
BEGIN|prosa.analysis.facts.priority.edf.hep_job_task_deadline
@hep_job_task_deadline
     : forall (Job : JobType) (H : JobArrival Job) (Task : TaskType) (H0 : TaskDeadline Task) (H1 : JobTask Job Task) (j j' : Job), hep_job j j' = (job_arrival j + task_deadline (job_task j) <= job_arrival j' + task_deadline (job_task j'))
END|prosa.analysis.facts.priority.edf.hep_job_task_deadline
BEGIN|prosa.analysis.facts.priority.edf.hep_job_arrival_edf
@hep_job_arrival_edf
     : forall (Job : JobType) (H : JobArrival Job) (Task : TaskType) (H0 : TaskDeadline Task) (H1 : JobTask Job Task) (j j' : Job), same_task j j' -> hep_job j j' = (job_arrival j <= job_arrival j')
END|prosa.analysis.facts.priority.edf.hep_job_arrival_edf
BEGIN|prosa.analysis.facts.priority.edf.EDF_respects_sequential_tasks
@EDF_respects_sequential_tasks
     : forall (Job : JobType) (H : JobArrival Job) (Task : TaskType) (H0 : TaskDeadline Task) (H1 : JobTask Job Task), policy_respects_sequential_tasks (EDF Job)
END|prosa.analysis.facts.priority.edf.EDF_respects_sequential_tasks
BEGIN|prosa.analysis.facts.priority.edf.EDF_implies_sequential_tasks
@EDF_implies_sequential_tasks
     : forall (Task : TaskType) (H0 : TaskDeadline Task) (Job : JobType) (H2 : JobTask Job Task) (Arrival : JobArrival Job) (Cost : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall (sched : schedule PState) (H3 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall H4 : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (EDF Job) -> sequential_tasks arr_seq sched
END|prosa.analysis.facts.priority.edf.EDF_implies_sequential_tasks
BEGIN|prosa.analysis.facts.priority.elf.hep_job_elf_gel
@hep_job_elf_gel
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H0 : JobTask Job Task) (AR : JobArrival Job) (FP : FP_policy Task) (j j' : Job), ep_task (job_task j) (job_task j') -> hep_job j j' = hep_job j j'
END|prosa.analysis.facts.priority.elf.hep_job_elf_gel
BEGIN|prosa.analysis.facts.priority.elf.hep_job_arrival_elf
@hep_job_arrival_elf
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H0 : JobTask Job Task) (AR : JobArrival Job) (FP : FP_policy Task), reflexive_task_priorities FP -> forall j j' : Job, same_task j j' -> hep_job j j' = (job_arrival j <= job_arrival j')
END|prosa.analysis.facts.priority.elf.hep_job_arrival_elf
BEGIN|prosa.analysis.facts.priority.elf.ELF_is_reflexive
@ELF_is_reflexive
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H0 : JobTask Job Task) (AR : JobArrival Job) (FP : FP_policy Task), reflexive_task_priorities FP -> reflexive_job_priorities (ELF FP)
END|prosa.analysis.facts.priority.elf.ELF_is_reflexive
BEGIN|prosa.analysis.facts.priority.elf.ELF_is_transitive
@ELF_is_transitive
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H0 : JobTask Job Task) (AR : JobArrival Job) (FP : FP_policy Task), transitive_task_priorities FP -> transitive_job_priorities (ELF FP)
END|prosa.analysis.facts.priority.elf.ELF_is_transitive
BEGIN|prosa.analysis.facts.priority.elf.ELF_is_total
@ELF_is_total
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H0 : JobTask Job Task) (AR : JobArrival Job) (FP : FP_policy Task), total_task_priorities FP -> total_job_priorities (ELF FP)
END|prosa.analysis.facts.priority.elf.ELF_is_total
BEGIN|prosa.analysis.facts.priority.elf.ELF_is_JLFP_FP_compatible
@ELF_is_JLFP_FP_compatible
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H0 : JobTask Job Task) (AR : JobArrival Job) (FP : FP_policy Task), JLFP_FP_compatible (ELF FP) FP
END|prosa.analysis.facts.priority.elf.ELF_is_JLFP_FP_compatible
BEGIN|prosa.analysis.facts.priority.elf.ELF_respects_sequential_tasks
@ELF_respects_sequential_tasks
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H0 : JobTask Job Task) (AR : JobArrival Job) (FP : FP_policy Task), reflexive_task_priorities FP -> policy_respects_sequential_tasks (ELF FP)
END|prosa.analysis.facts.priority.elf.ELF_respects_sequential_tasks
BEGIN|prosa.analysis.facts.priority.elf.ELF_implies_sequential_tasks
@ELF_implies_sequential_tasks
     : forall (Task : TaskType) (H : PriorityPoint Task) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobCost Job) (AR : JobArrival Job) (FP : FP_policy Task), reflexive_task_priorities FP -> transitive_task_priorities FP -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall (sched : schedule PState) (H2 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall H3 : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (ELF FP) -> sequential_tasks arr_seq sched
END|prosa.analysis.facts.priority.elf.ELF_implies_sequential_tasks
BEGIN|prosa.analysis.facts.priority.fifo.hep_job_arrival_FIFO
@hep_job_arrival_FIFO
     : forall (Job : JobType) (Arrival : JobArrival Job) (j j' : Job), hep_job j j' = (job_arrival j <= job_arrival j')
END|prosa.analysis.facts.priority.fifo.hep_job_arrival_FIFO
BEGIN|prosa.analysis.facts.priority.fifo.not_hep_job_arrival_FIFO
@not_hep_job_arrival_FIFO
     : forall (Job : JobType) (Arrival : JobArrival Job) (j j' : Job), ~~ hep_job j j' = (job_arrival j' < job_arrival j)
END|prosa.analysis.facts.priority.fifo.not_hep_job_arrival_FIFO
BEGIN|prosa.analysis.facts.priority.fifo.not_hep_job_FIFO
@not_hep_job_FIFO
     : forall (Job : JobType) (Arrival : JobArrival Job) (j j' : Job), ~~ hep_job j j' -> hep_job j' j
END|prosa.analysis.facts.priority.fifo.not_hep_job_FIFO
BEGIN|prosa.analysis.facts.priority.fifo.not_hep_job_always_higher_priority_FIFO
@not_hep_job_always_higher_priority_FIFO
     : forall (Job : JobType) (Arrival : JobArrival Job) (j j' : Job), ~~ hep_job j j' -> always_higher_priority j' j
END|prosa.analysis.facts.priority.fifo.not_hep_job_always_higher_priority_FIFO
BEGIN|prosa.analysis.facts.priority.fifo.FIFO_implies_no_priority_inversion
@FIFO_implies_no_priority_inversion
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, valid_schedule sched arr_seq -> forall H : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (FIFO Job) -> forall (j : Job) (t : instant), arrives_in arr_seq j -> pending sched j t -> ~~ priority_inversion arr_seq sched j t
END|prosa.analysis.facts.priority.fifo.FIFO_implies_no_priority_inversion
BEGIN|prosa.analysis.facts.priority.fifo.scheduled_implies_higher_priority_completed
@scheduled_implies_higher_priority_completed
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, valid_schedule sched arr_seq -> forall H : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (FIFO Job) -> forall (j : Job) (t : instant), scheduled_at sched j t -> forall j_hp : Job, arrives_in arr_seq j_hp -> ~~ hep_job j j_hp -> completed_by sched j_hp t
END|prosa.analysis.facts.priority.fifo.scheduled_implies_higher_priority_completed
BEGIN|prosa.analysis.facts.priority.fifo.FIFO_implies_no_pi
@FIFO_implies_no_pi
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, valid_schedule sched arr_seq -> forall H : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (FIFO Job) -> forall (Task : TaskType) (H0 : JobTask Job Task) (tsk : Task), valid_schedule sched arr_seq -> priority_inversion_is_bounded_by arr_seq sched tsk (constant 0)
END|prosa.analysis.facts.priority.fifo.FIFO_implies_no_pi
BEGIN|prosa.analysis.facts.priority.fifo.FIFO_implies_no_service_inversion
@FIFO_implies_no_service_inversion
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, valid_schedule sched arr_seq -> forall H : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (FIFO Job) -> forall (Task : TaskType) (H0 : JobTask Job Task) (tsk : Task), valid_schedule sched arr_seq -> service_inversion_is_bounded_by arr_seq sched tsk (constant 0)
END|prosa.analysis.facts.priority.fifo.FIFO_implies_no_service_inversion
BEGIN|prosa.analysis.facts.priority.fifo.tasks_execute_sequentially
@tasks_execute_sequentially
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, valid_schedule sched arr_seq -> forall H : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (FIFO Job) -> forall (Task : TaskType) (H0 : JobTask Job Task), sequential_tasks arr_seq sched
END|prosa.analysis.facts.priority.fifo.tasks_execute_sequentially
BEGIN|prosa.analysis.facts.priority.fifo.fifo_respects_sequential_tasks
@fifo_respects_sequential_tasks
     : forall (Job : JobType) (Arrival : JobArrival Job) (Task : TaskType) (H0 : JobTask Job Task), policy_respects_sequential_tasks (FIFO Job)
END|prosa.analysis.facts.priority.fifo.fifo_respects_sequential_tasks
BEGIN|prosa.analysis.facts.priority.fifo.no_preemptions_under_FIFO
@no_preemptions_under_FIFO
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, valid_schedule sched arr_seq -> work_conserving arr_seq sched -> forall H : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (FIFO Job) -> no_superfluous_preemptions sched -> forall (j : Job) (t : instant), ~~ preempted_at sched j t
END|prosa.analysis.facts.priority.fifo.no_preemptions_under_FIFO
BEGIN|prosa.analysis.facts.priority.fifo.FIFO_is_nonpreemptive
@FIFO_is_nonpreemptive
     : forall (Job : JobType) (Arrival : JobArrival Job) (Cost : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall sched : schedule PState, valid_schedule sched arr_seq -> work_conserving arr_seq sched -> forall H : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (FIFO Job) -> no_superfluous_preemptions sched -> nonpreemptive_schedule sched
END|prosa.analysis.facts.priority.fifo.FIFO_is_nonpreemptive
BEGIN|prosa.analysis.facts.priority.fifo_ahep_bound.bound_on_hep_workload
@bound_on_hep_workload
     : forall (Task : TaskType) (H : TaskCost Task) (H0 : MaxArrivals Task) (Job : JobType) (H1 : JobTask Job Task) (H2 : JobCost Job) (H3 : JobArrival Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_supply_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> arrivals_have_valid_job_costs arr_seq -> forall ts : seq Task, all_jobs_from_taskset arr_seq ts -> taskset_respects_max_arrivals arr_seq ts -> valid_taskset_arrival_curve ts max_arrivals -> forall tsk : Task, tsk \in ts -> forall sched : schedule PState, jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall j : Job, job_of_task tsk j -> arrives_in arr_seq j -> job_cost_positive j -> forall t1 t2 : instant, busy_interval arr_seq sched j t1 t2 -> forall Δ : instant, t1 + Δ < t2 -> cumulative_another_hep_job_interference arr_seq sched j t1 (t1 + Δ) <= \sum_(tsko <- ts) task_request_bound_function tsko (job_arrival j - t1 + 1) - task_cost tsk
END|prosa.analysis.facts.priority.fifo_ahep_bound.bound_on_hep_workload
BEGIN|prosa.analysis.facts.priority.gel.hep_job_priority_point
@hep_job_priority_point
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : PriorityPoint Task) (Arrival : JobArrival Job) (j j' : Job), hep_job j j' = ((job_arrival j)%:R + task_priority_point (job_task j) <= (job_arrival j')%:R + task_priority_point (job_task j'))%R
END|prosa.analysis.facts.priority.gel.hep_job_priority_point
BEGIN|prosa.analysis.facts.priority.gel.hep_job_arrival_gel
@hep_job_arrival_gel
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : PriorityPoint Task) (Arrival : JobArrival Job) (j j' : Job), same_task j j' -> hep_job j j' = (job_arrival j <= job_arrival j')
END|prosa.analysis.facts.priority.gel.hep_job_arrival_gel
BEGIN|prosa.analysis.facts.priority.gel.hep_job_arrives_before
@hep_job_arrives_before
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : PriorityPoint Task) (Arrival : JobArrival Job) (j j' : Job), hep_job j' j -> ((job_arrival j')%:R <= (job_arrival j)%:R + task_priority_point (job_task j) - task_priority_point (job_task j'))%R
END|prosa.analysis.facts.priority.gel.hep_job_arrives_before
BEGIN|prosa.analysis.facts.priority.gel.hep_job_arrives_after_zero
@hep_job_arrives_after_zero
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : PriorityPoint Task) (Arrival : JobArrival Job) (j j' : Job), hep_job j' j -> (0 <= (job_arrival j)%:R + task_priority_point (job_task j) - task_priority_point (job_task j'))%R
END|prosa.analysis.facts.priority.gel.hep_job_arrives_after_zero
BEGIN|prosa.analysis.facts.priority.gel.GEL_respects_sequential_tasks
@GEL_respects_sequential_tasks
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : PriorityPoint Task) (Arrival : JobArrival Job), policy_respects_sequential_tasks (GEL Job Task)
END|prosa.analysis.facts.priority.gel.GEL_respects_sequential_tasks
BEGIN|prosa.analysis.facts.priority.gel.GEL_implies_sequential_tasks
@GEL_implies_sequential_tasks
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (H0 : PriorityPoint Task) (Arrival : JobArrival Job) (H1 : JobCost Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall PState : ProcessorState Job, uniprocessor_model PState -> forall (sched : schedule PState) (JobReady0 : JobReady Job PState), work_bearing_readiness arr_seq sched -> valid_schedule sched arr_seq -> forall H2 : JobPreemptable Job, valid_preemption_model arr_seq sched -> respects_JLFP_policy_at_preemption_point arr_seq sched (GEL Job Task) -> sequential_tasks arr_seq sched
END|prosa.analysis.facts.priority.gel.GEL_implies_sequential_tasks
BEGIN|prosa.analysis.facts.priority.inversion.sched_itself_implies_no_priority_inversion
@sched_itself_implies_no_priority_inversion
     : forall (Job : JobType) (H1 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (j : Job) (t : instant), scheduled_at sched j t -> ~~ priority_inversion arr_seq sched j t
END|prosa.analysis.facts.priority.inversion.sched_itself_implies_no_priority_inversion
BEGIN|prosa.analysis.facts.priority.inversion.priority_inversion_scheduled_at
@priority_inversion_scheduled_at
     : forall (Job : JobType) (H1 : JobArrival Job) (PState : ProcessorState Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> forall (JLFP : JLFP_policy Job) (j : Job) (t : instant), priority_inversion arr_seq sched j t -> exists j' : Job, scheduled_at sched j' t
END|prosa.analysis.facts.priority.inversion.priority_inversion_scheduled_at
BEGIN|prosa.analysis.facts.priority.inversion.no_priority_inversion_when_idle
