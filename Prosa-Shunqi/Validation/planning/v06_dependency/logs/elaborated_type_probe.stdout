@jitter_prop_same_jobs
     : forall (Task : TaskType) (Job : JobType) (H : JobTask Job Task) (original_arrival : JobArrival Job) (H0 : TaskJitter Task) (H1 : JobJitter Job) (arr_seq : arrival_sequence Job), valid_arrival_sequence arr_seq -> forall ts : seq Task, valid_jitter_bounds ts -> all_jobs_from_taskset arr_seq ts -> all_jobs_from_taskset (release_sequence arr_seq) ts
