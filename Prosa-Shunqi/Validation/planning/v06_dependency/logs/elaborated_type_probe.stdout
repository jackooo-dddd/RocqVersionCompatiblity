@cumul_interference_plus_sched_le_serv_of_task_plus_cumul_task_interference
     : forall (Task : TaskType) (Job : JobType) (H0 : JobTask Job Task) (H1 : JobArrival Job) (jc : JobCost Job) (PState : ProcessorState Job), uniprocessor_model PState -> unit_service_proc_model PState -> forall arr_seq : arrival_sequence Job, valid_arrival_sequence arr_seq -> forall sched : schedule PState, jobs_come_from_arrival_sequence sched arr_seq -> jobs_must_arrive_to_execute sched -> completed_jobs_dont_execute sched -> forall (tsk : Task) (H3 : Interference Job) (H4 : InterferingWorkload Job), definitions.work_conserving arr_seq sched -> sequential_tasks arr_seq sched -> interference_and_workload_consistent_with_sequential_tasks arr_seq sched tsk -> forall j : Job, arrives_in arr_seq j -> job_of_task tsk j -> job_cost_positive j -> forall t1 t2 : instant, definitions.busy_interval sched j t1 t2 -> forall x : duration, t1 + x < t2 -> ~~ completed_by sched j (t1 + x) -> cumulative_interference j t1 (t1 + x) <= task_service_of_jobs_in sched tsk (arrivals_between arr_seq t1 (t1 + (job_arrival j - t1) + 1)) t1 (t1 + x) - service_during sched j t1 (t1 + x) + cumul_task_interference arr_seq sched j t1 (t1 + x)
END|prosa.analysis.abstract.IBF.task.cumul_interference_plus_sched_le_serv_of_task_plus_cumul_task_interference
