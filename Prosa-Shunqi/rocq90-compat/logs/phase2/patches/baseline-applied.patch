+Fixpoint Nat_add n m :=
+  match m with
+  | 0 => n
+  | Nat_succ p => Nat_succ (Nat_add n p)
+  end.
+
+Fixpoint Nat_mul n m :=
+  match m with
+  | 0 => 0
+  | Nat_succ p => Nat_add (Nat_mul n p) n
+  end.
+
+Fixpoint Nat_pow n m :=
+  match m with
+    | 0 => 1
+    | Nat_succ m => Nat_mul (Nat_pow n m) n
+  end.
