+  | Bound i when i = cutoff -> raise_notrace DependentAccMotive
+  | Bound i when i > cutoff -> Bound (i - 1)
+  | Bound i -> Bound i
+  | Sort u -> Sort u
+  | Const (n, us) -> Const (n, us)
